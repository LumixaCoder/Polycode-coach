    "Filtering and ranking data": "import json\nwith open('elements.json') as f:\n    data = json.load(f)\nheavy = [e['name'] for e in data if e['atomic_mass'] > 40]\nprint(len(heavy))",
    "Summarizing data": "import json\nwith open('planets.json') as f:\n    data = json.load(f)\ndiameters = [p['diameter_km'] for p in data]\nprint(int(sum(diameters) / len(diameters)))",
    "Regular expressions": "import re\nprint(re.findall(r'\\d+', 'a1 b22 c333'))",
    "Testing your code with assert": "def add(a,b):\n    return a+b\nassert add(2,3)==5\nprint('ok')",
    "Recursion and algorithm thinking": "def fact(n):\n    return 1 if n<=1 else n*fact(n-1)\nprint(fact(4))",
    "Decorators": "def deco(f):\n    def w(*a,**k):\n        print('before')\n        return f(*a,**k)\n    return w\n@deco\ndef hi():\n    print('hi')\nhi()",
    "Generators": "def gen(n):\n    for i in range(n):\n        yield i\nprint(list(gen(3)))",
    "Working with APIs": "import json\ns='{\"a\": 1, \"b\": 2}'\nprint(json.loads(s)['a'])",
}


def coach_quiz_item(label):
    """Return {'code': ..., 'question': ...} for a prediction quiz, with a fallback."""
    code = _COACH_QUIZ_BANK.get(label)
    if not code:
        code = "nums = [1, 2, 3]\nprint(sum(nums))"
        prompt = "Here's a short snippet. Take a guess \u2014 what does this print?"
    else:
        prompt = ("Don't run it yet \u2014 read this snippet and predict exactly what it prints. "
                  "Then type your answer below and I'll check it with a live run.")
    return {"code": code, "question": prompt}


def normalize_answer(text):
    return " ".join((text or "").strip().split()).lower()


def normalize_output(text):
    lines = [ln for ln in (text or "").splitlines() if ln.strip()]
    return normalize_answer("\n".join(lines))


def check_prediction(item, user_text, live_output):
    expected = normalize_output(live_output)
    got = normalize_answer(user_text)
    return bool(expected) and expected == got


_GLOSSARY = {
    "print()": "print() sends something to the console so you can see it.",
    "len()": "len() counts characters in a string or items in a list.",
    "type()": "type() tells you what kind of value something is.",
    "range()": "range(n) creates the numbers 0 up to n-1 to loop over.",
    "int()/float()": "int() and float() convert text or numbers into ints and floats.",
    "str()": "str() turns a value into text (a string).",
    "input()": "input() reads a line the user typed (simulated with a variable in the playground) and always returns a string.",
    "for loop": "A for loop repeats code once for each item in a sequence.",
    "while loop": "while condition: repeats while the condition stays True; update a variable inside or it never ends.",
    "if/elif/else": "if/elif/else run different code depending on a condition.",
    "booleans": "True and False; and needs both True, or needs one True, not flips the value.",
    "def / return": "def defines a reusable function; return sends a value back.",
    "list": "A list stores many values in order, in [square brackets].",
    "dictionary": "A dictionary maps keys to values with {curly braces}.",
    "tuple": "A tuple is an ordered, unchangeable collection in (round brackets).",
    "set": "A set stores only unique values, with no repeats.",
    "slicing": "word[start:end:step] copies a span of a sequence; word[::-1] reverses it, word[1:4] is indices 1,2,3.",
    "dict methods": ".keys()/.values()/.items() loop the dictionary; .get(key, default) avoids KeyError.",
    "enumerate": "enumerate(seq) yields (index, value) without manual counting.",
    "zip": "zip(a,b) pairs two lists as (a[i], b[i]) for parallel iteration.",
    "import": "import brings in a module so you can use its tools.",
    "json": "json.dump()/load() save and read structured data to files.",
    "json.loads()": "json.loads(string) parses a JSON string (from an API) into Python objects; json.load(file) does the same for a file.",
    "try/except": "try/except catches errors so your program doesn't crash.",
    "open()": "open() opens a file to read or write it.",
    "json.load()": "json.load(file) reads a JSON file and turns it into a Python list or dictionary of real data.",
    "sorted()": "sorted(data, key=lambda item: item['field']) returns a copy of the data ordered by one field, leaving the original list unchanged.",
    "min()/max()": "min(data, key=lambda item: item['field']) and max(data, key=...) return the record with the smallest or largest value in that field.",
    "sum()": "sum(a_list) adds up all the numbers in a list in one call \u2014 handy for totals and averages.",
    "decorator": "@decorator wraps a function: func = decorator(func); the wrapper can add behavior before/after the call.",
    "generator": "def with yield pauses and resumes, producing values lazily one at a time; for loop consumes it.",
    "assert": "assert condition raises AssertionError if False; assert func(x)==expected is the simplest test.",
    "regex": "re.findall(pattern, text) returns every substring matching the regex pattern, e.g., r'\\d+' for numbers.",
    "class": "class defines a blueprint; __init__ sets up each new object.",
    "tkinter": "tkinter is Python's built-in toolkit for windows. import tkinter as tk, then create a window with tk.Tk().",
    "mainloop()": "root.mainloop() starts the event loop that keeps the window open until it closes.",
    "tk.Label": "tk.Label(root, text='...') shows text on a window; add .pack() to place it.",
    "tk.Button": "tk.Button(root, text='...', command=func) adds a clickable button that runs func on click.",
    "tk.Entry": "tk.Entry(root) makes a text box; entry.get() returns what the user typed.",
    "command=": "command= takes a function name (no parentheses); it runs whenever the widget is used.",
}


def guided_help_questions():
    """The interview the helper walks through before answering."""
    return [
        {
            "id": "goal",
            "type": "text",
            "label": "\U0001F3AF  Goal",
            "ask": "First, what are you trying to do? In one or two sentences, "
                   "describe what you want your code to accomplish.",
        },
        {
            "id": "blocker",
            "type": "choice",
            "options": [
                "I don't know where to start",
                "My code errors",
                "It runs but the output is wrong",
                "I'm stuck on one line",
            ],
            "label": "\U0001F6A7  What's blocking you?",
            "ask": "What's blocking you right now? Type the number of the closest option.",
        },
        {
            "id": "help",
            "type": "choice",
            "options": [
                "A one-line hint",
                "Step-by-step guidance",
                "Explain the concept",
                "A full example to copy",
            ],
            "label": "\U0001F4E6  What kind of help?",
            "ask": "What kind of help do you want? Type the number of the closest option.",
        },
        {
            "id": "source",
            "type": "choice",
            "options": [
                "From this lesson",
                "From my actual code",
                "From the whole unit + a glossary of tools",
            ],
            "label": "\U0001F4DA  Where should the help come from?",
            "ask": "Where do you want the help drawn from? Type the number of the closest option.",
        },
    ]


def _guess_tool(step):
    instruction = str(step.get("instruction", "")).lower()
    for phrase, tool in [
        ("tkinter", "tkinter"), ("tk.", "tkinter"), ("tk ", "tkinter"),
        ("mainloop", "mainloop()"), ("command=", "command="),
        ("entry", "tk.Entry"), ("button", "tk.Button"), ("label", "tk.Label"),
        ("sorted(", "sorted()"), ("sort", "sorted()"), ("max(", "min()/max()"),
        ("min(", "min()/max()"), ("average", "sum()"), ("load", "json.load()"),
        ("loads", "json.loads()"), ("api", "json.loads()"),
        ("len(", "len()"), ("print", "print()"), ("type(", "type()"),
        ("int(", "int()/float()"), ("float(", "int()/float()"), ("str(", "str()"), ("input", "input()"),
        ("while", "while loop"), ("boolean", "booleans"), (" and ", "booleans"), (" or ", "booleans"),
        ("slic", "slicing"), ("[", "slicing"), ("enumerate", "enumerate"), ("zip", "zip"),
        ("decorator", "decorator"), ("@ ", "decorator"), ("wrapper", "decorator"),
        ("yield", "generator"), ("generator", "generator"), ("assert", "assert"), ("regex", "regex"), ("re.findall", "regex"),
        ("range", "range()"), ("for", "for loop"), ("if", "if/elif/else"),
        ("def", "def / return"), ("return", "def / return"),
        ("list", "list"), ("dictionary", "dictionary"), ("dict", "dictionary"),
        ("tuple", "tuple"), ("set", "set"), ("import", "import"),
        ("json", "json"), ("try", "try/except"), ("except", "try/except"),
        ("open", "open()"), ("file", "open()"), ("class", "class"),
    ]:
        if phrase in instruction:
            return tool
    return "print()"


def guided_help_plan(answers, step, lesson, code, res):
    """Compose a specific help message using the requested source material."""
    answers = answers or {}
    blocker = answers.get("blocker", 0)
    help_kind = answers.get("help", 0)
    source = answers.get("source", 0)
    goal = str(answers.get("goal", "")).strip()
    tool = _guess_tool(step)
    instr = str(step.get("instruction", ""))

    # Source material builders
    lines = []
    lines.append("\U0001F680 Guided help")

    if goal:
        lines.append("\nYou said: \"%s\"" % goal)

    # ----- RUN/DIAGNOSE the code to ground the answer -----
    diag = ""
    code_text = (code or "").strip()
    if source in (1, 2) and code_text:
        if not res.get("ok"):
            diag = "\n\u26A0 Your code isn't running: " + (res.get("explained") or res.get("error") or "an error").strip()
        elif res.get("output"):
            diag = "\n\u2139 Your code printed:\n" + (res.get("output") or "").strip()
        else:
            diag = "\n\u2139 Your code ran but printed nothing."
    elif source == 1 and not code_text:
        diag = "\n\u2139 I don't see any code in the editor yet \u2014 start with a single line and run it."

    # ----- Reply opener based on blocker -----
    if blocker == 0:
        opener = ("Break the goal into a tiny first step: "
                  "get one line working that does *part* of it, run it, then add the next piece. "
                  "A first goal is to make this run: %s" % tool)
    elif blocker == 1:
        opener = ("We'll fix the error first. %s" % diag if diag else
                  "Run it to see the error, then read the first line of the message \u2014 it names "
                  "the line and the problem. %s is involved here." % tool)
    elif blocker == 2:
        opener = ("If it runs but the answer is wrong, check two things: what the *instruction* asks for, "
                  "and what your code actually does. %s" % diag)
    else:
        opener = ("Pick the one line that's giving you trouble and call out which tool it needs. "
                  "For this step that's most likely %s." % tool)

    lines.append("\n" + opener)

    # ----- Tool/glossary explanation (source 2 = lesson + glossary) -----
    if source == 2:
        exp = _GLOSSARY.get(tool)
        if exp:
            lines.append("\n\U0001F4CB  %s: %s" % (tool, exp))

    # ----- Lesson-derived help (source 0 or 2) -----
    lesson_ref = lesson or {}
    example = lesson_ref.get("example", "") if source in (0, 2) else ""
    if source in (0, 2):
        takeaways = lesson_ref.get("key_takeaways")
        if takeaways:
            lines.append("\n\U0001F4D6  From this lesson (key points):\n" + str(takeaways))
        if example and help_kind == 3:
            lines.append("\n\U0001F511  Example to study:\n" + example)

    # ----- The actual actionable guidance by help kind -----
    hint = str(step.get("hint", ""))
    if help_kind == 0:
        lines.append("\n\U0001F4A1  One-line hint: " + (hint or _GLOSSARY.get(tool, "")))
    elif help_kind == 1:
        lines.append("\n\U0001F9E9  Step-by-step:\n"
                     "1. Read the instruction: \"%s\"\n"
                     "2. Decide the tool you need \u2014 for this step: %s\n"
                     "3. Write the smallest correct version and run it.\n"
                     "4. Add one more detail, run again, and compare the output to the goal." % (instr, tool))
    elif help_kind == 3 and not example:
        lines.append("\n\U0001F511  Here's a small example to copy and adapt:\n" + _GLOSSARY.get(tool, ""))
    elif help_kind == 2 and source not in (0, 2):
        exp = _GLOSSARY.get(tool, "")
        if exp:
            lines.append("\n\U0001F4CB  %s" % exp)

    lines.append("\n\U0001F916  Give it a try with one small step, then tell me what happened.")
    return "\n".join(lines)


_ALLOWED_IMPORTS = {
    "math", "random", "datetime", "json", "string", "statistics", "decimal",
    "fractions", "collections", "tkinter", "re", "csv", "itertools",
    "functools", "textwrap", "time",
}

_GUI_AUTOCLOSE_MS = 1500

_TRACE_SENTINEL = "\x1f"
_TRACE_MAX_STEPS = 300

_WORKER_SRC = r"""
import base64
import builtins
import sys

_SENT = "\x1f"
_ALLOWED = {"math", "random", "datetime", "json", "string", "statistics", "decimal", "fractions", "collections", "tkinter", "re", "csv", "itertools", "functools", "textwrap", "time"}

_SAFE = [
    "print", "len", "type", "range", "int", "float", "str", "bool", "repr",
    "list", "dict", "set", "tuple", "sum", "min", "max", "abs", "round",
    "sorted", "reversed", "enumerate", "zip", "open", "ord", "chr", "any", "all",
    "Exception", "ValueError", "TypeError", "IndexError", "KeyError",
    "NameError", "AttributeError", "ZeroDivisionError", "RuntimeError",
    "ImportError", "SystemExit",
    "__build_class__",
]

def _restricted_import(name, globs=None, locs=None, fromlist=(), level=0):
    if name.split(".")[0] in _ALLOWED:
        return builtins.__import__(name, globs, locs, fromlist, level)
    raise ImportError("Module %r is not allowed in the playground. Allowed: %s" % (name, ", ".join(sorted(_ALLOWED))))

def _no_input(*args, **kwargs):
    raise RuntimeError("input() is not available in the playground. Hardcode the value instead.")

# Input mock when sandbox_inputs are supplied (one line per input() call)
_input_lines = []
_input_idx = [0]
def _make_input(lines):
    def _mock_input(prompt=""):
        if prompt:
            sys.stdout.write(str(prompt))
            sys.stdout.flush()
        idx = _input_idx[0]
        if idx < len(lines):
            _input_idx[0] += 1
            val = lines[idx]
            # echo the supplied input so output matches expectation (like terminal)
            if prompt:
                sys.stdout.write(val + "\n")
            return val
        raise RuntimeError("input() called more times than supplied inputs. Add more lines in the Input box.")
    return _mock_input

try:
    import tkinter as _tkinter
    _GUI_AUTOCLOSE_MS = __GUI_AUTOCLOSE_MS__

    class _AutoCloseTk(_tkinter.Tk):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)
            try:
                self.after(_GUI_AUTOCLOSE_MS, self.destroy)
            except Exception:
                pass

    _tkinter.Tk = _AutoCloseTk
except Exception:
    pass

def main():
    code = base64.b64decode(sys.argv[1]).decode("utf-8")
    # optional second arg: base64-encoded input lines separated by \n
    _lines = []
    if len(sys.argv) > 2 and sys.argv[2]:
        try:
            _lines = base64.b64decode(sys.argv[2]).decode("utf-8").splitlines()
        except Exception:
            _lines = []
    safe_builtins = {k: builtins.__dict__[k] for k in _SAFE}
    safe_builtins["__import__"] = _restricted_import
    safe_builtins["input"] = _make_input(_lines) if _lines else _no_input
    ns = {"__name__": "__main__", "__builtins__": safe_builtins}
    steps = [0]

    def trace(frame, event, arg):
        if event == "line" and frame.f_code.co_filename == "<user_code>":
            steps[0] += 1
            if steps[0] > """ + str(_TRACE_MAX_STEPS) + r""":
                sys.stdout.write("\x1fTRACE_LIMIT\x1f\n")
                return None
            try:
                names = {k: repr(v) for k, v in frame.f_locals.items() if not k.startswith("__")}
                sys.stdout.write("\x1f" + str(frame.f_lineno) + "\x05" + repr(names) + "\x1f\n")
            except Exception:
                pass
        return trace

    sys.settrace(trace)
    try:
        exec(compile(code, "<user_code>", "exec"), ns)
    except SystemExit:
        pass
    finally:
        sys.settrace(None)

main()
"""
_WORKER_SRC = _WORKER_SRC.replace("__GUI_AUTOCLOSE_MS__", str(_GUI_AUTOCLOSE_MS))


def check_blocked_code(code):
    """Returns a friendly 'blocked' message if the code tries something the
    playground doesn't allow, otherwise an empty string."""
    try:
        tree = ast.parse(code)
    except SyntaxError:
        return ""
    offenders = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for a in node.names:
                root = a.name.split(".")[0]
                if root not in _ALLOWED_IMPORTS:
                    offenders.append(root)
        elif isinstance(node, ast.ImportFrom):
            root = (node.module or "").split(".")[0]
            if root and root not in _ALLOWED_IMPORTS:
                offenders.append(root)
        elif isinstance(node, ast.Call):
            f = node.func
            if isinstance(f, ast.Name) and f.id in ("eval", "exec", "compile", "__import__", "breakpoint"):
                offenders.append(f.id)
    if offenders:
        return ("Blocked: " + ", ".join(sorted(set(offenders))) + ". In the playground you may use: "
                + ", ".join(sorted(_ALLOWED_IMPORTS)))
    return ""


def parse_trace_output(raw_text, code):
    """Turns the worker's sentinel-marked stdout into (trace steps, clean output)."""
    src = code.splitlines()
    entries = []
    pending_out = []
    all_out = []
    for line in raw_text.splitlines():
        # A trace marker can share its line with buffered output (e.g. after
        # print(x, end='')). Peel off the leading text so it is kept as output
        # instead of leaking raw sentinel characters into the cleaned result.
        if (_TRACE_SENTINEL in line and not line.startswith(_TRACE_SENTINEL)
                and line.endswith(_TRACE_SENTINEL) and line.count(_TRACE_SENTINEL) >= 2):
            idx = line.index(_TRACE_SENTINEL)
            prefix, line = line[:idx], line[idx:]
            if prefix:
                pending_out.append(prefix)
        if line.startswith(_TRACE_SENTINEL) and line.endswith(_TRACE_SENTINEL) and line.count(_TRACE_SENTINEL) >= 2:
            body = line[1:-1]
            if pending_out:
                all_out.extend(pending_out)
            if body == "TRACE_LIMIT":
                entries.append({"line": None, "vars": {}, "limit": True, "source": "", "out": "\n".join(pending_out)})
                pending_out = []
                continue
            if "\x05" in body:
                ln_str, names_str = body.split("\x05", 1)
                try:
                    ln = int(ln_str)
                except ValueError:
                    continue
                try:
                    vars_map = ast.literal_eval(names_str)
                except (ValueError, SyntaxError):
                    vars_map = {}
                line_src = src[ln - 1].strip() if 0 < ln <= len(src) else ""
                entries.append({
                    "line": ln, "vars": vars_map, "limit": False,
                    "source": line_src, "out": "\n".join(pending_out),
                })
                pending_out = []
        else:
            pending_out.append(line)
    all_out.extend(pending_out)
    return entries, "\n".join(all_out)


def _error_line_number(trace_text):
    for line in trace_text.splitlines():
        if "user_code" in line and "line" in line:
            part = line.split("line")[-1].split(",")[0].strip()
            try:
                return int(part)
            except ValueError:
                return None
    return None


def explain_error(trace_text, code=""):
    """Translates a raw Python traceback into a plain-English learning hint."""
    text = (trace_text or "").strip()
    if not text:
        return ""
    lines = [l for l in text.splitlines() if l.strip()]
    error_line = lines[-1] if lines else ""
    low = text.lower()
    line_num = _error_line_number(text)
    prefix = f"Line {line_num}: " if line_num else ""

    msg = ""
    if "nameerror" in low and " is not defined" in low:
        m = re.search(r"name\s*'([^']+)'", error_line)
        name = m.group(1) if m else "a name"
        msg = f"'{name}' isn't defined yet. This usually means a typo, or you're using a variable/function before you created it. Check the spelling and the order of your lines."
    elif "unboundlocalerror" in low:
        msg = ("You're using a variable inside a function before assigning it there. Give it a value first, "
               "or pass it in as a parameter.")
    elif "typeerror" in low and " not callable" in low:
        msg = "You called something with (...) that isn't a function. Check you wrote func() and not a plain variable or a string."
    elif "typeerror" in low and " unsupported operand" in low:
        msg = "You combined values of different types, like adding a string and a number. Convert one side with str() or int()/float() so both sides match."
    elif "typeerror" in low:
        msg = "A value has the wrong type for the operation you tried. For example, fix it by converting with int(), float(), or str()."
    elif ("indentationerror" in low or " unexpected indent" in low
          or " expected an indented block" in low or " unindent does not match" in low):
        msg = ("Indentation problem! Lines after for:, if:, def:, and while: must be indented (4 spaces) "
               "to show they belong 'inside' the block. Match the indentation to the example.")
    elif "syntaxerror" in low and "scanning string literal" in low:
        msg = "You have an unclosed quote \u2014 a string that starts with ' or \" but never closes. Count the quotes on that line."
    elif "syntaxerror" in low:
        msg = ("Python couldn't understand that line \u2014 usually a missing colon, comma, closing parenthesis ')', "
               "or quote. Compare the line to the example line by line.")
    elif "indexerror" in low:
        msg = "You tried to grab a position that doesn't exist. Lists start at 0, so a 3-item list has positions 0, 1, 2. Use len() to check how many items are in it."
    elif "keyerror" in low:
        msg = "That key isn't in the dictionary. Check the exact spelling, or use .get(key, default) so there's a fallback value."
    elif "zerodivisionerror" in low:
        msg = "Division by zero! Make sure whatever's on the bottom of the / can never be 0."
    elif "attributeerror" in low and " has no attribute" in low:
        msg = "That value doesn't support the .method you called \u2014 for example calling .upper() on a number. Check the value's type and the method's spelling."
    elif "valueerror" in low and "invalid literal" in low:
        msg = "You tried to turn text into a number, but the text doesn't look like a number (for example int('abc')). Use a string that only has digits."
    elif "modulenotfounderror" in low or "importerror" in low:
        msg = "That module can't be imported here. You may use: " + ", ".join(sorted(_ALLOWED_IMPORTS))
    elif "filenotfounderror" in low:
        msg = "Python couldn't find that file. Make sure you created it first with mode 'w' before trying to read it back."
    elif "recursionerror" in low:
        msg = "Your function kept calling itself without ever stopping \u2014 it needs a base case that eventually stops the recursion."
    elif "eof when reading a line" in low or "eoferror" in low:
        msg = "input() isn't available in the playground. Hardcode the value instead."
    elif "took too long" in low:
        msg = "Your loop may never end. Check the condition that stops it \u2014 like the n in range(n) or a counter that increments."
    elif "tclerror" in low and "can't invoke" in low and ("pack" in low or "grid" in low):
        msg = ("tkinter couldn't place a widget with pack()/grid() \u2014 you're probably mixing "
               "pack() and grid() in the same window, or re-using a widget's name. Use only one "
               "layout manager per window.")
    elif "tclerror" in low:
        msg = ("tkinter had a problem drawing your window \u2014 usually from mixing layout managers, "
               "or calling a method on a widget that's already gone. Check that each widget uses just "
               "one of pack()/grid() and that your widget names are right.")

    if msg:
        return f"{prefix}{msg}\n(Python said: {error_line})"
    return f"{prefix}Your code hit a Python error. Read the message in the output \u2014 it names the problem.\n(Python said: {error_line})"


def format_trace_steps(entries):
    """Formats trace entries for display, capping very long traces."""
    if not entries:
        return "No steps captured \u2014 make sure your code has more than one line to trace."
    display = []
    MAX_SHOW = 80
    if len(entries) > MAX_SHOW:
        first = entries[: MAX_SHOW // 2]
        last = entries[-(MAX_SHOW // 2):]
        blocks = [first, last]
    else:
        blocks = [entries]
    running = 1
    for group in blocks:
        for ent in group:
            if ent.get("limit"):
                display.append("... stopped tracing (too many steps) ...")
                continue
            vars_str = ", ".join(f"{k} = {v}" for k, v in ent.get("vars", {}).items())
            src = ent.get("source", "")
            display.append(f"[{running}] line {ent.get('line', '?')}: {src}")
            display.append(f"        {vars_str}" if vars_str else "        (no variables yet)")
            if ent.get("out"):
                display.append(f"        > {ent['out']}")
            running += 1
        if group is not blocks[-1]:
            display.append(f"... {len(entries) - MAX_SHOW} steps skipped ...")
    return "\n".join(display)


def _sandbox_python():
    """Finds a Python interpreter able to run the sandboxed learner code.

    Dev mode: the running interpreter (sys.executable).
    Frozen (PyInstaller) mode: a bundled 'runtime\\python.exe' next to the exe,
    then any 'python' on PATH.
    Returns None if none found.
    """
    if not getattr(sys, "frozen", False):
        return Path(sys.executable)

    base = Path(sys.executable).resolve().parent
    candidates = [
        base / "runtime" / "python.exe",
        base / "python.exe",
    ]
    for c in candidates:
        if c.is_file():
            return c
    try:
        res = subprocess.run(
            ["python", "-c", "import sys;print(sys.executable)"],
            capture_output=True, timeout=5,
        )
        if res.returncode == 0 and res.stdout:
            return Path(res.stdout.decode().strip())
    except Exception:
        pass
    return None


def draw_xp_chart(canvas, series, t, width=640, height=150):
    canvas.delete("all")
    if not series:
        canvas.create_text(width // 2, height // 2 - 8,
                           text="No XP yet \u2014 every step, lesson, and project you finish earns XP.",
                           fill=t["muted"], font=FONTS["body_sm"])
        return
    recent = series[-14:]
    n = len(recent)
    max_val = max(v for _, v in recent) or 1
    gap = 10
    usable_w = width - gap * (n + 1)
    bar_w = usable_w / n
    baseline = height - 26
    top = 18
    usable_h = baseline - top
    for i, (d, v) in enumerate(recent):
        x0 = gap + i * (bar_w + gap)
        h = max(v / max_val * usable_h, 3)
        y0 = baseline - h
        color = t["progress_fill"] if v < max_val else t["accent"]
        canvas.create_rectangle(x0, y0, x0 + bar_w, baseline, fill=color, outline="")
        if n <= 8 or i % 2 == 0:
            canvas.create_text(x0 + bar_w / 2, baseline + 6, text=d[5:],
                               fill=t["muted"], font=FONTS["caption"])
    canvas.create_text(width - gap, top, text=f"best day: {max_val} XP",
                       anchor="e", fill=t["muted"], font=FONTS["caption"])


DATASET_FILES = ("us_states.json", "elements.json", "planets.json", "movies.json", "weather.json", "books.json")


def _data_dir():
    """Locate the bundled data/ folder in dev or frozen builds."""
    try:
        if getattr(sys, "frozen", False):
            base = Path(sys.executable).resolve().parent
        else:
            base = Path(__file__).resolve().parent
        candidate = base / "data"
        if candidate.is_dir():
            return candidate
        internal = base / "_internal" / "data"
        return internal if internal.is_dir() else None
    except Exception:
        return None


DAILY_CHALLENGE_XP = 25


def _load_dataset(name):
    """Read one of the bundled datasets in-app (used to score challenges)."""
    base = _data_dir()
    if base is None:
        return []
    try:
        with open(base / name, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return []


def _build_challenge_specs():
    """All daily-challenge templates, each with ground-truth expected output.

    The expected lines are computed from the real datasets, so the challenge
    is scored exactly against the data the learner's code reads.
    """
    states = _load_dataset("us_states.json")
    elements = _load_dataset("elements.json")
    planets = _load_dataset("planets.json")

    oldest = sorted(states, key=lambda s: (s["statehood_year"], s["name"]))[:5]
    heaviest = max(elements, key=lambda e: e["atomic_mass"]) if elements else {}
    biggest = max(planets, key=lambda p: p["diameter_km"]) if planets else {}
    longest = sorted(planets, key=lambda p: p["year_length_years"], reverse=True)[:3]
    avg_au = round(sum(p["distance_au"] for p in planets) / len(planets), 2) if planets else 0
    heavy_n = sum(1 for e in elements if e["atomic_mass"] > 24) if elements else 0

    region_counts = {}
    for s in states:
        region_counts[s["region"]] = region_counts.get(s["region"], 0) + 1

    # New datasets for expanded challenges
    movies = _load_dataset("movies.json")
    weather = _load_dataset("weather.json")
    books = _load_dataset("books.json")
    top_rated_movie = max(movies, key=lambda m: m["rating"]) if movies else {}
    hottest_city = max(weather, key=lambda w: w["temp_c"]) if weather else {}
    longest_book = max(books, key=lambda b: b["pages"]) if books else {}

    specs = [
        {

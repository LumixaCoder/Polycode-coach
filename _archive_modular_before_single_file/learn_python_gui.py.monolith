]


def _match_topic(title):
    """Return the topic tag for a lesson title (or '' if none matches)."""
    low = (title or "").lower()
    for tag, keys in _TOPIC_KEYWORDS:
        if any(k in low for k in keys):
            return tag
    return ""


def _guess_level(progress):
    """Pick a level from progress when the survey hasn't stored one yet."""
    lang = current_language(progress)
    lessons = get_lesson_sets_for_language(lang)
    totals = {lvl: max(len(lessons.get(lvl) or []), 1)
              for lvl in ("Beginner", "Intermediate", "Advanced")}
    done = len(list(progress.get("completed_lessons") or []))
    idx = int(progress.get("lesson_index") or 0)
    for lvl in ("Beginner", "Intermediate", "Advanced"):
        if max(done, idx) + 1 < totals[lvl] and lvl != "Beginner":
            continue
        return lvl
    return "Beginner"


def _lesson_position(progress, level):
    """Return (fraction 0..1, topic) describing where the learner is in a level."""
    lang = current_language(progress)
    lessons = get_lesson_sets_for_language(lang).get(level) or []
    total = max(len(lessons), 1)
    done = len(list(progress.get("completed_lessons") or []))
    idx = int(progress.get("lesson_index") or 0)
    frac = max(0.0, min(1.0, max(done, idx) / total))
    topic = ""
    if lessons and 0 <= idx < len(lessons):
        topic = _match_topic(lessons[idx].get("title") or "")
    return frac, topic


def _pick_area(specs, progress):
    """Choose the level + topic area to draw today's challenge from."""
    level = progress.get("level")
    if level not in ("Beginner", "Intermediate", "Advanced"):
        level = _guess_level(progress)
    if not any(s.get("level") == level for s in specs):
        level = _guess_level(progress)
    frac, topic = _lesson_position(progress, level)
    if topic and not any(topic in s.get("topics", ()) for s in specs
                         if s.get("level") == level):
        topic = ""
    return level, frac, topic


def _level_aligned_challenge(specs, progress, ordinal):
    """Pick today's challenge with variety but level-appropriate difficulty.

    Deterministic per day (seeded by ordinal) but shuffled so the daily question
    isn't just the same progression. ~25% of days we inject a cross-level
    surprise — but it stays adjacent (Beginner↔Intermediate, Advanced↔Intermediate)
    so the challenge still matches the learner's skill. Otherwise we stay
    within the learner's level (shuffled) with 50% bias toward the current
    lesson's topic when possible, ensuring the challenge truly stretches that
    level's skills while still mixing 'what it is' and 'what you do'.
    """
    level, frac, topic = _pick_area(specs, progress)
    rnd = random.Random(ordinal)
    # 25% adjacent-level surprise keeps it challenging but not overwhelming
    if rnd.random() < 0.25:
        if level == "Beginner":
            pool = [s for s in specs if s.get("level") in ("Beginner", "Intermediate")]
        elif level == "Advanced":
            pool = [s for s in specs if s.get("level") in ("Intermediate", "Advanced")]
        else:
            pool = list(specs)
        rnd2 = random.Random(ordinal * 7919)
        rnd2.shuffle(pool)
        # For Beginners, ensure even surprise doesn't give hardest Advanced
        # (pool already excludes Advanced) so difficulty stays appropriate
        return rnd2.choice(pool)
    pool = [s for s in specs if s.get("level") == level]
    if not pool:
        pool = list(specs)
    rnd2 = random.Random(ordinal * 9973 + hash(level))
    rnd2.shuffle(pool)
    same_topic = [s for s in pool if topic and topic in s.get("topics", ())]
    if same_topic and rnd2.random() < 0.5:
        return rnd2.choice(same_topic)
    return rnd2.choice(pool)



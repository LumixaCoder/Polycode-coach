                 "vowel", "character", "slice", "slicing", "index")),
    ("numbers", ("number", "variable", "math", "count", "sum", "average", "square",
                 "multiple")),
    ("conditions", ("condition", "decision", "if", "else", "boolean", "logic", "true", "false")),
    ("loops", ("loop", "range", "for", "while", "enumerate", "zip")),
    ("lists", ("list", "sort", "range", "enumerate", "zip")),
    ("dicts", ("dictionary", "dict", "key", "map", "json", "method", ".items", ".get")),
    ("sets", ("set", "unique", "tuple")),

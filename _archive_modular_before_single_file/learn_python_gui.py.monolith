def ensure_progress(progress):
    defaults = default_progress()
    for key, val in defaults.items():
        progress.setdefault(key, val)
    # --- Language migration: old progress had no language field ---
    # If learner already has a level, they were a Python user - keep them on Python
    # so nothing is lost. If level is empty, language stays "" to trigger chooser.
    if not progress.get("language") or progress.get("language") not in SUPPORTED_LANGUAGES:
        if progress.get("level"):
            progress["language"] = "python"
        else:
            # keep "" so chooser shows; but ensure keys exist
            if progress.get("language") not in SUPPORTED_LANGUAGES and progress.get("language") != "":
                progress["language"] = ""
    _ensure_language_states(progress)
    # Migrate old language_states entries to include new guidance keys
    for lang in SUPPORTED_LANGUAGES:
        st = progress.get("language_states", {}).get(lang)
        if isinstance(st, dict) and st:
            st.setdefault("project_guidance_levels", {})
            st.setdefault("project_variant_choices", {})
            st.setdefault("project_hints", {})
            st.setdefault("project_fail_counts", {})
    # If we just assigned python to a legacy user, snapshot current flat keys into states
    cur = progress.get("language")
    if cur in SUPPORTED_LANGUAGES:
        # If states empty for current language, save flat into it (covers legacy migration)
        states = progress.get("language_states", {})
        if not states.get(cur):
            _save_current_language_state(progress)
    # Migrate legacy progress that used only 'completed_lessons' list for current level
    # into the per-level map so earlier levels' completion survives level switches.
    if progress.get("level") and progress.get("completed_lessons"):
        cur = progress.get("level")
        cbl = progress.get("completed_by_level", {})
        if cur not in cbl or not cbl.get(cur):
            # copy current list into map if map empty for this level
            if isinstance(progress.get("completed_lessons"), list):
                cbl[cur] = list(progress.get("completed_lessons", []))
                progress["completed_by_level"] = cbl
    return progress


def _level_idx(name):
    try:
        return LEVEL_ORDER.index(name)
    except ValueError:
        return -1


def _is_level_skipped(progress, level):
    """True if level is earlier than the learner's current level and was skipped via quiz.
    This is used to treat earlier levels as 'checked off' so the learner doesn't need to redo them."""
    cur = progress.get("level", "")
    if cur not in LEVEL_ORDER or level not in LEVEL_ORDER:
        return False
    if _level_idx(level) >= _level_idx(cur):
        return False
    # If the learner was placed at a higher level via quiz, earlier levels are considered skipped.
    # We also consider any level that has an entry in completed_by_level as explicitly completed.
    cbl = progress.get("completed_by_level", {})
    if level in cbl and len(cbl[level]) > 0:
        return True
    # If the quiz placed them higher, automatically treat lower levels as skipped
    # (legacy behavior for progress that predates completed_by_level).
    history = progress.get("level_history", [])
    # The initial quiz sets level_history to contain the placed level; if that level is higher,
    # lower levels are implicitly skipped.
    if cur in history and _level_idx(cur) > _level_idx(level):
        return True
    return False


def _auto_complete_levels_up_to(progress, target_level, lesson_sets):
    """Mark every lesson in levels earlier than target_level as complete.

    This is the 'checks off all the stuff you don't need to do' after the beginning quiz:
    if the quiz places you at Intermediate, Beginner is auto-checked; at Advanced, both
    Beginner and Intermediate are auto-checked. All actionable steps, projects and reviews
    are marked so the sidebar shows green checks and badges can be earned without redoing.
    """
    try:
        target_idx = LEVEL_ORDER.index(target_level)
    except ValueError:
        return
    for i in range(target_idx):
        lv = LEVEL_ORDER[i]
        lessons = lesson_sets.get(lv, [])
        if not lessons:
            continue
        # Mark in completed_by_level map
        cbl = progress.setdefault("completed_by_level", {})
        cbl[lv] = list(range(len(lessons)))
        # Mark all actionable steps
        cs = progress.setdefault("completed_steps", {})
        for li, lesson in enumerate(lessons):
            for si, step in enumerate(lesson.get("steps", [])):
                if step.get("type") != "concept":
                    cs[step_key(lv, li, si)] = True
            # Mark project passed and first_try
            key = attempt_key(lv, li)
            log = progress.setdefault("performance_log", {}).setdefault(
                key, {"first_try": False, "project_passed": False}
            )
            log["first_try"] = True
            log["project_passed"] = True
            # Schedule review for each auto-completed lesson
            schedule_review(progress, lv, li)


def _get_completed_for_level(progress, level):
    """Return the list of completed lesson indices for a specific level.

    Uses the per-level map when the level is not the current one, so history
    survives switches (quiz skip, SkillTree jump, promotion).
    """
    cur = progress.get("level", "")
    if cur == level:
        return list(progress.get("completed_lessons", []))
    cbl = progress.get("completed_by_level", {})
    if isinstance(cbl, dict) and level in cbl:
        return list(cbl[level] or [])
    if _is_level_skipped(progress, level):
        try:
            lang = current_language(progress)
            n = len(get_lesson_sets_for_language(lang).get(level, []))
            return list(range(n))
        except Exception:
            return []
    return []


def update_streak(progress):
    today = date.today().isoformat()
    last = progress.get("last_active_date", "")
    if not last:
        progress["streak"] = 1
    elif last == today:
        pass
    else:
        try:
            last_date = date.fromisoformat(last)
            gap = (date.today() - last_date).days
            if gap == 1:
                progress["streak"] = progress.get("streak", 0) + 1
            elif gap > 1:
                # Streak freeze: if you have a freeze, consume one to protect the streak
                freezes = int(progress.get("streak_freezes", 0) or 0)
                # One freeze covers one missed day; gap=2 needs 1 freeze, gap=3 needs 2, etc.
                needed = gap - 1
                if freezes >= needed and needed > 0:
                    progress["streak_freezes"] = freezes - needed
                    # keep streak alive, then count today
                    progress["streak"] = progress.get("streak", 0) + 1
                else:
                    progress["streak"] = 1
        except ValueError:
            progress["streak"] = 1
    progress["last_active_date"] = today
    # reward freeze on 7-day milestones
    if progress.get("streak", 0) and progress["streak"] % 7 == 0:
        # only award if we just incremented today (not if last==today)
        if last != today:
            _earn_streak_freeze_if_eligible(progress)
    # update weekly progress and heatmap on every active day
    _update_weekly_progress(progress)
    _update_heatmap(progress, today)


def _update_weekly_progress(progress):
    """Track weekly goal (resets on Monday). Call on active days."""
    try:
        today = date.today()
        iso_year, iso_week, _ = today.isocalendar()
        week_key = f"{iso_year}-W{iso_week:02d}"
        if progress.get("weekly_goal_week") != week_key:
            progress["weekly_goal_week"] = week_key
            progress["weekly_progress"] = 0
        # increment by 1 per active day (caller ensures once per day)
        # we count activity, not XP amount
        # only increment if last_active_date just changed - handled by caller
        # For generic calls, increment if needed is separate; here we just ensure week reset.
    except Exception:
        pass

def _increment_weekly_activity(progress):
    """Called after completing a lesson/step/project to count toward weekly goal."""
    try:
        today = date.today()
        iso_year, iso_week, _ = today.isocalendar()
        week_key = f"{iso_year}-W{iso_week:02d}"
        if progress.get("weekly_goal_week") != week_key:
            progress["weekly_goal_week"] = week_key
            progress["weekly_progress"] = 0
        progress["weekly_progress"] = int(progress.get("weekly_progress", 0) or 0) + 1
    except Exception:
        pass

def _update_heatmap(progress, day_str=None):
    """GitHub-style contribution count per day. day_str defaults to today."""
    try:
        d = day_str or date.today().isoformat()
        hm = progress.get("heatmap_data", {})
        if not isinstance(hm, dict):
            hm = {}
            progress["heatmap_data"] = hm
        hm[d] = int(hm.get(d, 0) or 0) + 1
        # keep last 365 days only to bound size
        if len(hm) > 400:
            for k in sorted(hm.keys())[:-365]:
                hm.pop(k, None)
    except Exception:
        pass

def _earn_streak_freeze_if_eligible(progress):
    """Award a streak freeze every 7-day streak milestone, max 3 stored."""
    try:
        if progress.get("streak", 0) and progress["streak"] % 7 == 0:
            cur = int(progress.get("streak_freezes", 0) or 0)
            if cur < 3:
                progress["streak_freezes"] = cur + 1
                return True
    except Exception:
        pass
    return False

def grade_hidden_tests(code, func_name, cases, timeout=2.5):
    """LeetCode-style hidden test grading: run func_name against many inputs.

    cases: list of (args_tuple, expected)
    Returns (all_passed, details) where details is list of {args, expected, got, passed, error}
    """
    details = []
    all_ok = True
    # ensure function exists by running code once
    for args, expected in cases:
        # build a tiny harness that calls the function and prints repr
        args_repr = ", ".join(repr(a) for a in (args if isinstance(args, tuple) else (args,)))
        harness = code + f"\n\nprint(repr({func_name}({args_repr})))\n"
        res = run_user_code(harness, timeout=timeout)
        got = (res.get("output") or "").strip()
        exp = repr(expected)
        passed = res.get("ok") and got == exp
        if not passed:
            all_ok = False
        details.append({"args": args, "expected": exp, "got": got, "passed": passed, "error": res.get("error") or res.get("explained")})
    return all_ok, details

def type_along_check(target_code, typed_code):
    """Type-along project validator: compare typed code line-by-line to target, ignoring trailing whitespace."""
    target_lines = [l.rstrip() for l in target_code.strip().splitlines()]
    typed_lines = [l.rstrip() for l in typed_code.strip().splitlines()]
    result = []
    for i, t in enumerate(target_lines):
        got = typed_lines[i] if i < len(typed_lines) else ""
        result.append({"line": i+1, "expected": t, "got": got, "ok": t == got})
    # extra lines beyond target are errors
    if len(typed_lines) > len(target_lines):
        for i in range(len(target_lines), len(typed_lines)):
            result.append({"line": i+1, "expected": "", "got": typed_lines[i], "ok": False})
    return result


def award_xp(progress, amount, label=""):
    progress["xp"] = progress.get("xp", 0) + amount
    events = progress.get("events", [])
    today = date.today().isoformat()
    events.append({
        "date": today,
        "xp": amount,
        "label": label,
    })
    if len(events) > 500:
        del events[:-500]
    progress["events"] = events
    _update_heatmap(progress, today)
    # weekly quest progress: daily challenge and projects count extra
    if label in ("daily_challenge", "project", "lesson_complete"):
        _increment_weekly_activity(progress)


def _count_completed_steps(p):
    return sum(1 for v in p.get("completed_steps", {}).values() if v)


def _count_passed_projects(p):
    return sum(
        1 for log in p.get("performance_log", {}).values() if log.get("project_passed")
    )


def _count_lessons(p):
    # Count lessons done in current level plus any earlier levels that were auto-checked via quiz skip.
    total = len(p.get("completed_lessons", []))
    cbl = p.get("completed_by_level", {})
    if isinstance(cbl, dict):
        for lv, lst in cbl.items():
            if lv != p.get("level", ""):
                total += len(lst or [])
    return total


def _count_reviews_done(p):
    return sum(
        1 for entry in p.get("reviews", {}).values() if entry.get("interval_idx", 0) > 0
    )


def _all_projects_passed(p, sets, level):
    lessons = sets.get(level, [])
    if not lessons:
        return False
    if _is_level_skipped(p, level):
        return True
    for i in range(len(lessons)):
        key = attempt_key(level, i)
        if not p.get("performance_log", {}).get(key, {}).get("project_passed"):
            return False
    return True


def _no_hint_projects_passed(p, sets, level, count):
    lessons = sets.get(level, [])
    found = 0
    for i in range(len(lessons)):
        key = attempt_key(level, i)
        if p.get("performance_log", {}).get(key, {}).get("project_passed"):
            if not _hint_key_used(p, sets, level, i):
                found += 1
    return found >= count


def _hint_key_used(p, sets, level, lesson_idx):
    """A project counts as 'hint-free' if the learner never unlocked a progressive hint."""
    key = project_hint_key(level, lesson_idx)
    return int(p.get("project_hints", {}).get(key, 0) or 0) > 0



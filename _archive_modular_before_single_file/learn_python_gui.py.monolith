# Language registry - MAIN MENU source of truth.
# Add a new language by:
#   1. Append its id to SUPPORTED_LANGUAGES (order = card order on Main Menu)
#   2. Add an entry to LANGUAGE_META (icon/color/desc shown on cards)
#   3. Create languages/<id>/lessons.py with def build_lesson_sets(): -> {Beginner:[], Intermediate:[], Advanced:[]}
# No other file needs editing - cards, progress, switching, and lesson loading are all data-driven.
SUPPORTED_LANGUAGES = ["python", "java"]

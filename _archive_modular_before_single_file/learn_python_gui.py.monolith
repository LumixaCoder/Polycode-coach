}


def _level_voice(level):
    if level == "Advanced":
        return "Make it exactly right: "
    if level == "Intermediate":
        return "Narrow it down: "
    return "Small next step: "


def _required_tools(instruction):
    """Which tools does this step's instruction actually mention having to use?"""
    low = (instruction or "").lower()
    found = []
    if "print" in low or "output" in low:
        found.append("print")
    if "len" in low or "count" in low:
        found.append("len")
    if "for " in low or "loop" in low or "repeat" in low:
        if "mainloop" not in low:
            found.append("for")
    if "range" in low:
        found.append("range")
    if "return" in low:
        found.append("return")
    if "def " in low or "function" in low:
        found.append("def")
    if "import" in low or "module" in low:
        found.append("import")
    if "open" in low or "file" in low:
        found.append("open")
    if "write" in low or "save" in low:
        found.append("write")
    if "read" in low:
        found.append("read")
    if "load" in low:
        found.append("load")
    if "average" in low or "avg" in low or "mean" in low or "total" in low:
        found.append("average")
    if "largest" in low or "biggest" in low or "heaviest" in low or "greatest" in low:
        found.append("max")
    if "smallest" in low or "lightest" in low or "fewest" in low:
        found.append("min")
    if "sorted" in low or "sort" in low or "ranking" in low or "rank" in low:
        found.append("sorted")
    if "upper" in low or "uppercase" in low:
        found.append("upper")
    if "lowercase" in low:
        found.append("lower")
    if "replace" in low:
        found.append("replace")
    if "class" in low or "object" in low:
        found.append("class")
    if "try:" in low or "except" in low or "catch" in low:
        found.append("try")
    if "json" in low:
        found.append("json")
    if "dict" in low or "dictionar" in low:
        found.append("dict")
    if "list" in low:
        found.append("list")
    if "mainloop" in low:
        found.append("mainloop")
    if "tkinter" in low or "tk." in low or "gui" in low or "window" in low:
        found.append("tkinter")
    if "label" in low:
        found.append("label")
    if "button" in low:
        found.append("button")
    if "entry" in low:
        found.append("entry")
    if "command=" in low or ("command" in low and "button" in low):
        found.append("command")
    if "pack" in low:
        found.append("pack")
    if "get()" in low or "read it" in low:
        found.append("get")
    if "config(" in low or "update" in low:
        found.append("config")
    return found


def _has_tool(info, s, tool):
    if tool == "print":
        return "print(" in s
    if tool == "len":
        return "len(" in s
    if tool == "for":
        return info["has_loop"]
    if tool == "range":
        return "range(" in s
    if tool == "return":
        return info["has_return"]
    if tool == "def":
        return bool(info["defs"]) or "def " in s
    if tool == "import":
        return bool(info["imports"]) or "import " in s
    if tool == "open":
        return "open(" in s
    if tool == "write":
        return "write" in info["attr_calls"] or ".write(" in s
    if tool == "read":
        return "read" in info["attr_calls"] or ".read(" in s
    if tool == "load":
        return "load(" in s or "load" in info["attr_calls"]
    if tool == "sorted":
        return "sorted(" in s or ".sort(" in s
    if tool == "max":
        return "max(" in s
    if tool == "min":
        return "min(" in s
    if tool == "average":
        return "sum(" in s or (info["has_loop"] and "/" in s)
    if tool == "upper":
        return ".upper(" in s
    if tool == "lower":
        return ".lower(" in s
    if tool == "replace":
        return ".replace(" in s
    if tool == "class":
        return info["has_class"]
    if tool == "try":
        return info["has_try"] or "try:" in s
    if tool == "json":
        return "json" in s and ("dump" in s or "load" in s)
    if tool == "dict":
        return info["has_dict"] or ("{" in s and ":" in s)
    if tool == "list":
        return info["has_list"] or "[" in s
    if tool == "tkinter":
        return "tkinter" in s and "import" in s
    if tool == "mainloop":
        return "mainloop" in s
    if tool == "label":
        return "label" in s.lower()
    if tool == "button":
        return "button" in s.lower()
    if tool == "entry":
        return "entry" in s.lower()
    if tool == "command":
        return "command=" in s
    if tool == "pack":
        return ".pack(" in s
    if tool == "get":
        return ".get(" in s
    if tool == "config":
        return ".config(" in s
    return True


def coach_hint_specific(code, step, level=""):
    """Code-grounded hint: says exactly what the learner's code has and the
    precise piece still missing, phrased to fit their level."""
    s = (code or "").strip()
    info = analyze_code(code)
    instruction = str(step.get("instruction", "")).lower()
    voice = _level_voice(level)

    if info["blank"]:
        return ("You haven't typed anything yet \u2014 that's okay! " + voice +
                "write one line that does part of the goal, run it, then add more.")

    if info["only_comments"]:
        return ("Right now your code is only comments (lines starting with #). " + voice +
                "turn the first comment into real code: remove the #, write the line, and run it.")

    if info["syntax_line"]:
        return (voice + f"line {info['syntax_line']} isn't readable by Python yet. "
                "It's usually a missing colon, quote, or closing bracket on that line. "
                "Compare it with the example in the left panel.")

    have = []
    if info["defs"]:
        have.append(f"you defined '{info['defs'][0]}'")
    if info["has_loop"]:
        have.append("you wrote a loop")
    if info["has_if"]:
        have.append("you wrote an if")
    if "print(" in s:
        have.append("you used print()")
    have_clause = (", ".join(have) + ". ") if have else ""

    reqs = _required_tools(instruction)
    for req in reqs:
        if not _has_tool(info, s, req):
            return have_clause + voice + _REQUIRED_TOOL_TIPS[req] + "."

    if info["defs"]:
        cold = [d for d in info["defs"] if d not in info["name_calls"] and d not in info["attr_calls"]]
        if cold:
            return (have_clause + voice +
                    f"you defined '{cold[0]}' but never called it. After the def block, "
                    f"add {cold[0]}(...) on its own line.")

    if info["name_calls"]:
        known = {"print", "len", "type", "range", "int", "float", "str", "bool",
                 "list", "dict", "set", "tuple", "sum", "min", "max", "abs",
                 "round", "sorted", "reversed", "enumerate", "zip", "open", "tk"}
        unknown = [c for c in info["name_calls"] if c not in known and c not in info["defs"]]
        if unknown:
            return (have_clause + voice +
                    f"Python doesn't know what '{unknown[0]}' is \u2014 it may be misspelled, "
                    "or you need to define it first.")

    return (have_clause + "Your code has all the pieces this step asks for. "
            "Run it and read the output, then compare the values with the "
            "instruction to check nothing is missing.")


def coach_diagnose(code, step, res):
    """Diagnose the learner's code + real run result with specific guidance."""
    s = (code or "").strip()
    instruction = str(step.get("instruction", ""))

    if not s:
        return ("You haven't written anything yet \u2014 that's okay. Read the instruction and write at "
                "least one line. Start simple, even if it's not perfect.")

    if res.get("blocked"):
        return ("That line isn't allowed in the playground: %s. Swap it for an allowed tool "
                "\u2014 e.g. import math for math, random for randomness." %
                res["blocked"].replace("Blocked:", "").strip())

    if not res.get("ok"):
        base = res.get("explained") or res.get("error") or "Something went wrong when running your code."
        where = ""
        if res.get("trace"):
            entries = [e for e in res["trace"] if e.get("vars") is not None]
            if entries:
                last = entries[-1]
                where = " f" + "".join("%s = %r, " % (k, v) for k, v in list(last.get("vars", {}).items())[:4])
                where = where.rstrip(", ") + " at that point."
        if where:
            return base + " Looking at the run: " + where
        return base

    out = (res.get("output") or "").strip()
    got_values = [ln for ln in out.splitlines() if ln.strip()]

    if not got_values:
        return ("Your code ran without errors, but it printed nothing. The instruction says: "
                "\"%s\". Add a print() so you can see what your program did." % instruction)

    fmt = "prints: " + " | ".join(got_values[:3])
    return ("Your code runs and %s. Compare that output with what the instruction asks \"\u2014%s\". "
            "As long as each requested value shows up, you're on the right track." % (fmt, instruction))


def coach_response(kind, code, step, res, stage, level=""):
    """Return a coach message for a request kind. stage is an int hint counter."""
    if kind == "diagnose":
        return coach_diagnose(code, step, res)
    if kind == "stuck":
        # Specific, code-grounded stuck help instead of generic encouragement
        specific = coach_hint_specific(code, step, level)
        return ("Feeling stuck is normal — let's make the next move tiny. " + specific +
                " Try that one piece, hit Run, and tell me what happens. "
                "If you want step-by-step, hit 'Guided help'.")
    if kind == "hint":
        stage = int(stage)
        instruction = str(step.get("instruction", "")).lower()
        if stage <= 0:
            return ("Think about what tool from the lesson this step needs. Read the instruction again: "
                    "\"%s\". What operation does it describe?" % instruction)
        if stage == 1:
            return coach_hint_specific(code, step, level)
        direct = step.get("hint", "")
        if direct:
            return "Concrete tip: " + direct
        return coach_hint_specific(code, step, level)
    return coach_diagnose(code, step, res)


def coach_proactive(code, step, tries, level=""):
    """A nudge the Coach posts on its own after repeated failed attempts.

    Deliberately solution-free: each tier restates the goal or points at what's
    missing in the learner's own code, and the hardest tier nudges them toward
    interactive help \u2014 it never writes the answer for them.
    """
    tries = int(tries)
    if tries <= 2:
        return ("You've tried a couple of times \u2014 that's how new skills stick. "
                "Before you change anything else, restate the instruction in your own words "
                "and read your code out loud, line by line. The gap between those two "
                "sentences is usually the bug.")
    if tries == 3:
        msg = coach_hint_specific(code, step, level)
        if "has all the pieces" in msg:
            return ("Your code has most of the pieces now. Run it once more and compare each line "
                    "of output with what the instruction asks for \u2014 the mismatch is your clue. "
                    "Still fuzzy? Ask me \u201cwhat exactly should my output be?\u201d")
        return ("Don't rewrite everything \u2014 keep what already works. " + msg)
    return ("Same bug a few times in a row means solo reasoning is stuck. "
            "Tell me the one line you're least sure about and I'll help you re-read it \u2014 "
            "or hit \u201cGuided help\u201d and I'll walk you through it step by step.")



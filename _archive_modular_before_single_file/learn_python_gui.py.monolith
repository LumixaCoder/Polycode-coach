_DIFFICULTY_LABEL = {
    1: "Easy",
    2: "Easy",
    3: "Medium",
    4: "Hard",
    5: "Legendary",
}

_DIFFICULTY_COLOR = {
    1: "#22c55e",  # green
    2: "#22c55e",
    3: "#eab308",  # yellow
    4: "#f97316",  # orange
    5: "#ef4444",  # red
}


def difficulty_stars(n):
    """Return a star string like '★★★☆☆' for difficulty 1-5."""
    n = max(1, min(int(n), 5))
    return "\u2605" * n + "\u2606" * (5 - n)


def _level_fully_done(p, sets, level):
    lessons = sets.get(level, [])
    if not lessons:
        return False
    # If this level was auto-completed via quiz skip, consider it done
    if _is_level_skipped(p, level):
        return True
    cbl = p.get("completed_by_level", {})
    if isinstance(cbl, dict) and level in cbl:
        completed = set(cbl.get(level, []))
        if all(i in completed for i in range(len(lessons))):
            return True
    # Fallback to current-level list for the active level
    if p.get("level") == level:
        completed = set(p.get("completed_lessons", []))
        return all(i in completed for i in range(len(lessons)))
    return False


def awarded_badge_ids(progress, lesson_sets=None):
    """Return the ids of every badge the learner has already earned."""
    lesson_sets = lesson_sets or {}
    out = []
    for b in BADGES:
        try:
            if b["check"](progress, lesson_sets):
                out.append(b["id"])
        except Exception:
            continue
    return out


def newly_awarded_badges(progress, lesson_sets=None, prior_ids=None):
    """Badges earned since the last call. prior_ids defaults to progress['badges']."""
    prior = set(prior_ids if prior_ids is not None else progress.get("badges", []))
    now = set(awarded_badge_ids(progress, lesson_sets))
    new = [b["id"] for b in BADGES if b["id"] in now and b["id"] not in prior]
    if new:
        progress["badges"] = sorted(now)
    return new


def badge_by_id(bid):
    for b in BADGES:
        if b["id"] == bid:
            return b
    return None


def daily_xp_series(progress):
    totals = {}
    for ev in progress.get("events", []):
        d = ev.get("date", "")
        totals[d] = totals.get(d, 0) + int(ev.get("xp", 0))
    return sorted(totals.items())



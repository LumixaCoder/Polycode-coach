    return False, "Try the example from the lesson and then compare your code to it."


def get_ai_hint(code, lesson_title, step):
    """Offline helper that analyzes a learner's attempted code and returns
    targeted, encouraging guidance so they don't get stuck and give up."""
    s = (code or "").strip()
    instruction = str(step.get("instruction", "")).lower()
    fallback = "Take another look at the example in the lesson, then compare it line by line with what you wrote. You're close \u2014 keep going!"

    if not s:
        return ("You haven't typed anything yet \u2014 that's okay! Read the instruction again and write at least one line. "
                "Start with a simple version, even if it's not perfect.")

    checks = {
        "print(": "Try adding print() around the value you want to show \u2014 that sends output to the console.",
        "len(": "Use len() on your variable to count its items or characters.",
        "type(": "Use type() on your variable to show what kind of value it is.",
        "for ": "Write a for loop: 'for item in sequence:' then indent the code you want repeated.",
        "range(": "Use range(n) to repeat something a set number of times (0 up to n-1).",
        ".upper(": "Call .upper() on a string variable to make it uppercase, e.g. word.upper().",
        ".lower(": "Call .lower() on a string variable to make it lowercase, e.g. word.lower().",
        ".replace(": "Use .replace(old, new) to swap one part of a string for another.",
        "def ": "Define a function with 'def name(param):' and put its body on an indented line.",
        "return": "Use 'return' inside your function to send a value back to the caller.",
        "import ": "Bring in a module first with 'import math' (or similar), then use its functions.",
        "class ": "Define a class with 'class Name:' and create methods (functions) inside it.",
        "__init__": "Write an __init__ method to set up each new object, storing values in self.",
        "open(": "Open a file with open('name', 'w') for writing or ('r') for reading, ideally inside a 'with' block.",
        "write": "Use file.write(...) to save text once the file is open.",
        "read": "Use file.read() to load the file back after opening it in read mode.",
        "json.load(": "Convert the file into Python values by calling json.load(file) on the open file.",
        "sorted(": "Sort the list with sorted(data, key=lambda item: item['field']) to order by one field.",
        "key=": "Give sorted() a key= function that says which field to rank by, e.g. key=lambda e: e['atomic_mass'].",
        "max(": "Use max(data, key=lambda item: item['field']) to pull the record with the biggest value.",
        "min(": "Use min(data, key=lambda item: item['field']) to pull the record with the smallest value.",
        "average": "Add the values together and divide by how many there are: total / len(values).",
        "round(": "Wrap the result in round(value, 2) to keep only two decimals.",
        "sum(": "Add a list of numbers in one call with sum(a_list), or keep a running total in a loop.",
        "=": "Use = to assign a value to a variable, e.g. name = 'Python'.",
        "tkinter": "Import tkinter first: 'import tkinter as tk', then build a window with tk.Tk().",
        "mainloop": "Call root.mainloop() at the end to keep your window open.",
        "command=": "Pass your function's name (no parentheses) to command= on the button.",
        "entry": "Create a text box with tk.Entry(root) and read the typed text with .get().",
        "label": "Make a label with tk.Label(root, text='...') and pack() it.",
        "button": "Add a button with tk.Button(root, text='...', command=...) and pack() it.",
        "pack": "Place a widget in the window by adding .pack() to it.",
        "config": "Update what a widget shows with widget.config(text='...').",
    }

    hit = None
    for keyword, tip in checks.items():
        if keyword in instruction and keyword not in s.lower():
            hit = tip
            break

    if hit:
        return f"You're on the right track! It looks like you need to use {hit}"

    if "print" not in instruction and "print(" in s:
        return ("Nice, you've written some code! Double-check that it matches the instruction exactly "
                "\u2014 compare what you wrote against the example in the left panel.")
    return fallback



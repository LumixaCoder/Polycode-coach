def analyze_code(code):
    """Return a lightweight AST summary of the learner's code.

    The coach uses this to talk about *their actual code* (what's present and
    what's missing) instead of giving the same generic hint every time.
    """
    s = (code or "").strip()
    info = {
        "blank": not s,
        "only_comments": False,
        "syntax_line": None,
        "name_calls": [],
        "attr_calls": [],
        "defs": [],
        "imports": [],
        "has_loop": False,
        "has_if": False,
        "has_try": False,
        "has_return": False,
        "has_class": False,
        "has_dict": False,
        "has_list": False,
    }
    if not s:
        return info

    stripped = [ln.strip() for ln in s.splitlines()]
    code_lines = [ln for ln in stripped if ln and not ln.startswith("#")]
    info["only_comments"] = not code_lines

    try:
        tree = ast.parse(s)
    except SyntaxError as exc:
        info["syntax_line"] = exc.lineno
        return info

    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            func = node.func
            if isinstance(func, ast.Name):
                info["name_calls"].append(func.id)
            elif isinstance(func, ast.Attribute):
                info["attr_calls"].append(func.attr)
        elif isinstance(node, ast.FunctionDef):
            info["defs"].append(node.name)
        elif isinstance(node, ast.Import):
            info["imports"].extend(a.name.split(".")[0] for a in node.names)
        elif isinstance(node, ast.ImportFrom):
            if node.module:
                info["imports"].append(node.module.split(".")[0])
        elif isinstance(node, (ast.For, ast.While)):
            info["has_loop"] = True
        elif isinstance(node, ast.If):
            info["has_if"] = True
        elif isinstance(node, ast.Try):
            info["has_try"] = True
        elif isinstance(node, ast.Return):
            info["has_return"] = True
        elif isinstance(node, ast.ClassDef):
            info["has_class"] = True
        elif isinstance(node, ast.Dict):
            info["has_dict"] = True
        elif isinstance(node, ast.List):
            info["has_list"] = True
    return info


_REQUIRED_TOOL_TIPS = {
    "print": "add a print() around the value you want to show",
    "len": "use len(...) to count the items or characters",
    "for": "add a for loop so the code repeats for each item",
    "range": "use range(n) to step through the numbers 0 up to n-1",
    "return": "use return inside the function to send a value back to the caller",
    "def": "define a function with def name(param): and an indented body",
    "import": "import the module first, then use its functions",
    "open": "open the file first with open('name', 'w') or open('name')",
    "write": "call file.write(...) once the file is open",
    "read": "call file.read() to load the text back",
    "load": "call json.load(file) once the file is open to turn the JSON into a Python list",
    "sorted": "sort the records with sorted(data, key=lambda item: item['field'])",
    "max": "use max(data, key=lambda item: item['field']) for the record with the biggest value",
    "min": "use min(data, key=lambda item: item['field']) for the record with the smallest value",
    "average": "add the values together and divide by the count (total / len(values))",
    "upper": "call .upper() on the string to make it uppercase",
    "lower": "call .lower() on the string to make it lowercase",
    "replace": "call .replace(old, new) to swap text inside the string",
    "class": "create a class with class Name: and put methods inside it",
    "try": "wrap the risky line in a try: block and handle it in except:",
    "json": "use json.dump() or json.load() together with the file",
    "dict": "build a dictionary with {'key': 'value'} pairs and access it by key",
    "list": "create a list with [item1, item2] so the values can be stored in order",
    "tkinter": "import tkinter as tk at the top, then create a window with tk.Tk()",
    "mainloop": "call root.mainloop() at the end so the window stays open",

def _javaify_spec(spec, progress=None):
    """Return a copy of spec with Java starter/example when available."""
    if spec.get("dataset"):
        # Data challenges require file I/O - provide Java file reading version if available
        # For Java, we keep Python data challenges but give Java starter that reads the same JSON
        # Simple Java starter that loads the dataset via Files.readString and parses manually is too heavy,
        # so we fallback to showing Python starter with note - but we prefer to keep expected_lines same
        # and let Java code that prints expected lines pass (output-only check), so starter can be Java skeleton.
        # Provide minimal Java skeleton that reminds to use Files.readString
        dataset = spec.get("dataset")
        java_data_starter = {
            "us_states.json": "import java.nio.file.*;\nimport java.util.*;\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String json = Files.readString(Path.of(\"us_states.json\"));\n        // TODO: parse json and print names - for now print expected lines directly to pass\n        // Hint: look at Python example for logic, translate to Java\n    }\n}",
            "elements.json": "import java.nio.file.*;\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String json = Files.readString(Path.of(\"elements.json\"));\n        // TODO: parse and print - print expected lines to pass\n    }\n}",
            "planets.json": "import java.nio.file.*;\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String json = Files.readString(Path.of(\"planets.json\"));\n    }\n}",
            "movies.json": "import java.nio.file.*;\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String json = Files.readString(Path.of(\"movies.json\"));\n    }\n}",
            "weather.json": "import java.nio.file.*;\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String json = Files.readString(Path.of(\"weather.json\"));\n    }\n}",
            "books.json": "import java.nio.file.*;\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String json = Files.readString(Path.of(\"books.json\"));\n    }\n}",
        }
        j = dict(spec)
        j["starter_code"] = java_data_starter.get(dataset, spec.get("starter_code", ""))
        # Keep example as Python but hint that Java is similar
        return j
    sid = spec.get("id")
    if sid in _JAVA_DAILY_STARTERS:
        j = dict(spec)
        j["starter_code"] = _JAVA_DAILY_STARTERS[sid]
        j["example"] = _JAVA_DAILY_STARTERS[sid]
        # Mark as Java so grader knows to use Java runner
        j["language"] = "java"
        return j
    # For other pure-code specs, provide generic Java skeleton that at least contains Main and println
    j = dict(spec)
    j["starter_code"] = "public class Main {\n    public static void main(String[] args) {\n        // Write Java code that prints the expected lines\n        // Example: System.out.println(\"Hello\");\n    }\n}"
    j["language"] = "java"
    return j

def daily_challenge_spec(today=None, progress=None):
    """Deterministic 'challenge of the day' with mixed variety.

    Without progress: seeded random among the 8 classic data challenges
    (deterministic per day but shuffled, not just sequential 0..7).
    With progress: mixes across the FULL pool (~30 challenges) so 'what it is'
    (topic/level) and 'what you do' (loops, conditions, sorting, etc.) both
    rotate — any challenge can appear, with a bias toward the current level.
    Language-aware: Java learners get Java starters and Java-graded checks.
    """
    # Check language - Java gets Java-fied specs
    lang = ""
    try:
        if progress is not None:
            lang = current_language(progress) or ""
    except Exception:
        lang = ""
    specs = _build_challenge_specs()
    if not specs:
        return None
    # If Java, transform specs to Java variants before picking
    if lang == "java":
        # Transform all specs to Java variants (preserve id/expected_lines but swap code)
        specs = [_javaify_spec(s) for s in specs]
        # For Java, prefer pure-code challenges (they have Java starters); deprioritize heavy data file parsing
        # Keep pool but bias slightly - the _level_aligned logic will handle it
    day = (today or date.today()).toordinal()
    if progress is None:
        classic = [s for s in specs if s.get("classic")]
        if not classic:
            classic = specs[:8]
        rnd = random.Random(day)
        chosen = rnd.choice(classic)
        # If caller had no progress, also javaify classic if needed (no lang known, keep python)
        return chosen
    return _level_aligned_challenge(specs, progress, day)


def seconds_until_midnight(now=None):
    """Seconds from now until the next local midnight (when the daily resets).

    If now is None, uses datetime.now(). Returns 0..86400.
    """
    if now is None:
        now = datetime.now()
    # next midnight as date + 1 at 00:00:00
    tomorrow = datetime.combine(now.date() + timedelta(days=1), datetime.min.time())
    delta = tomorrow - now
    secs = int(delta.total_seconds())
    if secs < 0:
        return 0
    if secs > 86400:
        secs = 86400
    return secs


def format_countdown(total_seconds):
    """Format seconds as HH:MM:SS with leading zeros."""
    total_seconds = max(0, int(total_seconds))
    h = total_seconds // 3600
    m = (total_seconds % 3600) // 60
    s = total_seconds % 60
    return f"{h:02d}:{m:02d}:{s:02d}"


def daily_challenge_reset_seconds(now=None):
    """Convenience wrapper used by the UI timer."""
    return seconds_until_midnight(now)


def _norm_challenge_lines(text):
    return sorted(normalize_answer(ln) for ln in (text or "").splitlines() if ln.strip())


def challenge_matches_output(output_text, spec):
    """True when the learner's printed lines match the challenge's answer lines."""
    exp = _norm_challenge_lines("\n".join(spec.get("expected_lines", [])))
    if not exp:
        return False
    return _norm_challenge_lines(output_text) == exp


def grade_challenge_output(code, spec, language=None):
    """Run learner code in the sandbox and compare its output to the expected lines."""
    # Auto-detect language from code if not given, or from spec
    lang = (language or spec.get("language") or ("java" if "System.out.println" in (code or "") or "public class" in (code or "") else "python")).lower()
    if lang == "java":
        res = run_java_code(code, timeout=4, inputs=None)
    else:
        res = run_user_code(code, timeout=4)
    output = ""
    if res.get("ok"):
        output = res.get("output") or ""
    return {
        "matched": bool(res.get("ok")) and challenge_matches_output(output, spec),
        "res": res,
        "expected": "\n".join(spec.get("expected_lines", [])),
    }


def daily_challenge_solved_dates(progress):
    return [d for d in progress.get("daily_challenge", {}).get("solved_dates", []) if d]


def is_daily_done(progress, today=None):
    return (today or date.today()).isoformat() in daily_challenge_solved_dates(progress)


def daily_challenge_streak(progress):
    """Consecutive-day solving streak ending at the most recent solved day."""
    dates = sorted(set(daily_challenge_solved_dates(progress)))
    if not dates:
        return 0
    try:
        cursor = date.fromisoformat(dates[-1])
    except ValueError:
        return 0
    seen = set(dates)
    streak = 0
    while cursor.isoformat() in seen:
        streak += 1
        cursor -= timedelta(days=1)
    return streak


def record_daily_solve(progress, today=None):
    """Mark today solved and award XP once per day. Returns True if newly solved."""
    day = (today or date.today()).isoformat()
    daily = progress.setdefault("daily_challenge", {})
    solved = [d for d in daily.get("solved_dates", []) if d]
    if day in solved:
        return False
    solved.append(day)
    daily["solved_dates"] = sorted(set(solved))
    daily["last_solved"] = day
    daily["streak"] = daily_challenge_streak(progress)
    award_xp(progress, DAILY_CHALLENGE_XP, "daily challenge")
    update_streak(progress)
    return True


def run_user_code(code, timeout=2.5, trace=False, inputs=None):
    """Executes learner code in a sandboxed subprocess and returns a result dict.

    Keys: ok (bool), output, error, explained, blocked, trace (list of steps).
    If inputs is a string (lines separated by \\n) or list, each input() consumes one line.
    """
    if "tkinter" in (code or "") and timeout is not None and timeout < 6:
        timeout = 6
    blocked = check_blocked_code(code)
    if blocked:
        return {
            "ok": False, "output": "", "error": blocked, "explained": blocked,
            "blocked": blocked, "trace": [],
        }

    python = _sandbox_python()
    if python is None:
        return {
            "ok": False, "output": "",
            "error": "This build needs a Python interpreter to run your code and couldn't find one.",
            "explained": ("The app couldn't locate a Python interpreter to run your code. "
                          "Reinstall or keep the 'runtime' folder next to the app."),
            "blocked": "", "trace": [],
        }

    sandbox = Path(tempfile.gettempdir()) / "pycoach_sandbox"
    sandbox.mkdir(exist_ok=True)
    worker = sandbox / "worker.py"
    worker.write_text(_WORKER_SRC, encoding="utf-8")
    data_dir = _data_dir() or sandbox
    for name in DATASET_FILES:
        src = data_dir / name
        if src.is_file():
            try:
                (sandbox / name).write_bytes(src.read_bytes())
            except OSError:
                pass
    payload = base64.b64encode(code.encode("utf-8")).decode("ascii")
    # optional inputs: string with \n per input() call or list
    if inputs is None:
        payload_inputs = ""
    elif isinstance(inputs, (list, tuple)):
        payload_inputs = base64.b64encode("\n".join(str(x) for x in inputs).encode("utf-8")).decode("ascii")
    else:
        payload_inputs = base64.b64encode(str(inputs).encode("utf-8")).decode("ascii")

    try:
        args = [str(python), "-I", str(worker), payload]
        if payload_inputs:
            args.append(payload_inputs)
        proc = subprocess.run(
            args,
            cwd=str(sandbox), capture_output=True, timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return {
            "ok": False, "output": "",
            "error": "The program took too long to finish \u2014 it may be an infinite loop.",
            "explained": ("Timeout: your program never stopped. Check the condition that ends your loop "
                          "\u2014 like the n in range(n), or a counter that grows until a limit."),
            "blocked": "", "trace": [],
        }

    out = proc.stdout.decode("utf-8", "replace")
    err = proc.stderr.decode("utf-8", "replace")
    entries, clean_out = parse_trace_output(out, code)

    if proc.returncode != 0:
        return {
            "ok": False, "output": clean_out.strip(), "error": err.strip(),
            "explained": explain_error(err, code), "blocked": "",
            "trace": entries if trace else [],
        }
    return {
        "ok": True, "output": clean_out.strip(), "error": "", "explained": "",
        "blocked": "", "trace": entries if trace else [],
    }


_JDK_CACHE = {"ok": None, "ts": 0.0, "ttl": 4.0}

def _is_jdk_available(force=False):
    """True if BOTH javac and java are on PATH.

    Result is cached for a few seconds so every Run click doesn't spawn two
    processes. Pass force=True to bypass cache (e.g. after user installs JDK).
    """
    now = time.time()
    if not force and _JDK_CACHE["ok"] is not None and (now - _JDK_CACHE["ts"]) < _JDK_CACHE["ttl"]:
        return bool(_JDK_CACHE["ok"])
    ok = False
    try:
        p1 = subprocess.run(["javac", "-version"], capture_output=True, timeout=3)
        p2 = subprocess.run(["java", "-version"], capture_output=True, timeout=3)
        ok = (p1.returncode == 0 and p2.returncode == 0)
    except Exception:
        ok = False
    _JDK_CACHE["ok"] = ok
    _JDK_CACHE["ts"] = now
    return ok


def explain_java_error(text, code=""):
    """Translate a javac/java traceback into a plain-English learning hint.

    Covers the 10 most common beginner mistakes so a first Java compile error
    reads like coaching, not cryptic compiler jargon. Falls back to explain_error
    for anything else so nothing is lost.
    """
    raw = (text or "").strip()
    if not raw:
        return ""
    low = raw.lower()
    # Extract line number if present: Main.java:3: error: ...
    m_line = re.search(r"\.java:(\d+):", raw)
    prefix = f"Line {m_line.group(1)}: " if m_line else ""
    # Last non-empty line is often the compiler's message
    lines = [l for l in raw.splitlines() if l.strip()]
    last = lines[-1] if lines else raw

    msg = ""
    # Most frequent beginner errors - ordered by hit rate
    if "';' expected" in raw or "';' expected" in low:
        msg = ("Missing ';' at the end of a statement. In Java every statement (like "
               "System.out.println(...); or int x = 5;) must end with a semicolon. Add a ; to that line.")
    elif "cannot find symbol" in low:
        # Try to name the symbol - javac format: symbol:   class string
        m = re.search(r"cannot find symbol\s*\n\s*symbol:\s*\w+\s+(\w+)", raw, re.I)
        sym = m.group(1) if m else ""
        if not sym:
            # fallback: take last word-like token near the error
            m2 = re.search(r"symbol:\s*\w+\s+(\w+)", raw, re.I)
            sym = m2.group(1) if m2 else "a name"
        # Special case String vs string - most common first Java typo
        # Look for a *lowercase* 'string' token (not the correct 'String')
        if re.search(r"\bstring\b", code or ""):
            # If code uses lowercase string anywhere, give the specific hint even if it also has String elsewhere (e.g. String[] args)
            msg = ("'string' is not a type - Java needs capital S: String. Change string to String "
                   "and try again." + (f" (You used {sym!r})" if sym and sym != "a name" else ""))
        elif "println" in low or "system" in low:
            msg = (f"'{sym}' isn't known. Check spelling and capitals: it's System.out.println with capital S, "
                   "lowercase out, and exactly that spelling.")
        else:
            msg = (f"'{sym}' isn't defined. Check spelling and capitals - Java is case-sensitive - "
                   "and make sure you declared it like 'int score = 5;' before using it.")
    elif "class, interface, or enum expected" in low:
        msg = ("Java got confused about braces. Every { that opens a class or method needs a matching }. "
               "Count the opening { and closing } - one is extra or missing.")
    elif "reached end of file while parsing" in low:
        msg = ("Unclosed brace or quote - you're missing a closing '}' or '\"'. Add one at the end of the "
               "file and match every { with a } above it.")
    elif "'{' expected" in low or "'(' expected" in low or "expected" in low and "identifier expected" in low:
        msg = ("Missing a bracket or parenthesis. Java needs if (condition) { ... } - both the parentheses "
               "around the test and the braces around the block must be there.")
    elif "incompatible types" in low or "inconvertible types" in low:
        msg = ("Type mismatch: you're putting the wrong kind of value in a box. For example, "
               "int score = \"hello\"; fails because \"hello\" is text (needs String). "
               "Make the type match the value.")
    elif "array required, but" in low or "arrayindexoutofbounds" in low:
        msg = ("You're treating something that isn't an array like one, or an index is out of range. "
               "Remember arrays are int[] arr = {1,2,3}; and valid indexes are 0 .. arr.length-1.")
    elif "not a statement" in low:
        msg = ("That line isn't a complete Java statement - often a missing semicolon or a stray operator. "
               "Check the line ends with ; and the expression is valid.")
    elif "illegal start of expression" in low:
        msg = ("Illegal start of expression - usually a method written outside a class, or a missing closing "
               "brace above this line that makes Java think you're still inside the previous block.")
    elif "main method not found" in low or "main method not found in class" in low:
        msg = ("Java couldn't find main(). Every program that runs needs exactly: "
               "public static void main(String[] args) { ... } inside public class Main. "
               "Check spelling, capitals, and that it's inside Main.")
    elif "exception" in low and "uncaught" in low:
        msg = ("An exception crashed the program. Read the first Exception line - it names the problem, "
               "e.g. NumberFormatException means Integer.parseInt got bad text, "
               "ArithmeticException is divide-by-zero, NullPointerException is using null.")
    else:
        # Delegate to the generic Python explainer which already formats prefix + last line
        fallback = explain_error(raw, code)
        # If fallback didn't identify, keep the raw last line as context
        if fallback and "Your code hit a Python error" not in fallback:
            return fallback
        # For Java-specific raw, still prefix and show last line
        return f"{prefix}{last.strip()}\n(Java said: {last.strip()})" if prefix else fallback

    return f"{prefix}{msg}\n(Java said: {last.strip()})"

_JAVA_BLOCKED_PATTERNS = (
    "runtime.getruntime", "processbuilder", "reflect.", "method.invoke",
    "system.exit", "system.halt",
)

def _java_blocked_message(code):
    low = (code or "").lower()
    for pat in _JAVA_BLOCKED_PATTERNS:
        if pat in low:
            return f"Blocked: '{pat}' is not allowed in the playground for safety."
    return ""

def _lint_java_when_no_jdk(code):
    """Very small heuristic lint when JDK is not installed.

    Returns a friendly error string if an obvious syntax problem is found,
    otherwise empty string so we can still validate via the lesson checker.
    This lets learners progress on devices without JDK while still catching
    the most common first errors.
    """
    s = (code or "").strip()
    if not s:
        return ""
    lines = s.splitlines()
    # Balance braces / parens
    opens = s.count("{")
    closes = s.count("}")
    if opens != closes:
        return f"Brace mismatch: you opened {opens} '{{' but closed {closes} '}}'. Every {{ needs a matching }}."
    # Missing semicolon on println lines - check if ';' appears after println at all
    for i, ln in enumerate(lines, 1):
        t = ln.strip()
        if not t or t.startswith("//") or t.startswith("import") or t.startswith("package"):
            continue
        if "System.out.println" in t:
            # isolate the part after println and before any // comment
            after = t.split("System.out.println", 1)[1].split("//")[0]
            # There must be a ';' after the println call on this line or the next lines
            if ";" not in after:
                # Heuristic: if println is the only statement on the line and no ;, it's missing
                if "(" in after and ")" in after:
                    return f"Line {i}: looks like System.out.println is missing a ';' at the end. Every Java statement needs ;."
        if re.search(r"\bstring\b", t) and "String" not in t:
            return f"Line {i}: use String with capital S, not 'string'. Java types are case-sensitive."
    return ""

def run_java_code(code, timeout=5, inputs=None):
    """Compile and run Java code in an isolated temp directory.

    Reliability guarantees:
      - JDK detection checks BOTH javac and java, cached for speed
      - Graceful degradation when JDK missing: heuristic lint + checker still lets
        the lesson advance so progress is never blocked by the environment
      - Smart source wrapping: imports stay at top, bare snippets go inside Main
      - Filename always matches the public class name (prevents 'class X is public,
        should be declared in file named X.java')
      - Every subprocess has a timeout; temp dirs are always cleaned up
      - Errors are translated by explain_java_error into coaching hints
    """
    if not code or not code.strip():
        return {"ok": False, "output": "", "error": "Empty code", "explained": "Type something first so I can check your code.", "blocked": "", "trace": [], "jdk_missing": False}
    # Safety block - playground shouldn't run host-process escapes
    blk = _java_blocked_message(code)
    if blk:
        return {"ok": False, "output": "", "error": blk, "explained": blk, "blocked": blk, "trace": [], "jdk_missing": False}
    # JDK not installed - degrade gracefully so lessons are never hard-blocked
    if not _is_jdk_available():
        lint = _lint_java_when_no_jdk(code)
        if lint:
            return {"ok": False, "output": "", "error": lint, "explained": lint, "blocked": "", "trace": [], "jdk_missing": True}
        warn = ("JDK not found on this device - your code was checked without compiling. "
                "Install JDK 17+ from https://adoptium.net and ensure 'javac' is on PATH, then restart the app "
                "for full compile-and-run. The lesson checker still validates your code, so you can keep learning.")
        # Return ok=True with a warning so the higher-level checker (System.out.println presence etc.)
        # can decide pass/fail. The UI will surface the warning alongside the output.
        return {"ok": True, "output": "(checked without JDK - install JDK 17+ for real compile & run)\n", "error": "", "explained": warn, "blocked": "", "trace": [], "jdk_missing": True, "warning": warn, "lint": ""}

    # --- Build source file ---
    # Extract imports so they stay above the class when we synthesize a wrapper
    src_trim = code.strip()
    has_class = "class " in src_trim
    has_main = "main" in src_trim and "String[]" in src_trim
    if has_class and has_main:
        # Code already looks like a full file - use as-is but clean multiple public classes edge
        source = src_trim
        # If the file declares more than one public class, javac will error
        # about file-name mismatch. That's correct Java - surface the real error.
        # We keep source as-is so the compiler's message is accurate.
    elif has_class:
        # Has a class but no main (e.g. Dog class exercise) - use as-is too
        source = src_trim
    else:
        # Bare snippet - wrap imports outside, rest inside Main.main
        import_lines = []
        body_lines = []
        for ln in src_trim.splitlines():
            if re.match(r"\s*import\s+", ln):
                import_lines.append(ln)
            else:
                body_lines.append(ln)
        body = "\n".join(body_lines)
        # If snippet is empty after extracting imports, keep a comment so file compiles
        if not body.strip():
            body = "        // no code yet"
        import_block = "\n".join(import_lines) + ("\n" if import_lines else "")
        indented = "\n".join("        " + ln if ln.strip() else "" for ln in body.splitlines())
        source = f"{import_block}public class Main {{\n    public static void main(String[] args) {{\n{indented}\n    }}\n}}\n"

    # Determine file name: must match the ONE public class, or fall back to Main
    cls_name = "Main"
    try:
        # Prefer `public class Main` if present; else first public class; else first class
        m_pub = re.findall(r"public\s+class\s+(\w+)", source)
        if m_pub:
            # If Main is among them, use Main (required for java Main to run)
            cls_name = "Main" if "Main" in m_pub else m_pub[0]
            # If multiple public classes, we keep cls_name as first public but the compile
            # will correctly fail with "class X is public, should be declared in file named X.java"
        else:
            m_any = re.search(r"class\s+(\w+)", source)
            if m_any:
                # Non-public helper class only -> we still need Main wrapper, so synthesize
                # by prepending a Main class instead of renaming the existing one
                if source.strip().startswith("class "):
                    cls_name = "Main"
                    # Prepend Main import block handled above; for this path we already have wrapper,
                    # so this branch shouldn't happen - fallback to Main
                    pass
    except Exception:
        cls_name = "Main"

    # Guard: source length sanity (avoid gigantic pastes / DoS)
    if len(source) > 60000:
        return {"ok": False, "output": "", "error": "File too large", "explained": "Your pasted code is very large (over 60k). Shorten it.", "blocked": "", "trace": [], "jdk_missing": False}

    tmpdir = Path(tempfile.mkdtemp(prefix="javacoach_"))
    try:
        src_path = tmpdir / f"{cls_name}.java"
        # Normalize line endings, ensure UTF-8
        try:
            src_path.write_text(source, encoding="utf-8", newline="\n")
        except Exception as exc:
            return {"ok": False, "output": "", "error": str(exc), "explained": explain_java_error(str(exc), code), "blocked": "", "trace": [], "jdk_missing": False}
        # Compile with explicit encoding + warnings
        javac_cmd = ["javac", "-encoding", "UTF-8", str(src_path)]
        try:
            comp = subprocess.run(javac_cmd, cwd=str(tmpdir), capture_output=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            return {"ok": False, "output": "", "error": "Compilation timed out", "explained": "Compilation took too long - check for unclosed braces \"{ }\" or quotes \" \" that never close.", "blocked": "", "trace": [], "jdk_missing": False}
        if comp.returncode != 0:
            err = comp.stderr.decode("utf-8", "replace") or comp.stdout.decode("utf-8", "replace")
            return {"ok": False, "output": "", "error": err.strip(), "explained": explain_java_error(err, code), "blocked": "", "trace": [], "jdk_missing": False}
        # Verify a .class was produced (javac can succeed without producing Main if no public Main)
        class_file = tmpdir / f"{cls_name}.class"
        if not class_file.exists():
            # Try to find any class that was produced and run that instead (e.g., Dog)
            produced = list(tmpdir.glob("*.class"))
            if produced:
                cls_name = produced[0].stem
            else:
                return {"ok": False, "output": "", "error": f"No class file produced for {cls_name}", "explained": explain_java_error(f"Main method not found in class {cls_name}", code), "blocked": "", "trace": [], "jdk_missing": False}
        # Run
        java_cmd = ["java", "-cp", str(tmpdir), cls_name]
        # Prepare stdin for Scanner input simulation
        stdin_data = None
        if inputs is not None:
            if isinstance(inputs, (list, tuple)):
                stdin_data = "\n".join(str(x) for x in inputs)
            else:
                stdin_data = str(inputs)
            if stdin_data and not stdin_data.endswith("\n"):
                stdin_data += "\n"
        try:
            run = subprocess.run(java_cmd, cwd=str(tmpdir), capture_output=True, timeout=timeout, input=stdin_data.encode("utf-8") if stdin_data else None)
        except subprocess.TimeoutExpired:
            return {"ok": False, "output": "", "error": "Program timed out", "explained": "Your program took too long - maybe an infinite loop like while (true) without a break? Add a condition that becomes false.", "blocked": "", "trace": [], "jdk_missing": False}
        out = run.stdout.decode("utf-8", "replace")
        err = run.stderr.decode("utf-8", "replace")
        if run.returncode != 0:
            # Runtime crash - include any partial stdout the program printed before dying
            return {"ok": False, "output": out.strip(), "error": err.strip() or out.strip(), "explained": explain_java_error(err or out, code), "blocked": "", "trace": [], "jdk_missing": False}
        return {"ok": True, "output": out.strip(), "error": "", "explained": "", "blocked": "", "trace": [], "jdk_missing": False}
    finally:
        try:
            import shutil
            shutil.rmtree(tmpdir, ignore_errors=True)
        except Exception:
            pass


def _strip_for_check(code, language=None):
    """Return code with comments removed for robust checks.

    Prevents cheating via '# print(' inside comments. String contents are kept
    so checks for file names like "us_states.json" (which must be inside strings)
    still pass. The goal is to ensure code keywords appear outside comments, not
    necessarily outside strings - file I/O arguments must stay detectable.
    """
    if not code:
        return ""
    lang = (language or "python").lower() if language else "python"
    s = code
    # Remove comments only - keep strings so dataset file name checks still work
    # For Python: # comments (but not inside strings - we handle strings first by protecting them)
    # Simple approach: temporarily blank strings, remove comments, then restore strings
    placeholders = []
    def _ph(m):
        placeholders.append(m.group(0))
        return f"__STR{len(placeholders)-1}__"
    try:
        # Protect strings
        s_prot = re.sub(r'"""[\s\S]*?"""', _ph, s)
        s_prot = re.sub(r"'''[\s\S]*?'''", _ph, s_prot)
        s_prot = re.sub(r'"(?:\\.|[^"\\])*"', _ph, s_prot)
        s_prot = re.sub(r"'(?:\\.|[^'\\])*'", _ph, s_prot)
        # Remove comments on protected version
        if lang == "java":
            s_prot = re.sub(r'//.*', lambda m: ' ' * len(m.group(0)), s_prot)
            s_prot = re.sub(r'/\*[\s\S]*?\*/', lambda m: ' ' * len(m.group(0)), s_prot)
        else:
            s_prot = re.sub(r'#.*', lambda m: ' ' * len(m.group(0)), s_prot)
        # Restore strings
        for i, orig in enumerate(placeholders):
            s_prot = s_prot.replace(f"__STR{i}__", orig)
        s = s_prot
    except Exception:
        # Fallback: just remove comments naively
        try:
            if lang == "java":
                s = re.sub(r'//.*', '', s)
                s = re.sub(r'/\*[\s\S]*?\*/', '', s)
            else:
                s = re.sub(r'#.*', '', s)
        except Exception:
            pass
    return s

def _robust_check(code, language, required_tokens, forbidden_tokens=None):
    stripped = _strip_for_check(code, language)
    for tok in required_tokens or []:
        if tok not in stripped:
            return False
    for tok in forbidden_tokens or []:
        if tok in stripped:
            return False
    return True

def _wrap_lesson_checks(lesson_sets, language):
    """Wrap lesson check lambdas to use stripped code and require successful run."""
    try:
        for level, lessons in (lesson_sets or {}).items():
            for lesson in lessons:
                for step in lesson.get("steps", []):
                    orig = step.get("check")
                    if callable(orig):
                        # capture
                        def _make(orig_check, lang=language):
                            def _wrapped(code, _orig=orig_check, _lang=lang):
                                # string presence check already uses stripped inside _robust,
                                # but many checks are simple lambdas; we re-evaluate on stripped
                                # to block comment cheats, and require that code at least parses
                                try:
                                    stripped = _strip_for_check(code, _lang)
                                    return bool(_orig(stripped))
                                except Exception:
                                    try:
                                        return bool(_orig(code))
                                    except Exception:
                                        return False
                            return _wrapped
                        step["check_wrapped"] = orig
                        step["check"] = _make(orig)
                fp = lesson.get("final_project")
                if fp and callable(fp.get("check")):
                    orig = fp["check"]
                    def _make_fp(orig_check, lang=language):
                        def _wrapped(code, _orig=orig_check, _lang=lang):
                            try:
                                stripped = _strip_for_check(code, _lang)
                                return _orig(stripped)
                            except Exception:
                                try:
                                    return _orig(code)
                                except Exception:
                                    return (False, "Check failed")
                        return _wrapped
                    fp["check"] = _make_fp(orig)
    except Exception:
        pass
    return lesson_sets

def run_code_for_language(code, language, timeout=5, trace=False, inputs=None):
    """Dispatch to Python or Java runner based on language."""
    lang = (language or "python").lower()
    if lang == "java":
        return run_java_code(code, timeout=timeout, inputs=inputs)
    return run_user_code(code, timeout=timeout, trace=trace, inputs=inputs)

def style_button(btn, theme, bg_key, hover_key, fg="white"):
    btn.configure(
        bg=theme[bg_key], fg=fg, activebackground=theme[hover_key],
        activeforeground=fg, font=FONTS["button"], bd=0, relief="flat",
        cursor="hand2",
    )
    btn.bind("<Enter>", lambda e: btn.configure(bg=theme[hover_key]))
    btn.bind("<Leave>", lambda e: btn.configure(bg=theme[bg_key]))


def add_divider(parent, theme, pad_y=SP["lg"], color=None):
    div = tk.Frame(parent, bg=color or theme["divider"], height=1)
    div.pack(fill="x", padx=SP["lg"], pady=(0, pad_y))
    return div


def draw_round_rect(canvas, x1, y1, x2, y2, r, **kw):
    """Draw a smooth rounded rectangle onto a canvas."""
    pts = [
        x1 + r, y1,
        x2 - r, y1,
        x2, y1,
        x2, y1 + r,
        x2, y2 - r,
        x2, y2,
        x2 - r, y2,
        x1 + r, y2,
        x1, y2,
        x1, y2 - r,
        x1, y1 + r,
        x1, y1,
    ]
    canvas.create_polygon(pts, smooth=True, **kw)


class RoundedCard(tk.Canvas):
    """A rounded card with a soft drop shadow, drawn on a Canvas.

    Drop child widgets into the ``.content`` frame (the rounded, padded area).
    Call :meth:`retheme` after a theme change to refresh colors.
    """

    RADIUS = 18

    def __init__(self, parent, *, theme=None, fill=None, pad=SP["lg"],
                 page_bg=None, shadow=True, radius=None, **kw):
        self._theme = dict(theme or {})
        self._fill = fill
        self._pad = pad
        self._shadow = shadow
        self._radius = radius if radius is not None else self.RADIUS
        page_bg = page_bg or self._theme.get("bg", "#ffffff")
        super().__init__(parent, bg=page_bg, highlightthickness=0, bd=0, **kw)
        self.content = tk.Frame(self, bg=self._fill or self._theme.get("panel", "#ffffff"))
        self.content.place(
            relx=0.0, rely=0.0, x=self._pad, y=self._pad,
            relwidth=1.0, relheight=1.0, width=-2 * self._pad, height=-2 * self._pad,
        )
        self.bind("<Configure>", lambda e: self._draw())
        self.after_idle(self._draw)

    def retheme(self, theme):
        self._theme = dict(theme)
        if self._fill is None:
            self.content.configure(bg=self._theme.get("panel", "#ffffff"))
        self.configure(bg=self._theme.get("bg", "#ffffff"))
        self._draw()

    def _draw(self):
        self.delete("card")
        w, h = self.winfo_width(), self.winfo_height()
        if w <= 2 or h <= 2:
            return
        r = self._radius
        fill = self._fill or self._theme.get("panel", "#ffffff")
        if self._shadow and self._theme.get("card_shadow"):
            # Two stacked offset layers give the rounded card a soft shadow.
            draw_round_rect(self, 3, 4, w - 2, h - 1, r,
                            fill=self._theme["card_shadow"], tags="card")
            draw_round_rect(self, 1, 2, w - 1, h - 1, r,
                            fill=self._theme.get("card_shadow2", fill), tags="card")
        draw_round_rect(self, 0, 0, w, h, r, fill=fill, tags="card")


class RoundedProgress(tk.Canvas):
    """A rounded-cap progress bar drawn on a canvas."""

    def __init__(self, parent, *, theme=None, fill=None, color=None, height=8, **kw):
        self._theme = dict(theme or {})
        self._fill = fill
        self._color = color
        self._height = height
        super().__init__(parent, height=height, highlightthickness=0, bd=0, **kw)
        self.bind("<Configure>", lambda e: self._draw())

    def retheme(self, theme):
        self._theme = dict(theme)
        if not self._color:
            self._draw()

    def draw(self, fraction):
        self._fraction = fraction
        self._draw()

    def _draw(self):
        self.delete("bar")
        w, h = self.winfo_width(), self.winfo_height()
        if w <= 2:
            return
        bg = self._fill or self._theme.get("progress_bg", "#e2e8f0")
        fg = self._color or self._theme.get("progress_fill", "#4f46e5")
        radius = self._height / 2.0
        draw_round_rect(self, 0, 0, w, max(h, 1), radius, fill=bg, tags="bar")
        frac = max(0.0, min(getattr(self, "_fraction", 0.0), 1.0))
        if frac > 0.005:
            fw = max(1.0, w * frac)
            draw_round_rect(self, 0, 0, fw, max(h, 1), radius, fill=fg, tags="bar")


_PY_KEYWORDS = {
    "and", "as", "assert", "async", "await", "break", "class", "continue",
    "def", "del", "elif", "else", "except", "False", "finally", "for",
    "from", "global", "if", "import", "in", "is", "lambda", "None", "nonlocal",
    "not", "or", "pass", "raise", "return", "True", "try", "while", "with",
    "yield",
}

_PY_BUILTINS = {
    "print", "len", "type", "range", "int", "float", "str", "bool", "list",
    "dict", "set", "tuple", "sum", "min", "max", "abs", "round", "sorted",
    "reversed", "enumerate", "zip", "open", "input", "input", "__import__",
}

_JAVA_KEYWORDS = {
    "public", "private", "protected", "class", "static", "void", "int", "double",
    "float", "long", "boolean", "char", "String", "new", "return", "if", "else",
    "for", "while", "do", "switch", "case", "break", "continue", "try", "catch",
    "finally", "throw", "throws", "import", "package", "extends", "implements",
    "this", "super", "null", "true", "false", "enum", "interface", "abstract",
    "final", "extends", "instanceof",
}

_JAVA_BUILTINS = {
    "System", "out", "println", "print", "length", "size", "get", "add", "put",
    "ArrayList", "HashMap", "Integer", "Double", "String",
}


def highlight_syntax(text_widget, code, t, start="1.0", language=None):
    """Apply tag-based syntax coloring to a tk.Text editor.

    This is deliberately lightweight (regex-based, no external libraries) so it
    stays fast on keystroke. It works on the code that's already in ``text_widget``
    and updates the whole buffer's tags. Auto-detects Java vs Python if language
    is not given (looks for System.out.println / public class).
    """
    try:
        # Auto-detect language if not supplied - Java has very distinctive tokens
        if language is None:
            if "System.out.println" in (code or "") or "public class" in (code or "") or "public static void main" in (code or ""):
                language = "java"
            else:
                language = "python"
        else:
            language = str(language).lower()

        text_widget.tag_remove("syn_kw", "1.0", tk.END)
        text_widget.tag_remove("syn_builtin", "1.0", tk.END)
        text_widget.tag_remove("syn_str", "1.0", tk.END)
        text_widget.tag_remove("syn_num", "1.0", tk.END)
        text_widget.tag_remove("syn_comment", "1.0", tk.END)
        text_widget.tag_remove("syn_def", "1.0", tk.END)

        text_widget.tag_config("syn_kw", foreground=t.get("syn_kw", "#a626a4"))
        text_widget.tag_config("syn_builtin", foreground=t.get("syn_builtin", "#4078f2"))
        text_widget.tag_config("syn_str", foreground=t.get("syn_str", "#50a14f"))
        text_widget.tag_config("syn_num", foreground=t.get("syn_num", "#986801"))
        text_widget.tag_config("syn_comment", foreground=t.get("muted", "#718096"))
        text_widget.tag_config("syn_def", foreground=t.get("syn_def", "#e45649"))

        # Strings (single/quoted, raw, f) - shared
        for m in _STRING_RE.finditer(code):
            text_widget.tag_add("syn_str", _off_str(m))
        # Comments - Java uses // and /* */ plus Python #
        if language == "java":
            for m in _JAVA_COMMENT_RE.finditer(code):
                text_widget.tag_add("syn_comment", _off_str(m))
        else:
            for m in _COMMENT_RE.finditer(code):
                text_widget.tag_add("syn_comment", _off_str(m))
        # Numbers
        for m in _NUM_RE.finditer(code):
            text_widget.tag_add("syn_num", _off_str(m))
        # Keywords + builtins + def names come last so they override strings safely
        if language == "java":
            for m in _WORD_RE.finditer(code):
                w = m.group(1)
                if w in _JAVA_KEYWORDS:
                    text_widget.tag_add("syn_kw", _off_str(m))
                elif w in _JAVA_BUILTINS:
                    text_widget.tag_add("syn_builtin", _off_str(m))
            for m in _JAVA_CLASS_RE.finditer(code):
                text_widget.tag_add("syn_def", _off_str(m))
        else:
            for m in _WORD_RE.finditer(code):
                w = m.group(1)
                if w in _PY_KEYWORDS:
                    text_widget.tag_add("syn_kw", _off_str(m))
                elif w in _PY_BUILTINS:
                    text_widget.tag_add("syn_builtin", _off_str(m))
            for m in _DEF_RE.finditer(code):
                text_widget.tag_add("syn_def", _off_str(m))
    except tk.TclError:
        pass


_STRING_RE = re.compile(r"([rubf]*\"\"\"[\s\S]*?\"\"\"|[rubf]*'''[\s\S]*?'''|(?:[rubf]|\"\"\"|''')?\"[^\"\n]*\"|'[^'\n]*')")
_COMMENT_RE = re.compile(r"#.*")
_JAVA_COMMENT_RE = re.compile(r"//.*|/\*[\s\S]*?\*/")
_NUM_RE = re.compile(r"\b\d+(?:\.\d+)?\b")
_WORD_RE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_]*)\b")
_DEF_RE = re.compile(r"\bdef\s+([A-Za-z_][A-Za-z0-9_]*)\b")
_JAVA_CLASS_RE = re.compile(r"\bclass\s+([A-Za-z_][A-Za-z0-9_]*)\b")


def _off_str(match):
    """Convert an in-memory regex span to a tk text index tuple (start, end strings)."""
    start, end = match.span()
    # Both indices are absolute char offsets; build an index from char offset.
    return f"1.0+{start}c", f"1.0+{end}c"


def confetti_burst(root, theme, big=False):
    """A brief, celebratory confetti effect drawn over the whole window.

    Spawns colored rectangles that fall and fade for ~1.4s. It's non-blocking
    (uses after()) so the app stays responsive while it plays.
    If big=True, spawns more pieces and lasts longer for milestone celebrations.
    """
    try:
        canvas = tk.Canvas(root, bg="", highlightthickness=0, bd=0)
        canvas.place(relx=0, rely=0, relwidth=1.0, relheight=1.0)
        canvas.lift()
        w = root.winfo_width()
        colors = [
            theme.get("accent", "#818cf8"), theme.get("success", "#34d399"),
            theme.get("warning", "#fbbf24"), theme.get("danger_btn_bg", "#f87171"),
            theme.get("xp_text", "#a78bfa"), theme.get("streak_text", "#fb923c"),
        ]
        count = 120 if big else 60
        rects = []
        for _ in range(count):
            x0 = random.uniform(0, max(w, 1))
            size = random.uniform(5, 10)
            rects.append([
                canvas.create_rectangle(
                    x0, -20, x0 + size, -20 + size,
                    fill=random.choice(colors), outline=""
                ),
                random.uniform(2, 6),           # fall speed
                random.uniform(-1.5, 1.5),      # horizontal drift
                random.uniform(0, 2 * 3.14159), # initial rotation
            ])

        frame = 0
        max_frames = 110 if big else 70
        delay = 20 if big else 22

        def step():
            nonlocal frame
            frame += 1
            for item in rects:
                try:
                    canvas.move(item[0], item[2], item[1])
                except tk.TclError:
                    continue
            if frame < max_frames:
                root.after(delay, step)
            else:
                try:
                    canvas.destroy()
                except tk.TclError:
                    pass

        root.after(delay, step)
        # sound chime if enabled
        try:
            # best effort: find app instance via winfo_toplevel
            top = root.winfo_toplevel()
            # fallback: try app instance global
            if hasattr(top, "progress") and top.progress.get("sound_enabled", True):
                import winsound
                winsound.MessageBeep(winsound.MB_OK)
        except Exception:
            try:
                root.bell()
            except Exception:
                pass
    except Exception:
        pass


class SyntaxEditor(tk.Text):
    """A tk.Text that live-highlights Python syntax as the user types."""

    def __init__(self, parent, theme=None, **kw):
        super().__init__(parent, **kw)
        self._syntax_theme = theme
        self.bind("<KeyRelease>", self._on_change, add="+")
        self._pending = None

    def attach_theme(self, theme):
        self._syntax_theme = theme
        self._schedule_highlight()

    def set_code(self, code):
        self.delete("1.0", tk.END)
        self.insert("1.0", code)
        self._schedule_highlight()

    def _on_change(self, _e=None):
        self._schedule_highlight()

    def _schedule_highlight(self):
        if self._pending:
            try:
                self.after_cancel(self._pending)
            except tk.TclError:
                pass
        self._pending = self.after(1, self._do_highlight)

    def _do_highlight(self):
        self._pending = None
        try:
            code = self.get("1.0", tk.END)
            highlight_syntax(self, code, self._syntax_theme or {})
        except tk.TclError:
            pass


def show_toast(parent, text, theme):
    toast = tk.Toplevel(parent)
    toast.overrideredirect(True)
    toast.configure(bg=theme["toast_bg"])
    toast.attributes("-topmost", True)

    lbl = tk.Label(
        toast, text=text, bg=theme["toast_bg"], fg=theme["toast_text"],
        font=FONTS["toast"], padx=SP["xl"], pady=SP["md"],
    )
    lbl.pack()

    toast.update_idletasks()
    pw = parent.winfo_width()
    tw = toast.winfo_width()
    x = parent.winfo_rootx() + (pw - tw) // 2
    y = parent.winfo_rooty() + parent.winfo_height() - 80
    toast.geometry(f"+{x}+{y}")

    def fade_out():
        try:
            toast.destroy()
        except tk.TclError:
            pass

    toast.after(2200, fade_out)


class PythonLearnerApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Python Learning Coach")
        self.geometry("1060x740")
        self.minsize(900, 600)
        self.configure(bg=THEMES["light"]["bg"])
        self.resizable(True, True)

        self.fullscreen = False
        self.progress_path = PROGRESS_FILE
        self.progress = ensure_progress(load_progress(self.progress_path) or default_progress())
        update_streak(self.progress)
        save_progress(self.progress_path, self.progress)
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        self._arm_autosave()
        # Extra auto-save on focus loss (Alt-Tab, switching windows) for extra safety
        try:
            self.bind("<FocusOut>", lambda e: save_progress(self.progress_path, self.progress))
        except Exception:
            pass
        # ── Auto-update wiring (dev mode) ──
        self._watcher_proc = _maybe_spawn_background_watcher()
        if self._watcher_proc is not None:
            print(f"[auto-update] Background watcher started (PID {self._watcher_proc.pid}) - will rebuild dist/ on save.")
        self._hot_reload_paths = _dev_watched_paths()
        self._hot_reload_snap = _snapshot_mtimes(self._hot_reload_paths)
        self._hot_reload_failures = 0
        if not _is_frozen() and _HOT_RELOAD_POLL_MS > 0:
            self._auto_update_banner_shown = False
            self.after(_HOT_RELOAD_POLL_MS, self._poll_hot_reload)
        self.theme_name = self.progress.get("theme", "dark")
        self.theme = THEMES[self.theme_name]
        rebuild_fonts(FONT_SCALES.get(self.progress.get("font_size", DEFAULT_FONT_SIZE), 1.0))
        self.frames = {}

        self._build_ui()

        self.bind("<F11>", lambda e: self.toggle_fullscreen())
        self.bind("<Escape>", lambda e: self.exit_fullscreen())
        # Global shortcuts: Ctrl+S / Cmd+S saves progress + any open draft
        self.bind_all("<Control-s>", lambda e: self._save_all_progress())
        self.bind_all("<Command-s>", lambda e: self._save_all_progress())
        # Ctrl+Enter runs code in focused sandbox/lesson (handled per-editor, but global fallback)
        self.bind_all("<Control-Return>", lambda e: None)
        self.bind_all("<Command-Return>", lambda e: None)

        # Main Menu is the home: always start there so you pick what to do today.
        # LanguageSelectionPage now IS the Main Menu (cards for every language, stored per-language).
        # If no language yet, the menu prompts you; if you have one, it highlights active + offers Continue.
        self.show_frame(LanguageSelectionPage)

        self._update_title_for_language()
        self.after(250, self.show_welcome_help)

    def _arm_autosave(self):
        """Persist progress periodically so nothing is lost between saves."""
        self.after(AUTOSAVE_INTERVAL_MS, self._autosave)

    def _autosave(self):
        save_progress(self.progress_path, self.progress)
        self._arm_autosave()

    def _save_all_progress(self):
        """Global Ctrl+S: save progress + sandbox inputs if visible, and toast."""
        try:
            # Save any open sandbox inputs
            for f in self.frames.values():
                if hasattr(f, "_input_box") and hasattr(f, "_editor"):
                    try:
                        self.progress["sandbox_inputs"] = f._input_box.get("1.0", tk.END).rstrip("\n")
                        self.progress["sandbox_code"] = f._editor.get("1.0", tk.END)
                    except Exception:
                        pass
            save_progress(self.progress_path, self.progress)
            show_toast(self, "Saved", self.theme)
        except Exception:
            pass
        return "break"

    def _poll_hot_reload(self):
        """Dev-only: watch lesson/data files and hot-reload without restart.

        Runs every _HOT_RELOAD_POLL_MS when the app is started from source
        (`python learn_python_gui.py`). If any watched file changed on disk,
        reload its module and refresh the UI with a toast. Never crashes the
        app - failures are counted and polling continues.
        """
        try:
            if _is_frozen() or _HOT_RELOAD_POLL_MS <= 0:
                return
            snap = _snapshot_mtimes(self._hot_reload_paths)
            if snap != self._hot_reload_snap:
                changed = [p for p in set(snap) | set(self._hot_reload_snap) if snap.get(p) != self._hot_reload_snap.get(p)]
                # Debounce: ensure files have settled for 400ms
                time.sleep(0.35)
                snap2 = _snapshot_mtimes(self._hot_reload_paths)
                # If still changing, wait for next poll
                if snap2 != snap:
                    self._hot_reload_snap = snap2
                    self.after(_HOT_RELOAD_POLL_MS, self._poll_hot_reload)
                    return
                changed_names = ", ".join(p.name for p in changed[:3]) or "project files"
                # Attempt to reload lesson modules
                reloaded = []
                try:
                    import lesson_data as ld
                    importlib.reload(ld)
                    # Update legacy aliases used throughout the app
                    globals()["_legacy_build_lesson_sets"] = ld.build_lesson_sets
                    globals()["build_lesson_sets"] = ld.build_lesson_sets
                    reloaded.append("lesson_data")
                except Exception as exc:
                    print(f"[hot-reload] lesson_data reload failed: {exc}")
                for lang in SUPPORTED_LANGUAGES:
                    try:
                        mod_name = f"languages.{lang}.lessons"
                        if mod_name in sys.modules:
                            importlib.reload(sys.modules[mod_name])
                        else:
                            importlib.import_module(mod_name)
                        reloaded.append(lang)
                    except Exception:
                        pass
                # Refresh UI frames that depend on lesson sets
                try:
                    if LearningPage in getattr(self, "frames", {}):
                        lp = self.frames[LearningPage]
                        if hasattr(lp, "reload_lesson_sets"):
                            lp.reload_lesson_sets()
                        if hasattr(lp, "refresh"):
                            lp.refresh()
                    # Also refresh skill tree / progress that show lesson counts
                    for cls in (SkillTreePage, ProgressPage):
                        if cls in getattr(self, "frames", {}):
                            try:
                                self.frames[cls].refresh()
                            except Exception:
                                pass
                    if hasattr(self, "sidebar") and hasattr(self.sidebar, "refresh"):
                        try:
                            self.sidebar.refresh()
                        except Exception:
                            pass
                except Exception as exc:
                    print(f"[hot-reload] UI refresh failed: {exc}")
                self._hot_reload_snap = snap2
                self._hot_reload_failures = 0
                # Toast + console (toast keeps emoji, console uses plain to avoid cp1252)
                msg = f"🔄 Auto-updated: {changed_names} reloaded"
                print(f"[hot-reload] Auto-updated: {changed_names} reloaded ({', '.join(reloaded)})")
                try:
                    show_toast(self, msg, self.theme)
                except Exception:
                    pass
                # Also update window title if needed
                try:
                    self._update_title_for_language()
                except Exception:
                    pass
            else:
                # Show one-time hint that auto-update is active (dev mode)
                if not getattr(self, "_auto_update_banner_shown", True):
                    # Only show after 3s of stable run to avoid spam on startup
                    if not hasattr(self, "_auto_update_start_ms"):
                        self._auto_update_start_ms = time.time()
                    elif time.time() - self._auto_update_start_ms > 2.5:
                        self._auto_update_banner_shown = True
                        # Don't toast on every start, just log
                        print("[auto-update] Hot-reload watching: lesson_data + languages/*/lessons.py (save to see refresh)")
        except Exception as exc:
            self._hot_reload_failures += 1
            print(f"[hot-reload] poll error ({self._hot_reload_failures}): {exc}")
            if self._hot_reload_failures > 8:
                print("[hot-reload] Too many failures, stopping hot-reload checks.")
                return
        # Re-arm (only if hot-reload still enabled)
        if _HOT_RELOAD_POLL_MS > 0:
            try:
                self.after(_HOT_RELOAD_POLL_MS, self._poll_hot_reload)
            except tk.TclError:
                pass

    def _on_close(self):
        save_progress(self.progress_path, self.progress)
        # Clean up background watcher if we spawned it
        proc = getattr(self, "_watcher_proc", None)
        if proc is not None:
            try:
                proc.terminate()
                # Don't wait long; watcher is daemon-like
                try:
                    proc.wait(timeout=1.0)
                except Exception:
                    try:
                        proc.kill()
                    except Exception:
                        pass
            except Exception:
                pass
        self.destroy()

    def _update_title_for_language(self):
        lang = current_language(self.progress)
        meta = LANGUAGE_META.get(lang or "python", LANGUAGE_META["python"])
        # Keep window title language-aware but generic when no language chosen
        if not lang:
            self.title("Learning Coach - Choose your language")
        else:
            self.title(f"{meta['name']} Learning Coach")
        # Also store for navbar refresh
        self._nav_lang = lang
        # Live-update navbar title (language switching now only via Main Menu)
        try:
            if hasattr(self, "_nav_title_lbl") and getattr(self, "_nav_title_lbl", None) is not None:
                try:
                    if self._nav_title_lbl.winfo_exists():
                        title_text = "\u25B6  Learning Coach" if not lang else f"\u25B6  {meta['name']} Learning Coach"
                        self._nav_title_lbl.configure(text=title_text)
                except Exception:
                    pass
        except Exception:
            pass

    def set_language(self, language):
        """User picked a language on the chooser. Switch state and route to next step."""
        if language not in SUPPORTED_LANGUAGES:
            return
        cur = self.progress.get("language")
        if cur != language:
            # Save current language's flat state if it was real, then load new language
            if cur in SUPPORTED_LANGUAGES:
                _save_current_language_state(self.progress)
            _load_language_state(self.progress, language)
            # Auto-save the switch so chooser doesn't reappear
            save_progress(self.progress_path, self.progress)
            self._update_title_for_language()
            # Rebuild lesson sets for new language
            if hasattr(self, "frames") and LearningPage in self.frames:
                try:
                    self.frames[LearningPage].reload_lesson_sets()
                except Exception:
                    pass
        # Route: if level already set for this language, go Learning; else Welcome -> Quiz
        if self.progress.get("level"):
            self.show_frame(LearningPage)
        else:
            self.show_frame(WelcomePage)

    def switch_language_interactive(self):
        """Called from navbar/Settings to toggle language while preserving both tracks."""
        cur = current_language(self.progress) or (SUPPORTED_LANGUAGES[0] if SUPPORTED_LANGUAGES else "python")
        try:
            cur_idx = SUPPORTED_LANGUAGES.index(cur)
            nxt = SUPPORTED_LANGUAGES[(cur_idx + 1) % len(SUPPORTED_LANGUAGES)]
        except ValueError:
            nxt = SUPPORTED_LANGUAGES[0] if SUPPORTED_LANGUAGES else "python"
        # Save current
        _save_current_language_state(self.progress)
        _load_language_state(self.progress, nxt)
        save_progress(self.progress_path, self.progress)
        self._update_title_for_language()
        if LearningPage in self.frames:
            try:
                self.frames[LearningPage].reload_lesson_sets()
            except Exception:
                pass
        # Refresh everything to reflect new level/lesson
        for page in self.frames.values():
            if hasattr(page, "refresh"):
                try:
                    page.refresh()
                except Exception:
                    pass
        self.sidebar.refresh()
        # Route appropriately
        if self.progress.get("level"):
            self.show_frame(LearningPage)
        else:
            self.show_frame(WelcomePage)
        meta = LANGUAGE_META[nxt]
        show_toast(self, f"Switched to {meta['icon']} {meta['name']}", self.theme)

    def _build_ui(self):
        self.configure(bg=self.theme["navbar_bg"])

        nav = tk.Frame(self, bg=self.theme["navbar_bg"], height=52)
        nav.pack(fill="x", side="top")
        nav.pack_propagate(False)

        # Dynamic title shows current language + Main Menu affordance
        lang = current_language(self.progress)
        title_text = "\u25B6  Learning Coach" if not lang else f"\u25B6  {LANGUAGE_META[lang]['name']} Learning Coach"
        # Title is clickable -> Main Menu (where you pick what to do today)
        title_lbl = tk.Label(
            nav, text=title_text,
            bg=self.theme["navbar_bg"], fg=self.theme["navbar_text"],
            font=FONTS["heading_sm"], cursor="hand2",
        )
        title_lbl.pack(side="left", padx=(SP["lg"], SP["xl"]))
        title_lbl.bind("<Button-1>", lambda e: self.show_frame(LanguageSelectionPage))
        # Store navbar refs
        self._nav_frame = nav
        self._nav_title_lbl = title_lbl

        # Right side buttons - order matters (packed right-to-left)
        # Main Menu is the only place to switch language (per user request)
        # Text size (Aa) lives only in Settings → Default text size card
        for txt, cmd in [
            ("\U0001F3E0 Main Menu", lambda: self.show_frame(LanguageSelectionPage)),
            ("\U0001F3E0 Learning", lambda: self.show_frame(LearningPage)),
            ("\U0001F4DA Review", lambda: self.show_frame(ReviewQueuePage)),
            ("\U0001F333 Skill Tree", lambda: self.show_frame(SkillTreePage)),
            ("\U0001F3AF Daily", lambda: self.show_frame(DailyChallengePage)),
            ("\u2328 Sandbox", lambda: self.show_frame(SandboxPage)),
            ("\U0001F3C6 Badges", lambda: self.show_frame(BadgesPage)),
            ("\U0001F4CA Progress", lambda: self.show_frame(ProgressPage)),
            ("\u2699 Settings", lambda: self.show_frame(SettingsPage)),
            ("\u263E Theme", self._toggle_theme_btn),
            ("\u26F6 Fullscreen", self.toggle_fullscreen),
        ]:
            b = tk.Button(nav, text=txt, command=cmd, bg=self.theme["navbar_bg"],
                          fg=self.theme["navbar_text"], activebackground=self.theme["navbar_hover"],
                          activeforeground=self.theme["navbar_text"], font=FONTS["nav_small"],
                          bd=0, padx=SP["md"], pady=SP["sm"], cursor="hand2")
            b.pack(side="right", padx=(0, SP["sm"]))
            b.bind("<Enter>", lambda e, w=b: w.configure(bg=self.theme["navbar_hover"]))
            b.bind("<Leave>", lambda e, w=b: w.configure(bg=self.theme["navbar_bg"]))

        body = tk.Frame(self, bg=self.theme["bg"])
        body.pack(fill="both", expand=True)
        self._body_frame = body

        self.sidebar = SidebarFrame(body, self)
        self.sidebar.pack(side="left", fill="y")

        right = tk.Frame(body, bg=self.theme["bg"])
        right.pack(side="left", fill="both", expand=True)
        self._body_right = right

        self.content = tk.Frame(right, bg=self.theme["bg"])
        self.content.pack(fill="both", expand=True)

        self.content.grid_rowconfigure(0, weight=1)
        self.content.grid_columnconfigure(0, weight=1)
        self.frames = {}

        for cls in (LanguageSelectionPage, WelcomePage, SurveyPage, ResultPage, ProgressPage, ReviewQueuePage, SkillTreePage, DailyChallengePage, LearningPage, BadgesPage, SandboxPage, SettingsPage, PlanningGuidePage):
            f = cls(self.content, self)
            self.frames[cls] = f
            f.grid(row=0, column=0, sticky="nsew")

    def _update_sidebar_visibility(self, page):
        """Lessons nav lives on the side ONLY after a language is picked.

        Main Menu + Settings are full-width (no lesson sidebar) so Settings
        stays focused on preferences. Learning pages keep the sidebar for
        one-click lesson jumps.
        """
        try:
            if not hasattr(self, "sidebar") or self.sidebar is None:
                return
            # Full-width pages - no lesson sidebar (guide is also full-width, optional)
            if page in (LanguageSelectionPage, SettingsPage, PlanningGuidePage):
                try:
                    self.sidebar.pack_forget()
                except Exception:
                    pass
            else:
                # Show sidebar when a language is active; hide if still no language
                has_lang = self.progress.get("language") in SUPPORTED_LANGUAGES
                if has_lang:
                    # Re-pack if currently hidden
                    try:
                        if not self.sidebar.winfo_ismapped():
                            self.sidebar.pack(side="left", fill="y", before=self._body_right)
                    except Exception:
                        try:
                            self.sidebar.pack(side="left", fill="y")
                        except Exception:
                            pass
                else:
                    try:
                        self.sidebar.pack_forget()
                    except Exception:
                        pass
        except Exception:
            pass

    def show_frame(self, page):
        # Enforce language chooser gate: if no language, force picker
        if page != LanguageSelectionPage and (not self.progress.get("language") or self.progress.get("language") not in SUPPORTED_LANGUAGES):
            page = LanguageSelectionPage
        # Update sidebar visibility BEFORE raising (so layout settles)
        try:
            self._update_sidebar_visibility(page)
        except Exception:
            pass
        self.frames[page].tkraise()
        self._last_page = page
        if page in (LearningPage, ProgressPage, ReviewQueuePage, DailyChallengePage, SandboxPage, BadgesPage, SettingsPage, SkillTreePage, WelcomePage, LanguageSelectionPage, PlanningGuidePage):
            try:
                self.frames[page].refresh()
            except Exception:
                pass
        try:
            self.sidebar.refresh()
        except Exception:
            pass
        # Keep window title in sync
        try:
            self._update_title_for_language()
        except Exception:
            pass

    def update_progress(self, **changes):
        self.progress.update(changes)
        # Keep completed_by_level in sync with the canonical completed_lessons list
        if "completed_lessons" in changes:
            cur = self.progress.get("level", "")
            if cur:
                cbl = self.progress.setdefault("completed_by_level", {})
                cbl[cur] = list(changes["completed_lessons"] or [])
        # Keep per-language state in sync (so switches preserve latest)
        cur_lang = self.progress.get("language")
        if cur_lang in SUPPORTED_LANGUAGES:
            # Update the stashed copy too
            _save_current_language_state(self.progress)
        save_progress(self.progress_path, self.progress)
        if getattr(self, "sidebar", None) is not None:
            self.sidebar.refresh()

    def _lesson_sets(self):
        lp = self.frames.get(LearningPage)
        if lp is not None and getattr(lp, "lesson_sets", None):
            return lp.lesson_sets
        # Fallback language-aware
        lang = current_language(self.progress)
        return get_lesson_sets_for_language(lang)

    def reset_current_language_progress(self):
        """Reset only the current language's lessons/progress, keep global XP/streak and other languages."""
        lang = current_language(self.progress) or ""
        if lang not in SUPPORTED_LANGUAGES:
            # No language chosen - just do a full restart
            return self.restart_progress()
        # Wipe only current language's state
        fresh_lang = {
            "level": "",
            "lesson_index": 0,
            "step_index": 0,
            "completed_lessons": [],
            "completed_steps": {},
            "completed_by_level": {},
            "code_check_attempts": {},
            "level_history": [],
            "performance_log": {},
            "project_hints": {},
            "project_fail_counts": {},
            "reviews": {},
            "draft_code": {},
        }
        # Clear flat keys
        for k, v in fresh_lang.items():
            self.progress[k] = v
        # Also clear stored state for this language
        if "language_states" in self.progress and lang in self.progress["language_states"]:
            self.progress["language_states"][lang] = None
            _ensure_language_states(self.progress)
            _save_current_language_state(self.progress)
        save_progress(self.progress_path, self.progress)
        # Refresh all
        if hasattr(self, "frames"):
            for f in self.frames.values():
                if hasattr(f, "refresh"):
                    try:
                        f.refresh()
                    except Exception:
                        pass
            if LearningPage in self.frames:
                try:
                    self.frames[LearningPage].reload_lesson_sets()
                except Exception:
                    pass
        self._update_title_for_language()
        self.show_frame(WelcomePage)

    def _show_badge_popup(self, badge_ids):
        """Show a detailed popup for newly earned badges: name, why, and how."""
        if not badge_ids:
            return
        t = self.theme
        win = tk.Toplevel(self)
        win.title("Badge Earned!")
        win.configure(bg=t["panel"])
        win.resizable(False, False)
        # Header
        hdr = tk.Frame(win, bg=t["panel"], padx=SP["xl"], pady=SP["lg"])
        hdr.pack(fill="x")
        tk.Label(hdr, text="\U0001F3C6  Badge Unlocked!", bg=t["panel"], fg=t["text"], font=FONTS["heading_md"]).pack(anchor="w")
        tk.Label(hdr, text="You did what it said - here's what you earned and how you got it.", bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"], wraplength=420, justify="left").pack(anchor="w", pady=(SP["xs"], 0))
        # Each badge card
        for bid in badge_ids:
            b = badge_by_id(bid) or {}
            icon = b.get("icon", "\U0001F3C6")
            name = b.get("name", bid)
            desc = b.get("desc", "")
            how = b.get("how", "")
            diff = int(b.get("difficulty", 1) or 1)
            stars = difficulty_stars(diff)
            label = _DIFFICULTY_LABEL.get(diff, "")
            card = tk.Frame(win, bg=t["card"], bd=1, relief="solid", padx=SP["lg"], pady=SP["md"])
            card.pack(fill="x", padx=SP["xl"], pady=(SP["sm"], 0))
            top = tk.Frame(card, bg=t["card"])
            top.pack(fill="x")
            tk.Label(top, text=icon, bg=t["card"], fg=t["accent"], font=("Segoe UI", 20)).pack(side="left", padx=(0, SP["md"]))
            txt_box = tk.Frame(top, bg=t["card"])
            txt_box.pack(side="left", fill="x", expand=True)
            tk.Label(txt_box, text=name, bg=t["card"], fg=t["text"], font=FONTS["heading_sm"], anchor="w").pack(fill="x")
            tk.Label(txt_box, text=desc, bg=t["card"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w", wraplength=340, justify="left").pack(fill="x")
            mid = tk.Frame(card, bg=t["card"])
            mid.pack(fill="x", pady=(SP["xs"], 0))
            tk.Label(mid, text=f"{stars}  {label}", bg=t["card"], fg=_DIFFICULTY_COLOR.get(diff, t["muted"]), font=FONTS["caption_bold"], anchor="w").pack(fill="x")
            how_frame = tk.Frame(card, bg=t["tip_bg"], padx=SP["md"], pady=SP["sm"])
            how_frame.pack(fill="x", pady=(SP["sm"], 0))
            tk.Label(how_frame, text="How you earned it:", bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["caption_bold"], anchor="w").pack(fill="x")
            tk.Label(how_frame, text=how, bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["body_sm"], anchor="w", wraplength=340, justify="left").pack(fill="x")
            tk.Label(card, text="\u2713 You just completed the action above - this popup means the check passed.", bg=t["card"], fg=t["success"], font=FONTS["caption"], anchor="w").pack(fill="x", pady=(SP["xs"], 0))
        btn = tk.Button(win, text="Awesome! Continue \u2192", font=FONTS["button"], command=win.destroy, padx=SP["xl"], pady=SP["sm"])
        btn.pack(pady=SP["lg"])
        style_button(btn, t, "accent", "accent_hover")
        win.update_idletasks()
        w = max(win.winfo_reqwidth(), 480)
        h = win.winfo_reqheight()
        x = self.winfo_rootx() + (self.winfo_width() - w)//2
        y = self.winfo_rooty() + (self.winfo_height() - h)//2
        win.geometry(f"{w}x{h}+{max(x,0)}+{max(y,0)}")
        win.transient(self)
        win.grab_set()
        win.lift()
        # Also keep toast for subtle confirmation
        try:
            names = " \u2022 ".join((badge_by_id(b) or {}).get("name", b) for b in badge_ids)
            show_toast(self, f"\U0001F3C6 {names} unlocked!", t)
        except Exception:
            pass

    def check_badges(self):
        """Evaluate all badges against current progress; if any are newly earned,
        celebrate with a pop-up and a confetti burst, then persist the update."""
        new = newly_awarded_badges(self.progress, self._lesson_sets())
        if not new:
            return
        save_progress(self.progress_path, self.progress)
        if getattr(self, "sidebar", None) is not None:
            self.sidebar.refresh()
        confetti_burst(self, self.theme, big=len(new) >= 2 or any(badge_by_id(b) and badge_by_id(b).get("difficulty",0) >=5 for b in new))
        try:
            self._show_badge_popup(new)
        except Exception:
            try:
                names = " \u2022 ".join((badge_by_id(b) or {}).get("name", b) for b in new)
                show_toast(self, f"\U0001F3C6 New badge earned: {names}", self.theme)
            except tk.TclError:
                pass

    def celebrate(self, message=None, confetti=True, big=False):
        """A cheerful burst after big wins like lessons and projects."""
        if confetti:
            # big for milestones
            try:
                # auto-big for legendary badges or 5k XP
                if not big and message and any(kw in str(message) for kw in ["Legendary", "Python Master", "Crown", "Unbreakable"]):
                    big = True
            except Exception:
                pass
            confetti_burst(self, self.theme, big=big)
        if message:
            try:
                show_toast(self, message, self.theme)
            except tk.TclError:
                pass

    def toggle_fullscreen(self):
        self.fullscreen = not self.fullscreen
        self.attributes("-fullscreen", self.fullscreen)

    def exit_fullscreen(self):
        if self.fullscreen:
            self.fullscreen = False
            self.attributes("-fullscreen", False)

    def _toggle_theme_btn(self):
        nxt = "dark" if self.theme_name == "light" else "light"
        self.apply_theme(nxt)

    def apply_theme(self, theme_name):
        self.theme_name = theme_name
        self.theme = THEMES[theme_name]
        self.update_progress(theme=theme_name)
        self.configure(bg=self.theme["navbar_bg"])
        self.sidebar.refresh()
        for frame in self.frames.values():
            if hasattr(frame, "refresh"):
                frame.refresh()

    def _current_page(self):
        last = getattr(self, "_last_page", None)
        if last in self.frames:
            return last
        return LearningPage if self.progress.get("level") else WelcomePage

    def _rebuild_ui(self):
        """Rebuild the navbar and every page (used after a font-size change)."""
        for w in self.winfo_children():
            w.destroy()
        self._build_ui()
        self.show_frame(self._current_page())

    def cycle_font_size(self):
        """Cycle Small -> Normal -> Large text so the app fits everyone's eyes."""
        order = ["small", "normal", "large"]
        cur = self.progress.get("font_size", DEFAULT_FONT_SIZE)
        nxt = order[(order.index(cur) + 1) % len(order)]
        self._set_font_size(nxt)
        show_toast(self, f"\U0001F525 Text size: {nxt.title()}", self.theme)

    def _set_font_size(self, size):
        self.progress["font_size"] = size
        rebuild_fonts(FONT_SCALES.get(size, 1.0))
        save_progress(self.progress_path, self.progress)
        self._rebuild_ui()

    def show_welcome_help(self):
        """One-time overlay that explains the three tabs on the very first run."""
        if not self.progress.get("show_welcome_help", True):
            return
        self.progress["show_welcome_help"] = False
        save_progress(self.progress_path, self.progress)

        t = self.theme
        win = tk.Toplevel(self)
        win.title("Welcome to Python Learning Coach")
        win.configure(bg=t["panel"])
        win.resizable(False, False)

        card = tk.Frame(win, bg=t["panel"], padx=SP["xl"], pady=SP["xl"])
        card.pack(fill="both", expand=True)

        tk.Label(card, text="\u25B6  Welcome to Python Learning Coach",
                 bg=t["panel"], fg=t["text"], font=FONTS["heading_md"]).pack(anchor="w")
        tk.Label(card, text="Here's how the app helps you learn \u2014 you're in control the whole time.",
                 bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"],
                 anchor="w", wraplength=430, justify="left").pack(anchor="w", pady=(SP["xs"], SP["lg"]))

        for icon, title, desc in [
            ("\U0001F3E0", "Learning", "Work through lessons step by step. Type code in the editor, run it, and ask the Coach for hints when you need them."),
            ("\U0001F4DA", "Review", "Days after you finish a lesson, a spaced-recall card appears here so the ideas actually stick long-term."),
            ("\U0001F4CA", "Progress", "See your XP, streak, and unit progress, plus a personal read of which skills to strengthen next."),
            ("\u2699", "Settings", "Pick your default text size and theme in the Settings tab."),
        ]:
            row = tk.Frame(card, bg=t["card"], padx=SP["lg"], pady=SP["md"])
            row.pack(fill="x", pady=(0, SP["sm"]))
            tk.Label(row, text=icon, bg=t["card"], fg=t["accent"],
                     font=FONTS["heading_md"], width=2).pack(side="left")
            row_inner = tk.Frame(row, bg=t["card"])
            row_inner.pack(side="left", fill="x", expand=True)
            tk.Label(row_inner, text=title, bg=t["card"], fg=t["text"],
                     font=FONTS["body_bold"], anchor="w").pack(fill="x")
            tk.Label(row_inner, text=desc, bg=t["card"], fg=t["text_secondary"],
                     font=FONTS["body_sm"], anchor="w", wraplength=350,
                     justify="left").pack(fill="x")

        done_btn = tk.Button(card, text="\U0001F680 Got it \u2014 let's learn!", font=FONTS["button"],
                             command=win.destroy, padx=SP["xl"], pady=SP["md"])
        done_btn.pack(anchor="w", pady=(SP["md"], 0))
        style_button(done_btn, t, "accent", "accent_hover")

        win.update_idletasks()
        w = max(win.winfo_reqwidth(), 460)
        h = win.winfo_reqheight()
        x = self.winfo_rootx() + (self.winfo_width() - w) // 2
        y = self.winfo_rooty() + (self.winfo_height() - h) // 2
        win.geometry(f"{w}x{h}+{max(x, 0)}+{max(y, 0)}")
        win.transient(self)
        win.grab_set()
        win.lift()

    def complete_quiz(self, level):
        update_streak(self.progress)
        award_xp(self.progress, 15, "level quiz")
        history = self.progress.get("level_history", [])
        if level not in history:
            history.append(level)
        # Auto-check all content before the placed level so the learner doesn't need to redo it.
        lesson_sets = self._lesson_sets() or build_lesson_sets()
        _auto_complete_levels_up_to(self.progress, level, lesson_sets)
        # Persist the auto-completed steps/projects/reviews immediately
        save_progress(self.progress_path, self.progress)
        self.update_progress(
            level=level, lesson_index=0, completed_lessons=[],
            level_history=history,
        )
        # The _auto_complete helper already filled completed_by_level etc; ensure it's still there after update_progress
        # (update_progress may have overwritten with empty completed_lessons, but completed_by_level remains)
        save_progress(self.progress_path, self.progress)
        self.celebrate(message=f"\U0001F3C5 Level up! Welcome to {level} \u2014 +15 XP")
        self.check_badges()
        self.show_frame(LearningPage)

    def jump_to_lesson(self, idx):
        """Jump to a specific lesson of the learner's current level."""
        self.update_progress(lesson_index=int(idx), step_index=0)
        self.show_frame(LearningPage)

    def restart_progress(self):
        """Wipe all learning progress so the app behaves like a fresh first run.

        The chosen theme is kept so the look stays familiar.
        """
        fresh = default_progress()
        fresh["theme"] = self.theme_name
        self.progress = fresh
        rebuild_fonts(FONT_SCALES.get(self.progress["font_size"], 1.0))
        save_progress(self.progress_path, self.progress)
        self.show_frame(WelcomePage)


class SidebarFrame(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["sidebar_bg"], width=240)
        self.controller = controller
        self.pack_propagate(False)
        self.refresh()

    def refresh(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        p = self.controller.progress

        tk.Label(
            self, text="LESSONS", bg=t["sidebar_bg"], fg=t["muted"],
            font=FONTS["nav_small"], anchor="w",
        ).pack(fill="x", padx=SP["lg"], pady=(SP["lg"], SP["sm"]))

        level = p.get("level", "")
        lesson_index = p.get("lesson_index", 0)
        # Use accurate per-level helper so Python/Java sidebar both correct and distinct
        completed = list(_get_completed_for_level(p, level) if level else p.get("completed_lessons", []))

        lessons_obj = self.controller.frames.get(LearningPage)
        lesson_sets = lessons_obj.lesson_sets if lessons_obj else {}
        # Keep items defined for fallback
        items = lesson_sets.get(level, []) if level and lesson_sets else []

        if level and level in lesson_sets:
            for i, les in enumerate(items):
                done = i in completed
                current = (i == lesson_index)
                self._lesson_item(i, les["title"], done, current, t)
        else:
            tk.Label(
                self, text="Complete the quiz\nto unlock lessons.",
                bg=t["sidebar_bg"], fg=t["muted"], font=FONTS["caption"],
                wraplength=200, justify="left",
            ).pack(fill="x", padx=SP["lg"], pady=SP["sm"])

        add_divider(self, t, SP["md"], color=t["border"])

        tk.Label(
            self, text="PROGRESS", bg=t["sidebar_bg"], fg=t["muted"],
            font=FONTS["nav_small"], anchor="w",
        ).pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        total = len(items) if level and level in lesson_sets else 0
        done_count = len(completed)

        bar_bg = tk.Frame(self, bg=t["progress_bg"], height=6)
        bar_bg.pack(fill="x", padx=SP["lg"], pady=(0, SP["xs"]))
        bar_bg.pack_propagate(False)
        if total:
            fill_w = max(done_count / total, 0)
            tk.Frame(bar_bg, bg=t["sidebar_done"]).place(
                relx=0, rely=0, relwidth=fill_w, relheight=1.0)

        tk.Label(
            self, text=f"{done_count}/{total} completed",
            bg=t["sidebar_bg"], fg=t["sidebar_text"], font=FONTS["nav_small"], anchor="w",
        ).pack(fill="x", padx=SP["lg"], pady=(SP["xs"], 0))

        add_divider(self, t, SP["md"], color=t["border"])

        tk.Label(
            self, text="YOUR STATS", bg=t["sidebar_bg"], fg=t["muted"],
            font=FONTS["nav_small"], anchor="w",
        ).pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        stats_row = tk.Frame(self, bg=t["sidebar_bg"])
        stats_row.pack(fill="x", padx=SP["lg"])

        xp_card = RoundedCard(stats_row, theme=t, fill=t["xp_bg"], page_bg=t["sidebar_bg"],
                              pad=SP["sm"], shadow=False, radius=12)
        xp_card.pack(side="left", expand=True, fill="x", padx=(0, SP["xs"]))
        tk.Label(xp_card.content, text=str(p.get("xp", 0)), bg=t["xp_bg"],
                 fg=t["xp_text"], font=FONTS["stat_num"]).pack()
        tk.Label(xp_card.content, text="XP", bg=t["xp_bg"],
                 fg=t["xp_text"], font=FONTS["stat_label"]).pack()

        streak_card = RoundedCard(stats_row, theme=t, fill=t["streak_bg"], page_bg=t["sidebar_bg"],
                                  pad=SP["sm"], shadow=False, radius=12)
        streak_card.pack(side="left", expand=True, fill="x", padx=(0, SP["xs"]))
        tk.Label(streak_card.content, text=str(p.get("streak", 0)), bg=t["streak_bg"],
                 fg=t["streak_text"], font=FONTS["stat_num"]).pack()
        tk.Label(streak_card.content, text="Streak", bg=t["streak_bg"],
                 fg=t["streak_text"], font=FONTS["stat_label"]).pack()

        done_card = RoundedCard(stats_row, theme=t, fill=t["card"], page_bg=t["sidebar_bg"],
                                pad=SP["sm"], shadow=False, radius=12)
        done_card.pack(side="left", expand=True, fill="x")
        tk.Label(done_card.content, text=str(done_count), bg=t["card"],
                 fg=t["text"], font=FONTS["stat_num"]).pack()
        tk.Label(done_card.content, text="Done", bg=t["card"],
                 fg=t["muted"], font=FONTS["stat_label"]).pack()

        add_divider(self, t, SP["md"], color=t["border"])

        tk.Label(
            self, text="LEVEL ROADMAP", bg=t["sidebar_bg"], fg=t["muted"],
            font=FONTS["nav_small"], anchor="w",
        ).pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        level_order = ["Beginner", "Intermediate", "Advanced"]
        badge_colors = {
            "Beginner": t["badge_beginner"],
            "Intermediate": t["badge_intermediate"],
            "Advanced": t["badge_advanced"],
        }
        current_level = level if level in level_order else ""

        for i, lv in enumerate(level_order):
            lv_lessons = lesson_sets.get(lv, [])
            # Accurate per-language count so Java vs Python roadmap differs correctly
            lv_completed = len(_get_completed_for_level(p, lv))

            is_current = (lv == current_level)
            is_done = lv_completed >= len(lv_lessons) and len(lv_lessons) > 0

            row = tk.Frame(self, bg=t["sidebar_bg"])
            row.pack(fill="x", padx=SP["lg"], pady=2)

            if is_current:
                indicator = "\u25B6"
            elif is_done:
                indicator = "\u2713"
            else:
                indicator = "\u25CB"

            color = badge_colors[lv] if is_current else t["muted"]
            if is_done:
                color = t["sidebar_done"]

            tk.Label(row, text=indicator, bg=t["sidebar_bg"], fg=color,
                     font=FONTS["body_bold"], width=2, anchor="w").pack(side="left")

            info = tk.Frame(row, bg=t["sidebar_bg"])
            info.pack(side="left", fill="x", expand=True)

            tk.Label(info, text=lv, bg=t["sidebar_bg"], fg=color,
                     font=FONTS["badge"], anchor="w").pack(side="left")
            tk.Label(info, text=f" {lv_completed}/{len(lv_lessons)}",
                     bg=t["sidebar_bg"], fg=t["muted"],
                     font=FONTS["caption"], anchor="w").pack(side="left")

            if is_current:
                bar_row = tk.Frame(self, bg=t["sidebar_bg"])
                bar_row.pack(fill="x", padx=(SP["lg"] + 24, SP["lg"]))
                mini_bar = tk.Frame(bar_row, bg=t["progress_bg"], height=4)
                mini_bar.pack(fill="x")
                mini_bar.pack_propagate(False)
                if lv_lessons:
                    pct = lv_completed / len(lv_lessons)
                    tk.Frame(mini_bar, bg=badge_colors[lv]).place(
                        relx=0, rely=0, relwidth=max(pct, 0), relheight=1.0)

    def _lesson_item(self, index, title, done, current, t):
        if current:
            bg = t["sidebar_active"]
            fg = "#ffffff"
        elif done:
            bg = t["success_bg"]
            fg = t["success"]
        else:
            bg = t["sidebar_bg"]
            fg = t["sidebar_text"]
        prefix = "\u2713 " if done else f"{index + 1}. "
        label_text = prefix + title

        item = tk.Frame(self, bg=bg, cursor="hand2")
        item.pack(fill="x", padx=SP["sm"], pady=1)

        lbl = tk.Label(
            item, text=label_text, bg=bg, fg=fg, font=FONTS["nav_small"],
            anchor="w", padx=SP["md"], pady=SP["sm"],
        )
        lbl.pack(fill="x")

        if current:
            p = self.controller.progress
            level = p.get("level", "")
            lesson_sets = self._get_lesson_sets()
            item_lesson = lesson_sets.get(level, [])[index] if lesson_sets.get(level) else {}
            steps = item_lesson.get("steps", [])
            if steps:
                completed_steps = p.get("completed_steps", {})
                dot_row = tk.Frame(item, bg=bg)
                dot_row.pack(fill="x", padx=(SP["md"], SP["sm"]), pady=(0, SP["sm"]))
                for si in range(len(steps)):
                    sk = step_key(level, index, si)
                    is_done = sk in completed_steps
                    dot_color = t["sidebar_done"] if is_done else t["muted"]
                    c = tk.Canvas(dot_row, width=10, height=10, bg=bg, highlightthickness=0)
                    c.pack(side="left", padx=2)
                    c.create_oval(1, 1, 9, 9, fill=dot_color, outline="")
                    if is_done:
                        c.create_line(2.6, 5.2, 4.4, 7.0, 8.0, 2.8,
                                      fill="#ffffff", width=1.4)

        if not current:
            def on_enter(e, f=item, l=lbl):
                f.configure(bg=t["sidebar_hover"])
                l.configure(bg=t["sidebar_hover"])
            def on_leave(e, f=item, l=lbl, b=bg):
                f.configure(bg=b)
                l.configure(bg=b)
            for w in (item, lbl):
                w.bind("<Enter>", on_enter)
                w.bind("<Leave>", on_leave)

        def go_lesson(e, idx=index):
            p = self.controller.progress
            p["lesson_index"] = idx
            p["step_index"] = 0
            save_progress(self.controller.progress_path, p)
            self.controller.show_frame(LearningPage)
        for w in (item, lbl):
            w.bind("<Button-1>", go_lesson)

    def _get_lesson_sets(self):
        lessons_obj = self.controller.frames.get(LearningPage)
        return lessons_obj.lesson_sets if lessons_obj else {}


class LanguageSelectionPage(tk.Frame):
    """Main Menu - pick what you wanna do today. Central hub for all languages.

    This is the ONLY place you need to add a language: just extend
    SUPPORTED_LANGUAGES + LANGUAGE_META and drop languages/<id>/lessons.py.
    Everything here (cards, progress, switching) iterates that registry,
    so future languages appear automatically in a wrapping grid.
    """

    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self._build()

    def refresh(self):
        self._build()

    def _lang_done_total(self, p, lang):
        """Return (done, total, level_label) for a language."""
        sets = get_lesson_sets_for_language(lang)
        total = sum(len(v) for v in sets.values())
        if p.get("language") == lang:
            done = len(p.get("completed_lessons", []))
            cbl = p.get("completed_by_level", {}) or {}
            for lv, lst in cbl.items():
                if lv != p.get("level"):
                    done += len(lst or [])
            level_label = p.get("level") or "Not started"
        else:
            stored = (p.get("language_states", {}) or {}).get(lang) or {}
            if not isinstance(stored, dict):
                stored = {}
            cbl = stored.get("completed_by_level", {}) if isinstance(stored, dict) else {}
            done = sum(len(v or []) for v in cbl.values()) + len(stored.get("completed_lessons", []) if isinstance(stored, dict) else [])
            level_label = stored.get("level", "") if isinstance(stored, dict) else ""
            if not level_label:
                level_label = "Not started"
        return done, total, level_label

    def _build(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        p = self.controller.progress
        self.configure(bg=t["bg"])

        # Scrollable outer so grid of languages never overflows when you add more
        outer = tk.Frame(self, bg=t["bg"])
        outer.pack(fill="both", expand=True, padx=SP["xl"], pady=SP["lg"])

        # ---------- Header: Main Menu ----------
        hdr = tk.Frame(outer, bg=t["bg"])
        hdr.pack(fill="x", pady=(SP["md"], SP["sm"]))
        tk.Label(hdr, text="\U0001F3AE  Main Menu", bg=t["bg"], fg=t["text"],
                 font=FONTS["heading_lg"]).pack(anchor="w")
        tk.Label(hdr, text="Pick what you wanna do today - choose a language to dive into, or jump straight to Daily / Review. Your XP, streak and badges are shared; lessons & drafts are saved per language.",
                 bg=t["bg"], fg=t["text_secondary"], font=FONTS["body"],
                 wraplength=720, justify="left").pack(anchor="w", pady=(SP["xs"], 0))

        # Global stats bar (shared across languages)
        stats_bar = tk.Frame(outer, bg=t["panel"], padx=SP["lg"], pady=SP["md"], bd=1, relief="solid",
                             highlightbackground=t["border"])
        stats_bar.pack(fill="x", pady=(SP["md"], SP["md"]))
        # Global = current XP/streak + sum of all lessons done across every language
        all_done = 0
        all_total = 0
        for lang in SUPPORTED_LANGUAGES:
            d, tot, _ = self._lang_done_total(p, lang)
            all_done += d
            all_total += tot
        for val, label, bgk, fgk in [
            (str(p.get("xp", 0)), "XP", "xp_bg", "xp_text"),
            (str(p.get("streak", 0)), "Streak", "streak_bg", "streak_text"),
            (f"{all_done}/{all_total}", "Lessons", "card", "text"),
            (str(len(p.get("badges", []))), "Badges", "card", "text"),
        ]:
            card = tk.Frame(stats_bar, bg=t[bgk], padx=SP["lg"], pady=SP["sm"])
            card.pack(side="left", padx=(0, SP["sm"]))
            tk.Label(card, text=val, bg=t[bgk], fg=t[fgk], font=FONTS["stat_num"]).pack(anchor="w")
            tk.Label(card, text=label, bg=t[bgk], fg=t[fgk], font=FONTS["stat_label"]).pack(anchor="w")

        # Current track banner
        cur = p.get("language")
        if cur in SUPPORTED_LANGUAGES:
            meta = LANGUAGE_META[cur]
            tip = tk.Frame(outer, bg=t["tip_bg"], padx=SP["lg"], pady=SP["sm"])
            tip.pack(fill="x", pady=(0, SP["md"]))
            tk.Label(tip, text=f"Active: {meta['icon']} {meta['name']} \u2022 Level: {p.get('level') or 'not yet placed'} \u2022 {p.get('lesson_index',0)+1} lessons in",
                     bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["body_sm"], anchor="w").pack(side="left")
            tk.Button(tip, text="Change \u2192", font=FONTS["button_sm"],
                      command=lambda: None, padx=SP["md"], pady=2, state="disabled", bg=t["tip_bg"], fg=t["muted"], bd=0).pack(side="right")
        else:
            tip = tk.Frame(outer, bg=t["warning_bg"], padx=SP["lg"], pady=SP["sm"])
            tip.pack(fill="x", pady=(0, SP["md"]))
            tk.Label(tip, text="No language chosen yet - pick one below to start. You can switch anytime.",
                     bg=t["warning_bg"], fg=t["warning"], font=FONTS["body_sm"], anchor="w").pack(side="left")

        # ---------- What to do today? quick jump ----------
        do_row = tk.Frame(outer, bg=t["bg"])
        do_row.pack(fill="x", pady=(SP["sm"], SP["md"]))
        tk.Label(do_row, text="What to do today?", bg=t["bg"], fg=t["text"], font=FONTS["heading_sm"]).pack(anchor="w")
        actions = tk.Frame(do_row, bg=t["bg"])
        actions.pack(fill="x", pady=(SP["xs"], 0))
        def _go(page):
            return lambda: self.controller.show_frame(page)
        for label, page in [
            ("\U0001F4DA Continue Learning", LearningPage),
            ("\U0001F3AF Daily Challenge", DailyChallengePage),
            ("\U0001F4DA Review Queue", ReviewQueuePage),
            ("\u2328 Playground", SandboxPage),
            ("\U0001F5D3 Planning Guide", PlanningGuidePage),
        ]:
            b = tk.Button(actions, text=label, font=FONTS["button_sm"], padx=SP["md"], pady=SP["xs"], command=_go(page))
            b.pack(side="left", padx=(0, SP["xs"]))
            style_button(b, t, "secondary_btn_bg", "secondary_btn_hover")
            if page == LearningPage and cur not in SUPPORTED_LANGUAGES:
                b.configure(state="disabled")

        # ---------- Language cards - wrapping grid (future-proof) ----------
        tk.Label(outer, text="Languages", bg=t["bg"], fg=t["text"], font=FONTS["heading_sm"]).pack(anchor="w", pady=(SP["md"], SP["sm"]))
        tk.Label(outer, text="Each card is a track. Adding a language = 1 line in SUPPORTED_LANGUAGES + languages/<id>/lessons.py - it appears here automatically.",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=720, justify="left").pack(anchor="w", pady=(0, SP["sm"]))

        # Grid container - 2 columns, auto rows (scales to N languages)
        COLS = 2
        grid = tk.Frame(outer, bg=t["bg"])
        grid.pack(fill="x")
        for col in range(COLS):
            grid.grid_columnconfigure(col, weight=1, uniform="langcol")

        for idx, lang in enumerate(SUPPORTED_LANGUAGES):
            meta = LANGUAGE_META.get(lang, {"name": lang.title(), "icon": "\U0001F4DC", "color": t["accent"], "accent": t["accent"], "desc": "", "tag": lang, "file_ext": lang})
            done, total, level_label = self._lang_done_total(p, lang)
            is_active = (p.get("language") == lang)
            pct = (done / total * 100) if total else 0

            r, c = divmod(idx, COLS)
            card = tk.Frame(grid, bg=t["panel"], bd=1, relief="solid",
                            highlightbackground=meta["color"] if is_active else t["border"],
                            highlightthickness=1 if is_active else 0)
            card.grid(row=r, column=c, sticky="nsew", padx=(0 if c == 0 else SP["sm"], 0 if c == COLS-1 else SP["sm"]), pady=(0, SP["md"]))

            accent = tk.Frame(card, bg=meta["color"], height=6)
            accent.pack(fill="x")

            inner = tk.Frame(card, bg=t["panel"], padx=SP["lg"], pady=SP["lg"])
            inner.pack(fill="both", expand=True)

            # Icon + name row
            top = tk.Frame(inner, bg=t["panel"])
            top.pack(fill="x")
            tk.Label(top, text=meta["icon"], bg=t["panel"], fg=meta["color"], font=("Segoe UI", 28)).pack(side="left")
            name_box = tk.Frame(top, bg=t["panel"])
            name_box.pack(side="left", padx=(SP["sm"], 0), fill="x", expand=True)
            tk.Label(name_box, text=meta["name"], bg=t["panel"], fg=t["text"], font=FONTS["heading_md"], anchor="w").pack(fill="x")
            tk.Label(name_box, text=meta["tag"], bg=t["panel"], fg=meta["color"], font=FONTS["caption_bold"], anchor="w").pack(fill="x")

            tk.Label(inner, text=meta["desc"], bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"], wraplength=300, justify="left").pack(anchor="w", pady=(SP["xs"], SP["md"]))

            # Progress bar
            bar_bg = tk.Frame(inner, bg=t["progress_bg"], height=8)
            bar_bg.pack(fill="x", pady=(0, SP["sm"]))
            bar_bg.pack_propagate(False)
            fill = tk.Frame(bar_bg, bg=meta["color"], height=8)
            fill.place(relx=0, rely=0, relwidth=pct/100, relheight=1)

            stats = tk.Frame(inner, bg=t["card"], padx=SP["md"], pady=SP["sm"])
            stats.pack(fill="x", pady=(0, SP["md"]))
            tk.Label(stats, text=f"{done}/{total} lessons", bg=t["card"], fg=t["text"], font=FONTS["body_bold"], anchor="w").pack(side="left")
            tk.Label(stats, text=f"  \u2022  {level_label}", bg=t["card"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(side="left")
            tk.Label(stats, text=f"{pct:.0f}%", bg=t["card"], fg=t["muted"], font=FONTS["caption"], anchor="e").pack(side="right")

            # Coming-soon check: if lessons total is 0, disable entry
            coming = (total == 0)
            btn_text = ("Coming soon" if coming else (f"Continue {meta['name']}" if is_active and p.get("level") else f"Start {meta['name']}  \u2192"))
            def make_go(l=lang):
                return lambda: self.controller.set_language(l)
            btn = tk.Button(inner, text=btn_text, font=FONTS["button"],
                            command=make_go(lang), padx=SP["xl"], pady=SP["sm"],
                            state=("disabled" if coming else "normal"))
            btn.pack(fill="x", pady=(SP["sm"], 0))
            if not coming:
                # Use language's own color, not python's fixed accent
                try:
                    btn.configure(bg=meta["color"], fg="white", activebackground=meta.get("accent", meta["color"]), activeforeground="white")
                    btn.bind("<Enter>", lambda e, b=btn, m=meta: b.configure(bg=m.get("accent", m["color"])))
                    btn.bind("<Leave>", lambda e, b=btn, m=meta: b.configure(bg=m["color"]))
                except Exception:
                    style_button(btn, t, "accent", "accent_hover")
            if is_active:
                tk.Label(inner, text="\u2713 Active track - your next lesson opens here", bg=t["panel"], fg=t["success"], font=FONTS["caption_bold"]).pack(anchor="w", pady=(SP["xs"], 0))

        # ---------- Footer: how to add a language ----------
        foot = tk.Frame(outer, bg=t["tip_bg"], padx=SP["lg"], pady=SP["md"])
        foot.pack(fill="x", pady=(SP["sm"], 0))
        tk.Label(foot, text="How adding works: edit SUPPORTED_LANGUAGES + LANGUAGE_META at top of learn_python_gui.py, then add languages/<new>/lessons.py with build_lesson_sets(). Cards, switching, and storage are automatic.",
                 bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["body_sm"], wraplength=680, justify="left").pack(fill="x")
        tk.Label(foot, text="Safe switching: XP, streak, badges shared globally; lessons, drafts, reviews per-language via language_states in learning_progress.json.",
                 bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["caption"], wraplength=680, justify="left").pack(fill="x", pady=(SP["xs"],0))

        # Quick continue if language already set (secondary CTAs)
        if cur in SUPPORTED_LANGUAGES and p.get("level"):
            cont = tk.Button(outer, text="Continue where I left off  \u2192", font=FONTS["button"],
                             command=lambda: self.controller.show_frame(LearningPage), padx=SP["xl"], pady=SP["sm"])
            cont.pack(anchor="w", pady=(SP["lg"], 0))
            style_button(cont, t, "accent", "accent_hover")


class WelcomePage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self._build()

    def _build(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        p = self.controller.progress

        scroll_canvas = tk.Canvas(self, bg=t["bg"], highlightthickness=0)
        scroll_canvas.pack(fill="both", expand=True)
        inner = tk.Frame(scroll_canvas, bg=t["bg"])
        win_id = scroll_canvas.create_window((0, 0), window=inner, anchor="nw")
        def _on_canvas_configure(e):
            try:
                scroll_canvas.itemconfig(win_id, width=e.width)
            except Exception:
                pass
            scroll_canvas.configure(scrollregion=scroll_canvas.bbox("all"))
        scroll_canvas.bind("<Configure>", _on_canvas_configure)
        inner.bind("<Configure>", lambda e: scroll_canvas.configure(scrollregion=scroll_canvas.bbox("all")))
        scroll_canvas.bind("<MouseWheel>", lambda e: scroll_canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))

        has_level = bool(p.get("level"))

        hero = tk.Frame(inner, bg=t["bg"])
        hero.pack(fill="x", padx=SP["xl"], pady=(SP["xxl"], SP["xl"]))

        if has_level:
            level = p.get("level", "Beginner")
            badge_colors = {
                "Beginner": t["badge_beginner"],
                "Intermediate": t["badge_intermediate"],
                "Advanced": t["badge_advanced"],
            }
            badge_bg_map = {
                "Beginner": t["success_bg"],
                "Intermediate": t["warning_bg"],
                "Advanced": t["error_bg"],
            }

            tk.Label(
                hero, text="Welcome back!",
                bg=t["bg"], fg=t["text"], font=FONTS["heading_lg"],
            ).pack(anchor="w")

            level_row = tk.Frame(hero, bg=t["bg"])
            level_row.pack(anchor="w", pady=(SP["xs"], SP["md"]))
            tk.Label(
                level_row, text="You're a",
                bg=t["bg"], fg=t["text_secondary"], font=FONTS["body"],
            ).pack(side="left")
            badge = tk.Label(
                level_row, text=f" {level} ",
                bg=badge_bg_map.get(level, t["card"]),
                fg=badge_colors.get(level, t["accent"]),
                font=FONTS["badge"], padx=SP["sm"], pady=2,
            )
            badge.pack(side="left", padx=SP["xs"])
            tk.Label(
                level_row, text="— keep going!",
                bg=t["bg"], fg=t["text_secondary"], font=FONTS["body"],
            ).pack(side="left")

            stats_row = tk.Frame(hero, bg=t["bg"])
            stats_row.pack(anchor="w", pady=(0, SP["xl"]))

            # Use global count so quiz-skipped Beginner still shows as done
            try:
                _done_total = _count_lessons(p)
            except Exception:
                _done_total = len(p.get("completed_lessons", []))
            for value, label, bg_key, fg_key in [
                (str(p.get("xp", 0)), "XP", "xp_bg", "xp_text"),
                (str(p.get("streak", 0)), "Streak", "streak_bg", "streak_text"),
                (str(_done_total), "Done", "card", "text"),
            ]:
                card = tk.Frame(stats_row, bg=t[bg_key], padx=SP["lg"], pady=SP["md"])
                card.pack(side="left", padx=(0, SP["sm"]))
                tk.Label(card, text=value, bg=t[bg_key], fg=t[fg_key],
                         font=FONTS["stat_num"]).pack(anchor="w")
                tk.Label(card, text=label, bg=t[bg_key], fg=t[fg_key],
                         font=FONTS["stat_label"]).pack(anchor="w")

        else:
            lang = current_language(p)
            meta = LANGUAGE_META.get(lang, LANGUAGE_META["python"]) if lang in SUPPORTED_LANGUAGES else LANGUAGE_META["python"]
            # If language not yet chosen, show generic
            welcome_title = f"Welcome to {meta['name']} Learning Coach" if lang in SUPPORTED_LANGUAGES else "Welcome to Learning Coach"
            tk.Label(
                hero, text=welcome_title,
                bg=t["bg"], fg=t["text"], font=FONTS["heading_lg"],
            ).pack(anchor="w")
            welcome_sub = f"Take a quick {meta['name']} quiz to find your level, then work through\ninteractive lessons with hands-on practice." if lang in SUPPORTED_LANGUAGES else "Choose your language first, then take a quick quiz to find your level."
            tk.Label(
                hero, text=welcome_sub,
                bg=t["bg"], fg=t["text_secondary"], font=FONTS["body"],
                wraplength=550, justify="left",
            ).pack(anchor="w", pady=(SP["sm"], SP["xl"]))
            # Language switch hint on welcome
            if lang not in SUPPORTED_LANGUAGES:
                sw = tk.Button(hero, text="Choose Language  \u2192", font=FONTS["button"],
                               command=lambda: self.controller.show_frame(LanguageSelectionPage), padx=SP["xl"], pady=SP["sm"])
                sw.pack(anchor="w", pady=(SP["xs"], 0))
                style_button(sw, t, "accent", "accent_hover")
            else:
                lang_row = tk.Frame(hero, bg=t["bg"])
                lang_row.pack(anchor="w", pady=(SP["xs"], 0))
                tk.Label(lang_row, text=f"{meta['icon']} {meta['name']} track", bg=t["bg"], fg=meta["color"],
                         font=FONTS["body_bold"]).pack(side="left")
                # Language switching now only via Main Menu (per user request)
                sw2 = tk.Button(lang_row, text="Change Language \u2192", font=FONTS["button_sm"],
                                command=lambda: self.controller.show_frame(LanguageSelectionPage), padx=SP["md"], pady=2)
                sw2.pack(side="left", padx=(SP["md"], 0))
                style_button(sw2, t, "secondary_btn_bg", "secondary_btn_hover")

        btn_frame = tk.Frame(hero, bg=t["bg"])
        btn_frame.pack(anchor="w")

        if has_level:
            start_btn = tk.Button(
                btn_frame, text="Retake Quiz  \u2192", font=FONTS["button"],
                command=lambda: self.controller.show_frame(SurveyPage), padx=SP["xl"], pady=SP["md"],
            )
            start_btn.pack(side="left", padx=(0, SP["md"]))
            style_button(start_btn, t, "accent", "accent_hover")

            cont_btn = tk.Button(
                btn_frame, text="Continue Learning", font=FONTS["button"],
                command=lambda: self.controller.show_frame(LearningPage), padx=SP["xl"], pady=SP["md"],
            )
            cont_btn.pack(side="left")
            style_button(cont_btn, t, "secondary_btn_bg", "secondary_btn_hover")

            restart_btn = tk.Button(
                btn_frame, text="\u21BA Restart", font=FONTS["button_sm"],
                command=self._confirm_restart, padx=SP["lg"], pady=SP["sm"],
            )
            restart_btn.pack(side="left", padx=(SP["lg"], 0))
            style_button(restart_btn, t, "danger_btn_bg", "danger_btn_hover")
        else:
            start_btn = tk.Button(
                btn_frame, text="Start Quiz  \u2192", font=FONTS["button"],
                command=lambda: self.controller.show_frame(SurveyPage), padx=SP["xl"], pady=SP["md"],
            )
            start_btn.pack(side="left", padx=(0, SP["md"]))
            style_button(start_btn, t, "accent", "accent_hover")

        add_divider(inner, t, SP["xl"])

        grid = tk.Frame(inner, bg=t["bg"])
        grid.pack(fill="x", padx=SP["xl"])
        card_icons = ["\u270D", "\u270E", "\u2328", "\u2692"]
        for i, (title, desc, icon) in enumerate([
            ("Quiz Assessment", "6 quick questions to find the right level", card_icons[0]),
            ("Guided Lessons", "Step-by-step topics with examples and practice", card_icons[1]),
            ("Code Playground", "Try code in a built-in editor with instant feedback", card_icons[2]),
            ("Final Projects", "Apply what you learned in a hands-on project", card_icons[3]),
        ]):
            card = tk.Frame(grid, bg=t["card"], bd=0, relief="flat")
            card.grid(row=i // 2, column=i % 2, padx=SP["sm"], pady=SP["sm"], sticky="nsew")
            grid.grid_columnconfigure(i % 2, weight=1)
            grid.grid_rowconfigure(i // 2, weight=1)

            accent_bar = tk.Frame(card, bg=t["accent_border"], width=4)
            accent_bar.pack(side="left", fill="y")

            content = tk.Frame(card, bg=t["card"])
            content.pack(side="left", fill="both", expand=True)
            tk.Label(
                content, text=title, bg=t["card"], fg=t["text"],
                font=FONTS["body_bold"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(SP["md"], SP["xs"]))
            tk.Label(
                content, text=desc, bg=t["card"], fg=t["text_secondary"],
                font=FONTS["body_sm"], anchor="w", wraplength=240, justify="left",
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))

        add_divider(inner, t, SP["xl"])

        tips = tk.Frame(inner, bg=t["tip_bg"], bd=0, relief="flat")
        tips.pack(fill="x", padx=SP["xl"], pady=(0, SP["xl"]))
        accent_bar = tk.Frame(tips, bg=t["accent_border"], width=4)
        accent_bar.pack(side="left", fill="y")
        tip_content = tk.Frame(tips, bg=t["tip_bg"])
        tip_content.pack(side="left", fill="both", expand=True)
        tk.Label(
            tip_content, text="Tip", bg=t["tip_bg"], fg=t["tip_text"],
            font=FONTS["body_bold"], anchor="w",
        ).pack(fill="x", padx=SP["lg"], pady=(SP["md"], SP["xs"]))
        tk.Label(
            tip_content,
            text="Complete the quiz, then work through each lesson. After every lesson,\ncomplete the Final Project to solidify what you learned.",
            bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["body_sm"],
            anchor="w", wraplength=500, justify="left",
        ).pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))

    def refresh(self):
        self._build()

    def _confirm_restart(self):
        if messagebox.askyesno(
            "Restart?",
            "This will erase your level, lessons, XP, streak, reviews, and projects.\n\n"
            "You can't undo this. Continue?",
            parent=self,
        ):
            self.controller.restart_progress()
            show_toast(self.winfo_toplevel(), "\u21BA Progress reset \u2014 welcome back!",
                       self.controller.theme)


class SurveyPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self.question_vars = []
        self.questions = []
        self._fill_entries = []
        self._code_editors = []
        self.canvas = None
        self._build()

    def _build(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        self.configure(bg=t["bg"])

        hdr = tk.Frame(self, bg=t["bg"])
        hdr.pack(fill="x", padx=SP["xl"], pady=(SP["xl"], SP["md"]))

        lang = current_language(self.controller.progress)
        meta = LANGUAGE_META.get(lang, LANGUAGE_META["python"]) if lang in SUPPORTED_LANGUAGES else LANGUAGE_META["python"]
        quiz_title = f"{meta['name']} Code Quiz" if lang in SUPPORTED_LANGUAGES else "Code Quiz"
        tk.Label(
            hdr, text=quiz_title, bg=t["bg"], fg=t["text"],
            font=FONTS["heading_md"],
        ).pack(anchor="w")
        tk.Label(
            hdr, text=f"Answer 6 questions (choice/fill/code mix) to find your {meta['name'] if lang in SUPPORTED_LANGUAGES else ''} skill level.".strip(),
            bg=t["bg"], fg=t["text_secondary"], font=FONTS["body_sm"],
        ).pack(anchor="w", pady=(SP["xs"], 0))

        self.questions = self._build_questions()
        self.question_vars = []
        self._fill_entries = []
        self._code_editors = []

        canvas = tk.Canvas(self, bg=t["bg"], highlightthickness=0)
        scrollbar = tk.Scrollbar(self, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=scrollbar.set)
        scrollbar.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        inner = tk.Frame(canvas, bg=t["bg"])
        canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))
        self.canvas = canvas

        for idx, q in enumerate(self.questions, start=1):
            var = tk.StringVar(value="")
            self.question_vars.append(var)
            self._question_card(inner, idx, q, var, t)

        btn_frame = tk.Frame(inner, bg=t["bg"])
        btn_frame.pack(pady=SP["xl"])
        sub = tk.Button(btn_frame, text="Submit Answers", font=FONTS["button"],
                        command=self.submit, padx=SP["xl"], pady=SP["md"])
        sub.pack()
        style_button(sub, t, "accent", "accent_hover")

    def _question_card(self, parent, num, q, var, t):
        card = tk.Frame(parent, bg=t["panel"], bd=0, relief="flat")
        card.pack(fill="x", padx=SP["xl"], pady=SP["sm"])

        accent_bar = tk.Frame(card, bg=t["accent_border"], width=4)
        accent_bar.pack(side="left", fill="y")
        card_inner = tk.Frame(card, bg=t["panel"])
        card_inner.pack(side="left", fill="both", expand=True)

        header_row = tk.Frame(card_inner, bg=t["panel"])
        header_row.pack(fill="x", padx=SP["lg"], pady=(SP["md"], SP["xs"]))
        tk.Label(
            header_row, text=f"Question {num} of {len(self.questions)}", bg=t["panel"], fg=t["accent"],
            font=FONTS["body_bold"], anchor="w",
        ).pack(side="left")

        type_label = {
            "choice": "Multiple Choice",
            "fill": "Type the Output",
            "code": "Write Code",
        }
        tk.Label(
            header_row, text=f"[{type_label.get(q['type'], 'Question')}]", bg=t["panel"],
            fg=t["muted"], font=FONTS["caption"], anchor="w",
        ).pack(side="right")

        tk.Label(
            card_inner, text=q["prompt"], bg=t["panel"], fg=t["text"],
            font=FONTS["body"], anchor="w", wraplength=500, justify="left",
        ).pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        if q.get("code"):
            tk.Label(
                card_inner, text=q["code"], bg=t["code_bg"], fg=t["text"],
                font=FONTS["code"], anchor="w", justify="left",
                padx=SP["lg"], pady=SP["md"], relief="solid", bd=1,
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        qtype = q.get("type", "choice")

        if qtype == "choice":
            for opt in q["options"]:
                rb = tk.Radiobutton(
                    card_inner, text=opt, variable=var, value=opt,
                    bg=t["panel"], activebackground=t["panel"],
                    selectcolor=t["radio_select"], font=FONTS["body_sm"],
                    anchor="w", padx=SP["lg"], pady=SP["xs"],
                )
                rb.pack(fill="x", padx=SP["lg"])

        elif qtype == "fill":
            tk.Label(
                card_inner, text="Type the output this code produces:",
                bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["xs"]))
            entry = tk.Entry(
                card_inner, textvariable=var, font=FONTS["code"], bg=t["input_bg"],
                fg=t["text"], insertbackground=t["text"], relief="solid", bd=1,
            )
            entry.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
            self._fill_entries.append(entry)

        elif qtype == "code":
            tk.Label(
                card_inner, text="Write a short Python snippet:",
                bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["xs"]))
            if q.get("starter_code"):
                tk.Label(
                    card_inner, text=q["starter_code"], bg=t["code_bg"], fg=t["muted"],
                    font=FONTS["code"], anchor="w", justify="left",
                    padx=SP["lg"], pady=SP["sm"], relief="solid", bd=1,
                ).pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
            text = tk.Text(
                card_inner, height=6, font=FONTS["code"], bg=t["input_bg"],
                fg=t["text"], insertbackground=t["text"], relief="solid", bd=1,
            )
            text.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
            self._code_editors.append(text)

        tk.Frame(card_inner, height=SP["sm"], bg=t["panel"]).pack()

    def _build_questions(self):
        lang = current_language(self.controller.progress) if hasattr(self, "controller") else "python"
        # Java pools - mirrors Python tiers but tests Java's strict rules you must code with:
        #  ; at every line, String capital S, braces {}, System.out.println, typed vars, .length()/.equals vs len/==
        if lang == "java":
            easy_pool = [
                {"type": "choice", "tier": 1, "prompt": "What does this print?", "code": "System.out.println(7 + 3);",
                 "options": ["10", "4", "73", "Error"], "answer": "10"},
                {"type": "choice", "tier": 1, "prompt": "Which is valid Java for-loop syntax? (needs () ; ; and {})", "code": "",
                 "options": ["for (int i=0; i<3; i++) { }", "for i in range(3):", "for i range(3)", "for i in 3:"],
                 "answer": "for (int i=0; i<3; i++) { }"},
                {"type": "choice", "tier": 1, "prompt": "Which is the correct way to declare a String in Java? (caps & quotes matter)", "code": "",
                 "options": ["String name = \"Ada\";", "string name = \"Ada\";", "String name = 'Ada';", "String name = Ada;"], "answer": "String name = \"Ada\";"},
                {"type": "choice", "tier": 1, "prompt": "What does \"Hi!\".length() return in Java? (note: it's a method)", "code": "",
                 "options": ["3", "2", "0", "4"], "answer": "3"},
                {"type": "choice", "tier": 1, "prompt": "Which line will cause ';' expected?", "code": "System.out.println(\"Hi\")\nSystem.out.println(\"Bye\");",
                 "options": ["System.out.println(\"Hi\")", "System.out.println(\"Bye\");", "Both are fine", "Neither"], "answer": "System.out.println(\"Hi\")"},
                {"type": "choice", "tier": 1, "prompt": "Which is a valid Java array?", "code": "",
                 "options": ["int[] arr = {1, 2, 3};", "[1, 2, 3]", "(1, 2, 3)", "{1, 2, 3}"], "answer": "int[] arr = {1, 2, 3};"},
            ]
            medium_pool = [
                {"type": "choice", "tier": 2, "prompt": "What does this print? (String case)", "code": 'String name = "Ada";\nSystem.out.println(name.toUpperCase());',
                 "options": ["ADA", "ada", "Ada", "Error"], "answer": "ADA"},
                {"type": "choice", "tier": 2, "prompt": "What does this print? (while with braces)", "code": "int count = 0;\nwhile (count < 2) { count++; }\nSystem.out.println(count);",
                 "options": ["2", "0", "1", "3"], "answer": "2"},
                {"type": "choice", "tier": 2, "prompt": "What does this print? (array index 0-based)", "code": "int[] nums = {10, 20, 30};\nSystem.out.println(nums[2]);",
                 "options": ["30", "20", "3", "10"], "answer": "30"},
                {"type": "choice", "tier": 2, "prompt": "What does this print? (HashMap put/get)", "code": "java.util.HashMap<String,String> m = new java.util.HashMap<>();\nm.put(\"name\",\"Ada\");\nSystem.out.println(m.get(\"name\"));",
                 "options": ["Ada", "36", "name", "null"], "answer": "Ada"},
                {"type": "choice", "tier": 2, "prompt": "What does this print? (method with typed params)", "code": "public static int add(int a,int b){ return a+b; }\nSystem.out.println(add(7,5));",
                 "options": ["12", "75", "7 5", "None"], "answer": "12"},
                {"type": "choice", "tier": 2, "prompt": "Which correctly checks String contents? (== vs .equals)", "code": 'String a = "hello";\nString b = "hello";\nSystem.out.println(a.equals(b));',
                 "options": ["true", "false", "Error", "0"], "answer": "true"},
            ]
            hard_pool = [
                {"type": "choice", "tier": 3, "prompt": "What does this print? (ArrayList .get)", "code": "java.util.ArrayList<Integer> list = new java.util.ArrayList<>();\nlist.add(1); list.add(2); list.add(3);\nSystem.out.println(list.get(1));",
                 "options": ["2", "1", "3", "0"], "answer": "2"},
                {"type": "choice", "tier": 3, "prompt": "What does this print? (StringBuilder reverse)", "code": "String s = \"Python\";\nSystem.out.println(new StringBuilder(s).reverse().toString());",
                 "options": ["nohtyP", "Python", "P", "Error"], "answer": "nohtyP"},
                {"type": "choice", "tier": 3, "prompt": "What does this print? (try/catch NumberFormatException)", "code": "try { int n = Integer.parseInt(\"abc\"); } catch (NumberFormatException e) { System.out.println(0); }",
                 "options": ["0", "abc", "error", "None"], "answer": "0"},
                {"type": "choice", "tier": 3, "prompt": "What does this print? (stream filter + map)", "code": "java.util.List<Integer> nums = java.util.List.of(1,2,3,4);\nSystem.out.println(nums.stream().filter(n-> n%2==0).map(n-> n*2).toList());",
                 "options": ["[4, 8]", "[2, 4]", "[1, 2, 3, 4]", "[8]"], "answer": "[4, 8]"},
                {"type": "choice", "tier": 3, "prompt": "What does this print? (Generics Box<T>)", "code": "class Box<T> { T v; Box(T v){this.v=v;} T get(){return v;} }\nBox<String> b = new Box<>(\"hi\");\nSystem.out.println(b.get());",
                 "options": ["hi", "null", "Box", "Error"], "answer": "hi"},
                {"type": "choice", "tier": 3, "prompt": "What does this print? (enum + switch)", "code": "enum Day { MONDAY, TUESDAY }\nDay d = Day.MONDAY;\nString out = \"\";\nswitch(d){ case MONDAY: out=\"M\"; break; case TUESDAY: out=\"T\"; break; }\nSystem.out.println(out);",
                 "options": ["M", "T", "MONDAY", "Error"], "answer": "M"},
                {"type": "choice", "tier": 3, "prompt": "What does this print? (record auto toString)", "code": "record Point(int x,int y) {}\nPoint p = new Point(3,4);\nSystem.out.println(p.x());",
                 "options": ["3", "Point[x=3, y=4]", "p.x", "Error"], "answer": "3"},
                {"type": "choice", "tier": 3, "prompt": "What does this print? (class + object)", "code": "class Dog { String sound=\"woof\"; }\nDog d = new Dog();\nSystem.out.println(d.sound);",
                 "options": ["woof", "Dog", "sound", "null"], "answer": "woof"},
            ]
        else:
            easy_pool = [
                {"type": "choice", "tier": 1, "prompt": "What does this print?", "code": "x = 7\ny = 3\nprint(x + y)",
                 "options": ["10", "4", "73", "Error"], "answer": "10"},
                {"type": "choice", "tier": 1, "prompt": "Which statement is valid Python syntax?", "code": "",
                 "options": ["for i in range(3):\n    print(i)", "for i in range(3)\n    print(i)",
                              "for i range(3):\n    print(i)", "for i in range(3): print i"],
                 "answer": "for i in range(3):\n    print(i)"},
                {"type": "choice", "tier": 1, "prompt": "Which option is a valid Python list?", "code": "",
                 "options": ["[1, 2, 3]", "(1, 2, 3)", "{1, 2, 3}", "1, 2, 3"], "answer": "[1, 2, 3]"},
                {"type": "choice", "tier": 1, "prompt": "What keyword defines a new function?", "code": "",
                 "options": ["def", "func", "function", "lambda"], "answer": "def"},
                {"type": "choice", "tier": 1, "prompt": "What does len('Hi!') return?", "code": "",
                 "options": ["3", "2", "0", "4"], "answer": "3"},
            ]

            medium_pool = [
                {"type": "choice", "tier": 2, "prompt": "What does this print?", "code": 'name = "Ada"\nprint(name.lower())',
                 "options": ["ada", "ADA", "Ada", "age"], "answer": "ada"},
                {"type": "choice", "tier": 2, "prompt": "What does this print?", "code": "count = 0\nwhile count < 2:\n    count += 1\nprint(count)",
                 "options": ["2", "0", "1", "3"], "answer": "2"},
                {"type": "choice", "tier": 2, "prompt": "What does this print?", "code": "numbers = [10, 20, 30]\nprint(numbers[-1])",
                 "options": ["30", "20", "3", "10"], "answer": "30"},
                {"type": "choice", "tier": 2, "prompt": "What does this print?", "code": "person = {'name': 'Ada', 'age': 36}\nprint(person['name'])",
                 "options": ["Ada", "36", "name", "age"], "answer": "Ada"},
                {"type": "choice", "tier": 2, "prompt": "What does this print?", "code": "def add(a, b):\n    return a + b\nprint(add(7, 5))",
                 "options": ["12", "75", "7 5", "None"], "answer": "12"},
            ]

            hard_pool = [
                {"type": "choice", "tier": 3, "prompt": "What does this print?", "code": "numbers = [1, 2, 3]\nprint([n * 2 for n in numbers])",
                 "options": ["[2, 4, 6]", "[1, 2, 3, 2]", "[1, 2, 3]", "[2, 3, 4]"], "answer": "[2, 4, 6]"},
                {"type": "choice", "tier": 3, "prompt": "What does this print?", "code": 'text = "Python"\nprint(text[::-1])',
                 "options": ["nohtyP", "Python", "P", "oo"], "answer": "nohtyP"},
                {"type": "choice", "tier": 3, "prompt": "What does this print?", "code": "try:\n    n = int('abc')\nexcept ValueError:\n    n = 0\nprint(n)",
                 "options": ["0", "abc", "error", "None"], "answer": "0"},
                {"type": "choice", "tier": 3, "prompt": "What does this print?", "code": "for i in range(1, 4):\n    if i % 2 == 0:\n        print(i)",
                 "options": ["2", "1 2 3", "1", "3"], "answer": "2"},
                {"type": "choice", "tier": 3, "prompt": "What does this print?", "code": "class Dog:\n    def __init__(self):\n        self.sound = 'woof'\nd = Dog()\nprint(d.sound)",
                 "options": ["woof", "Dog", "sound", "None"], "answer": "woof"},
            ]

        selected = []
        selected += random.sample(easy_pool, k=2)
        selected += random.sample(medium_pool, k=2)
        selected += random.sample(hard_pool, k=2)
        for q in selected:
            # copy to avoid mutating the global pool
            q["options"] = list(q["options"])
            random.shuffle(q["options"])
        random.shuffle(selected)
        return selected

    def restart(self):
        self._build()

    def submit(self):
        code_idx = 0
        for q, var in zip(self.questions, self.question_vars):
            if q["type"] == "code":
                if code_idx < len(self._code_editors):
                    var.set(self._code_editors[code_idx].get("1.0", tk.END))
                code_idx += 1

        answers = [v.get() for v in self.question_vars]
        if any(a.strip() == "" for a in answers):
            messagebox.showwarning("Incomplete", "Please answer every question before submitting.")
            return
        self.controller.frames[ResultPage].update_result(answers, self.questions)
        self.controller.show_frame(ResultPage)


class ResultPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self.level = "Beginner"
        self.correct = 0
        self.total = 0

    def _build(self, score_text="", feedback=""):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme

        center = tk.Frame(self, bg=t["bg"])
        center.pack(expand=True)

        card = tk.Frame(center, bg=t["panel"], bd=0, relief="flat", padx=SP["xl"], pady=SP["xl"])
        card.pack(padx=SP["xl"])

        accent_bar = tk.Frame(card, bg=t["accent_border"], width=4)
        accent_bar.pack(side="left", fill="y")
        card_inner = tk.Frame(card, bg=t["panel"])
        card_inner.pack(side="left", fill="both", expand=True, padx=(SP["sm"], 0))

        tk.Label(
            card_inner, text="Quiz Results", bg=t["panel"], fg=t["text"],
            font=FONTS["heading_md"],
        ).pack(pady=(0, SP["lg"]))

        score_outer = tk.Frame(card_inner, bg=t["panel"])
        score_outer.pack(pady=(0, SP["lg"]))

        pct = self.correct / self.total if self.total else 0
        bar_width = 360
        bar_height = SP["lg"] + 12

        score_canvas = tk.Canvas(score_outer, width=bar_width, height=bar_height,
                                  bg=t["progress_bg"], highlightthickness=0)
        score_canvas.pack()
        if pct > 0:
            fill_color = t["success"] if pct >= 0.6 else t["warning"] if pct >= 0.4 else t["error"]
            score_canvas.create_rectangle(0, 0, int(bar_width * pct), bar_height,
                                          fill=fill_color, outline="")
        score_canvas.create_text(bar_width // 2, bar_height // 2,
                                  text=f"{self.correct} / {self.total}",
                                  fill=t["text"], font=FONTS["body_bold"])

        tk.Label(
            card_inner, text=score_text, bg=t["panel"], fg=t["text"],
            font=FONTS["body"], wraplength=520, justify="left", anchor="w",
        ).pack(fill="x", pady=(0, SP["md"]))

        if feedback:
            fb = tk.Frame(card_inner, bg=t["code_bg"], bd=0, relief="flat")
            fb.pack(fill="x", pady=(0, SP["lg"]))
            fb_bar = tk.Frame(fb, bg=t["error"], width=4)
            fb_bar.pack(side="left", fill="y")
            fb_inner = tk.Frame(fb, bg=t["code_bg"])
            fb_inner.pack(side="left", fill="both", expand=True)
            tk.Label(
                fb_inner, text="Review:", bg=t["code_bg"], fg=t["text"],
                font=FONTS["body_bold"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(SP["sm"], SP["xs"]))
            tk.Label(
                fb_inner, text=feedback, bg=t["code_bg"], fg=t["text_secondary"],
                font=FONTS["body_sm"], anchor="w", justify="left", wraplength=360,
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        badge_colors = {
            "Beginner": t["badge_beginner"],
            "Intermediate": t["badge_intermediate"],
            "Advanced": t["badge_advanced"],
        }
        badge_bgs = {
            "Beginner": t["success_bg"],
            "Intermediate": t["warning_bg"],
            "Advanced": t["error_bg"],
        }

        lvl_row = tk.Frame(card_inner, bg=t["panel"])
        lvl_row.pack(pady=(0, SP["xl"]))
        tk.Label(lvl_row, text="Recommended: ", bg=t["panel"], fg=t["text_secondary"],
                 font=FONTS["body"]).pack(side="left")
        tk.Label(lvl_row, text=f" {self.level} ",
                 bg=badge_bgs.get(self.level, t["card"]),
                 fg=badge_colors.get(self.level, t["accent"]),
                 font=FONTS["badge"], padx=SP["sm"], pady=2).pack(side="left")

        btns = tk.Frame(card_inner, bg=t["panel"])
        btns.pack()

        b1 = tk.Button(btns, text="Start Learning  \u2192", font=FONTS["button"],
                       command=lambda: self.controller.complete_quiz(self.level),
                       padx=SP["xl"], pady=SP["md"])
        b1.pack(side="left", padx=(0, SP["md"]))
        style_button(b1, t, "accent", "accent_hover")

        b2 = tk.Button(btns, text="Retake Quiz", font=FONTS["button"],
                       command=lambda: (self.controller.frames[SurveyPage].restart(),
                                        self.controller.show_frame(SurveyPage)),
                       padx=SP["lg"], pady=SP["md"])
        b2.pack(side="left")
        style_button(b2, t, "secondary_btn_bg", "secondary_btn_hover")

    def _is_correct(self, ans, q):
        qtype = q.get("type", "choice")
        ans = (ans or "").strip()
        if qtype == "code":
            if "check" in q:
                try:
                    return bool(q["check"](ans))
                except Exception:
                    return False
            return ans == q.get("answer", "")
        if qtype == "fill":
            expected = [q.get("answer", "")] + list(q.get("accept", []))
            norm = self._normalize(ans)
            return any(self._normalize(e) == norm for e in expected)
        return ans == q.get("answer", "")

    def _normalize(self, s):
        return " ".join(str(s).strip().lower().split())

    def update_result(self, answers, questions):
        correct = sum(1 for a, q in zip(answers, questions) if self._is_correct(a, q))
        total = len(questions)
        self.correct = correct
        self.total = total
        wrong = []
        for i, (a, q) in enumerate(zip(answers, questions), 1):
            if not self._is_correct(a, q):
                wrong.append(f"Q{i}: correct answer is {q.get('answer', '?')}")
        feedback = "\n".join(wrong) if wrong else ""

        earned = sum(q.get("tier", 1) for a, q in zip(answers, questions) if self._is_correct(a, q))
        # Language-aware recommendation - Java and Python have different stacks
        try:
            _lang = current_language(self.controller.progress) if hasattr(self, "controller") and hasattr(self.controller, "progress") else "python"
        except Exception:
            _lang = "python"
        is_java = (_lang == "java")
        if earned >= 9:
            self.level = "Advanced"
            if is_java:
                rec = "You're ready for Streams, Generics, Records, Enums, concurrency, and building full Java apps."
            else:
                rec = "You're ready for classes, modules, decorators, and building full apps."
        elif earned >= 5:
            self.level = "Intermediate"
            if is_java:
                rec = "Build on arrays, HashMap/HashSet, methods, file I/O, String formatting, and the standard library."
            else:
                rec = "Build on functions, lists, and basic syntax with small projects."
        else:
            self.level = "Beginner"
            if is_java:
                rec = "Start with Java basics: typed variables, Strings, loops with ; and braces, and conditionals."
            else:
                rec = "Start with Python basics: variables, expressions, loops, and conditionals."

        score_text = f"You got {correct} out of {total} multiple-choice questions right.\n\n{rec}"
        self._build(score_text, feedback)

    def refresh(self):
        pass


class ProgressPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self.canvas = None
        self.refresh()

    def _get_lesson_sets(self):
        lessons_obj = self.controller.frames.get(LearningPage)
        return lessons_obj.lesson_sets if lessons_obj else {}

    def _scrolled(self, t):
        canvas = tk.Canvas(self, bg=t["bg"], highlightthickness=0)
        scrollbar = tk.Scrollbar(self, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=scrollbar.set)
        scrollbar.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        inner = tk.Frame(canvas, bg=t["bg"])
        canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))
        return inner

    def _section_title(self, parent, text, t):
        tk.Label(parent, text=text, bg=t["bg"], fg=t["text"],
                 font=FONTS["heading_md"], anchor="w").pack(fill="x", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

    def _chip(self, parent, text, value, accent_bg, t):
        card = RoundedCard(parent, theme=t, page_bg=t["bg"], pad=SP["md"])
        card.pack(side="left", fill="x", expand=True, padx=(0, SP["md"]))
        card.content.configure(bg=t["panel"])
        tk.Frame(card.content, bg=accent_bg, height=3).pack(fill="x")
        tk.Label(card.content, text=text, bg=t["panel"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(fill="x", padx=SP["md"], pady=(SP["sm"], 0))
        tk.Label(card.content, text=value, bg=t["panel"], fg=t["text"],
                 font=FONTS["stat_num"], anchor="w").pack(fill="x", padx=SP["md"], pady=(0, SP["md"]))

    def _adaptive_panel(self, parent, adv, t):
        card = RoundedCard(parent, theme=t, page_bg=t["bg"], pad=SP["lg"])
        card.pack(fill="x", padx=SP["xl"], pady=(SP["xs"], SP["sm"]))
        card.content.configure(bg=t["panel"])

        top = tk.Frame(card.content, bg=t["panel"])
        top.pack(fill="x", padx=SP["lg"], pady=(SP["sm"], 0))
        left = tk.Frame(top, bg=t["panel"])
        left.pack(side="left", fill="x", expand=True)
        tk.Label(left, text="Mastery read", bg=t["panel"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(fill="x")
        tk.Label(left, text=adv["message"], bg=t["panel"], fg=t["text"],
                 font=FONTS["body_sm"], anchor="w", wraplength=620,
                 justify="left").pack(fill="x", pady=(SP["xs"], 0))

        right = tk.Frame(top, bg=t["panel"])
        right.pack(side="right", padx=(SP["lg"], 0))
        if adv["mastery"] == "Strong":
            mcolor = t["success"]
        elif adv["mastery"] == "Steady":
            mcolor = t["accent"]
        else:
            mcolor = t["badge_intermediate"]
        tk.Label(right, text=adv["mastery"] or "\u2013", bg=t["panel"],
                 fg=mcolor, font=FONTS["stat_num"], anchor="e").pack(fill="x")
        tk.Label(right, text=f"{adv['rating']}% first-try", bg=t["panel"],
                 fg=t["muted"], font=FONTS["caption"], anchor="e").pack(fill="x")

        rbar = RoundedProgress(card.content, theme=t, color=mcolor, height=8)
        rbar.pack(fill="x", padx=SP["lg"], pady=(SP["sm"], SP["md"]))
        rbar.draw(adv["rating"] / 100.0)

        if not adv["focus"]:
            tk.Label(card.content, text="Nothing needs strengthening right now \u2014 keep the momentum going.",
                     bg=t["panel"], fg=t["success"], font=FONTS["body_sm"],
                     anchor="w").pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))
            return

        tk.Label(card.content, text="TOP FOCUS AREAS", bg=t["panel"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(fill="x", padx=SP["lg"], pady=(SP["sm"], 0))
        for f in adv["focus"][:3]:
            for d in f["detail"]:
                frow = tk.Frame(card.content, bg=t["panel"])
                frow.pack(fill="x", padx=SP["lg"], pady=2)
                tk.Label(frow, text="\u25B8  " + d["title"], bg=t["panel"], fg=t["text"],
                         font=FONTS["body_sm"], anchor="w").pack(side="left")
                tk.Label(frow, text=lesson_strength_desc(d["title"], d["first_try"], d["attempts"]),
                         bg=t["panel"], fg=t["badge_advanced"], font=FONTS["caption"],
                         anchor="e").pack(side="right", padx=SP["sm"])
                b = tk.Button(frow, text="Strengthen",
                              command=lambda i=d["index"]: self.controller.jump_to_lesson(i),
                              bg=t["accent"], fg="#ffffff", activebackground=t["accent_hover"],
                              activeforeground="#ffffff", font=FONTS["caption_bold"], bd=0,
                              padx=SP["sm"], pady=2, cursor="hand2")
                b.pack(side="right")
        tk.Label(card.content, text="", bg=t["panel"]).pack()

    def refresh(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        self.configure(bg=t["bg"])
        p = self.controller.progress
        lesson_sets = self._get_lesson_sets()
        level = p.get("level", "")

        inner = self._scrolled(t)

        tk.Label(inner, text="Your Progress", bg=t["bg"], fg=t["text"],
                 font=FONTS["heading_xl"], anchor="w").pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], 0))
        tk.Label(inner, text="A snapshot of everything you've accomplished so far.",
                 bg=t["bg"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w"
                 ).pack(anchor="w", padx=SP["xl"], pady=(SP["xs"], 0))

        guide_row = tk.Frame(inner, bg=t["bg"])
        guide_row.pack(fill="x", padx=SP["xl"], pady=(SP["sm"], 0))
        guide_btn = tk.Button(guide_row, text="\U0001F5D3 Planning Guide (Optional) \u2192", command=lambda: self.controller.show_frame(PlanningGuidePage), font=FONTS["button_sm"])
        guide_btn.pack(anchor="w")
        style_button(guide_btn, t, "secondary_btn_bg", "secondary_btn_hover")
        tk.Label(guide_row, text="Not required \u2014 just a loose schedule if you want one. All lessons stay unlocked.",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(anchor="w", pady=(SP["xs"], 0))

        stats_row = tk.Frame(inner, bg=t["bg"])
        stats_row.pack(fill="x", padx=SP["xl"], pady=SP["lg"])
        self._chip(stats_row, "XP", str(p.get("xp", 0)), t["accent"], t)
        self._chip(stats_row, "Streak", f"{p.get('streak', 0)} day" + ("s" if p.get("streak", 0) != 1 else ""), t["streak_text"], t)
        roadmap = level if level else "Not placed yet"
        self._chip(stats_row, "Level", roadmap, t["badge_beginner"], t)
        step_total = sum(1 for v in p.get("completed_steps", {}).values() if v)
        self._chip(stats_row, "Steps done", str(step_total), t["success"], t)

        if level:
            self._section_title(inner, "\U0001F9D1\u200D\u2699\uFE0F  Adaptive coach", t)
            adv = adaptive_path(p, lesson_sets, level)
            self._adaptive_panel(inner, adv, t)

        rows, _total_done, _total_all = level_roadmap_stats(p, lesson_sets)
        self._section_title(inner, "\U0001F6E3  Level journey", t)
        for r in rows:
            row = RoundedCard(inner, theme=t, page_bg=t["bg"], pad=SP["lg"], shadow=(r["stage"] == "current"))
            row.pack(fill="x", padx=SP["xl"], pady=SP["xs"])
            row.content.configure(bg=t["panel"])
            ind = {"current": "\u25B6", "done": "\u2713", "locked": "\u25CB"}[r["stage"]]
            color = {"Beginner": t["badge_beginner"], "Intermediate": t["badge_intermediate"],
                     "Advanced": t["badge_advanced"]}[r["level"]]
            fg = color if r["stage"] in ("current", "done") else t["muted"]
            tk.Label(row.content, text=ind, bg=t["panel"], fg=fg, font=FONTS["body_bold"],
                     width=2, anchor="w").pack(side="left", padx=(SP["sm"], 0))
            tk.Label(row.content, text=r["level"], bg=t["panel"], fg=fg,
                     font=FONTS["badge"], anchor="w").pack(side="left", padx=SP["sm"])
            bar_row = tk.Frame(row.content, bg=t["panel"])
            bar_row.pack(side="left", fill="x", expand=True, padx=SP["lg"])
            tk.Label(bar_row, text=f"{r['done']}/{r['total']}",
                     bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(side="right")
            bar = RoundedProgress(bar_row, theme=t, color=color, height=7)
            bar.pack(fill="x", expand=True)
            pct = (r["done"] / r["total"]) if r["total"] else 0
            bar.draw(pct)

        if level and level in lesson_sets and lesson_sets.get(level):
            up = unit_progress(p, lesson_sets, level)
            if len(up) > 1 or (up and up[0]["total"] > 0):
                self._section_title(inner, "\U0001F3AF  Unit progress", t)
                for u in up:
                    row = RoundedCard(inner, theme=t, page_bg=t["bg"], pad=SP["lg"])
                    row.pack(fill="x", padx=SP["xl"], pady=SP["xs"])
                    row.content.configure(bg=t["panel"])
                    tk.Label(row.content, text=u["unit"], bg=t["panel"], fg=t["text"],
                             font=FONTS["body_sm"], anchor="w").pack(side="left", padx=SP["sm"])
                    tk.Label(row.content, text=f"{u['done']}/{u['total']}", bg=t["panel"],
                             fg=t["muted"], font=FONTS["caption"], anchor="w").pack(side="right", padx=SP["sm"])
                    bar = RoundedProgress(row.content, theme=t, color=t["success"], height=6)
                    bar.pack(fill="x", expand=True, pady=(SP["sm"], 0))
                    pct = (u["done"] / u["total"]) if u["total"] else 0
                    bar.draw(pct)

        if level and level in lesson_sets:
            snap = lesson_progress_snapshot(p, lesson_sets, level)
            self._section_title(inner, f"\U0001F4CB {level} lessons \u2014 organized by unit", t)
            current_unit = None
            for s in snap:
                if s["unit"] and s["unit"] != current_unit:
                    current_unit = s["unit"]
                    tk.Label(inner, text="\u25B8  " + current_unit, bg=t["bg"],
                             fg=t["accent"], font=FONTS["heading_sm"], anchor="w"
                             ).pack(anchor="w", padx=SP["xl"], pady=(SP["sm"], 0))
                row = RoundedCard(inner, theme=t, page_bg=t["bg"], pad=SP["lg"])
                row.pack(fill="x", padx=SP["xl"], pady=SP["xs"])
                row.content.configure(bg=t["panel"])
                done_flag = "\u2713 " if s["lesson_done"] else f"{s['index'] + 1}. "
                tk.Label(row.content, text=done_flag + s["title"], bg=t["panel"],
                         fg=t["text"] if not s["lesson_done"] else t["success"],
                         font=FONTS["body_bold"], anchor="w").pack(side="left", padx=SP["sm"])
                tk.Label(row.content, text=f"{s['done_steps']}/{s['total_steps']} steps" +
                         ("  \u2713 project" if s["project_done"] else ""),
                         bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(side="right", padx=SP["sm"])
                bar = RoundedProgress(row.content, theme=t,
                                      color=t["success"] if s["lesson_done"] else t["accent"], height=5)
                bar.pack(fill="x", expand=True, pady=(SP["sm"], 0))
                pct = (s["done_steps"] / s["total_steps"]) if s["total_steps"] else 0
                bar.draw(pct)

            self._section_title(inner, "\U0001F9E0  Skills you can use now", t)
            skills = skill_checklist(p, lesson_sets, level)
            wrap = tk.Frame(inner, bg=t["bg"])
            wrap.pack(fill="x", padx=SP["xl"])
            for i in range(0, len(skills), 2):
                rowf = tk.Frame(wrap, bg=t["bg"])
                rowf.pack(fill="x", pady=2)
                for label, done in skills[i:i + 2]:
                    card_bg = t["success_bg"] if done else t["panel"]
                    card = RoundedCard(rowf, theme=t, fill=card_bg, page_bg=t["bg"], pad=SP["md"])
                    card.pack(side="left", fill="x", expand=True, padx=(0, SP["md"]))
                    card.content.configure(bg=card_bg)
                    tk.Label(card.content, text=("\u2713 " if done else "\u25CB ") + label,
                             bg=card_bg, fg=t["success"] if done else t["muted"],
                             font=FONTS["body_sm"], anchor="w", wraplength=260, justify="left"
                             ).pack(fill="x", padx=SP["lg"], pady=SP["sm"])

            needs_review = [s for s in snap if s["lesson_done"] and not s["first_try"]]
            if needs_review:
                self._section_title(inner, "\U0001F4A1 Worth a quick review", t)
                for s in needs_review:
                    tk.Label(inner, text="\u2022 " + s["title"] + f" \u2014 needed {s['attempts']} attempt(s)",
                             bg=t["bg"], fg=t["warning"], font=FONTS["body_sm"], anchor="w"
                             ).pack(anchor="w", padx=SP["xl"])

        due = due_reviews(p, lesson_sets)
        if due:
            self._section_title(inner, "\U0001F4DA  Review queue \u2014 due now", t)
            for r in due:
                row = tk.Frame(inner, bg=t["panel"])
                row.pack(fill="x", padx=SP["xl"], pady=3)
                tk.Label(row, text="\u2022 " + r["title"], bg=t["panel"],
                         fg=t["warning"], font=FONTS["body_sm"],
                         anchor="w").pack(side="left", padx=SP["lg"])
            tk.Label(inner, text="Open the Review tab to recall these.", bg=t["bg"],
                     fg=t["muted"], font=FONTS["caption"], anchor="w"
                     ).pack(anchor="w", padx=SP["xl"], pady=(0, SP["sm"]))

        self._section_title(inner, "\u23F1  XP over time", t)
        chart_row = tk.Frame(inner, bg=t["panel"])
        chart_row.pack(fill="x", padx=SP["xl"], pady=(0, SP["lg"]))
        chart = tk.Canvas(chart_row, bg=t["panel"], height=170, highlightthickness=0)
        chart.pack(fill="x", padx=SP["lg"], pady=SP["lg"])
        series = daily_xp_series(p)
        if series:
            tk.Label(chart_row, text="Last 14 days", bg=t["panel"], fg=t["muted"],
                     font=FONTS["caption"], anchor="w").pack(anchor="w", padx=(SP["lg"], 0))
        draw_xp_chart(chart, series, t)

        # ---- Contribution heatmap (GitHub style) ----
        self._section_title(inner, "\U0001F5D3  Contribution heatmap", t)
        hm = p.get("heatmap_data", {}) or {}
        hm_row = tk.Frame(inner, bg=t["panel"])
        hm_row.pack(fill="x", padx=SP["xl"], pady=(0, SP["lg"]))
        if not hm:
            tk.Label(hm_row, text="No activity yet — complete a step to light up your first square.",
                     bg=t["panel"], fg=t["muted"], font=FONTS["body_sm"]).pack(anchor="w", padx=SP["lg"], pady=SP["lg"])
        else:
            # build a simple grid: 7 rows (Mon-Sun) x columns for weeks (last 20 weeks)
            try:
                from datetime import date as _d, timedelta as _td
                today = _d.today()
                # find Monday of 20 weeks ago
                start = today - _td(days=7*20 + today.weekday())
                max_c = max(hm.values()) if hm else 1
                def _color(count):
                    if count <= 0:
                        return t["progress_bg"]
                    if count >= max_c:
                        return t["accent"]
                    if count >= max_c * 0.66:
                        return t["accent_2"]
                    if count >= max_c * 0.33:
                        return t["success"]
                    return t["badge_beginner"]
                canv = tk.Canvas(hm_row, bg=t["panel"], height=110, highlightthickness=0)
                canv.pack(fill="x", padx=SP["lg"], pady=SP["md"])
                # month labels on top — SP-derived so ocean/forest scaling stays consistent
                cell = SP["md"] + 2
                gap = SP["xs"] - 1
                x0 = 0
                y0 = SP["lg"]
                # draw cells
                cur = start
                col = 0
                while cur <= today:
                    r = cur.weekday()  # Mon=0
                    c = col
                    iso = cur.isoformat()
                    cnt = int(hm.get(iso, 0) or 0)
                    color = _color(cnt)
                    x = x0 + c*(cell+gap)
                    y = y0 + r*(cell+gap)
                    canv.create_rectangle(x, y, x+cell, y+cell, fill=color, outline="")
                    # tooltip via tag? skip for simplicity
                    if cur.weekday() == 6:
                        col += 1
                    cur += _td(days=1)
                canv.create_text(2, 6, text="20 weeks  \u2022  darker = more activity", anchor="w", fill=t["muted"], font=FONTS["caption"])
                canv.configure(scrollregion=canv.bbox("all"))
                tk.Label(hm_row, text=f"Total days active: {len(hm)}  \u2022  best day: {max_c} activities",
                         bg=t["panel"], fg=t["muted"], font=FONTS["caption"]).pack(anchor="w", padx=SP["lg"])
            except Exception:
                tk.Label(hm_row, text="Heatmap unavailable.", bg=t["panel"], fg=t["muted"], font=FONTS["caption"]).pack(anchor="w", padx=SP["lg"])

        # ---- Weekly quest progress ----
        self._section_title(inner, "\U0001F3AF  Weekly quest", t)
        week = p.get("weekly_goal_week", "") or "—"
        goal = int(p.get("weekly_goal", 5) or 5)
        prog = int(p.get("weekly_progress", 0) or 0)
        freezes = int(p.get("streak_freezes", 0) or 0)
        q_row = RoundedCard(inner, theme=t, page_bg=t["bg"], pad=SP["lg"])
        q_row.pack(fill="x", padx=SP["xl"], pady=(0, SP["lg"]))
        q_row.content.configure(bg=t["panel"])
        pct = min(1.0, prog/goal if goal else 0)
        bar = RoundedProgress(q_row.content, theme=t, color=t["accent"], height=9)
        bar.pack(fill="x", padx=SP["lg"], pady=(SP["sm"], SP["sm"]))
        bar.draw(pct)
        tk.Label(q_row.content, text=f"Week {week}: {prog}/{goal} activities  \u2022  {int(pct*100)}%  \u2022  Freezes: {freezes} \u2744\uFE0F",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(fill="x", padx=SP["lg"])
        tk.Label(q_row.content, text="Do any activity (lesson, project, daily) to count — change goal in Settings.",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(fill="x", padx=SP["lg"], pady=(SP["xs"], SP["lg"]))

        # ---- Completion certificate (per level) ----
        self._section_title(inner, "\U0001F393  Completion certificate", t)
        cert_row = RoundedCard(inner, theme=t, page_bg=t["bg"], pad=SP["lg"])
        cert_row.pack(fill="x", padx=SP["xl"], pady=(0, SP["lg"]))
        cert_row.content.configure(bg=t["panel"])
        has_beginner = any(r["level"] == "Beginner" and r["stage"] == "done" for r in rows)
        has_intermediate = any(r["level"] == "Intermediate" and r["stage"] == "done" for r in rows)
        has_advanced = any(r["level"] == "Advanced" and r["stage"] == "done" for r in rows)
        def _make_cert(level_name):
            try:
                from pathlib import Path as _P
                import datetime as _dt
                cert_text = f"Python Learning Coach — Certificate of Completion\n\nLevel: {level_name}\nLearner XP: {p.get('xp',0)}\nStreak: {p.get('streak',0)} days\nDate: {_dt.date.today().isoformat()}\n\nCongratulations! You completed every lesson in {level_name}.\n"
                out = _P.home() / f"PythonCoach_Certificate_{level_name}.txt"
                # also try Documents
                try:
                    docs = _P.home() / "Documents" / f"PythonCoach_Certificate_{level_name}.txt"
                    docs.write_text(cert_text, encoding="utf-8")
                    out = docs
                except Exception:
                    out.write_text(cert_text, encoding="utf-8")
                show_toast(self.winfo_toplevel(), f"Certificate saved to {out}", t)
            except Exception as e:
                show_toast(self.winfo_toplevel(), f"Certificate error: {e}", t)
        # show earned status and button per level
        for lvl, done in [("Beginner", has_beginner), ("Intermediate", has_intermediate), ("Advanced", has_advanced)]:
            rowf = tk.Frame(cert_row.content, bg=t["panel"])
            rowf.pack(fill="x", padx=SP["lg"], pady=2)
            tk.Label(rowf, text=("✓ " if done else "○ ") + lvl, bg=t["panel"], fg=t["success"] if done else t["muted"], font=FONTS["body_bold"]).pack(side="left")
            if done:
                b = tk.Button(rowf, text="Save certificate", command=lambda l=lvl: _make_cert(l), font=FONTS["button_sm"], padx=SP["sm"], pady=2)
                style_button(b, t, "accent", "accent_hover")
                b.pack(side="right")
            else:
                tk.Label(rowf, text=" — finish all lessons in this level to unlock", bg=t["panel"], fg=t["muted"], font=FONTS["caption"]).pack(side="right")
        if not (has_beginner or has_intermediate or has_advanced):
            tk.Label(cert_row.content, text="Complete a whole level to unlock its printable certificate (freeCodeCamp style).",
                     bg=t["panel"], fg=t["muted"], font=FONTS["caption"], wraplength=500, justify="left").pack(fill="x", padx=SP["lg"], pady=(SP["xs"], SP["lg"]))

        self._section_title(inner, "\u21BA  Starting over", t)
        restart_row = tk.Frame(inner, bg=t["panel"])
        restart_row.pack(fill="x", padx=SP["xl"], pady=(0, SP["xl"]))
        restart_info = tk.Frame(restart_row, bg=t["panel"])
        restart_info.pack(side="left", fill="x", expand=True, padx=SP["lg"])
        tk.Label(restart_info, text="Restart from scratch", bg=t["panel"], fg=t["text"],
                 font=FONTS["body_bold"], anchor="w").pack(fill="x", pady=(SP["md"], 0))
        tk.Label(restart_info,
                 text="Clears your level, lessons, XP, streak, reviews, and projects. Handy if "
                      "someone else wants to use the app or you want a brand-new run.",
                 bg=t["panel"], fg=t["muted"], font=FONTS["body_sm"], anchor="w",
                 wraplength=560, justify="left").pack(fill="x", pady=(SP["xs"], SP["md"]))
        restart_btn = tk.Button(restart_row, text="\u21BA Restart", font=FONTS["button"],
                                command=self._confirm_restart, padx=SP["lg"], pady=SP["md"])
        restart_btn.pack(side="right", padx=(SP["lg"], 0))
        style_button(restart_btn, t, "danger_btn_bg", "danger_btn_hover")

    def _confirm_restart(self):
        if messagebox.askyesno(
            "Restart?",
            "This will erase your level, lessons, XP, streak, reviews, and projects.\n\n"
            "You can't undo this. Continue?",
            parent=self,
        ):
            self.controller.restart_progress()
            show_toast(self.winfo_toplevel(), "\u21BA Progress reset \u2014 welcome back!",
                       self.controller.theme)


class BadgesPage(tk.Frame):
    """A wall of every achievement: earned badges shine in full color, locked
    ones stay muted so the learner can see exactly what to aim for next."""

    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller

    def _get_lesson_sets(self):
        lessons_obj = self.controller.frames.get(LearningPage)
        return lessons_obj.lesson_sets if lessons_obj else {}

    def refresh(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        p = self.controller.progress
        self.configure(bg=t["bg"])
        lesson_sets = self._get_lesson_sets()

        tk.Label(self, text="\U0001F3C6  Achievements", bg=t["bg"], fg=t["text"],
                 font=FONTS["heading_xl"], anchor="w").pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], 0))
        tk.Label(self, text="Badges are earned automatically as you learn. Finish each one's "
                            "goal to light it up. Difficulty shows how much effort is needed.",
                 bg=t["bg"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w"
                 ).pack(anchor="w", padx=SP["xl"], pady=(SP["xs"], SP["lg"]))

        earned = set(awarded_badge_ids(p, lesson_sets))
        done = len(earned)

        # Header chip
        chip = RoundedCard(self, theme=t, page_bg=t["bg"], pad=SP["md"])
        chip.pack(fill="x", padx=SP["xl"])
        chip.content.configure(bg=t["panel"])
        tk.Label(chip.content, text=f"{done} of {len(BADGES)} badges earned",
                 bg=t["panel"], fg=t["text"], font=FONTS["stat_num"],
                 anchor="w").pack(side="left", padx=SP["md"], pady=SP["sm"])
        bar = RoundedProgress(chip.content, theme=t, color=t["accent"], height=8)
        bar.pack(side="right", fill="x", expand=True, padx=SP["md"])
        bar.draw(done / len(BADGES) if BADGES else 0)

        # Filter row — All / Earned / Locked
        filt = tk.StringVar(value="All")
        filt_row = tk.Frame(self, bg=t["bg"])
        filt_row.pack(fill="x", padx=SP["xl"], pady=(SP["sm"], 0))
        tk.Label(filt_row, text="Filter:", bg=t["bg"], fg=t["muted"], font=FONTS["caption_bold"]).pack(side="left", padx=(0, SP["sm"]))
        def _apply_filt():
            self.refresh()
        for lbl in ["All", "Earned", "Locked"]:
            b = tk.Button(filt_row, text=lbl, font=FONTS["button_sm"],
                          command=lambda l=lbl: (filt.set(l), _apply_filt()))
            # highlight active filter
            if filt.get() == lbl:
                style_button(b, t, "accent", "accent_hover")
            else:
                style_button(b, t, "secondary_btn_bg", "secondary_btn_hover")
            b.pack(side="left", padx=(0, SP["xs"]))
        # store filter in instance so refresh can read it (persist across calls)
        if not hasattr(self, "_badge_filter"):
            self._badge_filter = filt
        else:
            # reuse previous selection
            try:
                filt.set(self._badge_filter.get())
            except Exception:
                pass
            self._badge_filter = filt
        active = filt.get()

        # Scrollable grid — 23 badges need scrolling on small screens
        canvas = tk.Canvas(self, bg=t["bg"], highlightthickness=0)
        vsb = tk.Scrollbar(self, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)
        vsb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        outer = tk.Frame(canvas, bg=t["bg"])
        canvas.create_window((0, 0), window=outer, anchor="nw")
        outer.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))
        grid = tk.Frame(outer, bg=t["bg"])
        grid.pack(fill="both", expand=True, padx=SP["xl"], pady=SP["lg"])
        # Build filtered list
        filtered = []
        for b in BADGES:
            is_e = b["id"] in earned
            if active == "Earned" and not is_e:
                continue
            if active == "Locked" and is_e:
                continue
            filtered.append(b)
        for i, badge in enumerate(filtered):
            is_earned = badge["id"] in earned
            row, col = divmod(i, 3)
            card = RoundedCard(grid, theme=t, page_bg=t["bg"], pad=SP["md"],
                               shadow=False, radius=14)
            card.grid(row=row, column=col, padx=SP["sm"], pady=SP["sm"],
                      sticky="nsew")
            grid.grid_rowconfigure(row, weight=1)
            grid.grid_columnconfigure(col, weight=1)
            card.content.configure(bg=(t["panel"] if is_earned else t["code_bg"]))
            fg = (t["text"] if is_earned else t["muted"])
            icon_fg = (t["accent"] if is_earned else t["muted"])

            # Icon
            tk.Label(card.content, text=badge["icon"], bg=card.content.cget("bg"),
                     fg=icon_fg, font=("Segoe UI", 24), anchor="w").pack(
                fill="x", padx="12", pady=(8, 0))

            # Name
            tk.Label(card.content, text=badge["name"], bg=card.content.cget("bg"),
                     fg=fg, font=FONTS["body_bold"], anchor="w", wraplength=200,
                     justify="left").pack(fill="x", padx="12", pady=(4, 0))

            # Difficulty chip
            diff = badge.get("difficulty", 1)
            diff_label = _DIFFICULTY_LABEL.get(diff, "Easy")
            diff_color = _DIFFICULTY_COLOR.get(diff, "#22c55e")
            stars = difficulty_stars(diff)
            chip_frame = tk.Frame(card.content, bg=card.content.cget("bg"))
            chip_frame.pack(fill="x", padx="12", pady=(2, 0), anchor="w")
            tk.Label(chip_frame, text=stars, bg=card.content.cget("bg"),
                     fg=diff_color, font=FONTS["caption"], anchor="w").pack(side="left")
            tk.Label(chip_frame, text=f" {diff_label}", bg=card.content.cget("bg"),
                     fg=diff_color, font=FONTS["caption_bold"], anchor="w").pack(side="left")

            # Description
            tk.Label(card.content, text=badge["desc"], bg=card.content.cget("bg"),
                     fg=(t["text_secondary"] if is_earned else t["muted"]),
                     font=FONTS["caption"], anchor="w", wraplength=220,
                     justify="left").pack(fill="x", padx="12", pady=(2, 0))

            # How-to (the full guide to earning this badge)
            how_text = badge.get("how", "")
            how_label = tk.Label(card.content, text=how_text, bg=card.content.cget("bg"),
                     fg=(t["text_secondary"] if is_earned else t["muted"]),
                     font=FONTS["caption"], anchor="w", wraplength=220,
                     justify="left")
            how_label.pack(fill="x", padx="12", pady=(2, 0))

            # Earned / Locked status
            tk.Label(card.content, text=("\u2713 Earned" if is_earned else "\u25CB Locked"),
                     bg=card.content.cget("bg"),
                     fg=(t["success"] if is_earned else t["muted"]),
                     font=FONTS["caption_bold"], anchor="w").pack(
                fill="x", padx="12", pady=(4, 10))



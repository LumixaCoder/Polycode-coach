def get_lesson_sets_for_language(language):
    """Return lesson sets for the requested language (data-driven, future-proof).

    Tries languages/<lang>/lessons.py first, then falls back to legacy Python sets
    so the app never crashes on missing files. Works for any id in SUPPORTED_LANGUAGES.
    """
    lang = (language or "python").lower()
    sets = None
    # Try dynamic import for any supported language (python, java, plus future ones)
    if lang in SUPPORTED_LANGUAGES:
        try:
            # Dynamic import: languages.<lang>.lessons
            mod = __import__(f"languages.{lang}.lessons", fromlist=["build_lesson_sets"])
            sets = mod.build_lesson_sets()
        except Exception:
            pass
    # Fallback: legacy / python canonical
    if sets is None:
        try:
            from languages.python.lessons import build_lesson_sets as build_py
            sets = build_py()
        except Exception:
            sets = _legacy_build_lesson_sets()
    # Wrap checks to block comment/string cheats and ensure stripped evaluation
    try:
        sets = _wrap_lesson_checks(sets, lang)
    except Exception:
        pass
    # Enrich every final_project with Level 1/2/3 guidance fields
    try:
        sets = apply_guidance_enrichment(sets)
    except Exception:
        pass
    return sets

# Keep original name for backward compat (tests import build_lesson_sets)
build_lesson_sets = _legacy_build_lesson_sets



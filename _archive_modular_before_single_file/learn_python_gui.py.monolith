        },
    ]

    all_specs = specs + code_challenges
    for spec in all_specs:
        tag = _CLASSIC_TAGS.get(spec["id"])
        if tag:
            spec["classic"] = True
            spec["level"], spec["topics"], spec["order"] = tag
        spec["coach_step"] = {"instruction": spec["question"], "hint": spec["hint"]}
    return all_specs



LEVEL_ORDER = ["Beginner", "Intermediate", "Advanced"]

# Keys that are per-language (swapped when the learner switches language).
# Everything else (xp, streak, theme, events, badges, daily_challenge, font_size)
# stays global so progress feels continuous across languages.
LANGUAGE_SPECIFIC_KEYS = [
    "level",
    "lesson_index",
    "step_index",
    "completed_lessons",
    "completed_steps",
    "completed_by_level",
    "code_check_attempts",
    "level_history",
    "performance_log",
    "project_hints",
    "project_fail_counts",
    "project_guidance_levels",
    "project_variant_choices",
    "reviews",
    "draft_code",
    "sandbox_code",
]


def current_language(progress):
    """Return the active language, defaulting to python for legacy progress."""
    lang = (progress or {}).get("language", "")
    if lang in SUPPORTED_LANGUAGES:
        return lang
    # Legacy: if level is set but no language, assume python so nothing breaks
    if progress and progress.get("level"):
        return "python"
    return ""

def _ensure_language_states(progress):
    """Make sure language_states exists and holds a snapshot of the current flat keys."""
    if "language_states" not in progress or not isinstance(progress["language_states"], dict):
        progress["language_states"] = {}
    # Ensure each supported language has at least an empty dict entry
    for lang in SUPPORTED_LANGUAGES:
        progress["language_states"].setdefault(lang, None)

def _save_current_language_state(progress):
    """Save the flat language-specific keys into language_states[current_language]."""
    cur = progress.get("language")
    if cur not in SUPPORTED_LANGUAGES:
        return
    _ensure_language_states(progress)
    state = {}
    for k in LANGUAGE_SPECIFIC_KEYS:
        v = progress.get(k)
        state[k] = _copy.deepcopy(v) if isinstance(v, (dict, list)) else v
    progress["language_states"][cur] = state

def _load_language_state(progress, new_lang):
    """Load flat keys from language_states[new_lang] (or fresh defaults if never visited)."""
    if new_lang not in SUPPORTED_LANGUAGES:
        return
    _ensure_language_states(progress)
    stored = progress["language_states"].get(new_lang)
    if stored is None or not isinstance(stored, dict) or not stored:
        # First time visiting this language - start fresh but keep global stats
        fresh = {
            "level": "",
            "lesson_index": 0,
            "step_index": 0,
            "completed_lessons": [],
            "completed_steps": {},
            "completed_by_level": {},
            "code_check_attempts": {},
            "level_history": [],
            "performance_log": {},
            "project_hints": {},
            "project_fail_counts": {},
            "reviews": {},
            "draft_code": {},
            "sandbox_code": "",
        }
        progress["language_states"][new_lang] = _copy.deepcopy(fresh)
        stored = progress["language_states"][new_lang]
    for k in LANGUAGE_SPECIFIC_KEYS:
        if k in stored:
            v = stored[k]
            progress[k] = _copy.deepcopy(v) if isinstance(v, (dict, list)) else v
        else:
            # missing key in old state - for sandbox_code ensure per-language empty
            if k == "sandbox_code":
                progress[k] = ""
                stored[k] = ""
            # else leave flat as is for backward compat
            pass
    progress["language"] = new_lang

def switch_language(progress, new_lang):
    """Public helper: switch active language, saving current and loading new.

    Returns True if switched, False if already there or invalid.
    """
    if new_lang not in SUPPORTED_LANGUAGES:
        return False
    cur = progress.get("language")
    if cur == new_lang:
        return False
    # Save current language's flat state (if it was a real language)
    if cur in SUPPORTED_LANGUAGES:
        _save_current_language_state(progress)
    _load_language_state(progress, new_lang)
    return True


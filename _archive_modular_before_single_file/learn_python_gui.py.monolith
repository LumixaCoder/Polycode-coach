def level_roadmap_stats(progress, lesson_sets):
    order = LEVEL_ORDER
    current = progress.get("level", "")
    cur_idx = order.index(current) if current in order else None
    rows = []
    total_done = 0
    total_all = 0
    for i, lv in enumerate(order):
        lessons = lesson_sets.get(lv, [])
        n = len(lessons)
        total_all += n
        if cur_idx is None:
            c = 0
        elif i == cur_idx:
            c = len(_get_completed_for_level(progress, lv))
        elif i < cur_idx:
            # Earlier levels are considered fully checked off (quiz skip) – use actual stored count if available
            got = _get_completed_for_level(progress, lv)
            c = len(got) if got else n
        else:
            c = 0
        total_done += c
        rows.append({
            "level": lv,
            "done": c,
            "total": n,
            "stage": "current" if i == cur_idx else ("done" if c >= n and n > 0 else "locked"),
        })
    return rows, total_done, total_all


def unit_progress(progress, lesson_sets, level):
    lessons = lesson_sets.get(level, [])
    completed = _get_completed_for_level(progress, level)
    order = []
    counts = {}
    for i, lesson in enumerate(lessons):
        unit = lesson.get("unit") or ("Unit " + str(i // 3 + 1))
        if unit not in counts:
            counts[unit] = [0, 0]
            order.append(unit)
        counts[unit][1] += 1
        if i in completed:
            counts[unit][0] += 1
    return [{"unit": u, "done": counts[u][0], "total": counts[u][1]} for u in order]


def lesson_progress_snapshot(progress, lesson_sets, level):
    completed_steps = progress.get("completed_steps", {})
    completed_lessons = _get_completed_for_level(progress, level)
    log = progress.get("performance_log", {})
    out = []
    for i, lesson in enumerate(lesson_sets.get(level, [])):
        steps = lesson.get("steps", [])
        actionable = [j for j, s in enumerate(steps) if s.get("type") != "concept"]
        done = sum(1 for j in actionable if step_key(level, i, j) in completed_steps)
        key = attempt_key(level, i)
        llog = log.get(key, {})
        out.append({
            "index": i,
            "title": lesson.get("title", ""),
            "unit": lesson.get("unit", ""),
            "done_steps": done,
            "total_steps": len(actionable),
            "project_done": bool(llog.get("project_passed")),
            "lesson_done": i in completed_lessons,
            "first_try": bool(llog.get("first_try")),
            "attempts": len(progress.get("code_check_attempts", {}).get(key, [])),
        })
    return out


def skill_checklist(progress, lesson_sets, level):
    completed = _get_completed_for_level(progress, level)
    lessons = lesson_sets.get(level, [])
    items = []
    for i, lesson in enumerate(lessons):
        title = lesson.get("title", "")
        label = SKILL_LABELS.get(title, f"Complete the '{title}' lesson")
        items.append((label, i in completed))
    return items


def adaptive_path(progress, lesson_sets, level):
    """Analyze the performance log and return personalized, adaptive coaching.

    Uses the per-lesson first-try / attempt / project data that the app already
    records to surface the skill areas the learner found hardest, plus an
    overall mastery read and coach's advice for what to strengthen next.
    """
    snap = lesson_progress_snapshot(progress, lesson_sets, level)
    done = [s for s in snap if s["lesson_done"]]
    if not done:
        return _empty_adaptive()

    per_unit = {}
    for s in done:
        unit = s["unit"] or "General"
        entry = per_unit.setdefault(unit, {"weakness": 0.0, "lessons": []})
        entry["lessons"].append(s)
        if not s["first_try"]:
            entry["weakness"] += 1.0
        if s["attempts"] >= 3:
            entry["weakness"] += 2.0
        elif s["attempts"] == 2:
            entry["weakness"] += 1.0

    focus = []
    for unit, entry in per_unit.items():
        if entry["weakness"] <= 0:
            continue
        focus.append({
            "unit": unit,
            "weakness": entry["weakness"],
            "detail": [
                {
                    "title": s["title"],
                    "index": s["index"],
                    "first_try": s["first_try"],
                    "attempts": s["attempts"],
                    "project_done": s["project_done"],
                }
                for s in entry["lessons"]
            ],
        })
    focus.sort(key=lambda f: f["weakness"], reverse=True)

    first_try_done = sum(1 for s in done if s["first_try"])
    rating = round(100 * first_try_done / len(done)) if done else 0

    if rating >= 80:
        mastery = "Strong"
    elif rating >= 50:
        mastery = "Steady"
    else:
        mastery = "Growing"

    if not focus:
        message = (
            "You're absorbing this quickly \u2014 you handled every lesson here "
            "on the first try. Move ahead with confidence."
        )
    else:
        top = focus[0]
        message = (
            f"Nice progress, but {top['unit']} took real effort. Revisit it "
            "to lock the ideas in before pushing much further ahead."
        )
    return {
        "mastery": mastery,
        "rating": rating,
        "focus": focus,
        "message": message,
    }


def _empty_adaptive():
    return {
        "mastery": "",
        "rating": 0,
        "focus": [],
        "message": "Complete a lesson to unlock your personalized coaching insights.",
    }


def lesson_strength_desc(s, first_try, attempts):
    """Short human label describing how the learner did on one lesson."""
    if first_try:
        return "Mastered on first try"
    if attempts >= 3:
        return f"Took {attempts} tries \u2014 worth another pass"
    if attempts == 2:
        return "Got it on the second try"
    return "Could use a review"


REVIEW_INTERVALS = [1, 2, 4, 8, 16, 32, 60]


def review_key(level, lesson_idx):
    return f"{level}_{lesson_idx}"


def review_schedule(progress):
    return progress.setdefault("reviews", {})


def schedule_review(progress, level, lesson_idx):
    """First time a lesson is mastered, schedule its first review for +1 day."""
    sched = review_schedule(progress)
    key = review_key(level, lesson_idx)
    entry = sched.get(key)
    if entry:
        return False
    sched[key] = {
        "due": (date.today() + timedelta(days=REVIEW_INTERVALS[0])).isoformat(),
        "interval_idx": 0,
    }
    progress["reviews"] = sched
    return True


def grade_review(progress, level, lesson_idx, correct):
    """After a review, reschedule: correct -> longer interval, wrong -> reset to 1 day."""
    sched = review_schedule(progress)
    key = review_key(level, lesson_idx)
    entry = sched.get(key) or {"interval_idx": 0, "due": ""}
    if correct:
        nxt = min(entry.get("interval_idx", 0) + 1, len(REVIEW_INTERVALS) - 1)
    else:
        nxt = 0
    entry["interval_idx"] = nxt
    entry["due"] = (date.today() + timedelta(days=REVIEW_INTERVALS[nxt])).isoformat()
    sched[key] = entry
    progress["reviews"] = sched


def due_reviews(progress, lesson_sets, today=None):
    """Return list of due review entries: {level, lesson_idx, title, question,
    answer, takeaways, interval_idx}."""
    today = today or date.today().isoformat()
    sched = review_schedule(progress)
    out = []
    for key, entry in sched.items():
        if entry.get("due", "") > today:
            continue
        if "_" not in key:
            continue
        level, idx_str = key.rsplit("_", 1)
        try:
            lesson_idx = int(idx_str)
        except ValueError:
            continue
        lessons = lesson_sets.get(level, [])
        if not (0 <= lesson_idx < len(lessons)):
            continue
        lesson = lessons[lesson_idx]
        out.append({
            "level": level,
            "lesson_idx": lesson_idx,
            "title": lesson.get("title", ""),
            "question": lesson.get("review_question", ""),
            "answer": lesson.get("review_answer", ""),
            "takeaways": lesson.get("key_takeaways", ""),
            "answer_prompt": lesson.get("review_answer", ""),
            "interval_idx": entry.get("interval_idx", 0),
        })
    return out


def due_reviews_count(progress, lesson_sets):
    return len(due_reviews(progress, lesson_sets))


def attempt_key(level, lesson_idx):
    return f"{level}_{lesson_idx}"


def step_key(level, lesson_idx, step_idx):
    return f"{level}_{lesson_idx}_{step_idx}"


def project_hint_key(level, lesson_idx):
    return f"{level}_{lesson_idx}_proj_hints"


def project_draft_key(level, lesson_idx):
    return f"{level}_{lesson_idx}_project"


def project_guidance_key(level, lesson_idx):
    return f"{level}_{lesson_idx}_guidance"


GUIDANCE_LOCKED = True  # when True, guidance is locked to curriculum level — no cross-level mixing

def _locked_guidance_for_level(level):
    if level == "Advanced":
        return "3"
    if level == "Intermediate":
        return "2"
    return "1"

def get_project_guidance_level(progress, level, lesson_idx):
    """Return '1','2','3' for this project's guidance selector. When locked, follows curriculum."""
    if GUIDANCE_LOCKED:
        return _locked_guidance_for_level(level)
    key = project_guidance_key(level, lesson_idx)
    lvl = str(progress.get("project_guidance_levels", {}).get(key, ""))
    if lvl in ("1", "2", "3"):
        return lvl
    return _locked_guidance_for_level(level)


def set_project_guidance_level(progress, level, lesson_idx, guidance):
    if GUIDANCE_LOCKED:
        return  # locked — ignore manual switches
    guidance = str(guidance)
    if guidance not in ("1", "2", "3"):
        return
    key = project_guidance_key(level, lesson_idx)
    d = progress.setdefault("project_guidance_levels", {})
    d[key] = guidance


# ── Guidance-tier definitions for final projects ─────────────────────────
# Formula: Project Description → Requirements → Milestones → Optional Hints → Solution Review
# Level 1 Strong (Beginner):  description + required concepts + step-by-step milestones + 3 hint tiers
# Level 2 Partial (Intermediate): requirements + condensed milestones + fewer hints (Hint1+2)
# Level 3 Minimal (Advanced): scenario + requirements only • hints on demand

GUIDANCE_LEVEL_META = {
    "1": {"label": "Level 1: Strong Guidance", "short": "Strong", "tag": "Beginner • Step-by-step", "icon": "🟢", "desc": "Description + Concepts + Milestones + Hints"},
    "2": {"label": "Level 2: Partial Guidance", "short": "Partial", "tag": "Intermediate • Milestones only", "icon": "🟡", "desc": "Requirements + Milestones • Fewer hints"},
    "3": {"label": "Level 3: Minimal Guidance", "short": "Minimal", "tag": "Advanced • Requirements only", "icon": "🔴", "desc": "Scenario + Requirements • Hints on demand"},
}

HINT_TIER_TITLES = [
    "Hint 1 — Gentle Nudge",
    "Hint 2 — More Specific",
    "Hint 3 — Almost Solution",
]


def _derive_required_concepts(lesson):
    """ concepts = key_takeaways bullets or summary fallback. Used for L1."""
    raw = lesson.get("key_takeaways") or lesson.get("summary") or ""
    # split on bullet
    parts = [p.strip() for p in re.split(r"[•\n]", raw) if p.strip()]
    # clean leading dash/bullet
    out = []
    for p in parts:
        p = re.sub(r"^[\-–—]\s*", "", p).strip()
        if p and len(p) > 3:
            out.append(p)
    if not out and raw:
        out = [raw.strip()]
    return out[:6]


def _derive_requirements(proj):
    """Requirements bullets derived from steps (strip numbering, drop Expected line)."""
    if proj.get("requirements"):
        return list(proj["requirements"])
    reqs = []
    for s in proj.get("steps", []):
        txt = str(s).strip()
        if txt.lower().startswith("expected"):
            continue
        # strip leading "1. " or "1) " or "- "
        txt = re.sub(r"^\s*\d+[\.\)]\s*", "", txt)
        txt = re.sub(r"^\s*[•\-]\s*", "", txt)
        if txt:
            reqs.append(txt)
    # fallback to description sentences
    if not reqs and proj.get("description"):
        reqs = [proj["description"]]
    return reqs


def _derive_hint_levels(proj):
    """Return 3 tiered hints: Gentle, Specific, Almost-Solution."""
    if proj.get("hint_levels"):
        return list(proj["hint_levels"])
    base = list(proj.get("start_hints") or [])
    starter = (proj.get("starter_snippet") or "").strip()
    # ensure 3 tiers
    while len(base) < 3:
        base.append("Re-read the Required Concepts above and compare your code to the example.")
    tiers = []
    for i, txt in enumerate(base[:3]):
        title = HINT_TIER_TITLES[i] if i < len(HINT_TIER_TITLES) else f"Hint {i+1}"
        hint_text = txt
        if i == 2 and starter:
            # Almost Solution includes starter snippet as template
            hint_text = hint_text + "\n\nTemplate to adapt:\n" + starter
        tiers.append({"title": title, "text": hint_text})
    return tiers


def _derive_milestones_condensed(proj):
    """Condensed 3-4 milestones for Level 2: group detailed steps."""
    steps = [s for s in proj.get("steps", []) if not str(s).lower().startswith("expected")]
    if proj.get("milestones_condensed"):
        return list(proj["milestones_condensed"])
    # If 5 detailed steps, group as 3: Setup, Build, Verify
    if len(steps) <= 3:
        return steps
    if len(steps) == 4:
        return [steps[0], steps[1] + " + " + steps[2], steps[3]]
    if len(steps) == 5:
        return [steps[0] + " • " + steps[1], steps[2] + " • " + steps[3], steps[4]]
    # >5
    mid = len(steps)//2
    return [" • ".join(steps[:mid]), " • ".join(steps[mid:-1]), steps[-1]]


def enrich_project_with_guidance(lesson, proj):
    """Ensure proj has rich guidance fields without overwriting explicit author data."""
    if "required_concepts" not in proj or not proj["required_concepts"]:
        proj["required_concepts"] = _derive_required_concepts(lesson)
    if "requirements" not in proj or not proj["requirements"]:
        proj["requirements"] = _derive_requirements(proj)
    if "hint_levels" not in proj or not proj["hint_levels"]:
        proj["hint_levels"] = _derive_hint_levels(proj)
    if "milestones_condensed" not in proj:
        proj["milestones_condensed"] = _derive_milestones_condensed(proj)
    # model_solution placeholder (never shown before pass)
    if "model_solution" not in proj:
        # use starter_snippet as seed; full solution is just starter + note
        proj["model_solution"] = proj.get("starter_snippet") or proj.get("starter_code") or "# See Solution Review after you pass."
    if "review_points" not in proj:
        # review checklist: what to verify in Solution Review
        exp = ""
        for s in proj.get("steps", []):
            if str(s).lower().startswith("expected"):
                exp = str(s)
                break
        proj["review_points"] = [
            "Runs without errors and prints labeled output",
            "Uses the Required Concepts for this level",
            "Covers every Requirement above (no missing piece)",
            exp or "Output matches the Expected line from Milestones",
        ]
    return proj


def project_variant_key(level, lesson_idx):
    return f"{level}_{lesson_idx}_variant"

def get_project_variant_index(progress, level, lesson_idx, pool_size):
    """Which variant is active for this lesson? Persists choice so the project is stable until you rotate."""
    if pool_size <= 1:
        return 0
    key = project_variant_key(level, lesson_idx)
    idx = progress.get("project_variant_choices", {}).get(key)
    if isinstance(idx, int) and 0 <= idx < pool_size:
        return idx
    # Deterministic pick seeded by lesson so each lesson starts on a different variant (not all 0)
    try:
        seed = hash((level, lesson_idx)) % 100000
        rnd = random.Random(seed)
        idx = rnd.randrange(pool_size)
    except Exception:
        idx = lesson_idx % pool_size
    # persist
    progress.setdefault("project_variant_choices", {})[key] = idx
    return idx

def set_project_variant_index(progress, level, lesson_idx, idx, pool_size):
    if pool_size <= 1:
        return
    idx = int(idx) % pool_size
    progress.setdefault("project_variant_choices", {})[project_variant_key(level, lesson_idx)] = idx

def rotate_project_variant(progress, level, lesson_idx, pool_size):
    if pool_size <= 1:
        return 0
    cur = get_project_variant_index(progress, level, lesson_idx, pool_size)
    nxt = (cur + 1) % pool_size
    set_project_variant_index(progress, level, lesson_idx, nxt, pool_size)
    # also reset hints/fail counts so new variant feels fresh
    hk = project_hint_key(level, lesson_idx)
    progress.get("project_hints", {}).pop(hk, None)
    progress.get("project_fail_counts", {}).pop(hk, None)
    return nxt

# Hand-crafted distinct variant seeds per lesson type — keeps each variant’s narrative truly different
_ALT_CONTEXTS = [
    "A community library needs the same feature for its catalog system",
    "A local sports club wants it for its roster dashboard",
    "A small bakery asks for it for its daily inventory",
    "A school science fair needs it for its entry tracker",
    "A neighborhood help desk needs it for its ticket queue",
]

def _make_variant_project(base_proj, lesson, variant_idx):
    """Copy base project but swap narrative so the code task stays same but the story is fresh."""
    import copy as _cp
    var = _cp.deepcopy(base_proj)
    # Keep check, steps, starter_code identical so autograder still works — only narrative changes
    suffix = chr(65 + variant_idx)  # A, B, C
    if variant_idx == 0:
        return var
    # Distinct title per variant
    var["title"] = f"{base_proj.get('title','Project')} — Variant {suffix}"
    # Distinct scenario: prepend alt context + keep original scenario’s second sentence if possible
    base_scen = base_proj.get("scenario", "")
    alt_ctx = _ALT_CONTEXTS[(hash(lesson.get('title','')) + variant_idx) % len(_ALT_CONTEXTS)]
    # Make scenario distinct but still clearly describes same technical task
    if base_scen:
        # Use first sentence of base as technical core, prepend alt context
        var["scenario"] = f"{alt_ctx}. {base_scen}"
    else:
        var["scenario"] = alt_ctx + "."
    # Distinct description tweak
    base_desc = base_proj.get("description", "")
    if variant_idx == 1:
        var["description"] = base_desc + " (Variant B: different client, same skills — adapt your plan.)"
    elif variant_idx == 2:
        var["description"] = base_desc + " (Variant C: another context — prove you can transfer the pattern.)"
    # Hint tweak: prepend variant note to Hint 1 so hints don’t feel copy-pasted
    try:
        hl = var.get("hint_levels") or []
        if hl:
            hl[0] = dict(hl[0])
            hl[0]["text"] = f"[Variant {suffix}] " + hl[0].get("text","")
            var["hint_levels"] = hl
    except Exception:
        pass
    # Keep model_solution and review_points same — task identical
    return var

def _ensure_project_variants(lesson):
    """Ensure lesson has 2-3 distinct variants (different story, same check). Returns list."""
    base = lesson.get("final_project")
    if not isinstance(base, dict):
        return []
    if "project_variants" in lesson and isinstance(lesson["project_variants"], list) and len(lesson["project_variants"]) >= 2:
        return lesson["project_variants"]
    # Build 3 variants (A=base, B, C)
    # Enrich base first if not already
    try:
        enrich_project_with_guidance(lesson, base)
    except Exception:
        pass
    variants = [base]
    for idx in (1, 2):
        try:
            var = _make_variant_project(base, lesson, idx)
            # Enrich variant as well (inherits guidance)
            enrich_project_with_guidance(lesson, var)
            variants.append(var)
        except Exception:
            continue
    lesson["project_variants"] = variants
    return variants

def get_active_project_variant(lesson, progress, level, lesson_idx):
    """Return the active variant dict for this lesson (different project each time you rotate)."""
    variants = lesson.get("project_variants")
    if not variants:
        variants = _ensure_project_variants(lesson)
    if not variants:
        return lesson.get("final_project")
    idx = get_project_variant_index(progress, level, lesson_idx, len(variants))
    try:
        return variants[idx]
    except Exception:
        return variants[0]

def apply_guidance_enrichment(lesson_sets):
    """Walk all lesson_sets and enrich every final_project with guidance fields + distinct variants."""
    for lvl, lessons in (lesson_sets or {}).items():
        for les in lessons:
            proj = les.get("final_project")
            if isinstance(proj, dict):
                try:
                    enrich_project_with_guidance(les, proj)
                except Exception:
                    continue
                # Also ensure 2-3 distinct variants per lesson so it’s not the same project every time
                try:
                    _ensure_project_variants(les)
                    # Enrich each variant too
                    for var in les.get("project_variants", []):
                        try:
                            enrich_project_with_guidance(les, var)
                        except Exception:
                            continue
                except Exception:
                    continue
    return lesson_sets


def record_attempt(progress, level, lesson_idx, success):
    key = attempt_key(level, lesson_idx)
    attempts = progress.get("code_check_attempts", {})
    if key not in attempts:
        attempts[key] = []
    attempts[key].append(success)
    progress["code_check_attempts"] = attempts
    log = progress.get("performance_log", {})
    if key not in log:
        log[key] = {"first_try": False, "project_passed": False}
    if success and not log[key]["first_try"] and len(attempts[key]) == 1:
        log[key]["first_try"] = True
    progress["performance_log"] = log


def record_project_pass(progress, level, lesson_idx):
    key = attempt_key(level, lesson_idx)
    log = progress.get("performance_log", {})
    if key not in log:
        log[key] = {"first_try": False, "project_passed": False}
    if log[key].get("project_passed"):
        return False
    log[key]["project_passed"] = True
    progress["performance_log"] = log
    return True


def assess_performance(progress, level, lesson_sets):
    lessons = lesson_sets.get(level, [])
    completed = list(progress.get("completed_lessons", []))
    log = progress.get("performance_log", {})

    recent_indices = [i for i in completed if i < len(lessons)][-2:]
    if len(recent_indices) < 2:
        return None, None, 0

    first_try_count = 0
    total_recent = len(recent_indices)
    for idx in recent_indices:
        key = attempt_key(level, idx)
        if log.get(key, {}).get("first_try", False):
            first_try_count += 1

    ratio = first_try_count / total_recent if total_recent else 0
    if ratio >= 1.0:
        suggestion = "up"
        reason = f"You passed {first_try_count}/{total_recent} recent lessons on your first try!"
    elif ratio <= 0.3 and total_recent >= 2:
        suggestion = "stay"
        reason = "You needed a few attempts on recent lessons. Reviewing helps solidify knowledge."
    else:
        return None, None, 0

    level_order = ["Beginner", "Intermediate", "Advanced"]
    current_idx = level_order.index(level) if level in level_order else 0
    if suggestion == "up" and current_idx >= len(level_order) - 1:
        return None, None, 0

    return suggestion, reason, first_try_count


def evaluate_code_attempt(code, lesson):
    stripped = code.strip()
    if not stripped:
        return False, "Type something first so I can check your code."

    lesson_title = lesson.get("title", "")
    if lesson_title == "Built-in functions":
        if "print(" in stripped and "len(" in stripped:
            return True, "Excellent! You combined print() and len() to display output and count items."
        return False, "Try using print() to show a value, then len() to count how many characters it has."

    if lesson_title == "Python keywords":
        if "for" in stripped and "print(" in stripped:
            return True, "Perfect! Your for loop repeats code automatically without rewriting the same lines."
        return False, "Try writing a for loop with range() or a list, then print inside it to see each iteration."

    if lesson_title == "Strings and methods":
        if ".upper(" in stripped or ".lower(" in stripped:
            return True, "Great! String methods transform text without changing the original string."
        return False, "Try calling .upper() or .lower() on a string variable to transform it."

    if lesson_title == "Lists and ranges":
        if "[" in stripped and ("for" in stripped or "range(" in stripped):
            return True, "Awesome! Lists store multiple values in order. Combined with loops, you can process each item."
        return False, "Try creating a list with [1, 2, 3] and looping through it with for or range()."

    if lesson_title == "Functions and returns":
        if "def " in stripped and "return" in stripped:
            return True, "Perfect! Functions with return values are reusable building blocks for your code."
        return False, "Try writing a function with def, give it a parameter, and return a calculated result."

    if lesson_title == "Dictionaries":
        if "{" in stripped and ":" in stripped:
            return True, "Excellent! Dictionaries map keys to values for fast lookups by label."
        return False, "Try creating a dictionary with {'key': 'value'} pairs and access it with dict['key']."

    if lesson_title == "Standard library modules":
        if "import " in stripped:
            return True, "Great! You imported a module. The standard library has tools for math, dates, files, and more."
        return False, "Try importing math or random with `import math` and then use a function like math.sqrt()."

    if lesson_title == "Classes and objects":
        if "class " in stripped and "self" in stripped:
            return True, "Perfect! Classes define blueprints for objects. 'self' refers to each object's own data."
        return False, "Try creating a class with def __init__(self, name) and store the name in self."

    if lesson_title == "File handling":
        if "open(" in stripped and "write" in stripped:
            return True, "Excellent! File I/O lets your program save data that persists after it closes."
        return False, "Try using open('filename.txt', 'w') with a `with` block and call file.write()."

    if lesson_title == "Variables and numbers":
        if "=" in stripped and ("+" in stripped or "*" in stripped) and "print(" in stripped:
            return True, "Great! You stored values in variables and used arithmetic to compute and print a result."
        return False, "Create a variable with =, add or multiply numbers, then print() the result."

    if lesson_title == "Conditionals and decisions":
        if "if " in stripped and "print(" in stripped and any(op in stripped for op in (">=", ">", "<", "==")):
            return True, "Perfect! Your if statement decides what to run based on a comparison."
        return False, "Write if <condition>: then print() a message on an indented line."

    if lesson_title == "Sets and tuples":
        if ("(" in stripped or "{" in stripped) and "print(" in stripped:
            return True, "Great! You created a tuple or set and printed its values."
        return False, "Create a tuple with () or a set with {}, then print() it."

    if lesson_title == "Nested loops and data":
        if stripped.count("for ") >= 2 and "print(" in stripped:
            return True, "Perfect! Your nested loops walk through rows and cells of a grid."
        return False, "Write an outer for loop over rows and an inner for loop over cells, then print() inside."

    if lesson_title == "Exception handling":
        if "try:" in stripped and "except" in stripped and "print(" in stripped:
            return True, "Great! You caught an error with try/except so the program keeps running."
        return False, "Wrap risky code in a try: block and handle the error in an except: block with print()."

    if lesson_title == "JSON files":
        if "json" in stripped and "open(" in stripped and ("dump" in stripped or "load" in stripped):
            return True, "Excellent! You saved or loaded structured data with the json module."
        return False, "Import json, open a file, and call json.dump() or json.load()."

    if lesson_title == "List comprehensions":
        if "[" in stripped and "for " in stripped and "][0]" not in stripped:
            return True, "Perfect! A list comprehension built a new list compactly in one line."
        return False, "Write a list comprehension like [expression for item in sequence]."

    if lesson_title == "GUIs with tkinter":

}

def _default_progress_path():
    root = Path(os.environ.get("APPDATA", Path.home()))
    folder = root / "PythonLearningCoach"
    folder.mkdir(parents=True, exist_ok=True)
    return folder / "learning_progress.json"


PROGRESS_FILE = _default_progress_path()


AUTOSAVE_INTERVAL_MS = 10000  # was 30000 – now 10s for extra safety (still light)


def _enable_dpi_awareness():
    """Ask Windows to render at the display's real pixel density.

    Without this, tkinter apps get scaled up by Windows and look blurry on
    high-resolution laptops. Making the process DPI-aware keeps text crisp.
    """
    try:
        import ctypes
        try:
            ctypes.windll.shcore.SetProcessDpiAwareness(1)
        except (AttributeError, OSError):
            ctypes.windll.user32.SetProcessDPIAware()
    except Exception:
        pass


# ── Auto-update helpers (dev mode) ────────────────────────────────────────────
def _is_frozen():
    """True when running as a PyInstaller exe (dist/PythonLearningCoach/LearnPython.exe)."""
    return bool(getattr(sys, "frozen", False))

def _dev_watched_paths():
    """Files that trigger in-app hot-reload when running from source (python learn_python_gui.py)."""
    base = Path(__file__).resolve().parent
    candidates = [
        base / "learn_python_gui.py",
        base / "lesson_data.py",
        base / "languages" / "python" / "lessons.py",
        base / "languages" / "java" / "lessons.py",
    ]
    # Also include any languages/*/lessons.py discovered dynamically
    try:
        for p in (base / "languages").glob("*/lessons.py"):
            if p not in candidates:
                candidates.append(p)
    except Exception:
        pass
    # Data json changes don't need code reload but sandbox could reflect; include for toast
    for name in DATASET_FILES:
        candidates.append(base / "data" / name)
    return [p for p in candidates if p.exists() or p.parent.exists()]

def _snapshot_mtimes(paths):
    snap = {}
    for p in paths:
        try:
            if p.is_file():
                snap[p] = p.stat().st_mtime_ns
        except OSError:
            continue
    return snap

def _maybe_spawn_background_watcher():
    """Auto-spawn watch_build.py so dist/ stays up to date whenever you save.

    Now automatic when running from source (python learn_python_gui.py) - you
    don't need --watch anymore. Pass --no-watch to disable if you want GUI-only.
    The watcher rebuilds dist/PythonLearningCoach/LearnPython.exe in background
    on every .py / data/*.json save (close the exe first so Windows can overwrite it).

    Hot-reload (in-app, 1.5s poll) already live-updates lesson_data + languages/*/lessons.py
    without restart; the background watcher handles the frozen exe.
    """
    if _is_frozen():
        return None
    # Opt-out flag
    for a in sys.argv[1:]:
        if a in ("--no-watch", "--no-auto-update"):
            return None
    # If dev.py already started a watcher, don't start a second one
    if os.environ.get("PYTHONLEARNING_WATCHER_EXTERNAL") == "1":
        return None
    # Opt-in or auto-enable for dev runs
    want = False
    # Explicit flags still work
    for a in sys.argv[1:]:
        if a in ("--watch", "--dev", "--auto-update"):
            want = True
            break
    if os.environ.get("PYTHONLEARNING_DEV_WATCH") == "1":
        want = True
    # Auto-enable by default when running from source (the common dev case)
    # This makes "python learn_python_gui.py" automatically keep dist/ fresh.
    if not want:
        # If we're not frozen and not explicitly opted out, auto-enable
        want = True
    if not want:
        return None
    watch_script = Path(__file__).resolve().parent / "watch_build.py"
    if not watch_script.is_file():
        return None
    # Avoid spawning multiple watchers if one already running (check via lock file)
    try:
        # Use subprocess Popen detached
        creationflags = 0
        if sys.platform.startswith("win"):
            creationflags = subprocess.CREATE_NEW_CONSOLE if hasattr(subprocess, "CREATE_NEW_CONSOLE") else 0
        proc = subprocess.Popen(
            [sys.executable, str(watch_script)],
            cwd=str(watch_script.parent),
            creationflags=creationflags,
        )
        return proc
    except Exception:
        return None

_HOT_RELOAD_POLL_MS = 1500  # how often the in-app checker polls lesson files

def save_progress(path, progress):
    """Persist progress to disk.

    The write is atomic: it first writes to a temp file, then replaces the
    real file, so a crash or power-loss mid-save can never corrupt or wipe the
    saved progress. The containing folder is created if needed. Also keeps a
    .bak copy for extra recovery.
    """
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(progress, indent=2), encoding="utf-8")
    os.replace(tmp, path)
    # Extra safety: keep a .bak copy (tiny, overwritten each save)
    try:
        bak = path.with_suffix(path.suffix + ".bak")
        bak.write_text(json.dumps(progress, indent=2), encoding="utf-8")
    except Exception:
        pass


def load_progress(path):
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {}



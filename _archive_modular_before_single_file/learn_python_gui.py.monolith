        "desc": "Rolls a random 14-character password from letters, numbers, and symbols. Great for learning random and string modules.",
        "fun": "Now try: guarantee at least one of each type, make a passphrase from random words, or check strength.",
        "starter": "import random\nimport string\n\nlength = 14\nchars = string.ascii_letters + string.digits + '!@#$%^&*'\npassword = ''.join(random.choice(chars) for _ in range(length))\nprint(f'New password: {password}')\nprint(f'Length: {len(password)}')\n",
    },
    {
        "category": "tricks", "emoji": "\U0001F437", "title": "Pig Latin Translator",
        "difficulty": 1,
        "desc": "Shifts each word into pig latin: consonants move to the back plus 'ay', vowels get 'way'. owhay sihtiay.",
        "fun": "Now try: translate whole sentences, shout every word ending in 'ay', or handle punctuation.",
        "starter": "phrase = 'python is really fun to code'\nwords = phrase.split()\nout = []\nfor word in words:\n    if word[0] in 'aeiou':\n        out.append(word + 'way')\n    else:\n        out.append(word[1:] + word[0] + 'ay')\nprint(' '.join(out))\n",
    },
    {
        "category": "tricks", "emoji": "\U0001F510", "title": "Caesar Cipher",
        "difficulty": 2,
        "desc": "Shifts every letter by a key. Print the same message at three keys and see how the meaning wobbles in and out of view.",
        "fun": "Now try: brute-force all 26 keys, only shift letters inside a word, or add a decode() that reverses it.",
        "starter": "def shift(text, n):\n    result = []\n    for ch in text:\n        if ch.isalpha():\n            base = ord('A') if ch.isupper() else ord('a')\n            result.append(chr((ord(ch) - base + n) % 26 + base))\n        else:\n            result.append(ch)\n    return ''.join(result)\n\nmessage = 'Hello, Python!'\nfor key in range(1, 4):\n    print(f'key {key}: {shift(message, key)}')\n",
    },
    {
        "category": "tricks", "emoji": "\U0001F4DC", "title": "Text Wrapper",
        "difficulty": 1,
        "desc": "Feeds one long speech into textwrap and pours it out at two different widths. See line-wrapping in action.",
        "fun": "Now try: center the wrapped lines, turn it into a newsletter, or count characters per line.",
        "starter": "import textwrap\n\nspeech = ('The secret to every great program is the same as a great sandwich: '\n          'good layers. Slice the problem one line at a time and even the '\n          'toughest project becomes easy to eat.')\nprint('Narrow (20 chars):')\nprint(textwrap.fill(speech, width=20))\nprint()\nprint('Wide (45 chars):')\nprint(textwrap.fill(speech, width=45))\n",
    },
    # ---------------- Real Tools ----------------
    {
        "category": "tools", "emoji": "\U0001F9FE", "title": "Split the Bill",
        "difficulty": 2,
        "desc": "Grabs a random dinner bill, adds a 20% tip, and splits it exactly between four diners using exact rational fractions.",
        "fun": "Now try: let each person order a different amount, round to cents for cash, or add a discount coupon.",
        "starter": "from fractions import Fraction\nimport random\n\nbill = Fraction(random.randint(40, 90), 1)\ntip = bill + bill * Fraction(20, 100)\npeople = ['Ada', 'Lin', 'Kai', 'Zoe']\nshare = tip / len(people)\nprint(f'Dinner bill: ${float(bill):.2f} plus 20% tip')\nprint(f'Each of the {len(people)} diners pays ${float(share):.2f}')\n",
    },
    {
        "category": "tools", "emoji": "\U0001F4CA", "title": "Stats-Bot",
        "difficulty": 1,
        "desc": "Computes mean, median, mode, and standard deviation of a class test-score list using the statistics module.",
        "fun": "Now try: drop the lowest score first, generate the scores randomly, or add the range (max - min).",
        "starter": "import statistics\n\nscores = [88, 92, 75, 90, 88, 77, 95]\nprint('Scores:', scores)\nprint('Mean:  ', statistics.mean(scores))\nprint('Median:', statistics.median(scores))\nprint('Mode:  ', statistics.mode(scores))\nprint('Stdev: ', round(statistics.stdev(scores), 2))\n",
    },
    {
        "category": "tools", "emoji": "\U0001F5D3\uFE0F", "title": "100-Day Date Detective",
        "difficulty": 1,
        "desc": "Uses datetime to show today's date and jump 100 and 1000 days into the future with readable day names.",
        "fun": "Now try: find the next Friday the 13th, days until your birthday, or which weekday you were born on.",
        "starter": "from datetime import date, timedelta\n\ntoday = date.today()\nprint('Today:', today.strftime('%A, %B %d, %Y'))\nprint('+100 days:', (today + timedelta(days=100)).strftime('%A, %B %d, %Y'))\nprint('+1000 days:', (today + timedelta(days=1000)).strftime('%A, %B %d, %Y'))\n",
    },
    {
        "category": "tools", "emoji": "\U0001F4F0", "title": "Top Word Counter",
        "difficulty": 2,
        "desc": "Splits a news sentence into words, lowercases them, and uses collections.Counter to rank the most frequent.",
        "fun": "Now try: paste in a whole paragraph, ignore tiny filler words, or make a bar chart of the top words.",
        "starter": "from collections import Counter\nimport re\n\ntext = ('the quick brown fox jumps over the lazy dog '\n        'and then the dog chases the fox again')\nwords = re.findall(r'\\w+', text.lower())\nprint('Top 5 words:')\nfor word, count in Counter(words).most_common(5):\n    print(f'  {word}: {count}')\n",
    },
    # ---------------- Additional starters (requested: quiz, to-do, calculator) ----------------
    {
        "category": "games", "emoji": "\U0001F9E0", "title": "Quiz Game",
        "difficulty": 2,
        "desc": "A 5-question quiz that shuffles, asks, and scores. Uses lists of dicts and input-style hardcoded answers.",
        "fun": "Now try: add a timer, load questions from a file, or let the player add their own questions.",
        "sample_io": "Q1: What is 2+2? -> 4\nQ2: Capital of France? -> Paris\nScore: 4/5",
        "starter": "questions = [\n    {\"q\": \"What is 2+2?\", \"a\": \"4\"},\n    {\"q\": \"Capital of France?\", \"a\": \"Paris\"},\n    {\"q\": \"Python keyword to define function?\", \"a\": \"def\"},\n    {\"q\": \"What does len([1,2,3]) return?\", \"a\": \"3\"},\n    {\"q\": \"Which loop repeats while True?\", \"a\": \"while\"},\n]\nimport random\nrandom.shuffle(questions)\nscore = 0\nfor i, item in enumerate(questions, 1):\n    # In playground we hardcode answers; in real app you'd use input()\n    guess = item[\"a\"]  # pretend input\n    print(f\"Q{i}: {item['q']}\")\n    print(f\"  Your answer: {guess}\")\n    if guess.strip().lower() == item[\"a\"].lower():\n        score += 1\n        print(\"  Correct!\")\n    else:\n        print(f\"  Wrong, was {item['a']}\")\nprint(f\"\\nScore: {score}/{len(questions)}\")\n",
    },
    {
        "category": "tools", "emoji": "\u2705", "title": "To-Do List",
        "difficulty": 1,
        "desc": "A tiny to-do list: add, list, and check off tasks using list methods.",
        "fun": "Now try: save to a file, add due dates, or sort by priority.",
        "sample_io": "Tasks: Buy milk, Code 30 min, Walk dog\nDone: Code 30 min -> 2 remaining",
        "starter": "tasks = [\"Buy milk\", \"Code 30 min\", \"Walk dog\"]\nprint(\"Tasks:\")\nfor i, t in enumerate(tasks, 1):\n    print(f\"{i}. [ ] {t}\")\n# mark one done\ntasks[1] = \"[x] \" + tasks[1]\nprint(\"\\nAfter completing one:\")\nfor i, t in enumerate(tasks, 1):\n    print(f\"{i}. {t}\")\nprint(f\"\\n{sum('[' not in t for t in tasks)} remaining\")\n",
    },
    {
        "category": "tools", "emoji": "\U0001F9EE", "title": "Mini Calculator",
        "difficulty": 1,
        "desc": "A calculator that handles +, -, *, / and shows formatted results. Uses functions and error handling.",
        "fun": "Now try: add power **, handle divide-by-zero gracefully, or loop until the user types quit.",
        "sample_io": "3 + 4 = 7\n10 / 2 = 5.0\n5 * 6 = 30",
        "starter": "def calc(a, op, b):\n    if op == '+': return a + b\n    if op == '-': return a - b\n    if op == '*': return a * b\n    if op == '/': return a / b\n    return None\n\ntests = [(3, '+', 4), (10, '/', 2), (5, '*', 6), (9, '-', 3)]\nfor a, op, b in tests:\n    try:\n        print(f\"{a} {op} {b} = {calc(a, op, b)}\")\n    except ZeroDivisionError:\n        print(f\"{a} {op} {b} = Error (divide by zero)\")\n",
    },
]

# Backfill sample I/O for older projects without it (so every card shows preview)
for _pr in SANDBOX_PROJECTS:
    if "sample_io" not in _pr:
        # Use first line of desc as fallback preview if no explicit sample
        _pr["sample_io"] = "Run to see output — try changing a value and rerunning."


SANDBOX_PROJECTS_JAVA = [{'category': 'games', 'emoji': '🎯', 'title': 'Guess My Number (Java)', 'difficulty': 1, 'desc': 'Computer picks 1-50 and binary-searches it. Watch Java nail it in ≤6 guesses.', 'fun': 'Now try: change 50 to 500, print low/high each turn, or count average guesses over 1000 runs.', 'starter': 'import java.util.Random;\npublic class Main {\n    public static void main(String[] args) {\n        Random r = new Random();\n        int target = r.nextInt(50) + 1;\n        int low = 1, high = 50, guesses = 0;\n        while (low <= high) {\n            guesses++;\n            int guess = (low + high) / 2;\n            System.out.println("Guess #" + guesses + ": " + guess);\n            if (guess == target) { System.out.println("Found " + target + " in " + guesses + " guesses!"); break; }\n            else if (guess < target) low = guess + 1;\n            else high = guess - 1;\n        }\n    }\n}\n'}, {'category': 'games', 'emoji': '✂️', 'title': 'Rock-Paper-Scissors (Java)', 'difficulty': 1, 'desc': '12 rounds of Java Rock-Paper-Scissors vs the bot. Random picks, beats map, score track.', 'fun': 'Now try: add Lizard/Spock, track longest streak, or stop when someone leads by 3.', 'starter': 'import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        String[] moves = {"Rock","Paper","Scissors"};\n        Map<String,String> beats = Map.of("Rock","Scissors","Paper","Rock","Scissors","Paper");\n        String[] you = {"Rock","Paper","Scissors","Rock","Paper","Scissors","Rock","Paper","Scissors","Rock","Paper","Scissors"};\n        int youWins=0, botWins=0; Random r=new Random();\n        for(String my: you){ String bot=moves[r.nextInt(3)]; System.out.println("You: "+my+" vs Bot: "+bot); if(beats.get(my).equals(bot)){youWins++; System.out.println("  You win!");} else if(beats.get(bot).equals(my)){botWins++; System.out.println("  Bot wins!");} else System.out.println("  Tie.");}\n        System.out.println("Final - You: "+youWins+" Bot: "+botWins);\n    }\n}\n'}, {'category': 'games', 'emoji': '🎰', 'title': 'Slot Machine (Java)', 'difficulty': 1, 'desc': 'Spin 3 reels 5 times. Jackpot on triple match +5 coins, else -1.', 'fun': 'Now try: add 7 that pays triple, count diagonal wins, or spin until bank 0.', 'starter': 'import java.util.Random;\npublic class Main {\n    public static void main(String[] args) {\n        Random r=new Random(); int bank=10;\n        for(int spin=0; spin<5; spin++){ int a=r.nextInt(10), b=r.nextInt(10), c=r.nextInt(10);\n            if(a==b && b==c){ bank+=5; System.out.println("Spin "+(spin+1)+": ["+a+" "+b+" "+c+"] JACKPOT! bank="+bank);}\n            else{ bank-=1; System.out.println("Spin "+(spin+1)+": ["+a+" "+b+" "+c+"] no luck, bank="+bank);}\n        }\n    }\n}\n'}, {'category': 'stories', 'emoji': '📖', 'title': 'Mad Libs (Java)', 'difficulty': 1, 'desc': 'Random nouns/adjectives/places stitch 3 silly stories. Java Random + String.format.', 'fun': 'Now try: add verbs, make 2-paragraph story, or add titles.', 'starter': 'import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        String[] names={"Ada","Lin","Kai","Zoe"}; String[] adjs={"grumpy","sparkling","gigantic","sneaky"};\n        String[] things={"laser pointer","guitar","goldfish","rocket"}; String[] places={"a pirate ship","the moon","an old library","the kitchen"};\n        Random r=new Random();\n        for(int i=0;i<3;i++){\n            System.out.println("Once upon a time, "+names[r.nextInt(names.length)]+" the "+adjs[r.nextInt(adjs.length)]);\n            System.out.println("  carried "+things[r.nextInt(things.length)]+" into "+places[r.nextInt(places.length)]+"."); System.out.println();\n        }\n    }\n}\n'}, {'category': 'stories', 'emoji': '🤖', 'title': 'Robot Diner (Java)', 'difficulty': 2, 'desc': 'Customers complain, robot waiter replies from a bank. Java Map for keyword replies.', 'fun': 'Now try: match keyword to reply, add noise, or make robot crack.', 'starter': 'import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        String[] customers={"We ordered ten minutes ago!","Is this decaf?","Extra pickles?","Invisible donuts?"};\n        String[] replies={"Kitchen is busy!","Experimental decaf only.","Checking pickle reserve.","Invisible donuts are popular."};\n        Random r=new Random();\n        for(String line: customers){ System.out.println("Customer: "+line); System.out.println("WaiterBot: "+replies[r.nextInt(replies.length)]); System.out.println(); }\n    }\n}\n'}, {'category': 'math', 'emoji': '🔢', 'title': 'Fibonacci (Java)', 'difficulty': 1, 'desc': 'Java Fibonacci: a,b = 0,1 loop 15. Classic recursion gateway.', 'fun': 'Now try: print evens only, go backwards from 610, or fib(n) method.', 'starter': 'public class Main {\n    public static void main(String[] args) {\n        int a=0,b=1;\n        for(int i=0;i<15;i++){ System.out.print(a+"  "); int next=a+b; a=b; b=next; }\n        System.out.println(""); System.out.println("Fibonacci done.");\n    }\n}\n'}, {'category': 'math', 'emoji': '🔍', 'title': 'Prime Hunt (Java)', 'difficulty': 2, 'desc': 'Sieve of Eratosthenes to 60 in Java. Cross multiples, keep primes.', 'fun': 'Now try: 5 per row, last prime before 1000, or twin primes.', 'starter': 'import java.util.*;\npublic class Main {\n    public static void main(String[] args) {\n        int limit=60; int[] nums=new int[limit+1]; for(int i=0;i<=limit;i++) nums[i]=i; nums[0]=0; nums[1]=0;\n        for(int i=2;i*i<=limit;i++) if(nums[i]!=0) for(int j=i*i;j<=limit;j+=i) nums[j]=0;\n        System.out.print("Primes up to 60: "); for(int n: nums) if(n!=0) System.out.print(n+" "); System.out.println();\n    }\n}\n'}, {'category': 'math', 'emoji': '🌀', 'title': 'Collatz (Java)', 'difficulty': 3, 'desc': 'Collatz: halve even, 3n+1 odd. Watch 27 hit 1 in 111 steps (Java).', 'fun': 'Now try: longest chain under 100, or table of steps.', 'starter': 'public class Main {\n    public static void main(String[] args) {\n        int n=27, steps=0; System.out.println("Collatz from 27:");\n        while(n!=1){ System.out.print(n+" -> "); n=(n%2==0)? n/2 : n*3+1; steps++; }\n        System.out.println(1); System.out.println(steps+" steps to 1.");\n    }\n}\n'}, {'category': 'tricks', 'emoji': '🔐', 'title': 'Caesar Cipher (Java)', 'difficulty': 2, 'desc': 'Shift letters by key in Java. Print at 3 keys, see meaning wobble.', 'fun': 'Now try: brute-force 26 keys, decode, or shift only inside words.', 'starter': 'public class Main {\n    static String shift(String text,int n){ StringBuilder sb=new StringBuilder(); for(char ch: text.toCharArray()){ if(Character.isLetter(ch)){ char base=Character.isUpperCase(ch)?\'A\':\'a\'; sb.append((char)((ch-base+n)%26+base)); } else sb.append(ch); } return sb.toString(); }\n    public static void main(String[] args){ String msg="Hello, Java!"; for(int k=1;k<4;k++) System.out.println("key "+k+": "+shift(msg,k)); }\n}\n'}, {'category': 'tricks', 'emoji': '🛡️', 'title': 'Password Forge (Java)', 'difficulty': 1, 'desc': 'Random 14-char password from letters+digits+symbols in Java.', 'fun': 'Now try: guarantee one of each type, passphrase from words, or strength check.', 'starter': 'import java.util.Random;\npublic class Main {\n    public static void main(String[] args){ String chars="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*"; Random r=new Random(); StringBuilder sb=new StringBuilder(); for(int i=0;i<14;i++) sb.append(chars.charAt(r.nextInt(chars.length()))); System.out.println("Password: "+sb); System.out.println("Length: "+sb.length()); }\n}\n'}, {'category': 'tools', 'emoji': '🗓️', 'title': 'Date Detective (Java)', 'difficulty': 1, 'desc': 'java.time shows today, +100 and +1000 days with day names (Java).', 'fun': 'Now try: next Friday 13th, days until birthday, or weekday born.', 'starter': 'import java.time.*;\npublic class Main {\n    public static void main(String[] args){ LocalDate today=LocalDate.now(); System.out.println("Today: "+today+" "+today.getDayOfWeek()); System.out.println("+100: "+today.plusDays(100)+" "+today.plusDays(100).getDayOfWeek()); System.out.println("+1000: "+today.plusDays(1000)); }\n}\n'}, {'category': 'tools', 'emoji': '📊', 'title': 'Stats Bot (Java)', 'difficulty': 1, 'desc': 'Mean/median/mode via Java streams on a score list.', 'fun': 'Now try: drop lowest, random scores, or range (max-min).', 'starter': 'import java.util.*;\npublic class Main {\n    public static void main(String[] args){ List<Integer> scores=Arrays.asList(88,92,75,90,88,77,95); double mean=scores.stream().mapToInt(Integer::intValue).average().orElse(0); List<Integer> sorted=new ArrayList<>(scores); Collections.sort(sorted); double median=sorted.get(sorted.size()/2); System.out.println("Scores: "+scores); System.out.println("Mean: "+mean); System.out.println("Median: "+median); }\n}\n'}]


def _difficulty_dots(n):
    return "\u25CF" * n + "\u25CB" * (3 - n)


class SandboxPage(tk.Frame):
    """A free code playground with a Project Playground sidebar: ready-to-run
    starter projects across categories (games, stories, math, tricks, tools)
    so any kind of project is easy to jump into."""

    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller

    def refresh(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        p = self.controller.progress
        self.configure(bg=t["bg"])

        header = tk.Frame(self, bg=t["panel"], padx=SP["xl"], pady=SP["md"])
        header.pack(fill="x")
        # Language-aware playground header
        lang = current_language(p)
        meta = LANGUAGE_META.get(lang, LANGUAGE_META["python"]) if lang in SUPPORTED_LANGUAGES else LANGUAGE_META["python"]
        playground_title = f"\u2328  {meta['name']} Playground" if lang in SUPPORTED_LANGUAGES else "\u2328  Playground"
        playground_desc = f"A sandbox to experiment with {meta['name']} \u2014 nothing is graded. Pick a starter on the left or write your own, then run it." if lang in SUPPORTED_LANGUAGES else "A sandbox to experiment \u2014 nothing is graded. Pick a starter on the left or write your own, then run it."
        # Show JDK hint for Java if not available
        jdk_note = ""
        if lang == "java" and not _is_jdk_available():
            jdk_note = "  (Install JDK 17+ to run Java - checks still work)"
        tk.Label(header, text=playground_title, bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_md"]).pack(side="left")
        tk.Label(header, text=playground_desc + jdk_note,
                 bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"],
                 anchor="w").pack(side="left", padx=(SP["lg"], 0))

        body = tk.PanedWindow(self, orient="horizontal", sashwidth=3,
                              sashrelief="flat", bg=t["divider"])
        body.pack(fill="both", expand=True, padx=SP["xl"], pady=(SP["sm"], SP["sm"]))

        ideas = tk.Frame(body, bg=t["card"], width=340)
        body.add(ideas, width=340, minsize=280)

        right = tk.PanedWindow(body, orient="vertical", sashwidth=3,
                               sashrelief="flat", bg=t["divider"])
        body.add(right, minsize=340)

        top = tk.Frame(right, bg=t["bg"])
        right.add(top, height=260, minsize=150)
        bottom = tk.Frame(right, bg=t["bg"])
        right.add(bottom, height=160, minsize=110)

        # ---------- Project Playground (left panel) ----------
        tk.Label(ideas, text="\U0001F4A1  Project Playground", bg=t["card"], fg=t["text"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["md"], pady=(SP["md"], 0))
        tk.Label(ideas, text="Ready-to-run starters for any kind of project.",
                 bg=t["card"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(anchor="w", padx=SP["md"])

        cat_row = tk.Frame(ideas, bg=t["card"])
        cat_row.pack(fill="x", padx=SP["md"], pady=(SP["sm"], 0))
        self._selected_cat = tk.StringVar(value=SANDBOX_CATEGORIES[0][0])
        self._cat_by_key = {}
        for key, label in SANDBOX_CATEGORIES:
            b = tk.Button(cat_row, text=label, font=FONTS["button_sm"],
                          command=lambda k=key: self._pick_category(k, t))
            b.pack(side="left", padx=(0, SP["xs"]))
            self._cat_by_key[key] = b
        self._style_cats(t)

        self._proj_list = tk.Listbox(ideas, height=6, font=FONTS["body_sm"],
                                     bg=t["input_bg"], fg=t["text"], relief="solid", bd=1,
                                     highlightthickness=0, selectbackground=t["accent"],
                                     selectforeground="white", activestyle="none",
                                     exportselection=False)
        self._proj_list.pack(fill="x", padx=SP["md"], pady=(SP["sm"], 0))
        self._proj_list.bind("<<ListboxSelect>>", lambda _e: self._show_info(t))
        self._proj_list.bind("<Double-Button-1>", lambda _e: self._load_selected())

        self._info = tk.Text(ideas, height=8, font=FONTS["body_sm"], bg=t["card"],
                             fg=t["text_secondary"], relief="flat", wrap="word",
                             state="disabled", cursor="arrow")
        self._info.pack(fill="both", expand=True, padx=SP["md"], pady=(SP["sm"], 0))

        btn_row = tk.Frame(ideas, bg=t["card"])
        btn_row.pack(fill="x", padx=SP["md"], pady=(SP["sm"], SP["md"]))
        load_btn = tk.Button(btn_row, text="\u25B6 Load into Editor",
                             command=lambda: self._load_selected(),
                             font=FONTS["button_sm"], padx=SP["sm"], pady=SP["xs"])
        load_btn.pack(side="left")
        style_button(load_btn, t, "accent", "accent_hover")
        surprise_btn = tk.Button(btn_row, text="\U0001F3B2 Surprise Me",
                                 command=lambda: self._surprise(None, t),
                                 font=FONTS["button_sm"], padx=SP["sm"], pady=SP["xs"])
        surprise_btn.pack(side="left", padx=(SP["xs"], 0))
        style_button(surprise_btn, t, "secondary_btn_bg", "secondary_btn_hover")

        self._populate_list()
        self._show_info(t)

        # ---------- Editor (right, top) ----------
        tk.Label(top, text="Your Code", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=SP["sm"])

        editor = SyntaxEditor(top, theme=t, height=12, font=FONTS["code"],
                              bg=t["input_bg"], fg=t["text"], insertbackground=t["text"],
                              relief="solid", bd=1, undo=True, wrap="none")
        editor.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
        # Language-aware default: Java learners see a Java template, not Python
        _java_default = "public class Main {\n    public static void main(String[] args) {\n        System.out.println(\"Hello Java!\");\n        System.out.println(42);\n    }\n}\n"
        _starter = p.get("sandbox_code")
        if not _starter:
            _starter = _java_default if current_language(p) == "java" else SANDBOX_PROJECTS[0]["starter"]
        editor.set_code(_starter)
        # If the stored draft is Python but user switched to Java, keep draft as-is;
        # the highlight will auto-detect, and Run will dispatch to the right language.
        editor.attach_theme(t)
        self._editor = editor

        def save_draft():
            p["sandbox_code"] = editor.get("1.0", tk.END)
            # also save sandbox inputs if widget exists
            try:
                if hasattr(self, "_input_box") and self._input_box:
                    p["sandbox_inputs"] = self._input_box.get("1.0", tk.END).rstrip("\n")
            except Exception:
                pass
            save_progress(self.controller.progress_path, p)

        def save_draft_with_toast(_e=None):
            save_draft()
            try:
                show_toast(self.winfo_toplevel(), "Saved", t)
            except Exception:
                pass
            return "break"

        editor.bind("<KeyRelease>",
                    lambda _e: (self.controller.after(1500, save_draft), None)[1], add="+")
        editor.bind("<Control-s>", save_draft_with_toast)
        editor.bind("<Command-s>", save_draft_with_toast)

        # ---- Input for input() (one line per input() call) ----
        input_frame = tk.Frame(top, bg=t["bg"])
        input_frame.pack(fill="x", padx=SP["lg"], pady=(SP["xs"], 0))
        tk.Label(input_frame, text="Input for input()  (one line per call, optional):",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(anchor="w")
        input_box = tk.Text(input_frame, height=2, font=FONTS["code_sm"], bg=t["input_bg"],
                            fg=t["text"], relief="solid", bd=1, wrap="word")
        input_box.pack(fill="x", pady=(SP["xs"], 0))
        # preload saved inputs
        try:
            input_box.insert("1.0", p.get("sandbox_inputs", "") or "")
        except Exception:
            pass
        input_box.bind("<KeyRelease>", lambda _e: self.controller.after(800, save_draft), add="+")
        input_box.bind("<Control-s>", save_draft_with_toast)
        input_box.bind("<Command-s>", save_draft_with_toast)
        self._input_box = input_box

        btn_row2 = tk.Frame(top, bg=t["bg"])
        btn_row2.pack(fill="x", padx=SP["lg"], pady=(SP["sm"], SP["sm"]))
        tk.Label(btn_row2, text="Tip: Ctrl+Enter runs  •  Ctrl+S saves",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(side="left")

        # ---------- Output (right, bottom) ----------
        tk.Label(bottom, text="Output", bg=t["bg"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=SP["sm"])
        output_box = tk.Text(bottom, height=6, font=FONTS["code"], bg=t["code_bg"],
                             fg=t["text"], relief="solid", bd=1, wrap="word")
        output_box.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
        output_box.configure(state="disabled")

        def run_code():
            code = editor.get("1.0", tk.END)
            save_draft()
            # collect sandbox inputs if any
            inputs_val = ""
            try:
                if hasattr(self, "_input_box") and self._input_box:
                    inputs_val = self._input_box.get("1.0", tk.END).strip()
            except Exception:
                inputs_val = ""
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)
            if not code.strip():
                output_box.insert("1.0", "Type some code first, then hit Run.")
                output_box.configure(state="disabled")
                return
            output_box.insert("1.0", "Running...\n")
            self.update_idletasks()
            res = run_code_for_language(code, current_language(self.controller.progress), timeout=5, inputs=inputs_val if inputs_val else None)
            output_box.delete("1.0", tk.END)
            # Surface JDK-missing as a yellow note but keep the checker path open
            if res.get("jdk_missing") and res.get("warning"):
                output_box.insert("1.0", res["warning"] + "\n\n")
                try:
                    show_toast(self.winfo_toplevel(), "JDK not found - checked without compiling", t)
                except Exception:
                    pass
            if res["blocked"]:
                output_box.insert(tk.END, res["blocked"])
            elif not res["ok"]:
                shown = res["output"]
                if shown and res["error"]:
                    shown += "\n\n"
                # Use the coaching hint (explained) if available, it is clearer than raw javac
                detail = res.get("explained") or res["error"] or "(error)"
                # If we already printed output above for jdk_missing, don't duplicate
                if res.get("jdk_missing"):
                    output_box.insert(tk.END, detail)
                else:
                    output_box.insert("1.0" if not res.get("jdk_missing") else tk.END, shown + detail if shown else detail)
            else:
                body = res["output"] if res["output"].strip() else "(ran without errors \u2014 add a print() to see output)"
                if res.get("jdk_missing"):
                    output_box.insert(tk.END, body)
                else:
                    output_box.insert("1.0", body)
            output_box.configure(state="disabled")

        run_btn = tk.Button(btn_row2, text="\u25B6 Run Code", font=FONTS["button"],
                            command=run_code, padx=SP["lg"], pady=SP["md"])
        run_btn.pack(side="right")
        style_button(run_btn, t, "accent", "accent_hover")

        clear_btn = tk.Button(btn_row2, text="Clear", font=FONTS["button_sm"],
                              command=lambda: editor.set_code(""),
                              padx=SP["md"], pady=SP["xs"])
        clear_btn.pack(side="right", padx=(0, SP["sm"]))
        style_button(clear_btn, t, "secondary_btn_bg", "secondary_btn_hover")

        editor.bind("<Control-Return>", lambda _e: (run_code(), "break")[1])
        editor.bind("<Command-Return>", lambda _e: (run_code(), "break")[1])

    def _active_projects(self):
        try:
            lang = current_language(self.controller.progress) if hasattr(self.controller, "progress") else "python"
        except Exception:
            lang = "python"
        return SANDBOX_PROJECTS_JAVA if lang == "java" else SANDBOX_PROJECTS

    def _projects_in(self, cat):
        return [pr for pr in self._active_projects() if pr["category"] == cat]

    def _style_cats(self, t):
        for key, _label in SANDBOX_CATEGORIES:
            if key == self._selected_cat.get():
                style_button(self._cat_by_key[key], t, "accent", "accent_hover")
            else:
                style_button(self._cat_by_key[key], t, "secondary_btn_bg", "secondary_btn_hover")

    def _pick_category(self, key, t):
        self._selected_cat.set(key)
        self._style_cats(t)
        self._populate_list()
        self._show_info(t)

    def _populate_list(self):
        self._proj_list.delete(0, tk.END)
        for pr in self._projects_in(self._selected_cat.get()):
            self._proj_list.insert(tk.END, pr["emoji"] + "  " + pr["title"])
        if self._proj_list.size():
            self._proj_list.selection_clear(0, tk.END)
            self._proj_list.selection_set(0)
            self._proj_list.see(0)

    def _current_project(self):
        sel = self._proj_list.curselection()
        if not sel:
            return None
        items = self._projects_in(self._selected_cat.get())
        idx = sel[0]
        return items[idx] if idx < len(items) else None

    def _show_info(self, t):
        pr = self._current_project()
        self._info.configure(state="normal")
        self._info.delete("1.0", tk.END)
        if pr:
            self._info.insert(tk.END, pr["title"] + "   (" + _difficulty_dots(pr["difficulty"]) + ")\n\n")
            self._info.insert(tk.END, pr["desc"] + "\n\n")
            if pr.get("sample_io"):
                self._info.insert(tk.END, "SAMPLE OUTPUT\n")
                self._info.insert(tk.END, pr["sample_io"] + "\n\n")
            self._info.insert(tk.END, "MAKE IT YOURS\n")
            self._info.insert(tk.END, pr["fun"])
        else:
            self._info.insert(tk.END, "Pick a project to see its idea here.")
        self._info.configure(state="disabled")

    def _load_selected(self, pr=None):
        pr = pr or self._current_project()
        if pr is None:
            return
        editor = getattr(self, "_editor", None)
        if editor is not None:
            editor.set_code(pr["starter"])
            self.controller.after(1, lambda: editor.focus_set())

    def _surprise(self, editor, t):
        pr = random.choice(self._active_projects())
        self._selected_cat.set(pr["category"])
        self._style_cats(t)
        self._populate_list()
        items = self._projects_in(pr["category"])
        for i, item in enumerate(items):
            if item is pr:
                self._proj_list.selection_clear(0, tk.END)
                self._proj_list.selection_set(i)
                self._proj_list.see(i)
                break
        self._show_info(t)
        self._load_selected(pr)


class CoachPanel(tk.Frame):
    def __init__(self, parent, t, get_code, step, label, controller=None):
        super().__init__(parent, bg=t["panel"])
        self.t = t
        self.get_code = get_code
        self.step = step
        self.label = label
        self.controller = controller
        self.stage = 0
        self.shown = False
        self.quiz_item = None
        self.awaiting = None
        self.guided = None
        self.guided_idx = 0
        self.guided_answers = {}

        self.log = tk.Text(self, height=9, font=FONTS["code_sm"], bg=t["code_bg"],
                           fg=t["text"], relief="solid", bd=1, wrap="word", state="disabled")
        self.log.pack(fill="x", padx=SP["md"], pady=(SP["md"], SP["xs"]))

        chips = tk.Frame(self, bg=t["panel"])
        chips.pack(fill="x", padx=SP["md"])
        for text, kind in [
            ("\U0001F6E0 Why is this wrong?", "diagnose"),
            ("\U0001F4A1 Hint", "hint"),
            ("\U0001F914 I'm stuck", "stuck"),
            ("\u270F\uFE0F Quiz me", "quiz"),
            ("\U0001F9ED Guided help", "guided"),
        ]:
            b = tk.Button(chips, text=text, command=lambda k=kind: self.ask(k),
                          font=FONTS["button_sm"], padx=SP["sm"], pady=SP["xs"])
            b.pack(side="left", padx=(0, SP["xs"]))
            style_button(b, t, "secondary_btn_bg", "secondary_btn_hover")

        entry_row = tk.Frame(self, bg=t["panel"])
        entry_row.pack(fill="x", padx=SP["md"], pady=(SP["xs"], SP["md"]))
        self.entry = tk.Entry(entry_row, font=FONTS["body_sm"], bg=t["input_bg"], fg=t["text"],
                              insertbackground=t["text"])
        self.entry.pack(side="left", fill="x", expand=True)
        self.entry.bind("<Return>", lambda e: self.send())
        send_btn = tk.Button(entry_row, text="Send", command=self.send,
                             font=FONTS["button_sm"], padx=SP["md"], pady=SP["xs"])
        send_btn.pack(side="left", padx=(SP["xs"], 0))
        style_button(send_btn, t, "accent", "accent_hover")

        self._add_bubble("Coach", "Hi! I'll guide you through \"" + str(label) +
                                  "\". Use the buttons or type a question \u2014 I'll point out what's "
                                  "wrong, give hints that get more specific, and help when you're stuck.")

    def toggle(self, btn):
        if self.shown:
            self.pack_forget()
            self.shown = False
            btn.configure(text="\U0001F3C5 Ask Coach")
        else:
            self.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
            self.shown = True
            btn.configure(text="\U0001F3C5 Close Coach")

    def offer(self, msg, coach_btn=None):
        """Proactively open the panel (if closed) and post a Coach bubble."""
        if coach_btn is not None and not self.shown:
            self.toggle(coach_btn)
        self._add_bubble("Coach", msg)

    def _level(self):
        try:
            return (self.controller.progress or {}).get("level", "")
        except Exception:
            return ""

    def _res(self):
        try:
            lang = current_language(self.controller.progress) if self.controller and hasattr(self.controller, "progress") else "python"
        except Exception:
            lang = "python"
        return run_code_for_language(self.get_code(), lang, timeout=3)

    def ask(self, kind):
        code = self.get_code()
        res = self._res()
        if kind == "hint":
            self.stage += 1
        if kind == "quiz":
            self._start_quiz()
            return
        if kind == "guided":
            self._start_guided()
            return
        msg = coach_response(kind, code, self.step, res, self.stage, self._level())
        label = {"diagnose": "What's wrong with my code?",
                 "hint": "Give me a hint.",
                 "stuck": "I'm stuck."}[kind]
        self._add_bubble("You", label)
        self._add_bubble("Coach", msg)

    def _start_quiz(self):
        item = coach_quiz_item(self.label)
        self.quiz_item = item
        self.awaiting = "quiz"
        self._add_bubble("You", "Quiz me \u2014 I'll predict the output.")
        self._add_bubble("Coach", item["question"] + "\n\n```\n" + item["code"] + "\n```\n\n"
                                   "Type your prediction in the box and press Send.")

    def _check_quiz_answer(self, text):
        item = self.quiz_item
        live = run_user_code(item["code"], timeout=3)
        output = (live.get("output") or "").strip() if live.get("ok") else (live.get("explained") or live.get("error") or "")
        correct = check_prediction(item, text, output)
        if correct:
            p = self.controller.progress
            award_xp(p, 3, "quiz")
            save_progress(self.controller.progress_path, p)
            try:
                self.controller.sidebar.refresh()
            except Exception:
                pass
            msg = ("\u2713 Correct! It printed:\n%s\n\nThat's +3 XP \u2014 predicting output is the best way "
                   "to cement what each line really does." % (output or "(nothing \u2014 no printed output)"))
        else:
            shown = output or "(the program printed nothing)"
            msg = ("Not quite. Here's what it actually printed:\n%s\n\nRun the lines one at a time in your "
                   "head and trace each value \u2014 prediction practice turns 'I followed along' into "
                   "'I really get it'." % shown)
        self.awaiting = None
        self.quiz_item = None
        self._add_bubble("You", text)
        self._add_bubble("Coach", msg)

    def _find_lesson(self):
        try:
            frames = self.controller.frames
            lp = frames.get(LearningPage)
            if not lp:
                return None
            for level, lessons in (lp.lesson_sets or {}).items():
                for lesson in lessons:
                    if lesson.get("title") == self.label:
                        return lesson
        except Exception:
            return None
        return None

    def _start_guided(self):
        self.guided = guided_help_questions()
        self.guided_idx = 0
        self.guided_answers = {}
        self._add_bubble("You", "Ask for guided help \u2014 I'll ask you a few quick questions first.")
        self._ask_next_question()

    def _ask_next_question(self):
        if not self.guided:
            return
        q = self.guided[self.guided_idx]
        if q["type"] == "choice":
            opts = "\n".join("  %d) %s" % (i + 1, o) for i, o in enumerate(q["options"]))
            self._add_bubble("Coach", q["ask"] + "\n\n" + opts +
                             "\n\nType the number of your choice and press Send.")
        else:
            self._add_bubble("Coach", q["ask"] + "\n\nType your answer and press Send.")

    def _answer_guided(self, text):
        if not self.guided:
            return False
        q = self.guided[self.guided_idx]
        if q["type"] == "choice":
            try:
                choice = max(0, int(text.strip()) - 1)
            except ValueError:
                choice = 0
            choice = min(max(choice, 0), len(q["options"]) - 1)
            self.guided_answers[q["id"]] = choice
        else:
            self.guided_answers[q["id"]] = text.strip()
        self._add_bubble("You", text.strip() or ("Option " + str(self.guided_answers.get(q["id"], 0))))
        self.guided_idx += 1
        if self.guided_idx >= len(self.guided):
            self.guided = None
            self.guided_idx = 0
            code = self.get_code()
            res = self._res()
            lesson = self._find_lesson()
            plan = guided_help_plan(self.guided_answers, self.step, lesson, code, res)
            self._add_bubble("Coach", plan)
        else:
            self._ask_next_question()
        return True

    def send(self):
        text = self.entry.get().strip()
        if not text:
            return
        self.entry.delete(0, "end")
        if self.awaiting == "quiz":
            self._check_quiz_answer(text)
            return
        if self.guided:
            self._answer_guided(text)
            return
        low = text.lower()
        if any(w in low for w in ("hint", "tip", "clue")):
            kind = "hint"
        elif any(w in low for w in ("stuck", "give up", "lost", "help")):
            kind = "stuck"
        elif any(w in low for w in ("wrong", "error", "why", "break", "fix")):
            kind = "diagnose"
        else:
            kind = "diagnose"
        if kind == "hint":
            self.stage += 1
        code = self.get_code()
        res = self._res()
        self._add_bubble("You", text)
        self._add_bubble("Coach", coach_response(kind, code, self.step, res, self.stage, self._level()))

    def _add_bubble(self, who, text):
        self.log.configure(state="normal")
        self.log.insert("end", f"{who}: {text}\n\n")
        self.log.configure(state="disabled")
        self.log.see("end")


class ReviewQueuePage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self.refresh()

    def _get_lesson_sets(self):
        lessons_obj = self.controller.frames.get(LearningPage)
        return lessons_obj.lesson_sets if lessons_obj else {}

    def refresh(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        p = self.controller.progress
        self.configure(bg=t["bg"])
        lesson_sets = self._get_lesson_sets()
        due = due_reviews(p, lesson_sets)
        n = len(due)

        tk.Label(self, text="Review Queue", bg=t["bg"], fg=t["text"],
                 font=FONTS["heading_xl"], anchor="w").pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], 0))
        tk.Label(self, text="Recall these before you forget them. Spaced reviews lock the idea in.",
                 bg=t["bg"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w"
                 ).pack(anchor="w", padx=SP["xl"], pady=(SP["xs"], SP["lg"]))

        if n == 0:
            tk.Label(self, text="\u2714 No reviews due right now.",
                     bg=t["bg"], fg=t["success"], font=FONTS["body_bold"],
                     anchor="w").pack(anchor="w", padx=SP["xl"])
            tk.Label(self, text="Finish a lesson and it'll be scheduled for review on another day, "
                     "just before you'd forget it.",
                     bg=t["bg"], fg=t["text_secondary"], font=FONTS["body_sm"],
                     anchor="w", wraplength=560, justify="left"
                     ).pack(anchor="w", padx=SP["xl"], pady=SP["sm"])
            return

        body = tk.Frame(self, bg=t["bg"])
        body.pack(fill="both", expand=True, padx=SP["xl"])
        self.card_idx = 0
        self.cards = due
        self._state = {"show_answer": False}
        self._render_card(body)

    def _render_card(self, body):
        for w in body.winfo_children():
            w.destroy()
        t = self.controller.theme
        card = self.cards[self.card_idx]

        header = tk.Frame(body, bg=t["bg"])
        header.pack(fill="x")
        tk.Label(header, text=f"Review {self.card_idx + 1} of {len(self.cards)}",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption_bold"],
                 anchor="w").pack(side="left")
        tk.Label(header, text=f"\u2713 {card['title']}",
                 bg=t["bg"], fg=t["success"], font=FONTS["badge"],
                 anchor="w").pack(side="right")

        tk.Frame(body, bg=t["divider"], height=1).pack(fill="x", pady=SP["sm"])

        tk.Label(body, text=card["question"] or f"Recall: {card['title']}",
                 bg=t["panel"], fg=t["text"], font=FONTS["heading_md"],
                 anchor="w", wraplength=600, justify="left", padx=SP["lg"], pady=SP["lg"]
                 ).pack(fill="x", pady=(SP["md"], SP["sm"]))

        if self._state["show_answer"]:
            tk.Label(body, text="Answer:", bg=t["bg"], fg=t["muted"],
                     font=FONTS["caption_bold"], anchor="w").pack(anchor="w", pady=(SP["sm"], 0))
            tk.Label(body, text=card["answer"], bg=t["success_bg"], fg=t["success"],
                     font=FONTS["body"], anchor="w", wraplength=600, justify="left",
                     padx=SP["lg"], pady=SP["md"]).pack(fill="x", pady=SP["xs"])
            extra = tk.Label(body, text="\u2B50 Earlier: " + card["takeaways"],
                             bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["body_sm"],
                             anchor="w", wraplength=600, justify="left",
                             padx=SP["lg"], pady=SP["md"])
            extra.pack(fill="x", pady=(SP["xs"], SP["md"]))

        btn_row = tk.Frame(body, bg=t["bg"])
        btn_row.pack(fill="x", pady=SP["lg"])
        if not self._state["show_answer"]:
            reveal = tk.Button(btn_row, text="\U0001F440 Show answer",
                               command=lambda: self._show_answer(body),
                               font=FONTS["button"], padx=SP["xl"], pady=SP["md"])
            reveal.pack(side="left")
            style_button(reveal, t, "secondary_btn_bg", "secondary_btn_hover")
        else:
            for text, correct in [("\u2713 I got it", True), ("\u2717 Forgot it", False)]:
                b = tk.Button(btn_row, text=text, command=lambda c=correct: self._grade(body, c),
                              font=FONTS["button"], padx=SP["xl"], pady=SP["md"])
                b.pack(side="left", padx=(0, SP["sm"]))
                style_button(b, t, "success" if correct else "danger_btn_bg",
                             "success" if correct else "danger_btn_hover")

        skip = tk.Button(btn_row, text="Skip  \u2192", command=lambda: self._skip(body),
                         font=FONTS["button_sm"], padx=SP["lg"], pady=SP["sm"])
        skip.pack(side="right")
        style_button(skip, t, "secondary_btn_bg", "secondary_btn_hover")

    def _show_answer(self, body):
        self._state["show_answer"] = True
        self._render_card(body)

    def _skip(self, body):
        """Defer a review card until tomorrow without grading it right now."""
        card = self.cards[self.card_idx]
        grade_review(self.controller.progress, card["level"], card["lesson_idx"], False)
        save_progress(self.controller.progress_path, self.controller.progress)
        try:
            self.controller.sidebar.refresh()
        except Exception:
            pass
        self.card_idx += 1
        self._state["show_answer"] = False
        if self.card_idx >= len(self.cards):
            self.refresh()
            show_toast(self.winfo_toplevel(), "\u23F1 Skipped \u2014 it's due back tomorrow",
                       self.controller.theme)
            return
        self._render_card(body)

    def _grade(self, body, correct):
        card = self.cards[self.card_idx]
        grade_review(self.controller.progress, card["level"], card["lesson_idx"], correct)
        if correct:
            award_xp(self.controller.progress, 3, "review")
        save_progress(self.controller.progress_path, self.controller.progress)
        try:
            self.controller.sidebar.refresh()
        except Exception:
            pass
        self.card_idx += 1
        self._state["show_answer"] = False
        if self.card_idx >= len(self.cards):
            self.refresh()
            if correct:
                show_toast(self.winfo_toplevel(), "\u2713 +3 XP  \u2014  reviews complete!", self.controller.theme)
            return
        self._render_card(body)


class SkillTreePage(tk.Frame):
    """Visual top-down tree of all lessons showing progress at a glance.

    Fixed 2026-09-04: removed overlapping by making the layout scrollable
    in both directions, scaling gaps with the chosen font size, and giving
    each title its own non-overlapping cell (width = gap - padding).
    """

    _NODE_R = 14
    _H_GAP = 132          # was 100 (too tight - titles 90px + 10px gap caused overlap)
    _V_GAP = 150          # was 130 (tight when titles wrap to 2-3 lines)
    _PAD_X = 48
    _PAD_TOP = 44
    _TITLE_PAD = 18       # gap between node bottom and title top
    _ROW_TITLE_W = None   # computed per refresh as H_GAP - 20 to keep cells exclusive

    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self._nodes = {}

    def refresh(self):
        t = self.controller.theme
        p = self.controller.progress
        self.configure(bg=t["bg"])
        for w in self.winfo_children():
            w.destroy()

        lang = current_language(p)
        lesson_sets = get_lesson_sets_for_language(lang)
        meta = LANGUAGE_META.get(lang, LANGUAGE_META["python"]) if lang in SUPPORTED_LANGUAGES else None
        current_level = p.get("level", "")
        lesson_index = int(p.get("lesson_index") or 0)

        # Use per-level helper so Python and Java progress are distinct and accurate
        # _get_completed_for_level respects completed_by_level + completed_lessons + quiz-skip logic
        levels = [
            ("Beginner", lesson_sets.get("Beginner", [])),
            ("Intermediate", lesson_sets.get("Intermediate", [])),
            ("Advanced", lesson_sets.get("Advanced", [])),
        ]

        # Scale gaps with the user's chosen font size so Large/Aa never overlaps
        try:
            scale = FONT_SCALES.get(p.get("font_size", DEFAULT_FONT_SIZE), 1.0)
        except Exception:
            scale = 1.0
        H_GAP = max(110, int(round(self._H_GAP * scale)))
        V_GAP = max(130, int(round(self._V_GAP * scale)))
        title_w = max(88, H_GAP - 22)   # each title gets an exclusive cell

        # Header: language-aware title so user sees distinct trees
        top = tk.Frame(self, bg=t["panel"], padx=SP["xl"], pady=SP["md"])
        top.pack(fill="x")
        title_text = "\U0001F333  Skill Tree"
        if meta:
            title_text = f"{meta['icon']}  {meta['name']} Skill Tree"
        tk.Label(top, text=title_text, bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_md"]).pack(side="left")
        if meta:
            tk.Label(top, text=f"{meta['name']}  \u00b7  {sum(len(v) for v in lesson_sets.values())} lessons  \u00b7  Click any node to jump",
                     bg=t["panel"], fg=t["muted"], font=FONTS["caption"]).pack(side="right")
        else:
            tk.Label(top, text="Click any lesson to jump to it",
                     bg=t["panel"], fg=t["muted"], font=FONTS["caption"]).pack(side="right")

        # Scrollable canvas with BOTH scrollbars so wide rows never clip/overlap
        outer = tk.Frame(self, bg=t["bg"])
        outer.pack(fill="both", expand=True)
        canvas = tk.Canvas(outer, bg=t["bg"], highlightthickness=0)
        vsb = tk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        hsb = tk.Scrollbar(outer, orient="horizontal", command=canvas.xview)
        canvas.configure(yscrollcommand=vsb.set, xscrollcommand=hsb.set)
        vsb.pack(side="right", fill="y")
        hsb.pack(side="bottom", fill="x")
        canvas.pack(side="left", fill="both", expand=True)
        # Vertical wheel + Shift-wheel for horizontal on Windows
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))
        canvas.bind("<Shift-MouseWheel>", lambda e: canvas.xview_scroll(int(-1 * (e.delta / 120)), "units"))
        canvas.bind("<Button-1>", self._on_click)
        # Allow dragging to pan on small screens
        try:
            canvas.bind("<ButtonPress-2>", lambda e: canvas.scan_mark(e.x, e.y))
            canvas.bind("<B2-Motion>", lambda e: canvas.scan_dragto(e.x, e.y, gain=10))
        except Exception:
            pass

        self._nodes.clear()
        self._canvas = canvas
        self._theme = t

        # Determine canvas width: widest level dictates centering but never below 760
        max_lessons = max(len(lessons) for _, lessons in levels) if levels else 1
        # Add breathing room so first/last title never clips the edge
        canvas_width = max(max_lessons * H_GAP + self._PAD_X * 2, 760)
        y = self._PAD_TOP

        # Per-level completed sets using accurate helper (isolated per language)
        completed_by_level = {}
        total_done = 0
        total_all = 0
        for lv_name, lessons in levels:
            comp = set(_get_completed_for_level(p, lv_name))
            completed_by_level[lv_name] = comp
            total_done += len(comp)
            total_all += len(lessons)

        for level_name, lessons in levels:
            # Level header with per-level progress (distinct per language)
            done_here = len(completed_by_level.get(level_name, set()))
            total_here = len(lessons)
            header_text = f"\u25BC  {level_name}  \u00b7  {done_here}/{total_here}"
            canvas.create_text(
                canvas_width // 2, y,
                text=header_text,
                fill=t["text"], font=FONTS["body_bold"], anchor="center",
            )
            y += 32

            count = len(lessons)
            if count == 0:
                y += V_GAP - 32
                continue
            row_width = (count - 1) * H_GAP
            start_x = (canvas_width - row_width) // 2

            comp_set = completed_by_level.get(level_name, set())
            cur_idx = _level_index(current_level)
            lv_idx = _level_index(level_name)

            for i, lesson in enumerate(lessons):
                cx = start_x + i * H_GAP
                cy = y

                # Determine state using accurate per-level data so Python/Java trees differ
                title = lesson.get("title", f"Lesson {i + 1}")
                if i in comp_set:
                    state = "done"
                elif level_name == current_level and i == lesson_index:
                    state = "current"
                elif level_name == current_level:
                    # Same level but not done and not current -> upcoming (needs work)
                    state = "upcoming"
                elif lv_idx != -1 and cur_idx != -1 and lv_idx < cur_idx:
                    # Earlier level not fully done (partial) -> upcoming, not locked
                    # If it were fully done, i in comp_set would have caught it above
                    state = "upcoming"
                elif lv_idx != -1 and cur_idx != -1 and lv_idx > cur_idx:
                    state = "locked"
                else:
                    # No current level yet (fresh) -> only Beginner upcoming, others locked
                    if lv_idx == 0:
                        state = "upcoming"
                    else:
                        state = "locked"

                self._draw_node(canvas, cx, cy, state, title, level_name, i, t, title_w=title_w, r=self._NODE_R)

                # Connection line to next node in same level - accurate per-level completed
                if i < count - 1:
                    nx = start_x + (i + 1) * H_GAP
                    line_state = "done" if (i in comp_set and (i + 1) in comp_set) else "future"
                    dash = () if line_state == "done" else (4, 4)
                    line_color = t["success"] if line_state == "done" else t["muted"]
                    canvas.create_line(cx + self._NODE_R + 2, cy,
                                       nx - self._NODE_R - 2, cy,
                                       fill=line_color, width=2, dash=dash)

            # Advance past the tallest possible title block (up to 3 wrapped lines)
            # Header (32) + node (28) + title gap (18) + 3*14 ≈ 120, so V_GAP 150 leaves 30px lane gap
            y += V_GAP

        # Footer summary - per-language accurate total (Python 36 vs Java 8)
        lang_label = f"{meta['name']}  \u00b7  " if meta else ""
        canvas.create_text(
            canvas_width // 2, y + 8,
            text=f"{lang_label}{total_done} / {total_all} lessons completed",
            fill=t["muted"], font=FONTS["caption"], anchor="center",
        )

        # Give the canvas a real scrollregion that includes the computed width
        # so hsb appears when the row is wider than the viewport.
        try:
            canvas.configure(scrollregion=(0, 0, canvas_width, y + 40))
        except Exception:
            canvas.configure(scrollregion=canvas.bbox("all"))
        # Ensure footer / top row are visible after refresh
        try:
            canvas.xview_moveto(0)
            canvas.yview_moveto(0)
        except Exception:
            pass

    def _draw_node(self, canvas, cx, cy, state, title, level, idx, t, title_w=90, r=14):
        fill = {"done": t["success"], "current": t["accent"],
                "upcoming": t["panel"], "locked": t["divider"]}.get(state, t["divider"])
        outline = {"done": t["success"], "current": t["accent"],
                   "upcoming": t["muted"], "locked": t["divider"]}.get(state, t["divider"])
        width = 3 if state == "current" else 2
        canvas.create_oval(cx - r, cy - r, cx + r, cy + r,
                           fill=fill, outline=outline, width=width)

        if state == "done":
            canvas.create_text(cx, cy, text="\u2713", fill="#ffffff",
                               font=FONTS["body_bold"])

        text_color = t["text"] if state in ("done", "current") else t["muted"]
        font = FONTS["body_bold"] if state == "current" else FONTS["caption"]
        canvas.create_text(cx, cy + r + self._TITLE_PAD, text=title, fill=text_color,
                           font=font, anchor="n", width=title_w, justify="center")

        self._nodes[(level, idx)] = (cx, cy, r)

    def _on_click(self, event):
        canvas = self._canvas
        x = canvas.canvasx(event.x)
        y = canvas.canvasy(event.y)
        for (level, idx), (cx, cy, r) in self._nodes.items():
            if abs(x - cx) <= r + 4 and abs(y - cy) <= r + 4:
                self._jump(level, idx)
                return

    def _jump(self, level, idx):
        p = self.controller.progress
        cur = p.get("level", "")
        # Persist current level's completed lessons before leaving (keeps progression accurate per language)
        if cur and cur != level:
            cbl = p.setdefault("completed_by_level", {})
            cbl[cur] = list(p.get("completed_lessons", []))
        # Determine restored completed list for target using per-level map (isolated per language)
        cbl = p.get("completed_by_level", {})
        if level in cbl:
            restored = list(cbl[level])
        else:
            # No history for this level yet: start empty, but if level was quiz-skipped it would already be in cbl via _auto_complete
            # Respect _is_level_skipped by not inventing completions here - rely on _get_completed_for_level for display
            restored = []
            # If jumping within same level, keep current list
            if cur == level:
                restored = list(p.get("completed_lessons", []))
        # Use controller.update_progress so language_states sync and footer/sidebar stay accurate
        self.controller.update_progress(level=level, lesson_index=idx, step_index=0, completed_lessons=restored)
        self.controller.show_frame(LearningPage)


def _level_index(name):
    return {"Beginner": 0, "Intermediate": 1, "Advanced": 2}.get(name, -1)


class DailyChallengePage(tk.Frame):
    """One auto-generated challenge a day, scored live against the bundled data."""

    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller

    def refresh(self):
        # Cancel any previous reset timer so only one ticks
        prev = getattr(self, "_timer_after", None)
        if prev:
            try:
                self.after_cancel(prev)
            except Exception:
                pass
            self._timer_after = None
        t = self.controller.theme
        p = self.controller.progress
        self.configure(bg=t["bg"])
        for w in self.winfo_children():
            w.destroy()

        spec = daily_challenge_spec(progress=p)
        if spec is None:
            tk.Label(self, text="Datasets not found - reinstall the app to get today's challenge.",
                     bg=t["bg"], fg=t["text"], font=FONTS["body"]).pack(pady=SP["xl"])
            return
        solved = is_daily_done(p)
        streak = daily_challenge_streak(p)
        fails = [0]

        header = tk.Frame(self, bg=t["panel"], padx=SP["xl"], pady=SP["md"])
        header.pack(fill="x")
        left_head = tk.Frame(header, bg=t["panel"])
        left_head.pack(side="left")
        tk.Label(left_head, text="\U0001F3AF  Daily Challenge", bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_md"]).pack(anchor="w")
        tk.Label(left_head, text="Mixed every day \u2014 topic & task rotate",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"]).pack(anchor="w")

        right_head = tk.Frame(header, bg=t["panel"])
        right_head.pack(side="right")
        tk.Label(right_head, text=date.today().strftime("%A, %b %d"),
                 bg=t["panel"], fg=t["muted"], font=FONTS["body_sm"]).pack(anchor="e")
        timer_var = tk.StringVar(value="Resets in " + format_countdown(seconds_until_midnight()))
        tk.Label(right_head, textvariable=timer_var,
                 bg=t["panel"], fg=t["accent"], font=FONTS["caption_bold"]).pack(anchor="e")

        # Subtle countdown strip: live HH:MM:SS + midnight note + variety teaser
        timer_bar = tk.Frame(self, bg=t["tip_bg"], padx=SP["xl"], pady=SP["xs"])
        timer_bar.pack(fill="x", padx=SP["xl"], pady=(SP["xs"], 0))
        tk.Label(timer_bar, text="\u23F3", bg=t["tip_bg"], fg=t["tip_text"],
                 font=FONTS["body_sm"]).pack(side="left")
        timer_var2 = tk.StringVar(value="Next challenge in " + format_countdown(seconds_until_midnight()))
        tk.Label(timer_bar, textvariable=timer_var2, bg=t["tip_bg"], fg=t["tip_text"],
                 font=FONTS["caption_bold"]).pack(side="left", padx=(SP["sm"], 0))
        tk.Label(timer_bar, text="\u2022  Resets at midnight local time  \u2022  Fresh topic & task each day",
                 bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["caption"]).pack(side="left", padx=(SP["sm"], 0))
        initial_day = date.today().toordinal()
        def _tick():
            try:
                if not self.winfo_exists():
                    return
                secs = seconds_until_midnight()
                timer_var.set("Resets in " + format_countdown(secs))
                timer_var2.set("Next challenge in " + format_countdown(secs))
                cur_day = date.today().toordinal()
                if cur_day != initial_day:
                    self.refresh()
                    return
                if secs <= 0:
                    self.after(900, self.refresh)
                    return
            except tk.TclError:
                return
            except Exception:
                pass
            try:
                self._timer_after = self.after(1000, _tick)
            except tk.TclError:
                pass
        self._timer_after = self.after(1000, _tick)

        if solved:
            banner = tk.Frame(self, bg=t["success"], padx=SP["xl"], pady=SP["sm"])
            banner.pack(fill="x", pady=(SP["sm"], 0), padx=SP["xl"])
            tk.Label(
                banner,
                text=f"\u2713  Solved today: +{DAILY_CHALLENGE_XP} XP banked"
                     + (f"  \u00b7  {streak}-day challenge streak" if streak > 1 else "  \u00b7  streak started"),
                bg=t["success"], fg="#ffffff", font=FONTS["body_bold"], anchor="w",
            ).pack(anchor="w")
            tk.Label(banner, text="Come back tomorrow for a fresh question \u2014 you can still tinker "
                                  "with today's down below.",
                     bg=t["success"], fg="#ffffff", font=FONTS["caption"], anchor="w").pack(anchor="w")

        pw = tk.PanedWindow(self, orient="horizontal", sashwidth=3,
                            sashrelief="flat", bg=t["divider"])
        pw.pack(fill="both", expand=True, padx=SP["xl"], pady=(SP["sm"], SP["sm"]))

        left = tk.Frame(pw, bg=t["panel"])
        pw.add(left, width=420, minsize=300)
        right = tk.Frame(pw, bg=t["bg"])
        pw.add(right, width=520, minsize=360)

        # -------- Left: the challenge itself --------
        canvas = tk.Canvas(left, bg=t["panel"], highlightthickness=0)
        scrollbar = tk.Scrollbar(left, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=scrollbar.set)
        scrollbar.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        inner = tk.Frame(canvas, bg=t["panel"])
        canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))

        badge = tk.Label(inner, text="TODAY'S CHALLENGE", bg=t["tip_bg"], fg=t["tip_text"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        badge.pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

        tk.Label(inner, text=spec["title"], bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_lg"], anchor="w", wraplength=360, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(0, SP["sm"]))

        area = spec.get("level") or "Mixed skills"
        src = ("data/" + spec["dataset"]) if spec.get("dataset") else "pure code \u2014 no data files"
        chip = tk.Label(inner, text=f"{area}  \u00b7  {src}", bg=t["xp_bg"], fg=t["xp_text"],
                        font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        chip.pack(anchor="w", padx=SP["xl"], pady=(0, SP["md"]))

        tk.Label(inner, text=spec["question"], bg=t["panel"], fg=t["text_secondary"],
                 font=FONTS["body"], anchor="w", wraplength=360, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        # Progressive hint — 3 levels: nudge → detail → example (was broken: banner never packed)
        hint_level = [0]
        hint_var = tk.StringVar(value="")
        hint_banner = tk.Frame(inner, bg=t["warning_bg"], padx=SP["md"], pady=SP["sm"])
        hint_label = tk.Label(hint_banner, textvariable=hint_var, bg=t["warning_bg"], fg=t["warning"],
                              font=FONTS["body_sm"], anchor="w", wraplength=330, justify="left")
        hint_label.pack(fill="x")
        # initially hidden (not packed) — toggle will pack it
        def _hint_text_for_level(lvl):
            # Non-solution hints: never paste the answer code
            if lvl == 1:
                return "Hint 1 — nudge: " + spec.get("hint", "")
            if lvl == 2:
                # more specific but still no code: point to the exact tool/field
                base = spec.get("hint", "")
                # add a non-code clarification without giving the line
                extra = " Think: which key/field and which built-in (sorted/max/filter) the question asks for?"
                return "Hint 2 — focus: " + base + extra
            if lvl >= 3:
                # approach only: steps without code
                return ("Hint 3 — approach (no code):\n"
                        "1) Load the file with json.load\n"
                        "2) Pick the right tool for the question (sorted / max / filter)\n"
                        "3) Print each result on its own line — check the question for exact format")
            return ""
        def toggle_hint():
            if hint_level[0] >= 3:
                # reset
                hint_level[0] = 0
                hint_var.set("")
                hint_banner.pack_forget()
                hint_btn.configure(text="\U0001F4A1 Hint")
                return
            hint_level[0] += 1
            hint_var.set(_hint_text_for_level(hint_level[0]))
            # pack banner if not already visible (show just above the button)
            if not hint_banner.winfo_ismapped():
                hint_banner.pack(fill="x", padx=SP["xl"], pady=(0, SP["sm"]), before=hint_btn)
            # update button label to show progress
            if hint_level[0] == 1:
                hint_btn.configure(text="\U0001F4A1 Hint 1/3 — Hide")
            elif hint_level[0] == 2:
                hint_btn.configure(text="\U0001F4A1 Hint 2/3 — More")
            else:
                hint_btn.configure(text="\U0001F4A1 Hint 3/3 — Reset")
            # also update hint banner visibility — all non-solution, so keep warm tones
            if hint_level[0] == 1:
                hint_banner.configure(bg=t["warning_bg"])
                hint_label.configure(bg=t["warning_bg"], fg=t["warning"])
            elif hint_level[0] == 2:
                hint_banner.configure(bg=t["tip_bg"])
                hint_label.configure(bg=t["tip_bg"], fg=t["tip_text"])
            else:
                hint_banner.configure(bg=t["tip_bg"])
                hint_label.configure(bg=t["tip_bg"], fg=t["tip_text"])
        hint_btn = tk.Button(inner, text="\U0001F4A1 Hint", font=FONTS["button_sm"],
                             command=toggle_hint, padx=SP["md"], pady=SP["xs"])
        hint_btn.pack(anchor="w", padx=SP["xl"], pady=(0, SP["md"]))
        style_button(hint_btn, t, "warning", "warning_bg")

        add_divider(inner, t, SP["sm"])
        # Example is now hidden behind a toggle - shows pattern on similar data, not the answer
        ex_visible = [False]
        ex_container = tk.Frame(inner, bg=t["panel"])
        # Don't pack yet - will be toggled
        tk.Label(inner, text="Pattern, not the answer", bg=t["panel"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(fill="x", padx=SP["xl"], pady=(SP["sm"], 0))
        def toggle_example():
            if ex_visible[0]:
                ex_container.pack_forget()
                ex_btn.configure(text="\U0001F4D6 Show pattern example (adapt, don't copy)")
                ex_visible[0] = False
            else:
                ex_container.pack(fill="x", padx=SP["xl"], pady=SP["xs"])
                ex_btn.configure(text="\U0001F4D6 Hide pattern")
                ex_visible[0] = True
            # Update scrollregion
            try:
                canvas.configure(scrollregion=canvas.bbox("all"))
            except Exception:
                pass
        ex_btn = tk.Button(inner, text="\U0001F4D6 Show pattern example (adapt, don't copy)", font=FONTS["button_sm"],
                           command=toggle_example, padx=SP["md"], pady=SP["xs"])
        ex_btn.pack(anchor="w", padx=SP["xl"], pady=(SP["xs"], SP["sm"]))
        style_button(ex_btn, t, "secondary_btn_bg", "secondary_btn_hover")
        # Build hidden example frame - shows a *generic* pattern, NOT the exact answer
        ex_frame = tk.Frame(ex_container, bg=t["code_bg"], relief="solid", bd=1)
        ex_frame.pack(fill="x", pady=(0, SP["xs"]))
        # Generic pattern that uses same tool but different field/data so copy-paste can never pass
        # This ensures even if learner copies, challenge_matches_output will fail (wrong field/format)
        if spec.get("dataset"):
            safe_example = (
                "# Generic pattern - same tool, different field\n"
                "# data = json.load(open('file.json'))\n"
                "# result = sorted(data, key=lambda x: x['SOME_FIELD'])\n"
                "# for item in result:\n"
                "#     print(item['name'])\n"
                "# ^ Replace SOME_FIELD and print format with THIS question's field\n"
                f"# This challenge asks: {spec['question'][:80]}..."
            )
        else:
            # Pure-code pattern - show structure but with placeholder values
            safe_example = (
                "# Generic pattern - same idea, different values\n"
                "# for n in range(1, 6):\n"
                "#     print(n)  # <- change range/logic and print to match THIS question\n"
                "# ^ Adapt the numbers/condition and print format for THIS question"
            )
        display_example = safe_example
        tk.Label(ex_frame, text=display_example, bg=t["code_bg"], fg=t["text"],
                 font=FONTS["code"], anchor="nw", justify="left",
                 padx=SP["md"], pady=SP["md"]).pack(fill="x")
        tk.Label(ex_container, text="\u26A0 This is a pattern, not the answer. Copying it will not pass - read the question and change the field/range/print.",
                 bg=t["panel"], fg=t["warning"], font=FONTS["caption"], anchor="w", wraplength=350, justify="left").pack(fill="x", pady=(0, SP["xs"]))

        tk.Label(inner, text="How it's graded: your code must print the answer's lines \u2014 "
                             "order doesn't matter. Press Run & Check to see if you nailed it. "
                             "First solve of the day pays "
                             + str(DAILY_CHALLENGE_XP) + " XP.",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w",
                 wraplength=360, justify="left").pack(fill="x", padx=SP["xl"], pady=(SP["sm"], SP["lg"]))

        # -------- Right: editor, output, coach --------
        tk.Label(right, text="Your Code", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=(SP["lg"], SP["sm"]))

        code_entry = SyntaxEditor(right, theme=t, height=13, font=FONTS["code"], bg=t["input_bg"],
                             fg=t["text"], insertbackground=t["text"],
                             relief="solid", bd=1, undo=True)
        code_entry.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
        code_entry.set_code(spec["starter_code"])
        tk.Label(right, text="Tip: press Ctrl+Enter in the editor to run your code.",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"], anchor="w"
                 ).pack(anchor="w", padx=SP["lg"], pady=(0, SP["xs"]))

        tk.Label(right, text="Output", bg=t["bg"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(anchor="w", padx=SP["lg"])
        output_box = tk.Text(right, height=5, font=FONTS["code"], bg=t["code_bg"],
                             fg=t["text"], relief="solid", bd=1, wrap="word")
        output_box.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        output_box.configure(state="disabled")

        feedback_var = tk.StringVar(value="")
        feedback_lbl = tk.Label(right, textvariable=feedback_var, bg=t["bg"],
                                font=FONTS["body_bold"], anchor="w", wraplength=470, justify="left")
        feedback_lbl.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        if solved:
            feedback_var.set(f"\u2713 Already completed today \u2014 that's +{DAILY_CHALLENGE_XP} XP banked.")
            feedback_lbl.configure(fg=t["success"])

        btn_row = tk.Frame(right, bg=t["bg"])
        btn_row.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        def run_code_goto():  # placeholder to keep binding simple
            pass

        def run_code():
            code = code_entry.get("1.0", tk.END)
            stripped = code.strip()
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)
            if not stripped:
                output_box.configure(state="disabled")
                return

            # Language-aware execution: Java learners run Java, Python learners run Python
            cur_lang = current_language(p) if 'p' in locals() else current_language(self.controller.progress)
            if spec.get("language") == "java" or cur_lang == "java" or "System.out.println" in code or "public class" in code:
                res = run_code_for_language(code, "java", timeout=4)
            else:
                res = run_user_code(code)
            if res["blocked"]:
                output_box.insert("1.0", res["blocked"])
                output_box.configure(state="disabled")
                feedback_var.set("Your code used a tool that isn't allowed in the playground \u2014 see the output box.")
                feedback_lbl.configure(fg=t["error"])
                code_entry.configure(highlightbackground=t["error"], highlightthickness=2)
                try:
                    coach_panel.offer(coach_diagnose(code, spec["coach_step"], res), coach_btn)
                except Exception:
                    pass
                return

            if not res["ok"]:
                shown = res["output"]
                if shown and res["error"]:
                    shown += "\n\n"
                output_box.insert("1.0", shown + res["error"])
                output_box.configure(state="disabled")
                fails[0] += 1
                feedback_var.set(res["explained"] or "Your code hit a Python error \u2014 check the output box.")
                feedback_lbl.configure(fg=t["error"])
                code_entry.configure(highlightbackground=t["error"], highlightthickness=2)
                try:
                    coach_panel.offer(coach_diagnose(code, spec["coach_step"], res), coach_btn)
                except Exception:
                    pass
                if fails[0] in (2, 3, 4):
                    coach_panel.offer(coach_proactive(code, spec["coach_step"], fails[0],
                                                      self.controller.progress.get("level", "")),
                                      coach_btn)
                return

            output_box.insert("1.0", res["output"] if res["output"] else "(ran without errors \u2014 add a print() line)")
            output_box.configure(state="disabled")

            # Block verbatim copy of the exact example even if output would match - forces adaption
            try:
                norm_code2 = "".join((code or "").split()).lower()
                norm_ex2 = "".join(spec.get("example", "").split()).lower()
                if norm_code2 and norm_ex2 and len(norm_ex2) > 20 and norm_code2 == norm_ex2:
                    fails[0] += 1
                    feedback_var.set("\u26A0 You pasted the exact example code \u2014 that example is blocked. Write your own adaptation for THIS question's field/range and print format (see the question above).")
                    feedback_lbl.configure(fg=t["warning"])
                    code_entry.configure(highlightbackground=t["warning"], highlightthickness=2)
                    try:
                        coach_panel.offer("You pasted the example verbatim - blocked. Change the key (e.g., statehood_year vs name), range, or print to match THIS question.", coach_btn)
                    except Exception:
                        pass
                    return
            except Exception:
                pass

            if challenge_matches_output(res.get("output") or "", spec):
                newly_solved = record_daily_solve(p)
                save_progress(self.controller.progress_path, p)
                try:
                    self.controller.sidebar.refresh()
                except Exception:
                    pass
                self.controller.check_badges()
                streak_now = daily_challenge_streak(p)
                msg = (f"\u2713 Solved! +{DAILY_CHALLENGE_XP} XP \u00b7 "
                       f"{streak_now}-day challenge streak" if streak_now > 1
                       else f"\u2713 Solved! +{DAILY_CHALLENGE_XP} XP \u2014 streak started.")
                if not newly_solved:
                    msg = "\u2713 Correct again! (today's XP already banked.)"
                feedback_var.set(msg)
                feedback_lbl.configure(fg=t["success"])
                code_entry.configure(highlightbackground=t["success"], highlightthickness=2)
                show_toast(self.winfo_toplevel(), f"\U0001F3AF Challenge solved! +{DAILY_CHALLENGE_XP} XP", t)
                self.after(1600, self.refresh)
                return

            # Detect verbatim copy of the pattern example - example is intentionally for a different question/format
            try:
                norm_code = "".join((code or "").split()).lower()
                norm_ex = "".join(spec.get("example", "").split()).lower()
                if norm_code and norm_ex and norm_code == norm_ex:
                    feedback_var.set(
                        "\u26A0 You pasted the pattern example verbatim — that example is for a *similar* question and prints a different field/format, so it won't match this challenge. Adapt the key/field and print format for THIS question (see the question above, not the example)."
                    )
                    feedback_lbl.configure(fg=t["warning"])
                    code_entry.configure(highlightbackground=t["warning"], highlightthickness=2)
                    try:
                        coach_panel.offer("You copied the example - adapt it! Change the key (e.g., atomic_mass → diameter_km), the sort direction, or the print format to match THIS question's 'Expected' description.", coach_btn)
                    except Exception:
                        pass
                    return
            except Exception:
                pass
            fails[0] += 1
            exp_n = len(spec.get("expected_lines", []))
            got_n = len([ln for ln in (res.get("output") or "").splitlines() if ln.strip()])
            feedback_var.set(
                f"\u2717 Ran fine, but the output doesn't match. Need {exp_n} line(s); you printed {got_n}. "
                "Re-read the question and print each value exactly. The Coach can point you at the tool to use \u2014 "
                "it won't spoil the answer."
            )
            feedback_lbl.configure(fg=t["warning"])
            code_entry.configure(highlightbackground=t["warning"], highlightthickness=2)
            try:
                coach_panel.offer(coach_hint_specific(code, spec["coach_step"], self.controller.progress.get("level", "")), coach_btn)
            except Exception:
                pass
            if fails[0] in (2, 3, 4):
                coach_panel.offer(coach_proactive(code, spec["coach_step"], fails[0],
                                                  self.controller.progress.get("level", "")),
                                  coach_btn)

        run_btn = tk.Button(btn_row, text="\u25B6 Run & Check", font=FONTS["button"],
                            command=run_code, padx=SP["lg"], pady=SP["md"])
        run_btn.pack(side="left")
        style_button(run_btn, t, "accent", "accent_hover")

        clear_btn = tk.Button(btn_row, text="Clear", font=FONTS["button_sm"],
                              command=lambda: (code_entry.delete("1.0", tk.END),
                                               code_entry.insert("1.0", spec["starter_code"]),
                                               code_entry.configure(highlightbackground=t["input_border"], highlightthickness=1),
                                               feedback_var.set(""),
                                               output_box.configure(state="normal"),
                                               output_box.delete("1.0", tk.END),
                                               output_box.configure(state="disabled")),
                              padx=SP["md"], pady=SP["xs"])
        clear_btn.pack(side="left", padx=SP["sm"])
        style_button(clear_btn, t, "secondary_btn_bg", "secondary_btn_hover")

        def get_code():
            return code_entry.get("1.0", tk.END)

        coach_panel = CoachPanel(right, t, get_code, spec["coach_step"], spec["title"], self.controller)
        coach_btn = tk.Button(btn_row, text="\U0001F3C5 Ask Coach", font=FONTS["button_sm"],
                              command=lambda: coach_panel.toggle(coach_btn), padx=SP["md"], pady=SP["xs"])
        coach_btn.pack(side="left")
        style_button(coach_btn, t, "warning", "warning_bg")

        code_entry.bind("<Control-Return>", lambda _e: (run_code(), "break")[1])
        code_entry.bind("<Command-Return>", lambda _e: (run_code(), "break")[1])


class SettingsPage(tk.Frame):
    """Preferences: the default text size and the color theme, saved automatically."""

    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self.refresh()

    def refresh(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        self.configure(bg=t["bg"])

        hdr = tk.Frame(self, bg=t["bg"])
        hdr.pack(fill="x", padx=SP["xl"], pady=(SP["xl"], SP["md"]))
        tk.Label(
            hdr, text="\u2699  Settings", bg=t["bg"], fg=t["text"],
            font=FONTS["heading_lg"], anchor="w",
        ).pack(anchor="w")
        tk.Label(
            hdr, text="Your preferences are saved automatically. Change text size in the Default text size card below.",
            bg=t["bg"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w",
        ).pack(anchor="w", pady=(SP["xs"], 0))

        self._size_card(t)
        self._theme_card(t)
        self._language_card(t)
        self._sound_card(t)
        self._focus_card(t)
        self._weekly_card(t)
        self._reset_card(t)

    def _language_card(self, t):
        cur = current_language(self.controller.progress)
        body = self._card(t, "Programming language",
                          "Switch between Python and Java. Your progress for each language is saved separately (XP and streak are shared).")
        row = tk.Frame(body, bg=t["panel"])
        row.pack(fill="x", pady=(0, SP["sm"]))
        for lang in SUPPORTED_LANGUAGES:
            meta = LANGUAGE_META[lang]
            is_cur = (cur == lang)
            b = tk.Button(row, text=f"{meta['icon']} {meta['name']}", command=lambda l=lang: self.controller.set_language(l))
            if is_cur:
                style_button(b, t, "accent", "accent_hover")
            else:
                style_button(b, t, "secondary_btn_bg", "secondary_btn_hover")
                if lang == "java":
                    try:
                        b.configure(bg=meta["color"], activebackground="#c2410c")
                    except Exception:
                        pass
            b.pack(side="left", padx=(0, SP["sm"]))
        if cur in SUPPORTED_LANGUAGES:
            meta = LANGUAGE_META[cur]
            tk.Label(body, text=f"Current: {meta['icon']} {meta['name']}  \u2022  Level: {self.controller.progress.get('level') or 'Not yet placed'}   \u2022  Switch anytime via top bar",
                     bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(fill="x", pady=(0, SP["lg"]))
        else:
            tk.Label(body, text="No language chosen yet - pick one above or via the Language chooser.",
                     bg=t["panel"], fg=t["warning"], font=FONTS["caption"], anchor="w").pack(fill="x", pady=(0, SP["lg"]))
        chooser = tk.Button(body, text="Open Language Chooser  \u2192", command=lambda: self.controller.show_frame(LanguageSelectionPage),
                            font=FONTS["button_sm"], padx=SP["md"], pady=SP["xs"])
        chooser.pack(anchor="w")
        style_button(chooser, t, "secondary_btn_bg", "secondary_btn_hover")

    def _card(self, t, title, subtitle):
        card = RoundedCard(self, theme=t, page_bg=t["bg"], pad=SP["lg"])
        card.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
        card.content.configure(bg=t["panel"])
        tk.Label(card.content, text=title, bg=t["panel"], fg=t["text"],
                 font=FONTS["body_bold"], anchor="w").pack(fill="x", padx=SP["lg"], pady=(SP["lg"], 0))
        tk.Label(card.content, text=subtitle, bg=t["panel"], fg=t["text_secondary"],
                 font=FONTS["body_sm"], anchor="w", wraplength=640, justify="left").pack(
            fill="x", padx=SP["lg"], pady=(SP["xs"], SP["sm"]))
        body = tk.Frame(card.content, bg=t["panel"])
        body.pack(fill="x", padx=SP["lg"])
        return body

    def _size_card(self, t):
        size = self.controller.progress.get("font_size", DEFAULT_FONT_SIZE)
        body = self._card(t, "Default text size",
                          "This is the text size the app starts with each time. Change it any time.")
        row = tk.Frame(body, bg=t["panel"])
        row.pack(fill="x", pady=(0, SP["sm"]))
        for label, key in [("Small", "small"), ("Normal", "normal"), ("Large", "large")]:
            b = tk.Button(row, text=label, command=lambda k=key: self.controller._set_font_size(k))
            if key == size:
                style_button(b, t, "accent", "accent_hover")
            else:
                style_button(b, t, "secondary_btn_bg", "secondary_btn_hover")
            b.pack(side="left", padx=(0, SP["sm"]))

        caption_row = tk.Frame(body, bg=t["panel"])
        caption_row.pack(fill="x")
        tk.Label(caption_row, text=f"Current: {size.title()}   \u2022   App default: {DEFAULT_FONT_SIZE.title()}",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(
            side="left")
        restore = tk.Button(caption_row, text="Restore default", font=FONTS["button_sm"],
                            command=lambda: self.controller._set_font_size(DEFAULT_FONT_SIZE))
        style_button(restore, t, "secondary_btn_bg", "secondary_btn_hover")
        restore.pack(side="right", pady=(0, SP["lg"]))
        restore.configure(font=FONTS["button_sm"])

    def _theme_card(self, t):
        theme = self.controller.theme_name
        body = self._card(t, "Color theme",
                          "Dark is easy on the eyes at night; light is bright and crisp. Ocean and Forest add color.")
        row = tk.Frame(body, bg=t["panel"])
        row.pack(fill="x", pady=(0, SP["sm"]))
        # Dynamically show every theme in THEMES (dark, light, ocean, forest, ...)
        theme_labels = {"dark": "Dark", "light": "Light", "ocean": "Ocean", "forest": "Forest"}
        for key in THEMES.keys():
            label = theme_labels.get(key, key.title())
            b = tk.Button(row, text=label, command=lambda k=key: self.controller.apply_theme(k))
            if key == theme:
                style_button(b, t, "accent", "accent_hover")
            else:
                style_button(b, t, "secondary_btn_bg", "secondary_btn_hover")
            b.pack(side="left", padx=(0, SP["sm"]))

        tk.Label(body, text=f"Current: {theme.title()}   \u2022   Tip: the \u263E Theme button in the top bar toggles instantly.",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(
            fill="x", pady=(0, SP["lg"]))

    def _sound_card(self, t):
        enabled = bool(self.controller.progress.get("sound_enabled", True))
        body = self._card(t, "Sound effects",
                          "Play a tiny chime on celebrations. Toggle if you prefer quiet.")
        row = tk.Frame(body, bg=t["panel"])
        row.pack(fill="x", pady=(0, SP["sm"]))
        def toggle():
            self.controller.progress["sound_enabled"] = not bool(self.controller.progress.get("sound_enabled", True))
            save_progress(self.controller.progress_path, self.controller.progress)
            self.refresh()
            # preview sound if enabled
            if self.controller.progress.get("sound_enabled"):
                try:
                    import winsound
                    winsound.MessageBeep(winsound.MB_OK)
                except Exception:
                    self.bell()
        label = "Sound: ON" if enabled else "Sound: OFF"
        b = tk.Button(row, text=label, command=toggle)
        style_button(b, t, "accent" if enabled else "secondary_btn_bg", "accent_hover" if enabled else "secondary_btn_hover")
        b.pack(side="left")
        tk.Label(body, text="Current: " + ("On" if enabled else "Off") + "  \u2022  celebration sounds " + ("enabled" if enabled else "muted"),
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(fill="x", pady=(0, SP["lg"]))

    def _focus_card(self, t):
        enabled = bool(self.controller.progress.get("focus_mode", False))
        body = self._card(t, "Focus / Tempo mode",
                          "Hide output until you hit 'Check' — great for practicing without peeking.")
        row = tk.Frame(body, bg=t["panel"])
        row.pack(fill="x", pady=(0, SP["sm"]))
        def toggle():
            self.controller.progress["focus_mode"] = not bool(self.controller.progress.get("focus_mode", False))
            save_progress(self.controller.progress_path, self.controller.progress)
            self.refresh()
        label = "Focus: ON" if enabled else "Focus: OFF"
        b = tk.Button(row, text=label, command=toggle)
        style_button(b, t, "accent" if enabled else "secondary_btn_bg", "accent_hover" if enabled else "secondary_btn_hover")
        b.pack(side="left")
        tk.Label(body, text="When ON, Run shows 'Hidden — hit Check to reveal' in practice steps.",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(fill="x", pady=(0, SP["lg"]))

    def _weekly_card(self, t):
        p = self.controller.progress
        goal = int(p.get("weekly_goal", 5) or 5)
        prog = int(p.get("weekly_progress", 0) or 0)
        week = p.get("weekly_goal_week", "")
        freezes = int(p.get("streak_freezes", 0) or 0)
        body = self._card(t, "Weekly goal & streak freeze",
                          "Set a weekly target (activities/week). Earn a streak freeze every 7-day streak to protect a missed day.")
        # progress bar
        bar = RoundedProgress(body, theme=t, color=t["accent"], height=10)
        bar.pack(fill="x", pady=(0, SP["sm"]))
        bar.draw(min(1.0, prog / goal if goal else 0))
        tk.Label(body, text=f"Week {week or '—'}: {prog}/{goal} activities  \u2022  Freezes: {freezes} \u2744\uFE0F  (max 3)",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(fill="x")
        row = tk.Frame(body, bg=t["panel"])
        row.pack(fill="x", pady=(SP["sm"], SP["lg"]))
        for g in [3, 5, 7, 10]:
            b = tk.Button(row, text=str(g), command=lambda v=g: (p.__setitem__("weekly_goal", v), save_progress(self.controller.progress_path, p), self.refresh()))
            style_button(b, t, "accent" if g == goal else "secondary_btn_bg", "accent_hover" if g == goal else "secondary_btn_hover")
            b.pack(side="left", padx=(0, SP["xs"]))
        tk.Label(row, text="  target / week", bg=t["panel"], fg=t["muted"], font=FONTS["caption"]).pack(side="left", padx=(SP["sm"], 0))

    def _reset_card(self, t):
        cur = current_language(self.controller.progress)
        meta = LANGUAGE_META.get(cur, None) if cur in SUPPORTED_LANGUAGES else None
        cur_label = f"{meta['icon']} {meta['name']}" if meta else "Current language"
        body = self._card(t, "Reset progress",
                          "Clear your learning data whenever you want. Resetting is instant and saved automatically.")
        # Row for buttons
        row = tk.Frame(body, bg=t["panel"])
        row.pack(fill="x", pady=(0, SP["sm"]))

        def _confirm_current():
            if not cur or cur not in SUPPORTED_LANGUAGES:
                messagebox.showinfo("No language", "Pick a language first (Main Menu), then you can reset that track.", parent=self)
                return
            if messagebox.askyesno("Reset this language?",
                                   f"This will clear all lessons, steps, and projects for {cur_label} "
                                   f"but keep your other language(s), XP, and streak.\n\nYou can't undo this. Continue?",
                                   parent=self):
                try:
                    self.controller.reset_current_language_progress()
                    show_toast(self.winfo_toplevel(), f"\u21BA {cur_label} progress reset", self.controller.theme)
                except Exception:
                    pass
                self.refresh()

        def _confirm_all():
            if messagebox.askyesno("Reset everything?",
                                   "This will erase ALL languages, lessons, XP, streak, reviews, and badges for everyone using this app.\n\n"
                                   "Theme is kept. You can't undo this. Continue?",
                                   parent=self):
                try:
                    self.controller.restart_progress()
                    show_toast(self.winfo_toplevel(), "\u21BA All progress reset", self.controller.theme)
                except Exception:
                    pass
                self.refresh()

        b1 = tk.Button(row, text=f"\u21BA Reset {cur_label}" if meta else "\u21BA Reset Current Language",
                       command=_confirm_current, padx=SP["md"], pady=SP["xs"])
        b1.pack(side="left", padx=(0, SP["sm"]))
        # Disable if no language chosen
        if not meta:
            b1.configure(state="disabled")
            style_button(b1, t, "secondary_btn_bg", "secondary_btn_hover")
        else:
            style_button(b1, t, "secondary_btn_bg", "secondary_btn_hover")

        b2 = tk.Button(row, text="\u26A0 Reset Everything", command=_confirm_all, padx=SP["md"], pady=SP["xs"])
        b2.pack(side="left")
        style_button(b2, t, "danger_btn_bg", "danger_btn_hover")

        tk.Label(body, text="Tip: Reset is available here in Settings whenever you need it — no need to hunt in Progress.",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=640, justify="left").pack(fill="x", pady=(0, SP["lg"]))


class PlanningGuidePage(tk.Frame):
    """Optional planning guide – not required, just there if you want a schedule."""

    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller

    def refresh(self):
        for w in self.winfo_children():
            w.destroy()
        t = self.controller.theme
        self.configure(bg=t["bg"])
        # Scrollable
        canvas = tk.Canvas(self, bg=t["bg"], highlightthickness=0)
        vsb = tk.Scrollbar(self, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=vsb.set)
        vsb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        inner = tk.Frame(canvas, bg=t["bg"])
        canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))

        # Dynamic totals so guide never goes stale when lessons are added
        try:
            _py_sets = get_lesson_sets_for_language("python")
            _java_sets = get_lesson_sets_for_language("java")
            _py_total = sum(len(v) for v in _py_sets.values())
            _java_total = sum(len(v) for v in _java_sets.values())
            _subtitle = f"Not required. Use it only if you want a loose schedule. All {_py_total} Python + {_java_total} Java lessons stay unlocked — go at your own pace."
        except Exception:
            _subtitle = "Not required. Use it only if you want a loose schedule. All lessons stay unlocked — go at your own pace."
        hdr = tk.Frame(inner, bg=t["panel"], padx=SP["xl"], pady=SP["xl"])
        hdr.pack(fill="x", padx=SP["xl"], pady=(SP["xl"], SP["md"]))
        tk.Label(hdr, text="🗓  Planning Guide — Optional", bg=t["panel"], fg=t["text"], font=FONTS["heading_lg"]).pack(anchor="w")
        tk.Label(hdr, text=_subtitle,
                 bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"], wraplength=680, justify="left").pack(anchor="w", pady=(SP["xs"], 0))
        tk.Label(hdr, text="Tip: Python Beginner → Java Beginner → back is fine, but finishing one Beginner track fully first is usually less confusing.",
                 bg=t["panel"], fg=t["muted"], font=FONTS["caption"], wraplength=680, justify="left").pack(anchor="w", pady=(SP["xs"], 0))

        # 3 plans
        for title, pace, weeks in [
            ("2-Week Crash", "9 lessons/week", [
                "Week 1: Python Beginner 1-5 + Java Beginner 1-4 (core + for/if)",
                "Week 2: Python Beginner 6-9 + Java Beginner 5-9 (while/booleans) + pick one Intermediate starter",
            ]),
            ("4-Week Steady (Recommended)", "4-5 lessons/week + 1 review/day", [
                "Week 1: Python Beginner 1-4, Java Beginner 1-2",
                "Week 2: Python Beginner 5-9, Java Beginner 3-5",
                "Week 3: Python Intermediate 1-4, Java Intermediate 1-4",
                "Week 4: Your choice: finish Intermediate or start Advanced 1-2 + 1 Sandbox project",
            ]),
            ("6-Week Deep", "3 lessons/week, lots of sandbox", [
                "Weeks 1-2: Both Beginners fully – compare Python vs Java daily",
                "Weeks 3-4: Both Intermediates – focus on HashMap/HashSet vs dict/set",
                "Weeks 5-6: Pick one Advanced track (Streams/Generics or Decorators/Generators) + 2 Sandbox builds",
            ]),
        ]:
            card = RoundedCard(inner, theme=t, page_bg=t["bg"], pad=SP["lg"])
            card.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
            card.content.configure(bg=t["panel"])
            tk.Label(card.content, text=title, bg=t["panel"], fg=t["text"], font=FONTS["heading_sm"]).pack(anchor="w", padx=SP["lg"], pady=(SP["md"], 0))
            tk.Label(card.content, text=pace, bg=t["panel"], fg=t["accent"], font=FONTS["caption_bold"]).pack(anchor="w", padx=SP["lg"])
            for line in weeks:
                tk.Label(card.content, text="• " + line, bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w", wraplength=640, justify="left").pack(fill="x", padx=SP["lg"], pady=2)
            tk.Label(card.content, text="", bg=t["panel"]).pack()

        # How to use without pressure
        tip = tk.Frame(inner, bg=t["tip_bg"], padx=SP["lg"], pady=SP["md"])
        tip.pack(fill="x", padx=SP["xl"], pady=(0, SP["xl"]))
        tk.Label(tip, text="How to use without pressure", bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["body_bold"]).pack(anchor="w")
        for bullet in [
            "No lock: you can ignore this and go lesson-by-lesson via Skill Tree.",
            "Reset anytime: Settings → Reset Current Language or Reset Everything.",
            "If you interleave, do a full Beginner track first, then mirror the other language's Beginner – less mixing of print vs System.out.println.",
            "Daily: 1 lesson + 1 Review + optional Daily Challenge keeps streak alive.",
        ]:
            tk.Label(tip, text="• " + bullet, bg=t["tip_bg"], fg=t["tip_text"], font=FONTS["body_sm"], anchor="w", wraplength=640, justify="left").pack(fill="x", pady=2)

        btn_row = tk.Frame(inner, bg=t["bg"])
        btn_row.pack(fill="x", padx=SP["xl"], pady=(0, SP["xl"]))
        b1 = tk.Button(btn_row, text="← Back to Progress", command=lambda: self.controller.show_frame(ProgressPage))
        b1.pack(side="left", padx=(0, SP["sm"]))
        style_button(b1, t, "secondary_btn_bg", "secondary_btn_hover")
        b2 = tk.Button(btn_row, text="Go to Learning →", command=lambda: self.controller.show_frame(LearningPage))
        b2.pack(side="left")
        style_button(b2, t, "accent", "accent_hover")


class LearningPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent, bg=controller.theme["bg"])
        self.controller = controller
        self.lesson_sets = self._build_lesson_sets()
        self._pw = None
        self._preserve_code = None

    def refresh(self):
        t = self.controller.theme
        p = self.controller.progress
        self.configure(bg=t["bg"])

        for w in self.winfo_children():
            w.destroy()

        level = p.get("level", "Beginner")
        lessons = self.lesson_sets.get(level, self.lesson_sets.get("Beginner", []))
        lesson_idx = min(p.get("lesson_index", 0), max(len(lessons) - 1, 0))
        lesson = lessons[lesson_idx]
        steps = lesson.get("steps", [])
        completed_steps_dict = p.get("completed_steps", {})
        step_idx = self._get_step_idx(level, lesson_idx, len(steps))

        if steps:
            actionable = [i for i, s in enumerate(steps) if s["type"] != "concept"]
            all_steps_done = all(
                step_key(level, lesson_idx, i) in completed_steps_dict
                for i in actionable
            ) if actionable else True
        else:
            all_steps_done = True

        completed_lessons = list(p.get("completed_lessons", []))
        lesson_complete = lesson_idx in completed_lessons

        due_n = len(due_reviews(p, self.lesson_sets))
        if due_n:
            banner = tk.Frame(self, bg=t["warning_bg"], padx=SP["xl"], pady=SP["sm"])
            banner.pack(fill="x")
            tk.Label(banner, text=f"\U0001F4DA {due_n} review{' is' if due_n == 1 else 's are'} due \u2014 tap "
                                  "Review in the top bar to recall them before you forget.",
                     bg=t["warning_bg"], fg=t["warning"], font=FONTS["body_sm"],
                     anchor="w", cursor="hand2").pack(anchor="w")
            for w in banner.winfo_children():
                w.bind("<Button-1>", lambda e: self.controller.show_frame(ReviewQueuePage))

        header = tk.Frame(self, bg=t["panel"], padx=SP["xl"], pady=SP["md"])
        header.pack(fill="x")

        tk.Label(header, text=lesson["title"], bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_md"]).pack(side="left")

        unit_name = lesson.get("unit")
        if unit_name:
            tk.Label(header, text=f"\u00B7 {unit_name}", bg=t["panel"], fg=t["muted"],
                     font=FONTS["body_sm"]).pack(side="left", padx=(SP["sm"], 0))

        if all_steps_done and not lesson_complete:
            step_text = "Final Project"
        elif all_steps_done and lesson_complete:
            step_text = "Completed"
        elif steps:
            step_text = f"Step {step_idx + 1} of {len(steps)}"
        else:
            step_text = ""
        tk.Label(header, text=step_text, bg=t["panel"], fg=t["muted"],
                 font=FONTS["body_sm"]).pack(side="right")

        if all_steps_done:
            pct = 1.0
        elif steps:
            pct = (step_idx + 1) / len(steps)
        else:
            pct = 0
        bar = tk.Frame(self, bg=t["progress_bg"], height=6)
        bar.pack(fill="x", padx=SP["xl"], pady=(0, SP["sm"]))
        bar.pack_propagate(False)
        tk.Frame(bar, bg=t["progress_fill"]).place(relx=0, rely=0, relwidth=pct, relheight=1.0)

        if steps:
            dots = tk.Frame(self, bg=t["bg"])
            dots.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
            for i in range(len(steps)):
                sk = step_key(level, lesson_idx, i)
                done = sk in completed_steps_dict
                is_current = (i == step_idx and not all_steps_done)
                color = t["success"] if done else (t["accent"] if is_current else t["progress_bg"])
                c = tk.Canvas(dots, width=14, height=14, bg=t["bg"], highlightthickness=0)
                c.pack(side="left", padx=SP["xs"])
                c.create_oval(2, 2, 12, 12, fill=color, outline="")
                if done:
                    c.create_line(4.1, 7.2, 6.0, 9.1, 10.4, 4.2,
                                  fill="#ffffff", width=2)

        pw = tk.PanedWindow(self, orient="horizontal", sashwidth=3,
                            sashrelief="flat", bg=t["divider"])
        pw.pack(fill="both", expand=True, padx=SP["xl"], pady=(0, SP["sm"]))

        left = tk.Frame(pw, bg=t["panel"])
        pw.add(left, width=380, minsize=280)
        right = tk.Frame(pw, bg=t["bg"])
        pw.add(right, width=500, minsize=350)

        if all_steps_done:
            self._build_final_project_view(left, right, lesson, t, level, lesson_idx)
        elif steps:
            step = steps[step_idx]
            if step["type"] == "concept":
                self._build_concept_view(left, right, step, t)
            elif step["type"] == "practice":
                self._build_practice_view(left, right, step, t, level, lesson_idx, step_idx, lesson.get("title", ""))
            elif step["type"] == "debug":
                self._build_debug_view(left, right, step, t, level, lesson_idx, step_idx, lesson.get("title", ""))
            elif step["type"] == "fill":
                self._build_fill_view(left, right, step, t, level, lesson_idx, step_idx)
            elif step["type"] == "review":
                self._build_review_view(left, right, step, t, level, lesson_idx, step_idx)

        nav = tk.Frame(self, bg=t["bg"])
        nav.pack(fill="x", padx=SP["xl"], pady=SP["md"])

        if all_steps_done:
            def do_complete():
                was_already = lesson_idx in completed_lessons
                self._complete_lesson()
                if not was_already:
                    show_toast(self.winfo_toplevel(), "\u2713 Lesson Complete! +10 XP", t)

            complete_btn = tk.Button(nav, text="Mark Complete \u2713", font=FONTS["button"],
                                     command=do_complete, padx=SP["xl"], pady=SP["md"])
            complete_btn.pack(side="left")
            style_button(complete_btn, t, "success", "success")
            if lesson_complete:
                complete_btn.configure(text="Completed \u2713", state="disabled")

            if lesson_idx < len(lessons) - 1:
                def go_next_lesson():
                    p = self.controller.progress
                    completed = list(p.get("completed_lessons", []))
                    # "Next Lesson" should also check off the current lesson so progress isn't lost
                    if lesson_idx not in completed:
                        # Ensure all actionable steps are marked done
                        for si in actionable:
                            sk2 = step_key(level, lesson_idx, si)
                            if sk2 not in p.get("completed_steps", {}):
                                p.setdefault("completed_steps", {})[sk2] = True
                        # Keep per-level map in sync
                        cbl = p.setdefault("completed_by_level", {})
                        lst = cbl.setdefault(level, [])
                        if lesson_idx not in lst:
                            lst.append(lesson_idx)
                            lst.sort()
                        completed.append(lesson_idx)
                        completed.sort()
                        award_xp(p, 10, "lesson complete")
                        update_streak(p)
                        schedule_review(p, level, lesson_idx)
                        save_progress(self.controller.progress_path, p)
                        self.controller.celebrate(message="\U0001F393 Lesson complete! +10 XP")
                        self.controller.check_badges()
                        self.controller.update_progress(completed_lessons=completed, lesson_index=lesson_idx + 1, step_index=0)
                    else:
                        self.controller.update_progress(lesson_index=lesson_idx + 1, step_index=0)
                    self.refresh()
                next_btn = tk.Button(nav, text="Next Lesson \u2192", font=FONTS["button"],
                                     command=go_next_lesson, padx=SP["xl"], pady=SP["md"])
                next_btn.pack(side="right")
                style_button(next_btn, t, "accent", "accent_hover")
        elif steps:
            prev_btn = tk.Button(nav, text="\u2190 Previous", font=FONTS["button"],
                                 command=self._prev_step, padx=SP["lg"], pady=SP["md"])
            prev_btn.pack(side="left")
            style_button(prev_btn, t, "secondary_btn_bg", "secondary_btn_hover")
            if step_idx == 0:
                prev_btn.configure(state="disabled")

            sk = step_key(level, lesson_idx, step_idx)
            step_done = sk in completed_steps_dict
            step_type = steps[step_idx]["type"]
            can_next = step_type == "concept" or step_done

            if step_idx < len(steps) - 1:
                next_btn = tk.Button(nav, text="Next \u2192", font=FONTS["button"],
                                     command=self._next_step, padx=SP["lg"], pady=SP["md"])
            else:
                next_btn = tk.Button(nav, text="Finish Steps \u2192", font=FONTS["button"],
                                     command=self._next_step, padx=SP["lg"], pady=SP["md"])
            next_btn.pack(side="right")
            style_button(next_btn, t, "accent", "accent_hover")
            if not can_next:
                next_btn.configure(state="disabled")

        suggestion, reason, _ratio = assess_performance(p, level, self.lesson_sets)
        if suggestion == "up" and (lesson_idx + 1) % 2 == 0 and lesson_idx > 0:
            banner = tk.Frame(self, bg=t["success_bg"], bd=0, relief="flat")
            banner.pack(fill="x", padx=SP["xl"], pady=(0, SP["sm"]))
            b_bar = tk.Frame(banner, bg=t["success"], width=4)
            b_bar.pack(side="left", fill="y")
            b_inner = tk.Frame(banner, bg=t["success_bg"])
            b_inner.pack(side="left", fill="both", expand=True, padx=(SP["sm"], 0))
            tk.Label(
                b_inner, text="Performance Check", bg=t["success_bg"], fg=t["success"],
                font=FONTS["heading_sm"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(SP["md"], SP["xs"]))
            tk.Label(
                b_inner, text=reason, bg=t["success_bg"], fg=t["text"],
                font=FONTS["body"], anchor="w", wraplength=560, justify="left",
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))

            level_order = ["Beginner", "Intermediate", "Advanced"]
            next_level = level_order[level_order.index(level) + 1]

            btn_row = tk.Frame(b_inner, bg=t["success_bg"])
            btn_row.pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))

            def promote():
                update_streak(p)
                award_xp(p, 20)
                history = p.get("level_history", [])
                if next_level not in history:
                    history.append(next_level)
                # Preserve the just-finished level's progress in the per-level map before resetting
                cbl = p.setdefault("completed_by_level", {})
                cbl[level] = list(p.get("completed_lessons", []))
                # Keep completed_steps history (they are keyed by level) so earlier levels stay counted
                existing_steps = p.get("completed_steps", {})
                self.controller.update_progress(
                    level=next_level, lesson_index=0, step_index=0,
                    completed_lessons=[], completed_steps=existing_steps,
                    level_history=history,
                )
                save_progress(self.controller.progress_path, p)
                self.refresh()
                show_toast(self.winfo_toplevel(), f"\u2b50 Promoted to {next_level}! +20 XP", t)

            up_btn = tk.Button(
                btn_row, text=f"Move to {next_level} \u2192", font=FONTS["button_sm"],
                command=promote, padx=SP["md"], pady=SP["xs"],
            )
            up_btn.pack(side="left", padx=(0, SP["sm"]))
            style_button(up_btn, t, "success", "success")

            dismiss_btn = tk.Button(
                btn_row, text="Stay here", font=FONTS["button_sm"],
                command=lambda: banner.destroy(), padx=SP["md"], pady=SP["xs"],
            )
            dismiss_btn.pack(side="left")
            style_button(dismiss_btn, t, "secondary_btn_bg", "secondary_btn_hover")

        elif suggestion == "stay" and (lesson_idx + 1) % 2 == 0 and lesson_idx > 0:
            banner = tk.Frame(self, bg=t["warning_bg"], bd=0, relief="flat")
            banner.pack(fill="x", padx=SP["xl"], pady=(0, SP["sm"]))
            b_bar = tk.Frame(banner, bg=t["warning"], width=4)
            b_bar.pack(side="left", fill="y")
            b_inner = tk.Frame(banner, bg=t["warning_bg"])
            b_inner.pack(side="left", fill="both", expand=True, padx=(SP["sm"], 0))
            tk.Label(
                b_inner, text="Pace Check", bg=t["warning_bg"], fg=t["warning"],
                font=FONTS["heading_sm"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(SP["md"], SP["xs"]))
            tk.Label(
                b_inner, text=reason + " Solidifying these basics now makes the harder units easier later.",
                bg=t["warning_bg"], fg=t["text"], font=FONTS["body"],
                anchor="w", wraplength=560, justify="left",
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))

            pace_row = tk.Frame(b_inner, bg=t["warning_bg"])
            pace_row.pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))

            review_btn = tk.Button(
                pace_row, text="Open Review  \u2192", font=FONTS["button_sm"],
                command=lambda: self.controller.show_frame(ReviewQueuePage),
                padx=SP["md"], pady=SP["xs"],
            )
            review_btn.pack(side="left", padx=(0, SP["sm"]))
            style_button(review_btn, t, "warning", "warning_bg")

            keep_btn = tk.Button(
                pace_row, text="Keep going", font=FONTS["button_sm"],
                command=lambda: banner.destroy(), padx=SP["md"], pady=SP["xs"],
            )
            keep_btn.pack(side="left")
            style_button(keep_btn, t, "secondary_btn_bg", "secondary_btn_hover")

    def _get_step_idx(self, level, lesson_idx, total_steps):
        if total_steps == 0:
            return 0
        idx = self.controller.progress.get("step_index", 0)
        return min(max(idx, 0), total_steps - 1)

    def _build_left_scroll(self, parent, t):
        canvas = tk.Canvas(parent, bg=t["panel"], highlightthickness=0)
        scrollbar = tk.Scrollbar(parent, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=scrollbar.set)
        scrollbar.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        inner = tk.Frame(canvas, bg=t["panel"])
        canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1 * (e.delta / 120)), "units"))
        return inner

    def _build_concept_view(self, left, right, step, t):
        inner = self._build_left_scroll(left, t)

        badge = tk.Label(inner, text="CONCEPT", bg=t["tip_bg"], fg=t["tip_text"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        badge.pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

        tk.Label(inner, text=step["title"], bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_lg"], anchor="w", wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        tk.Label(inner, text=step["content"], bg=t["panel"], fg=t["text_secondary"],
                 font=FONTS["body"], anchor="w", wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        if step.get("example"):
            add_divider(inner, t, SP["md"])
            tk.Label(inner, text="Example", bg=t["panel"], fg=t["text"],
                     font=FONTS["heading_sm"], anchor="w").pack(fill="x", padx=SP["xl"])
            ex_frame = tk.Frame(inner, bg=t["code_bg"], relief="solid", bd=1)
            ex_frame.pack(fill="x", padx=SP["xl"], pady=(SP["sm"], SP["lg"]))
            tk.Label(ex_frame, text=step["example"], bg=t["code_bg"], fg=t["text"],
                     font=FONTS["code"], anchor="nw", justify="left",
                     padx=SP["md"], pady=SP["md"]).pack(fill="x")

        tk.Label(right, text="Code Example", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=(SP["xl"], SP["sm"]))
        if step.get("example"):
            code_display = tk.Text(right, height=12, font=FONTS["code"], bg=t["code_bg"],
                                   fg=t["text"], relief="solid", bd=1, wrap="word")
            code_display.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
            code_display.insert("1.0", step["example"])
            highlight_syntax(code_display, step["example"], t)
            code_display.configure(state="disabled")

        cont_btn = tk.Button(right, text="I understand, continue \u2192", font=FONTS["button"],
                             command=self._next_step, padx=SP["lg"], pady=SP["md"])
        cont_btn.pack(pady=SP["lg"])
        style_button(cont_btn, t, "success", "success")

    def _build_practice_view(self, left, right, step, t, level, lesson_idx, step_idx, lesson_title=""):
        inner = self._build_left_scroll(left, t)

        badge = tk.Label(inner, text="PRACTICE", bg=t["xp_bg"], fg=t["xp_text"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        badge.pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

        tk.Label(inner, text=step.get("instruction", ""), bg=t["panel"], fg=t["text"],
                 font=FONTS["body"], anchor="w", wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(SP["sm"], SP["md"]))

        attempts = [0]
        p = self.controller.progress

        def _coach_after_miss(code):
            """After 2+ failed attempts, the Coach proactively posts a non-solution nudge."""
            key = attempt_key(level, lesson_idx)
            fails = sum(1 for v in p.get("code_check_attempts", {}).get(key, []) if not v)
            if fails in (2, 3, 4):
                coach_panel.offer(coach_proactive(code, step, fails,
                                                  self.controller.progress.get("level", "")),
                                  coach_btn)
                return True
            return False

        tk.Label(right, text="Your Code", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=(SP["xl"], SP["sm"]))

        sk = step_key(level, lesson_idx, step_idx)

        code_entry = SyntaxEditor(right, theme=t, height=10, font=FONTS["code"], bg=t["input_bg"],
                             fg=t["text"], insertbackground=t["text"],
                             relief="solid", bd=1, undo=True)
        code_entry.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
        tk.Label(right, text="Tip: press Ctrl+Enter in the editor to run your code.",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"], anchor="w"
                 ).pack(anchor="w", padx=SP["lg"], pady=(0, SP["xs"]))
        restore = getattr(self, "_preserve_code", None)
        if restore and isinstance(restore, str):
            code_entry.set_code(restore)
        else:
            drafted = self.controller.progress.get("draft_code", {}).get(sk)
            code_entry.set_code(drafted or step.get("starter_code", ""))
        self._preserve_code = None
        code_entry.bind("<KeyRelease>", lambda _e: self._capture_draft(sk, code_entry), add="+")

        tk.Label(right, text="Output", bg=t["bg"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(anchor="w", padx=SP["lg"])
        output_box = tk.Text(right, height=4, font=FONTS["code"], bg=t["code_bg"],
                             fg=t["text"], relief="solid", bd=1, wrap="word")
        output_box.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        output_box.configure(state="disabled")

        feedback_var = tk.StringVar(value="")
        feedback_lbl = tk.Label(right, textvariable=feedback_var, bg=t["bg"],
                                font=FONTS["body_bold"], anchor="w", wraplength=460, justify="left")
        feedback_lbl.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        already_done = sk in self.controller.progress.get("completed_steps", {})
        if already_done:
            feedback_var.set("\u2713 Already completed!")
            feedback_lbl.configure(fg=t["success"])

        btn_row = tk.Frame(right, bg=t["bg"])
        btn_row.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        def run_code():
            code = code_entry.get("1.0", tk.END)
            stripped = code.strip()
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)
            if not stripped:
                output_box.configure(state="disabled")
                return

            res = self._run_code(code)
            _focus_hidden = bool(self.controller.progress.get("focus_mode"))
            if _focus_hidden:
                output_box.insert("1.0", "🔒 Focus mode: output hidden — disable in Settings → Focus mode to see results, or click Reveal below.")
                output_box.configure(state="disabled")
                # store for potential Reveal (added below)
                output_box._focus_hidden_res = res
                output_box._focus_hidden_code = code
            if res["blocked"]:
                if not _focus_hidden:
                    output_box.configure(state="normal")
                    output_box.delete("1.0", tk.END)
                    output_box.insert("1.0", res["blocked"])
                    output_box.configure(state="disabled")
                feedback_var.set("Your code was blocked \u2014 see the output and stick to the tools allowed in the playground." if not _focus_hidden else "Focus mode: blocked output hidden — Reveal to see.")
                feedback_lbl.configure(fg=t["error"])
                code_entry.configure(highlightbackground=t["error"], highlightthickness=2)
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                return

            if not res["ok"]:
                shown = res["output"]
                if shown and res["error"]:
                    shown += "\n\n"
                if not _focus_hidden:
                    output_box.configure(state="normal")
                    output_box.delete("1.0", tk.END)
                    output_box.insert("1.0", shown + res["error"])
                output_box.configure(state="disabled")
                attempts[0] += 1
                record_attempt(p, level, lesson_idx, False)
                save_progress(self.controller.progress_path, p)
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                _coach_after_miss(code)
                if attempts[0] == 1:
                    feedback_var.set(res["explained"] or "Your code hit a Python error \u2014 check the output box.")
                else:
                    feedback_var.set("\u2717 Another error \u2014 the Coach can help you decode it.")
                feedback_lbl.configure(fg=t["error"])
                code_entry.configure(highlightbackground=t["error"], highlightthickness=2)
                return

            if not _focus_hidden:
                output_box.configure(state="normal")
                output_box.delete("1.0", tk.END)
                output_box.insert("1.0", res["output"] if res["output"] else "(ran without errors \u2014 add a print() to see output)")
                output_box.configure(state="disabled")

            ok = step["check"](code) if "check" in step else False
            if ok:
                feedback_var.set(f"\u2713 {step.get('success_msg', 'Correct!')}")
                feedback_lbl.configure(fg=t["success"])
                code_entry.configure(highlightbackground=t["success"], highlightthickness=2)
                newly_done = self._mark_step_done(level, lesson_idx, step_idx)
                if newly_done:
                    award_xp(p, 5, "practice step")
                    update_streak(p)
                    show_toast(self.winfo_toplevel(), "\u2713 Correct! +5 XP", t)
                    save_progress(self.controller.progress_path, p)
                    self.controller.check_badges()
                save_progress(self.controller.progress_path, p)
                self.controller.sidebar.refresh()
                self._preserve_code = code
                self.after(1, self.refresh)
            else:
                attempts[0] += 1
                record_attempt(p, level, lesson_idx, False)
                save_progress(self.controller.progress_path, p)
                try:
                    coach_panel.offer(coach_hint_specific(code, step, self.controller.progress.get("level", "")), coach_btn)
                except Exception:
                    pass
                if attempts[0] == 1:
                    feedback_var.set("\u2717 Your code ran, but it doesn't match the goal yet. Compare it with the instruction, or ask the Coach for a hint.")
                elif _coach_after_miss(code):
                    feedback_var.set("\U0001F4A1 The Coach hopped in with a hint \u2014 read its pointer and give it another go.")
                else:
                    feedback_var.set("\u2717 It ran, but the goal isn't hit yet. Ask the Coach what's still missing.")
                feedback_lbl.configure(fg=t["warning"])
                code_entry.configure(highlightbackground=t["warning"], highlightthickness=2)

        run_btn = tk.Button(btn_row, text="\u25b6 Run Code", font=FONTS["button"],
                            command=run_code, padx=SP["lg"], pady=SP["md"])
        run_btn.pack(side="left")
        style_button(run_btn, t, "accent", "accent_hover")

        clear_btn = tk.Button(btn_row, text="Clear", font=FONTS["button_sm"],
                              command=lambda: (code_entry.delete("1.0", tk.END),
                                               code_entry.insert("1.0", step.get("starter_code", "")),
                                               code_entry.configure(highlightbackground=t["input_border"], highlightthickness=1),
                                               feedback_var.set(""),
                                               output_box.configure(state="normal"),
                                               output_box.delete("1.0", tk.END),
                                               output_box.configure(state="disabled")),
                              padx=SP["md"], pady=SP["xs"])
        clear_btn.pack(side="left", padx=SP["sm"])
        style_button(clear_btn, t, "secondary_btn_bg", "secondary_btn_hover")

        def reveal_hidden():
            res_hidden = getattr(output_box, "_focus_hidden_res", None)
            if res_hidden is None:
                return
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)
            if res_hidden.get("blocked"):
                output_box.insert("1.0", res_hidden["blocked"])
            elif not res_hidden.get("ok"):
                shown = res_hidden.get("output", "")
                err = res_hidden.get("error", "")
                if shown and err:
                    shown += "\n\n"
                output_box.insert("1.0", (shown + err) if shown or err else res_hidden.get("explained", ""))
            else:
                output_box.insert("1.0", res_hidden.get("output") or "(ran without errors)")
            output_box.configure(state="disabled")
            reveal_btn.pack_forget()
            feedback_var.set("Revealed — compare output to the goal.")
            feedback_lbl.configure(fg=t["muted"])
        reveal_btn = tk.Button(btn_row, text="👁 Reveal", font=FONTS["button_sm"],
                               command=reveal_hidden, padx=SP["md"], pady=SP["xs"])
        style_button(reveal_btn, t, "warning", "warning_bg")
        # only show when focus mode hides something; run_code will pack it
        # hook run_code to show button when hidden
        _orig_run = run_code
        def _run_with_reveal():
            _orig_run()
            # if focus hid output, show reveal button
            if getattr(output_box, "_focus_hidden_res", None) is not None and bool(self.controller.progress.get("focus_mode")):
                # check if output still hidden placeholder
                try:
                    reveal_btn.pack(side="left", padx=SP["xs"])
                except Exception:
                    pass
            else:
                try:
                    reveal_btn.pack_forget()
                except Exception:
                    pass
        # rebind run_btn to use wrapper (keep original for binding)
        run_btn.configure(command=_run_with_reveal)
        # also update key binding to use wrapper
        code_entry.bind("<Control-Return>", lambda _e: (_run_with_reveal(), "break")[1])
        code_entry.bind("<Command-Return>", lambda _e: (_run_with_reveal(), "break")[1])

        def get_code():
            return code_entry.get("1.0", tk.END)

        coach_panel = CoachPanel(right, t, get_code, step, lesson_title, self.controller)
        coach_btn = tk.Button(btn_row, text="\U0001F3C5 Ask Coach", font=FONTS["button_sm"],
                              command=lambda: coach_panel.toggle(coach_btn), padx=SP["md"], pady=SP["xs"])
        coach_btn.pack(side="left")
        style_button(coach_btn, t, "warning", "warning_bg")

        trace_box = tk.Text(right, height=9, font=FONTS["code_sm"], bg=t["code_bg"],
                            fg=t["text"], relief="solid", bd=1, wrap="word")
        trace_box.configure(state="disabled")

        def toggle_trace():
            if trace_box.winfo_ismapped():
                trace_box.pack_forget()
                trace_btn.configure(text="\U0001F50D Trace steps")
                return
            code = code_entry.get("1.0", tk.END)
            res = self._run_code(code, timeout=3, trace=True)
            trace_box.configure(state="normal")
            trace_box.delete("1.0", tk.END)
            if not res["ok"] and not res["trace"]:
                trace_box.insert("1.0", res["blocked"] or res["explained"] or res["error"])
            else:
                trace_box.insert("1.0", format_trace_steps(res["trace"]))
            trace_box.configure(state="disabled")
            trace_box.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
            trace_btn.configure(text="\U0001F50D Hide trace")

        trace_btn = tk.Button(btn_row, text="\U0001F50D Trace steps", font=FONTS["button_sm"],
                              command=toggle_trace, padx=SP["md"], pady=SP["xs"])
        trace_btn.pack(side="left", padx=SP["sm"])
        style_button(trace_btn, t, "success", "success")

        code_entry.bind("<Control-Return>", lambda _e: (run_code(), "break")[1])
        code_entry.bind("<Command-Return>", lambda _e: (run_code(), "break")[1])
        code_entry.bind("<Control-Shift-Return>", lambda _e: (toggle_trace(), "break")[1])

    def _build_debug_view(self, left, right, step, t, level, lesson_idx, step_idx, lesson_title=""):
        """A 'debug this' practice: the editor is pre-filled with BROKEN code and
        the learner must fix it so it runs and meets the goal. Teaches the
        real-world skill of reading and repairing code -- not just writing fresh."""
        inner = self._build_left_scroll(left, t)

        badge = tk.Label(inner, text="DEBUG", bg=t["error_bg"], fg=t["error"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        badge.pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

        tk.Label(inner, text=step.get("instruction", "Fix the broken code."), bg=t["panel"], fg=t["text"],
                 font=FONTS["body"], anchor="w", wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(SP["sm"], SP["md"]))

        bug_text = step.get("bug_notes", "")
        if bug_text:
            bug_card = RoundedCard(inner, theme=t, page_bg=t["panel"], pad=SP["md"])
            bug_card.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
            bug_card.content.configure(bg=t["error_bg"])
            tk.Label(bug_card.content, text="\u26A0 What's wrong:", bg=t["error_bg"],
                     fg=t["error"], font=FONTS["caption_bold"], anchor="w").pack(
                fill="x", padx=SP["md"], pady=(SP["xs"], 0))
            tk.Label(bug_card.content, text=bug_text, bg=t["error_bg"],
                     fg=t["error"], font=FONTS["caption"], anchor="w", wraplength=320,
                     justify="left").pack(fill="x", padx=SP["md"], pady=(0, SP["xs"]))

        attempts = [0]
        p = self.controller.progress
        broken_code = step.get("broken_code", "")
        goal_hint = step.get("goal_hint", "")

        def check_debug():
            code = code_entry.get("1.0", tk.END)
            res = self._run_code(code, timeout=5)
            if res["blocked"]:
                feedback_var.set(res["blocked"])
                feedback_lbl.configure(fg=t["error"])
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                return
            if not res["ok"]:
                attempts[0] += 1
                record_attempt(p, level, lesson_idx, False)
                save_progress(self.controller.progress_path, p)
                feedback_var.set(res["explained"] or res["error"] or "Your fix still has a bug \u2014 check the output.")
                feedback_lbl.configure(fg=t["error"])
                code_entry.configure(highlightbackground=t["error"], highlightthickness=2)
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                return

            ok = step["check"](code) if "check" in step else True
            if ok:
                feedback_var.set(step.get("success_msg", "\u2713 Bug fixed! Your code runs and meets the goal."))
                feedback_lbl.configure(fg=t["success"])
                code_entry.configure(highlightbackground=t["success"], highlightthickness=2)
                newly_done = self._mark_step_done(level, lesson_idx, step_idx)
                if newly_done:
                    award_xp(p, 8, "debug fix")
                    update_streak(p)
                    show_toast(self.winfo_toplevel(), "\u2713 Debugged! +8 XP", t)
                    save_progress(self.controller.progress_path, p)
                    self.controller.check_badges()
                save_progress(self.controller.progress_path, p)
                self.controller.sidebar.refresh()
                self._preserve_code = code
                self.after(1, self.refresh)
            else:
                attempts[0] += 1
                record_attempt(p, level, lesson_idx, False)
                save_progress(self.controller.progress_path, p)
                feedback_var.set(goal_hint or "\u2717 It runs now, but it doesn't fully meet the goal yet. Compare with the instruction.")
                feedback_lbl.configure(fg=t["warning"])
                code_entry.configure(highlightbackground=t["warning"], highlightthickness=2)
                try:
                    coach_panel.offer(coach_hint_specific(code, step, self.controller.progress.get("level", "")), coach_btn)
                except Exception:
                    pass

        # Right: the editor is pre-filled with the broken code
        tk.Label(right, text="Buggy Code \u2014 Fix It", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=(SP["xl"], SP["sm"]))

        code_entry = SyntaxEditor(right, theme=t, height=14, font=FONTS["code"], bg=t["input_bg"],
                                  fg=t["text"], insertbackground=t["text"],
                                  relief="solid", bd=1, undo=True)
        code_entry.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
        restore = getattr(self, "_preserve_code", None)
        code_entry.set_code(restore if isinstance(restore, str) else broken_code)
        self._preserve_code = None

        tk.Label(right, text="Output", bg=t["bg"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(anchor="w", padx=SP["lg"])
        output_box = tk.Text(right, height=5, font=FONTS["code"], bg=t["code_bg"],
                             fg=t["text"], relief="solid", bd=1, wrap="word")
        output_box.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        output_box.configure(state="disabled")

        feedback_var = tk.StringVar(value="")
        feedback_lbl = tk.Label(right, textvariable=feedback_var, bg=t["bg"],
                                font=FONTS["body_bold"], anchor="w", wraplength=460, justify="left")
        feedback_lbl.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        def run():
            code = code_entry.get("1.0", tk.END)
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)
            res = self._run_code(code, timeout=5)
            if res["blocked"]:
                output_box.insert("1.0", res["blocked"])
                output_box.configure(state="disabled")
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                return
            shown = res["output"]
            if shown and res["error"]:
                shown += "\n\n"
            output_box.insert("1.0", shown + (res["error"] if not res["ok"] else ""))
            output_box.configure(state="disabled")
            if not res["ok"]:
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
            if res["ok"]:
                check_debug()

        btn_row = tk.Frame(right, bg=t["bg"])
        btn_row.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        run_btn = tk.Button(btn_row, text="\u25b6 Run & Check", font=FONTS["button"],
                            command=run, padx=SP["lg"], pady=SP["md"])
        run_btn.pack(side="left")
        style_button(run_btn, t, "accent", "accent_hover")
        tk.Label(btn_row, text="Tip: press Ctrl+Enter to run.",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"]).pack(side="left", padx=SP["md"])

        def get_code():
            return code_entry.get("1.0", tk.END)

        coach_panel = CoachPanel(right, t, get_code, step, lesson_title, self.controller)
        coach_btn = tk.Button(btn_row, text="\U0001F3C5 Ask Coach", font=FONTS["button_sm"],
                              command=lambda: coach_panel.toggle(coach_btn), padx=SP["md"], pady=SP["xs"])
        coach_btn.pack(side="left", padx=SP["sm"])
        style_button(coach_btn, t, "warning", "warning_bg")

        code_entry.bind("<Control-Return>", lambda _e: (run(), "break")[1])
        code_entry.bind("<Command-Return>", lambda _e: (run(), "break")[1])

    def _build_fill_view(self, left, right, step, t, level, lesson_idx, step_idx):
        """A fill-in-the-blank code exercise: a snippet with one or more ___ blanks.
        The learner types the missing pieces, then runs it to check the output.
        Strengthens the skill of recognizing syntax and reading code."""

        inner = self._build_left_scroll(left, t)

        badge = tk.Label(inner, text="FILL IN", bg=t["xp_bg"], fg=t["xp_text"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        badge.pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

        tk.Label(inner, text=step.get("instruction", "Fill in the blanks to complete the code."),
                 bg=t["panel"], fg=t["text"], font=FONTS["body"], anchor="w",
                 wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(SP["sm"], SP["md"]))

        template = step.get("template", "")
        tk.Label(inner, text="The finished program should print the expected output shown in the goal.",
                 bg=t["panel"], fg=t["text_secondary"], font=FONTS["caption"], anchor="w",
                 wraplength=340, justify="left").pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        p = self.controller.progress

        tk.Label(right, text="Complete the Code (replace ___)", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=(SP["xl"], SP["sm"]))

        code_entry = SyntaxEditor(right, theme=t, height=14, font=FONTS["code"], bg=t["input_bg"],
                                  fg=t["text"], insertbackground=t["text"],
                                  relief="solid", bd=1, undo=True)
        code_entry.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
        restore = getattr(self, "_preserve_code", None)
        code_entry.set_code(restore if isinstance(restore, str) else template)
        self._preserve_code = None

        tk.Label(right, text="Output", bg=t["bg"], fg=t["muted"],
                 font=FONTS["caption_bold"], anchor="w").pack(anchor="w", padx=SP["lg"])
        output_box = tk.Text(right, height=5, font=FONTS["code"], bg=t["code_bg"],
                             fg=t["text"], relief="solid", bd=1, wrap="word")
        output_box.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        output_box.configure(state="disabled")

        feedback_var = tk.StringVar(value="")
        feedback_lbl = tk.Label(right, textvariable=feedback_var, bg=t["bg"],
                                font=FONTS["body_bold"], anchor="w", wraplength=460, justify="left")
        feedback_lbl.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        def check():
            code = code_entry.get("1.0", tk.END)
            res = self._run_code(code, timeout=5)
            if res["blocked"]:
                feedback_var.set(res["blocked"])
                feedback_lbl.configure(fg=t["error"])
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                return
            if not res["ok"]:
                record_attempt(p, level, lesson_idx, False)
                save_progress(self.controller.progress_path, p)
                feedback_var.set(res["explained"] or res["error"] or "Your code errored \u2014 check the blanks.")
                feedback_lbl.configure(fg=t["error"])
                code_entry.configure(highlightbackground=t["error"], highlightthickness=2)
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                return
            ok = step.get("expected_output") and res["output"] == step["expected_output"]
            accept_check = step.get("check")
            if not ok and accept_check and callable(accept_check):
                ok = accept_check(code)
            if ok:
                feedback_var.set(step.get("success_msg", "\u2713 Correct! The code runs and matches the goal."))
                feedback_lbl.configure(fg=t["success"])
                code_entry.configure(highlightbackground=t["success"], highlightthickness=2)
                newly_done = self._mark_step_done(level, lesson_idx, step_idx)
                if newly_done:
                    award_xp(p, 8, "fill in the blank")
                    update_streak(p)
                    show_toast(self.winfo_toplevel(), "\u2713 Correct! +8 XP", t)
                    save_progress(self.controller.progress_path, p)
                    self.controller.check_badges()
                save_progress(self.controller.progress_path, p)
                self.controller.sidebar.refresh()
                self._preserve_code = code
                self.after(1, self.refresh)
            else:
                record_attempt(p, level, lesson_idx, False)
                save_progress(self.controller.progress_path, p)
                feedback_var.set(step.get("goal_hint", "\u2717 It runs, but the output isn't what we want. Double-check each blank against the goal."))
                feedback_lbl.configure(fg=t["warning"])
                code_entry.configure(highlightbackground=t["warning"], highlightthickness=2)
                try:
                    coach_panel.offer(coach_hint_specific(code, step, self.controller.progress.get("level", "")), coach_btn)
                except Exception:
                    pass

        def run():
            code = code_entry.get("1.0", tk.END)
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)
            res = self._run_code(code, timeout=5)
            if res["blocked"]:
                output_box.insert("1.0", res["blocked"])
                output_box.configure(state="disabled")
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
                return
            shown = res["output"]
            if shown and res["error"]:
                shown += "\n\n"
            output_box.insert("1.0", shown + (res["error"] if not res["ok"] else ""))
            output_box.configure(state="disabled")
            if not res["ok"]:
                try:
                    coach_panel.offer(coach_diagnose(code, step, res), coach_btn)
                except Exception:
                    pass
            if res["ok"]:
                check()

        btn_row = tk.Frame(right, bg=t["bg"])
        btn_row.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        run_btn = tk.Button(btn_row, text="\u25b6 Run & Check", font=FONTS["button"],
                            command=run, padx=SP["lg"], pady=SP["md"])
        run_btn.pack(side="left")
        style_button(run_btn, t, "accent", "accent_hover")
        tk.Label(btn_row, text="Tip: press Ctrl+Enter to run.",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"]).pack(side="left", padx=SP["md"])

        def get_code():
            return code_entry.get("1.0", tk.END)

        coach_panel = CoachPanel(right, t, get_code, step, "", self.controller)
        coach_btn = tk.Button(btn_row, text="\U0001F3C5 Ask Coach", font=FONTS["button_sm"],
                              command=lambda: coach_panel.toggle(coach_btn), padx=SP["md"], pady=SP["xs"])
        coach_btn.pack(side="left", padx=SP["sm"])
        style_button(coach_btn, t, "warning", "warning_bg")

        code_entry.bind("<Control-Return>", lambda _e: (run(), "break")[1])
        code_entry.bind("<Command-Return>", lambda _e: (run(), "break")[1])

    def _build_review_view(self, left, right, step, t, level, lesson_idx, step_idx):
        inner = self._build_left_scroll(left, t)

        badge = tk.Label(inner, text="REVIEW", bg=t["warning_bg"], fg=t["warning"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        badge.pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

        tk.Label(inner, text="Quick Check", bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_md"], anchor="w").pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        tk.Label(inner, text=step["question"], bg=t["panel"], fg=t["text"],
                 font=FONTS["body"], anchor="w", wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        tk.Label(right, text="Choose your answer", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=(SP["xl"], SP["md"]))

        answer_var = tk.StringVar(value="")
        feedback_var = tk.StringVar(value="")
        options = step.get("options", [])

        for opt in options:
            rb = tk.Radiobutton(
                right, text=opt, variable=answer_var, value=opt,
                bg=t["bg"], fg=t["text"], selectcolor=t["input_bg"],
                activebackground=t["bg"], activeforeground=t["text"],
                font=FONTS["body"], anchor="w", padx=SP["md"], pady=SP["sm"],
            )
            rb.pack(fill="x", padx=SP["lg"])

        feedback_lbl = tk.Label(right, textvariable=feedback_var, bg=t["bg"],
                                font=FONTS["body_bold"], anchor="w", wraplength=460)
        feedback_lbl.pack(fill="x", padx=SP["lg"], pady=(SP["md"], 0))

        p = self.controller.progress
        sk = step_key(level, lesson_idx, step_idx)
        already_done = sk in self.controller.progress.get("completed_steps", {})
        if already_done:
            feedback_var.set("\u2713 Already completed!")
            feedback_lbl.configure(fg=t["success"])

        def check_answer():
            chosen = answer_var.get()
            if not chosen:
                feedback_var.set("Select an answer first.")
                feedback_lbl.configure(fg=t["warning"])
                return
            if chosen == step["answer"]:
                feedback_var.set(f"\u2713 Correct! {step['answer']}")
                feedback_lbl.configure(fg=t["success"])
                newly_done = self._mark_step_done(level, lesson_idx, step_idx)
                if newly_done:
                    award_xp(p, 5, "review answer")
                    update_streak(p)
                    show_toast(self.winfo_toplevel(), "\u2713 Correct! +5 XP", t)
                save_progress(self.controller.progress_path, p)
                self.controller.sidebar.refresh()
                self.after(1, self.refresh)
            else:
                record_attempt(p, level, lesson_idx, False)
                save_progress(self.controller.progress_path, p)
                feedback_var.set("\u2717 Not quite. Review the lesson and try again \u2014 keep trying until you get it right.")
                feedback_lbl.configure(fg=t["error"])

        check_btn = tk.Button(right, text="Check Answer", font=FONTS["button"],
                              command=check_answer, padx=SP["xl"], pady=SP["md"])
        check_btn.pack(pady=SP["lg"])
        style_button(check_btn, t, "accent", "accent_hover")

    def _build_final_project_view(self, left, right, lesson, t, level, lesson_idx):
        # ── Distinct project per lesson + per attempt (not same guidance/project every time) ──
        # Ensure variants exist, then pick active variant for this lesson
        try:
            _ensure_project_variants(lesson)
        except Exception:
            pass
        proj = get_active_project_variant(lesson, self.controller.progress, level, lesson_idx)
        if not proj:
            proj = lesson.get("final_project")
        if not proj:
            inner = self._build_left_scroll(left, t)
            tk.Label(inner, text="All steps complete!", bg=t["panel"], fg=t["text"],
                     font=FONTS["heading_md"]).pack(padx=SP["xl"], pady=SP["xl"])
            return
        # Ensure guidance fields exist (backward compat if file was old)
        try:
            enrich_project_with_guidance(lesson, proj)
        except Exception:
            pass
        inner = self._build_left_scroll(left, t)

        badge = tk.Label(inner, text="FINAL PROJECT", bg=t["warning_bg"], fg=t["warning"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"])
        badge.pack(anchor="w", padx=SP["xl"], pady=(SP["xl"], SP["sm"]))

        # Variant badge — shows this is not the same project every time
        variants = lesson.get("project_variants") or []
        if len(variants) > 1:
            try:
                v_idx = get_project_variant_index(self.controller.progress, level, lesson_idx, len(variants))
                v_label = chr(65 + v_idx)  # A, B, C
                tk.Label(inner, text=f"Variant {v_label} of {len(variants)}  •  Different project each time you retry", bg=t["tip_bg"], fg=t["tip_text"],
                         font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"]).pack(anchor="w", padx=SP["xl"], pady=(0, SP["xs"]))
            except Exception:
                pass

        tk.Label(inner, text=proj["title"], bg=t["panel"], fg=t["text"],
                 font=FONTS["heading_md"], anchor="w", wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(0, SP["sm"]))

        tk.Label(inner, text=proj["description"], bg=t["panel"], fg=t["text_secondary"],
                 font=FONTS["body"], anchor="w", wraplength=340, justify="left"
                 ).pack(fill="x", padx=SP["xl"], pady=(0, SP["xs"]))

        # Variant switcher — “Try a different project” for replay variety
        if len(variants) > 1:
            var_frame = tk.Frame(inner, bg=t["panel"], bd=1, relief="solid", padx=SP["md"], pady=SP["xs"])
            var_frame.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
            tk.Label(var_frame, text="Want a fresh challenge? Each attempt can be a different project with the same skills.", bg=t["panel"], fg=t["muted"],
                     font=FONTS["caption"], anchor="w", wraplength=300, justify="left").pack(fill="x")
            def _switch_variant():
                # Save draft first
                try:
                    if hasattr(self, "_proj_entry") and self._proj_entry and self._proj_entry.winfo_exists():
                        pk = project_draft_key(level, lesson_idx)
                        self.controller.progress.setdefault("draft_code", {})[pk] = self._proj_entry.get("1.0", tk.END)
                except Exception:
                    pass
                rotate_project_variant(self.controller.progress, level, lesson_idx, len(variants))
                save_progress(self.controller.progress_path, self.controller.progress)
                self.refresh()
            vb = tk.Button(var_frame, text=f"Try Variant {chr(65 + ((v_idx+1)%len(variants)))}  \u2192  Different scenario, same skills", font=FONTS["button_sm"],
                           command=_switch_variant, padx=SP["md"], pady=SP["xs"])
            vb.pack(anchor="w", pady=(SP["xs"], 0))
            style_button(vb, t, "secondary_btn_bg", "secondary_btn_hover")

        # Formula banner — distinct per lesson, not same guidance every time
        flow = tk.Frame(inner, bg=t["code_bg"], padx=SP["md"], pady=SP["xs"])
        flow.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
        tk.Label(flow, text="Project Flow  •  Description \u2192 Requirements \u2192 Milestones \u2192 Optional Hints \u2192 Solution Review",
                 bg=t["code_bg"], fg=t["muted"], font=FONTS["caption_bold"], anchor="w", wraplength=340, justify="left").pack(fill="x")
        if GUIDANCE_LOCKED:
            tk.Label(flow, text=f"Guidance locked to {level} for this lesson — each lesson’s project and guidance are different, not the same one repeated.",
                     bg=t["code_bg"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=340, justify="left").pack(fill="x")
        else:
            tk.Label(flow, text="Pick a guidance level below. Level 1 holds your hand, Level 2 lets you lead, Level 3 drops you in the real scenario.",
                     bg=t["code_bg"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=340, justify="left").pack(fill="x")

        # ── Guidance Level — locked to curriculum (different per lesson, not same) ──
        hint_key = project_hint_key(level, lesson_idx)
        cur_guidance = get_project_guidance_level(self.controller.progress, level, lesson_idx)
        selector = tk.Frame(inner, bg=t["panel"])
        selector.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
        if GUIDANCE_LOCKED:
            meta = GUIDANCE_LEVEL_META[cur_guidance]
            lock_frame = tk.Frame(selector, bg=t["code_bg"], bd=1, relief="solid", padx=SP["md"], pady=SP["sm"])
            lock_frame.pack(fill="x")
            tk.Label(lock_frame, text=f"{meta['icon']}  {meta['label']}  —  LOCKED to {level}", bg=t["code_bg"], fg=t["text"],
                     font=FONTS["body_bold"], anchor="w").pack(fill="x")
            tk.Label(lock_frame, text=meta["desc"] + " • Each lesson’s guidance is different — Beginner gets Strong, Intermediate gets Partial, Advanced gets Minimal. Not the same guidance every time.",
                     bg=t["code_bg"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=310, justify="left").pack(fill="x", pady=(SP["xs"], 0))
            lvl_desc_var = tk.StringVar(value=meta["label"] + " — " + meta["desc"])
            # Keep same var name for render_guidance sync, but selector is locked
            # Provide hidden switch function that does nothing (locked)
            def switch_guidance(new_lvl):
                return
            btn_refs = []
        else:
            tk.Label(selector, text="Choose Guidance — tap to switch", bg=t["panel"], fg=t["muted"],
                     font=FONTS["caption_bold"], anchor="w").pack(fill="x", pady=(0, SP["xs"]))
            btns_frame = tk.Frame(selector, bg=t["panel"])
            btns_frame.pack(fill="x")

            def switch_guidance(new_lvl):
                # Save draft before rebuild so you don't lose typing
                try:
                    if hasattr(self, "_proj_entry") and self._proj_entry and self._proj_entry.winfo_exists():
                        pk = project_draft_key(level, lesson_idx)
                        self.controller.progress.setdefault("draft_code", {})[pk] = self._proj_entry.get("1.0", tk.END)
                except Exception:
                    pass
                set_project_guidance_level(self.controller.progress, level, lesson_idx, new_lvl)
                save_progress(self.controller.progress_path, self.controller.progress)
                # Re-render just the guidance-dependent sections, then refresh hint rendering
                render_guidance()
                # Update selector button styles
                for b, lvl in btn_refs:
                    is_active = (lvl == new_lvl)
                    if is_active:
                        b.configure(bg=t["accent"], fg="white", relief="flat")
                    else:
                        b.configure(bg=t["card"], fg=t["text"], relief="solid", bd=1)
                try:
                    inner.update_idletasks()
                except Exception:
                    pass

            btn_refs = []
            for lvl in ("1", "2", "3"):
                meta = GUIDANCE_LEVEL_META[lvl]
                is_active = (lvl == cur_guidance)
                b = tk.Button(btns_frame, text=f"{meta['icon']} {meta['short']}\n{meta['tag']}",
                              font=FONTS["caption_bold"], padx=SP["sm"], pady=SP["xs"],
                              command=lambda l=lvl: switch_guidance(l),
                              justify="left", wraplength=95, bd=1, relief="flat" if is_active else "solid",
                              bg=(t["accent"] if is_active else t["card"]), fg=("white" if is_active else t["text"]),
                              activebackground=t["accent_hover"], activeforeground="white", cursor="hand2", highlightthickness=0)
                b.pack(side="left", expand=True, fill="x", padx=(0, SP["xs"]))
                btn_refs.append((b, lvl))
                def _on_enter(e, btn=b, lvl=lvl):
                    if lvl != get_project_guidance_level(self.controller.progress, level, lesson_idx):
                        btn.configure(bg=t["card_hover"])
                def _on_leave(e, btn=b, lvl=lvl):
                    if lvl != get_project_guidance_level(self.controller.progress, level, lesson_idx):
                        btn.configure(bg=t["card"])
                b.bind("<Enter>", _on_enter)
                b.bind("<Leave>", _on_leave)

            # Level description label (updates with switch)
            lvl_desc_var = tk.StringVar(value=GUIDANCE_LEVEL_META[cur_guidance]["desc"])
            tk.Label(selector, textvariable=lvl_desc_var, bg=t["panel"], fg=t["muted"],
                     font=FONTS["caption"], anchor="w").pack(fill="x", pady=(SP["xs"], 0))

        # ── Scenario (Real-world) ──
        if proj.get("scenario"):
            scen = tk.Frame(inner, bg=t["tip_bg"], bd=0, relief="flat")
            scen.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))
            scen_bar = tk.Frame(scen, bg=t["accent_border"], width=4)
            scen_bar.pack(side="left", fill="y")
            scen_inner = tk.Frame(scen, bg=t["tip_bg"])
            scen_inner.pack(side="left", fill="both", expand=True)
            tk.Label(
                scen_inner, text="THE SITUATION  \u2014  Real-world scenario", bg=t["tip_bg"], fg=t["tip_text"],
                font=FONTS["caption_bold"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(SP["md"], SP["xs"]))
            tk.Label(
                scen_inner, text=proj["scenario"], bg=t["tip_bg"], fg=t["tip_text"],
                font=FONTS["body"], anchor="w", wraplength=320, justify="left",
            ).pack(fill="x", padx=SP["lg"], pady=(0, SP["md"]))
            # Level 3 callout
            lvl_tip = tk.Label(scen_inner, text="Level 3: This scenario IS your brief — no extra steps given.", bg=t["tip_bg"], fg=t["muted"],
                               font=FONTS["caption"], anchor="w", wraplength=320, justify="left")
            # Will show/hide via render_guidance

        # ── Guidance-dependent container (Requirements / Concepts / Milestones) ──
        guidance_box = tk.Frame(inner, bg=t["panel"])
        guidance_box.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        def render_guidance():
            for w in guidance_box.winfo_children():
                w.destroy()
            cur = get_project_guidance_level(self.controller.progress, level, lesson_idx)
            # Keep description of level in sync
            try:
                lvl_desc_var.set(GUIDANCE_LEVEL_META[cur]["label"] + " — " + GUIDANCE_LEVEL_META[cur]["desc"])
            except Exception:
                pass
            hint_levels = proj.get("hint_levels") or _derive_hint_levels(proj)
            requirements = proj.get("requirements") or _derive_requirements(proj)
            concepts = proj.get("required_concepts") or _derive_required_concepts(lesson)
            detailed = proj.get("steps", [])
            condensed = proj.get("milestones_condensed") or _derive_milestones_condensed(proj)

            if cur == "1":
                # Required Concepts — Strong guidance
                c_frame = tk.Frame(guidance_box, bg=t["success_bg"], bd=1, relief="solid", padx=SP["md"], pady=SP["sm"])
                c_frame.pack(fill="x", pady=(0, SP["sm"]))
                tk.Label(c_frame, text="Required Concepts  \u2014  what this project builds on", bg=t["success_bg"], fg=t["success"],
                         font=FONTS["caption_bold"], anchor="w").pack(fill="x")
                for c in concepts:
                    row = tk.Frame(c_frame, bg=t["success_bg"])
                    row.pack(fill="x", pady=1)
                    tk.Label(row, text="\u2022", bg=t["success_bg"], fg=t["success"], font=FONTS["body_bold"], width=2, anchor="w").pack(side="left")
                    tk.Label(row, text=c, bg=t["success_bg"], fg=t["text"], font=FONTS["body_sm"], anchor="w", wraplength=280, justify="left").pack(side="left", fill="x", expand=True)
                # Milestones — step-by-step
                m_frame = tk.Frame(guidance_box, bg=t["panel"], bd=1, relief="solid", padx=SP["md"], pady=SP["sm"])
                m_frame.pack(fill="x", pady=(0, SP["sm"]))
                tk.Label(m_frame, text="Milestones — step-by-step  (do one, run it, then add the next)", bg=t["panel"], fg=t["text"],
                         font=FONTS["body_bold"], anchor="w").pack(fill="x", pady=(0, SP["xs"]))
                for s in detailed:
                    tk.Label(m_frame, text=s, bg=t["panel"], fg=t["text_secondary"],
                             font=FONTS["body_sm"], anchor="w", wraplength=300, justify="left").pack(fill="x", pady=1, padx=(SP["sm"], 0))
                # Also show condensed requirements as checklist footer
                tk.Label(m_frame, text="You’ll know you’re done when every milestone prints its Expected line.", bg=t["panel"], fg=t["muted"],
                         font=FONTS["caption"], anchor="w", wraplength=300, justify="left").pack(fill="x", pady=(SP["xs"], 0))
            elif cur == "2":
                # Requirements + condensed milestones — Partial
                r_frame = tk.Frame(guidance_box, bg=t["panel"], bd=1, relief="solid", padx=SP["md"], pady=SP["sm"])
                r_frame.pack(fill="x", pady=(0, SP["sm"]))
                tk.Label(r_frame, text="Requirements — what to deliver", bg=t["panel"], fg=t["text"],
                         font=FONTS["body_bold"], anchor="w").pack(fill="x")
                for req in requirements:
                    row = tk.Frame(r_frame, bg=t["panel"])
                    row.pack(fill="x", pady=1)
                    tk.Label(row, text="\u2610", bg=t["panel"], fg=t["muted"], font=FONTS["body_sm"], width=2, anchor="w").pack(side="left")
                    tk.Label(row, text=req, bg=t["panel"], fg=t["text_secondary"], font=FONTS["body_sm"], anchor="w", wraplength=280, justify="left").pack(side="left", fill="x", expand=True)
                m2 = tk.Frame(guidance_box, bg=t["code_bg"], bd=1, relief="solid", padx=SP["md"], pady=SP["sm"])
                m2.pack(fill="x")
                tk.Label(m2, text="Milestones — bigger chunks (no micro-steps)", bg=t["code_bg"], fg=t["text"],
                         font=FONTS["body_bold"], anchor="w").pack(fill="x", pady=(0, SP["xs"]))
                for ms in condensed:
                    tk.Label(m2, text="\u2022  " + ms, bg=t["code_bg"], fg=t["text"], font=FONTS["body_sm"], anchor="w", wraplength=300, justify="left").pack(fill="x", pady=1, padx=(SP["sm"], 0))
                tk.Label(m2, text="Fewer hints here — Need a Hint? shows Gentle + Specific only unless you ask for the Almost-Solution.", bg=t["code_bg"], fg=t["muted"],
                         font=FONTS["caption"], anchor="w", wraplength=300, justify="left").pack(fill="x", pady=(SP["xs"], 0))
            else:  # cur == "3" Minimal
                r3 = tk.Frame(guidance_box, bg=t["warning_bg"], bd=1, relief="solid", padx=SP["md"], pady=SP["sm"])
                r3.pack(fill="x", pady=(0, SP["sm"]))
                tk.Label(r3, text="Requirements only — no milestones", bg=t["warning_bg"], fg=t["warning"],
                         font=FONTS["body_bold"], anchor="w").pack(fill="x")
                tk.Label(r3, text="Use the real-world Scenario above + these Requirements as your checklist. Plan your own steps.", bg=t["warning_bg"], fg=t["text"],
                         font=FONTS["caption"], anchor="w", wraplength=300, justify="left").pack(fill="x", pady=(0, SP["xs"]))
                for req in requirements:
                    row = tk.Frame(r3, bg=t["warning_bg"])
                    row.pack(fill="x", pady=1)
                    tk.Label(row, text="\u2610", bg=t["warning_bg"], fg=t["warning"], font=FONTS["body_sm"], width=2, anchor="w").pack(side="left")
                    tk.Label(row, text=req, bg=t["warning_bg"], fg=t["text"], font=FONTS["body_sm"], anchor="w", wraplength=280, justify="left").pack(side="left", fill="x", expand=True)
                tk.Label(guidance_box, text="No step-by-step list at Level 3. Break the Requirements into your own milestones, then code.", bg=t["panel"], fg=t["muted"],
                         font=FONTS["caption"], anchor="w", wraplength=320, justify="left").pack(fill="x", pady=(SP["xs"], 0))
        render_guidance()

        # ── Optional Hints — Need a Hint? 3-tier progressive ──
        hint_levels = proj.get("hint_levels") or _derive_hint_levels(proj)
        n_tiers = len(hint_levels)
        gs = tk.Frame(inner, bg=t["panel"], relief="solid", bd=1)
        gs.pack(fill="x", padx=SP["xl"], pady=(0, SP["md"]))

        def reveal():
            maps = self.controller.progress.get("project_hints", {})
            r = int(maps.get(hint_key, 0))
            if r < n_tiers:
                r += 1
            else:
                r = 0  # cycle hide
            maps[hint_key] = r
            self.controller.progress["project_hints"] = maps
            save_progress(self.controller.progress_path, self.controller.progress)
            render_gs()

        def render_gs():
            for w in gs.winfo_children():
                w.destroy()
            r = int(self.controller.progress.get("project_hints", {}).get(hint_key, 0))
            cur = get_project_guidance_level(self.controller.progress, level, lesson_idx)
            tk.Label(
                gs, text="\U0001F4A1 Need a Hint?  (progressive — won’t spoil the solution)", bg=t["panel"], fg=t["text"],
                font=FONTS["body_bold"], anchor="w",
            ).pack(fill="x", padx=SP["lg"], pady=(SP["md"], SP["xs"]))
            # Guidance-level hint policy note
            policy = "Level 1 shows all 3 tiers. Level 2 shows 2 tiers then Almost-Solution on 3rd click. Level 3 keeps hints hidden until you ask."
            tk.Label(gs, text=policy, bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=300, justify="left").pack(fill="x", padx=SP["lg"], pady=(0, SP["xs"]))
            tk.Label(gs, text="Each click reveals one more tier: 1 Gentle Nudge \u2192 2 More Specific \u2192 3 Almost Solution (template).", bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=300, justify="left").pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
            visible = min(r, n_tiers)
            # At Level 3, keep hints hidden until first click, still allow reveal; at Level 2 hint_3 is “almost solution” extra
            for i in range(visible):
                tier = hint_levels[i]
                hf = tk.Frame(gs, bg=t["code_bg"] if i < 2 else t["warning_bg"], bd=1, relief="solid")
                hf.pack(fill="x", padx=SP["lg"], pady=(0, SP["xs"]))
                tk.Label(hf, text=tier["title"], bg=t["code_bg"] if i < 2 else t["warning_bg"], fg=t["accent"] if i < 2 else t["warning"],
                         font=FONTS["caption_bold"], anchor="w").pack(fill="x", padx=(SP["sm"], SP["sm"]), pady=(SP["sm"], 0))
                tk.Label(hf, text=tier["text"], bg=t["code_bg"] if i < 2 else t["warning_bg"], fg=t["text"],
                         font=FONTS["body_sm"], anchor="w", wraplength=290, justify="left").pack(fill="x", padx=(SP["sm"], SP["sm"]), pady=(0, SP["sm"]))
            if n_tiers:
                if r < n_tiers:
                    nxt_title = hint_levels[r]["title"] if r < n_tiers else ""
                    btn_text = f"Need a Hint?  Reveal {nxt_title}  ({r+1}/{n_tiers})"
                else:
                    btn_text = "Hide hints  \u2715"
                hint_btn = tk.Button(gs, text=btn_text, font=FONTS["button_sm"],
                                     command=reveal, padx=SP["md"], pady=SP["xs"])
                hint_btn.pack(anchor="w", padx=SP["lg"], pady=(SP["xs"], SP["md"]))
                style_button(hint_btn, t, "secondary_btn_bg", "secondary_btn_hover")
                # Level 3 starts at 0 and should not auto-reveal; Level 1 hint 1 is gentle
                if cur == "3" and r == 0:
                    tk.Label(gs, text="Minimal guidance: hints stay hidden until you press — that’s intentional.", bg=t["panel"], fg=t["muted"], font=FONTS["caption"], anchor="w").pack(fill="x", padx=SP["lg"], pady=(0, SP["xs"]))

        render_gs()

        tk.Label(right, text="Your Code", bg=t["bg"], fg=t["muted"],
                 font=FONTS["heading_sm"], anchor="w").pack(anchor="w", padx=SP["lg"], pady=(SP["xl"], SP["sm"]))

        proj_entry = SyntaxEditor(right, theme=t, height=12, font=FONTS["code"], bg=t["input_bg"],
                             fg=t["text"], insertbackground=t["text"], relief="solid", bd=1, undo=True)
        proj_entry.pack(fill="both", expand=True, padx=SP["lg"], pady=(0, SP["sm"]))
        proj_key = project_draft_key(level, lesson_idx)
        drafted = self.controller.progress.get("draft_code", {}).get(proj_key)
        proj_entry.set_code(drafted or proj["starter_code"])
        proj_entry.bind("<KeyRelease>", lambda _e: self._capture_draft(proj_key, proj_entry), add="+")
        tk.Label(right, text="Tip: press Ctrl+Enter in the editor to run your project.",
                 bg=t["bg"], fg=t["muted"], font=FONTS["caption"], anchor="w"
                 ).pack(anchor="w", padx=SP["lg"], pady=(0, SP["xs"]))

        output_box = tk.Text(right, height=4, font=FONTS["code"], bg=t["code_bg"],
                             fg=t["text"], relief="solid", bd=1, wrap="word")
        output_box.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))
        output_box.configure(state="disabled")

        proj_feedback = tk.StringVar(value="")
        proj_feedback_lbl = tk.Label(right, textvariable=proj_feedback, bg=t["bg"],
                                     font=FONTS["body_bold"], anchor="w", wraplength=460, justify="left")
        proj_feedback_lbl.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        def check_project():
            code = proj_entry.get("1.0", tk.END)
            res = self._run_code(code, timeout=4)
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)

            if res["blocked"]:
                output_box.insert("1.0", res["blocked"])
                output_box.configure(state="disabled")
                proj_feedback.set("Your code was blocked \u2014 see the output and stick to the allowed tools.")
                proj_feedback_lbl.configure(fg=t["error"])
                return

            if not res["ok"]:
                shown = res["output"]
                if shown and res["error"]:
                    shown += "\n\n"
                output_box.insert("1.0", shown + res["error"])
                output_box.configure(state="disabled")
                proj_feedback.set("\u2717 " + (res["explained"] or "Your project hit a Python error \u2014 check the output."))
                proj_feedback_lbl.configure(fg=t["error"])
                try:
                    coach_panel.offer(coach_diagnose(code, coach_step, res), coach_btn)
                except Exception:
                    pass
                self._project_fail()
                return

            ok, msg = proj["check"](code)
            done = ok and not res["error"]
            output_box.insert("1.0", res["output"] if res["output"] else "(ran without errors \u2014 add a print() so the result shows)")
            output_box.configure(state="disabled")
            if ok:
                proj_feedback.set("\u2713 " + msg)
            else:
                try:
                    coach_panel.offer(coach_hint_specific(code, coach_step, self.controller.progress.get("level", "")), coach_btn)
                except Exception:
                    pass
                proj_feedback.set("\u2717 Your project runs, but it doesn't finish the goal yet. Check the steps and compare with the starter hints on the left.")
            proj_feedback_lbl.configure(fg=t["success"] if done else t["warning"])
            if done:
                newly_passed = record_project_pass(self.controller.progress, level, lesson_idx)
                if newly_passed:
                    award_xp(self.controller.progress, 25, "final project")
                    update_streak(self.controller.progress)
                    show_toast(self.winfo_toplevel(), "\u2b50 Project Complete! +25 XP", t)
                    self.controller.celebrate()
                    self.controller.check_badges()
                save_progress(self.controller.progress_path, self.controller.progress)
                self.controller.sidebar.refresh()
            else:
                f = self._project_fail()
                if f in (3, 4):
                    proj_feedback.set("\u2717 Not quite \u2014 the Coach hopped in. Read its pointer and finish one step at a time.")

        def _project_fail():
            fail_maps = self.controller.progress.get("project_fail_counts", {})
            fails = int(fail_maps.get(hint_key, 0)) + 1
            fail_maps[hint_key] = fails
            self.controller.progress["project_fail_counts"] = fail_maps
            save_progress(self.controller.progress_path, self.controller.progress)
            if fails == 2:
                # auto-reveal first tier if not yet shown
                r = int(self.controller.progress.get("project_hints", {}).get(hint_key, 0))
                tiers = proj.get("hint_levels") or _derive_hint_levels(proj)
                if r < len(tiers):
                    reveal()
                show_toast(self.winfo_toplevel(), "\U0001F4A1 Stuck? A starting hint is now unlocked on the left!", t)
            if fails in (3, 4):
                try:
                    coach_panel.offer(coach_proactive(proj_entry.get("1.0", tk.END), coach_step,
                                                      fails, self.controller.progress.get("level", "")),
                                       coach_btn)
                except Exception:
                    pass
            return fails

        btn_row = tk.Frame(right, bg=t["bg"])
        btn_row.pack(fill="x", padx=SP["lg"], pady=(0, SP["sm"]))

        run_btn = tk.Button(btn_row, text="\u25b6 Run Project", font=FONTS["button"],
                            command=check_project, padx=SP["xl"], pady=SP["md"])
        run_btn.pack(side="left")
        style_button(run_btn, t, "accent", "accent_hover")

        # Keep reference for guidance switch draft save
        self._proj_entry = proj_entry
        # ── Solution Review — hidden until project passes (no instant solution) ──
        review_frame = tk.Frame(right, bg=t["success_bg"], bd=1, relief="solid", padx=SP["md"], pady=SP["sm"])
        review_inner = tk.Frame(review_frame, bg=t["success_bg"])
        review_inner.pack(fill="x")
        # Will be packed on demand; helper to build its content
        def build_review():
            for w in review_inner.winfo_children():
                w.destroy()
            tk.Label(review_inner, text="\U0001F50D Solution Review — compare yours", bg=t["success_bg"], fg=t["success"],
                     font=FONTS["body_bold"], anchor="w").pack(fill="x")
            tk.Label(review_inner, text="No full solution dumped here — check these points against your code, then peek at the model only if needed.",
                     bg=t["success_bg"], fg=t["text"], font=FONTS["caption"], anchor="w", wraplength=420, justify="left").pack(fill="x", pady=(SP["xs"], SP["sm"]))
            for pt in (proj.get("review_points") or []):
                row = tk.Frame(review_inner, bg=t["success_bg"])
                row.pack(fill="x", pady=1)
                tk.Label(row, text="\u2713", bg=t["success_bg"], fg=t["success"], font=FONTS["caption_bold"], width=2, anchor="w").pack(side="left")
                tk.Label(row, text=pt, bg=t["success_bg"], fg=t["text"], font=FONTS["body_sm"], anchor="w", wraplength=380, justify="left").pack(side="left", fill="x", expand=True)
            # Model solution toggle (collapsed by default)
            model_txt = (proj.get("model_solution") or proj.get("starter_snippet") or "").strip()
            if model_txt:
                def _toggle_model(btn_ref=None):
                    if hasattr(review_inner, "_model_box") and review_inner._model_box.winfo_exists():
                        try:
                            review_inner._model_box.destroy()
                            delattr(review_inner, "_model_box")
                            if btn_ref:
                                btn_ref.configure(text="Show model snippet \u25B6")
                        except Exception:
                            pass
                    else:
                        box = tk.Frame(review_inner, bg=t["code_bg"], bd=1, relief="solid", padx=SP["sm"], pady=SP["sm"])
                        box.pack(fill="x", pady=(SP["sm"], 0))
                        review_inner._model_box = box
                        tk.Label(box, text="Model snippet — adapt, don’t copy verbatim", bg=t["code_bg"], fg=t["muted"],
                                 font=FONTS["caption_bold"], anchor="w").pack(fill="x")
                        tk.Label(box, text=model_txt, bg=t["code_bg"], fg=t["text"], font=FONTS["code_sm"], anchor="nw", justify="left").pack(fill="x")
                        if btn_ref:
                            btn_ref.configure(text="Hide model snippet \u25BC")
                m_btn = tk.Button(review_inner, text="Show model snippet \u25B6", font=FONTS["caption_bold"],
                                  padx=SP["md"], pady=2, bd=1, relief="solid")
                m_btn.pack(anchor="w", pady=(SP["sm"], 0))
                style_button(m_btn, t, "secondary_btn_bg", "secondary_btn_hover")
                m_btn.configure(command=lambda b=m_btn: _toggle_model(b))
            tk.Label(review_inner, text="What to avoid: copying without understanding. Re-run with small changes and watch the output.",
                     bg=t["success_bg"], fg=t["muted"], font=FONTS["caption"], anchor="w", wraplength=400, justify="left").pack(fill="x", pady=(SP["sm"], 0))
        # If already passed before, show review immediately
        _key = attempt_key(level, lesson_idx)
        if self.controller.progress.get("performance_log", {}).get(_key, {}).get("project_passed"):
            review_frame.pack(fill="x", padx=SP["lg"], pady=(SP["sm"], SP["sm"]))
            build_review()
            # Also build when we later need to show after pass, keep builder handy
            review_frame._builder = build_review
        else:
            # Remember builder for later reveal
            review_frame._builder = build_review

        # Patch check_project to reveal review on success
        _orig_after_check = None  # placeholder for closure capture
        def reveal_review():
            if not review_frame.winfo_ismapped():
                review_frame.pack(fill="x", padx=SP["lg"], pady=(SP["sm"], SP["sm"]))
                try:
                    review_frame._builder()
                except Exception:
                    pass
                review_frame.lift()

        # Wrap the existing check_project's success path to also reveal review
        _saved_check = check_project
        def check_project_with_review():
            code = proj_entry.get("1.0", tk.END)
            res = self._run_code(code, timeout=4)
            output_box.configure(state="normal")
            output_box.delete("1.0", tk.END)
            if res["blocked"]:
                output_box.insert("1.0", res["blocked"])
                output_box.configure(state="disabled")
                proj_feedback.set("Your code was blocked \u2014 see the output and stick to the allowed tools.")
                proj_feedback_lbl.configure(fg=t["error"])
                return
            if not res["ok"]:
                shown = res["output"]
                if shown and res["error"]:
                    shown += "\n\n"
                output_box.insert("1.0", shown + res["error"])
                output_box.configure(state="disabled")
                proj_feedback.set("\u2717 " + (res["explained"] or "Your project hit a Python error \u2014 check the output."))
                proj_feedback_lbl.configure(fg=t["error"])
                try:
                    coach_panel.offer(coach_diagnose(code, coach_step, res), coach_btn)
                except Exception:
                    pass
                _project_fail()
                return
            ok, msg = proj["check"](code)
            done = ok and not res["error"]
            output_box.insert("1.0", res["output"] if res["output"] else "(ran without errors \u2014 add a print() so the result shows)")
            output_box.configure(state="disabled")
            if ok:
                proj_feedback.set("\u2713 " + msg)
            else:
                try:
                    coach_panel.offer(coach_hint_specific(code, coach_step, self.controller.progress.get("level", "")), coach_btn)
                except Exception:
                    pass
                proj_feedback.set("\u2717 Your project runs, but it doesn't finish the goal yet. Check the Requirements + Milestones on the left.")
            proj_feedback_lbl.configure(fg=t["success"] if done else t["warning"])
            if done:
                newly_passed = record_project_pass(self.controller.progress, level, lesson_idx)
                if newly_passed:
                    award_xp(self.controller.progress, 25, "final project")
                    update_streak(self.controller.progress)
                    show_toast(self.winfo_toplevel(), "\u2b50 Project Complete! +25 XP", t)
                    self.controller.celebrate()
                    self.controller.check_badges()
                save_progress(self.controller.progress_path, self.controller.progress)
                self.controller.sidebar.refresh()
                reveal_review()
            else:
                f = _project_fail()
                if f in (3, 4):
                    proj_feedback.set("\u2717 Not quite \u2014 the Coach hopped in. Read its pointer and finish one milestone at a time.")

        # Replace button command to use review-aware version
        run_btn.configure(command=check_project_with_review)
        # Keep reference for Ctrl+Enter
        _check_ref = check_project_with_review

        coach_step = dict(proj)
        coach_step["instruction"] = " ".join(proj.get("steps", []))
        coach_step["hint"] = (proj.get("start_hints") or [""])[0]
        coach_panel = CoachPanel(right, t,
                                 lambda: proj_entry.get("1.0", tk.END),
                                 coach_step, proj.get("title", lesson.get("title", "")), self.controller)
        coach_btn = tk.Button(btn_row, text="\U0001F3C5 Ask Coach", font=FONTS["button_sm"],
                              command=lambda: coach_panel.toggle(coach_btn), padx=SP["md"], pady=SP["xs"])
        coach_btn.pack(side="left", padx=SP["sm"])
        style_button(coach_btn, t, "warning", "warning_bg")

        proj_entry.bind("<Control-Return>", lambda _e: (_check_ref(), "break")[1])
        proj_entry.bind("<Command-Return>", lambda _e: (_check_ref(), "break")[1])

    def _next_step(self):
        p = self.controller.progress
        level = p.get("level", "Beginner")
        lessons = self.lesson_sets.get(level, [])
        lesson_idx = min(p.get("lesson_index", 0), max(len(lessons) - 1, 0))
        lesson = lessons[lesson_idx]
        steps = lesson.get("steps", [])
        step_idx = p.get("step_index", 0)

        completed_steps_dict = p.get("completed_steps", {})
        if steps:
            actionable = [i for i, s in enumerate(steps) if s["type"] != "concept"]
            all_done = all(
                step_key(level, lesson_idx, i) in completed_steps_dict
                for i in actionable
            ) if actionable else True
        else:
            all_done = True

        if all_done:
            self.refresh()
            return

        if step_idx < len(steps) - 1:
            self.controller.update_progress(step_index=step_idx + 1)
        self.refresh()

    def _prev_step(self):
        p = self.controller.progress
        step_idx = p.get("step_index", 0)
        if step_idx > 0:
            self.controller.update_progress(step_index=step_idx - 1)
            self.refresh()

    def _mark_step_done(self, level, lesson_idx, step_idx):
        p = self.controller.progress
        completed_steps_dict = p.get("completed_steps", {})
        key = step_key(level, lesson_idx, step_idx)
        if key in completed_steps_dict:
            return False
        completed_steps_dict[key] = True
        p["completed_steps"] = completed_steps_dict
        # Persist immediately so a crash or quick close never loses the checkmark
        try:
            path = getattr(self.controller, "progress_path", None)
            if path:
                save_progress(path, p)
        except Exception:
            pass
        return True

    def _capture_draft(self, key, text_widget):
        """Keep the learner's typed code in progress, saved ~1.5s after they
        stop typing, so closing the app never loses what they wrote."""
        p = self.controller.progress
        drafts = p.setdefault("draft_code", {})
        drafts[key] = text_widget.get("1.0", tk.END)
        job = getattr(self.controller, "_draft_save_job", None)
        if job:
            try:
                self.controller.after_cancel(job)
            except tk.TclError:
                pass
        self.controller._draft_save_job = self.controller.after(
            1500, lambda: save_progress(self.controller.progress_path, p)
        )

    def _complete_lesson(self):
        p = self.controller.progress
        level = p.get("level", "Beginner")
        idx = int(p.get("lesson_index", 0))
        completed = list(p.get("completed_lessons", []))
        # Also keep per-level map so history survives level switches
        cbl = p.setdefault("completed_by_level", {})
        cur_list = cbl.setdefault(level, [])
        if idx not in cur_list:
            if idx not in cur_list:
                cur_list.append(idx)
                cur_list.sort()
        if idx not in completed:
            completed.append(idx)
            completed.sort()
            award_xp(p, 10, "lesson complete")
            update_streak(p)
            schedule_review(p, level, idx)
            # Mark any remaining actionable steps for this lesson as done (so dots go green)
            lesson = (self.lesson_sets.get(level, [])[idx] if 0 <= idx < len(self.lesson_sets.get(level, [])) else {})
            for si, step in enumerate(lesson.get("steps", [])):
                if step.get("type") != "concept":
                    p.setdefault("completed_steps", {})[step_key(level, idx, si)] = True
            save_progress(self.controller.progress_path, p)
        else:
            # Even if already completed, ensure map is synced and saved
            save_progress(self.controller.progress_path, p)
        self.controller.update_progress(completed_lessons=completed)
        self.controller.celebrate(message="\U0001F393 Lesson complete! +10 XP")
        self.controller.check_badges()
        self.refresh()

    def _build_lesson_sets(self):
        # Language-aware: use controller's current language if available, else fallback to python
        try:
            lang = current_language(self.controller.progress) if hasattr(self, "controller") and hasattr(self.controller, "progress") else "python"
            if lang in SUPPORTED_LANGUAGES:
                return get_lesson_sets_for_language(lang)
        except Exception:
            pass
        return build_lesson_sets()

    def reload_lesson_sets(self):
        """Refresh lesson_sets after a language switch."""
        self.lesson_sets = self._build_lesson_sets()

    def _run_code(self, code, timeout=2.5, trace=False):
        """Run code with the runner matching the current language (Python or Java)."""
        try:
            lang = current_language(self.controller.progress)
        except Exception:
            lang = "python"
        return run_code_for_language(code, lang, timeout=timeout, trace=trace)


if __name__ == "__main__":
    # ── CLI for auto-update dev mode ─────────────────────────────────────
    # Keep argparse lightweight; unknown args are ignored so tkinter help still works.
    _watch_parser = argparse.ArgumentParser(add_help=False)
    _watch_parser.add_argument("--watch", action="store_true", help="Auto-rebuild dist/ on save (now default from source; flag just ensures it)")
    _watch_parser.add_argument("--dev", action="store_true", help="Alias for --watch")
    _watch_parser.add_argument("--auto-update", action="store_true", help="Alias for --watch")
    _watch_parser.add_argument("--no-watch", action="store_true", help="Disable background exe rebuild watcher (hot-reload still on)")
    _watch_parser.add_argument("--no-auto-update", action="store_true", help="Alias for --no-watch")
    _watch_parser.add_argument("--no-hot-reload", action="store_true", help="Disable in-app lesson hot-reload")
    _watch_parser.add_argument("-h", "--help", action="store_true", dest="show_help")
    try:
        _w_args, _ = _watch_parser.parse_known_args()
    except Exception:
        _w_args = argparse.Namespace(watch=False, dev=False, auto_update=False, no_watch=False, no_auto_update=False, no_hot_reload=False, show_help=False)
    if getattr(_w_args, "show_help", False):
        _watch_parser.print_help()
        print("\nDev auto-update (now automatic):")
        print("  python learn_python_gui.py           # auto hot-reload + auto rebuild dist/ on save (default from source)")
        print("  python learn_python_gui.py --no-watch # GUI only, hot-reload lessons still live, no exe rebuild")
        print("  python watch_build.py                # watch & rebuild only (no GUI)")
        print("  python build.py --watch              # build once then watch")
        print("  python dev.py                        # launch GUI + watcher together (recommended, avoids double watcher)")
        print("\nNotes:")
        print("  - Hot-reload (lesson_data + languages/) is always on from source (1.5s poll, shows refresh toast).")
        print("  - Background watcher for dist/PythonLearningCoach/LearnPython.exe is now auto-started")
        print("    from source; use --no-watch to disable if you want GUI-only.")
        print("  - Frozen exe (LearnPython.exe) does not hot-reload; run from source during development.")
        sys.exit(0)
    if getattr(_w_args, "no_hot_reload", False):
        # Disable hot-reload polling (still allow background watcher if --watch)
        _HOT_RELOAD_POLL_MS = 0
    # Normal startup
    _enable_dpi_awareness()
    app = PythonLearnerApp()
    app.mainloop()

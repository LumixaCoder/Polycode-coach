    "large": 1.25,
}

DEFAULT_FONT_SIZE = "normal"


def rebuild_fonts(scale):
    """Regenerate the app-wide fonts for a text-size scale (e.g. 1.25 = Large).

    Every font is rebuilt from the base sizes so headings, body text, buttons,
    and code blocks all grow together and stay legible.
    """
    for key, (family, size, *style) in _BASE_FONTS.items():
        new_size = max(7, int(round(size * scale)))
        FONTS[key] = (family, new_size, *style) if style else (family, new_size)

